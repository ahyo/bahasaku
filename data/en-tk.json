", "instr": "Pilih kata yang tepat untuk gambar ini.", "ans": "1. c · 2. c · 3. a", "items": ["8️⃣ delapan → ?|two|six|eight", "6️⃣ enam → ?|eight|two|six", "2️⃣ dua → ?|two|ten|three"]}]}, {"num": 4, "en": "Animals", "id": "Hewan", "emoji": "🐾", "goals": ["Menyebut nama hewan dan menirukan suaranya."], "sections": [{"t": "vocab", "title": "🐾 Hewan", "cols": 3, "items": [["🐱", "cat", "ket", "kucing"], ["🐶", "dog", "dog", "anjing"], ["🐦", "bird", "berd", "burung"], ["🐟", "fish", "fisy", "ikan"], ["🐮", "cow", "kau", "sapi"], ["🦆", "duck", "dak", "bebek"], ["🐔", "chicken", "ci-ken", "ayam"], ["🐘", "elephant", "e-le-fen", "gajah"], ["🐵", "monkey", "mang-ki", "monyet"], ["🐰", "rabbit", "re-bit", "kelinci"]]}, {"t": "phrases", "title": "Tirukan, ya!", "items": [["The cat says meow! 🐱", "Kucing berbunyi meong!"], ["The cow says moo! 🐮", "Sapi berbunyi moo!"]], "label": "talk"}, {"t": "song", "title": "Old MacDonald", "lines": ["Old MacDonald had a farm, E-I-E-I-O 🚜", "And on that farm he had a cow, E-I-E-I-O 🐮", "With a moo-moo here, and a moo-moo there,", "Here a moo, there a moo, everywhere a moo-moo!"], "info": "Lagu tradisional. Ganti <i>cow</i> dengan <i>duck</i> (quack), <i>dog</i> (woof), atau <i>cat</i> (meow)."}, {"t": "ex", "kind": "match", "instr": "Cocokkan gambar dengan katanya. Ketuk kata untuk mendengar suaranya.", "ans": "1–c · 2–e · 3–d · 4–a · 5–b", "left": ["cat", "dog", "bird", "fish", "cow"], "right": ["🐟 ikan", "🐮 sapi", "🐱 kucing", "🐦 burung", "🐶 anjing"]}, {"t": "ex", "kind": "choice", "instr": "Pilih kata yang tepat untuk gambar ini.", "ans": "1. a · 2. b · 3. b", "items": ["🐮 sapi → ?|cow|cat|bird", "🐵 monyet → ?|cat|monkey|duck", "🐱 kucing → ?|duck|cat|elephant"]}]}, {"num": 5, "en": "Fruits", "id": "Buah", "emoji": "🍎", "goals": ["Menyebut nama buah-buahan."], "sections": [{"t": "vocab", "title": "🍎 Buah", "cols": 3, "items": [["🍎", "apple", "e-pel", "apel"], ["🍌", "banana", "be-na-na", "pisang"], ["🍊", "orange", "o-renj", "jeruk"], ["🥭", "mango