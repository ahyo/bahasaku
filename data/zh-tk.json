{"id": "zh-tk", "kind": "lang", "lang": "zh", "grade": null, "level": "tk", "tag": "TK / PAUD", "badge": ["TK", "🧸"], "title": "Mandarin Anak", "sub": "Bahasa Mandarin TK/PAUD · salam, warna, angka, hewan, lagu", "c": "#E8590C", "c2": "#FFF4E6", "c3": "#D9480F", "emojis": "👋 🌈 🔢 🐾 🍎 🧒 👨‍👩‍👧 🚗", "intro": "<div class=\"note\"><div class=\"note-h\">🧸 Untuk anak usia 3–6 tahun</div>Belajar lewat <b>gambar, suara, dan lagu</b>. Anak tidak perlu bisa membaca: ketuk gambar untuk mendengar, tirukan bersama, lalu bermain <b>🎮 Tebak Gambar</b>. Sebaiknya didampingi orang tua atau guru.</div>", "cando": ["Menyapa dan berterima kasih dalam bahasa Mandarin.", "Menyebut warna dalam bahasa Mandarin.", "Berhitung 1 sampai 10 dalam bahasa Mandarin.", "Menyebut nama hewan dalam bahasa Mandarin.", "Menyebut nama buah dalam bahasa Mandarin.", "Menyebut anggota tubuh dalam bahasa Mandarin.", "Menyebut anggota keluarga dalam bahasa Mandarin.", "Menyebut nama kendaraan dalam bahasa Mandarin."], "text": {"labels": {"learn": ["🧸", "Ayo Kenalan!", "Kosakata"], "talk": ["🗣️", "Ayo Bicara!", "Tirukan"], "read": ["📖", "Ayo Membaca", ""], "practice": ["🎮", "Ayo Bermain!", "Latihan bersama Ayah/Bunda"], "sing": ["🎵", "Ayo Bernyanyi!", "Lagu"], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Pola", ""], "write": ["📝", "Menulis", ""]}, "brand": "Mandarin untuk Anak", "unit_word": "tema", "tip_prefix": "Tips untuk Ayah/Bunda:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Benar", "false": "Salah", "review_t": "Ayo Ulang! ⭐", "review_s": "Permainan penutup", "pron_note": "", "pron_html": ""}, "units": [{"num": 1, "en": "你好！", "id": "Salam", "emoji": "👋", "goals": ["Menyapa dan berterima kasih dalam bahasa Mandarin."], "sections": [{"t": "vocab", "title": "👋 Salam", "cols": 3, "items": [["👋", "你好", "nǐ hǎo", "halo"], ["🌅", "早上好", "zǎoshang hǎo", "selamat pagi"], ["🙏", "谢谢", "xièxie", "terima kasih"], ["😊", "不客气", "bú kèqi", "sama-sama"], ["🙇", "对不起", "duìbuqǐ", "maaf"], ["🙋", "再见", "