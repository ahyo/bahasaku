{"id": "fr-1", "kind": "lang", "lang": "fr", "grade": null, "level": "umum", "tag": "A1", "badge": ["Level", "A1"], "title": "Bahasa Prancis Pemula", "sub": "Pelafalan, salam, être/avoir, angka, keluarga, kata kerja, restoran", "c": "#1971C2", "c2": "#E7F5FF", "c3": "#0B4A85", "emojis": "👋 🪪 🔢 👨‍👩‍👧 🏃 🍽️", "intro": "<div class=\"note\"><div class=\"note-h\">📌 Tentang kursus ini</div>Bahasa Prancis dari nol, setara <b>A1</b> (CEFR, persiapan DELF A1). Fokus pada pelafalan (huruf yang tidak dibaca, bunyi sengau) dan percakapan sehari-hari.</div>", "cando": ["Membaca gabungan huruf khas bahasa Prancis (ou, oi, eau, ch, j).", "Memperkenalkan diri, asal, dan tempat tinggal.", "Menghitung 0–100, termasuk 70–99 yang unik.", "Menyebut anggota keluarga dengan artikel le/la.", "Mengonjugasikan kata kerja -er serta aller dan faire.", "Memesan dengan je voudrais dan meminta tagihan."], "text": {"labels": {"learn": ["📚", "Vocabulaire", "Kosakata"], "talk": ["🗣️", "Dialogue", "Percakapan"], "read": ["📖", "Lecture", "Membaca"], "practice": ["✏️", "Exercices", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Grammaire", "Tata Bahasa"], "write": ["📝", "Menulis", ""]}, "brand": "Belajar Bahasa Prancis", "unit_word": "unit", "tip_prefix": "Tips:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Vrai", "false": "Faux", "review_t": "Révision · Evaluasi", "review_s": "Uji kemampuanmu", "pron_note": "", "pron_html": "<div class=\"note\"><div class=\"note-h\">🔊 Cara baca</div>Cara baca ditulis dengan ejaan sederhana, misalnya <i>bonjour</i> = <i>bon-zhur</i>. Huruf <b>ng</b> di akhir suku kata menandai bunyi sengau (nasal), dan <b>zh</b> = bunyi j lembut seperti <i>je</i>. Dengarkan juga suaranya dengan tombol 🔊.</div>"}, "units": [{"num": 1, "en": "Prononciation et salutations", "id": "Pelafalan & salam", "emoji": "👋", "goals": ["Membaca gabungan huruf khas bahasa Prancis (ou, oi, eau, ch, j).", "Menyapa, berterima kasih, dan berpamitan."], "sections": [{"t": "note", "html": "Bahasa Prancis dituturkan sekitar <b>320 juta orang</b> di lima benua (Prancis, Belgia, Swiss, Kanada, dan banyak negara Afrika), dan menjadi bahasa resmi PBB, Uni Eropa, serta Olimpiade. Ciri khasnya: <b>huruf mati di akhir kata biasanya tidak dibaca</b>, misalnya <i>petit</i> = pe-ti dan <i>Paris</i> = pa-ri.", "title": "Mengenal bahasa Prancis"}, {"t": "grammar", "title": "Gabungan huruf penting", "head": ["Tulisan", "Dibaca", "Contoh"], "rows": [["ou", "u", "vous (vu), bonjour (bon-zhur)"], ["u", "ü (i dengan bibir bulat)", "tu (tü), salut (sa-lü)"], ["oi", "wa", "moi (mwa), trois (trwa)"], ["au, eau", "o", "eau (o), au revoir (o re-vwar)"], ["ai, ei", "è", "mais (mè), neige (nèzh)"], ["eu", "ö", "deux (dö), bleu (blö)"], ["on, an/en, in", "bunyi sengau", "bon, enfant, vin"], ["ch", "sy", "chat (sya), chocolat (syo-ko-la)"], ["j, g + e/i", "zh (j lembut)", "je (zhe), rouge (ruzh)"], ["gn", "ny", "montagne (mon-ta-nye)"], ["h", "tidak dibaca", "hôtel (o-tèl)"]], "after": "<b>Liaison</b>: huruf mati di akhir kata dibaca bila kata berikutnya diawali vokal, misalnya <i>vous_avez</i> (vu-za-ve)."}, {"t": "phrases", "title": "Salam & sopan santun", "items": [["Bonjour !", "Halo / selamat pagi–siang!", "bon-zhur"], ["Bonsoir !", "Selamat malam!", "bon-swar"], ["Salut !", "Hai! (akrab)", "sa-lü"], ["Comment allez-vous ? / Ça va ?", "Apa kabar? (formal / akrab)", "ko-man ta-le vu / sa va"], ["Ça va bien, merci. Et toi ?", "Baik, terima kasih. Kamu?", "sa va bien, mer-si. e twa"], ["S'il vous plaît.", "Tolong / silakan.", "sil vu ple"], ["Merci beaucoup ! – De rien.", "Terima kasih banyak! – Sama-sama.", "mer-si bo-ku – de rien"], ["Excusez-moi. / Pardon.", "Permisi. / Maaf.", "eks-kü-ze mwa / par-don"], ["Au revoir ! / À bientôt !", "Sampai jumpa! / Sampai nanti!", "o re-vwar / a bien-to"]]}, {"t": "ex", "kind": "choice", "instr": "Choisis la bonne réponse.", "ans": "1. b · 2. c · 3. b · 4. b · 5. b", "items": ["Gabungan oi pada «moi» dibaca ...|oi|wa|o|u", "Gabungan ou pada «vous» dibaca ...|ou|o|u|au", "Kata «Paris» dibaca ...|pa-ris|pa-ri|pe-ris|pa-rih", "Gabungan eau pada «eau» dibaca ...|e-a-u|o|eu|yo", "Salam akrab untuk teman adalah ...|Bonsoir, monsieur.|Salut !|Comment allez-vous ?|Excusez-moi."]}]}, {"num": 2, "en": "Se présenter", "id": "Perkenalan & être", "emoji": "🪪", "goals": ["Memperkenalkan diri, asal, dan tempat tinggal.", "Memakai être serta membedakan tu dan vous."], "sections": [{"t": "grammar", "title": "être (adalah)", "head": ["Subjek", "être", "Contoh"], "rows": [["je (saya)", "suis", "Je <b>suis</b> indonésien."], ["tu (kamu)", "es", "Tu <b>es</b> étudiant ?"], ["il / elle / on (dia / kita)", "est", "Elle <b>est</b> française."], ["nous (kami)", "sommes", "Nous <b>sommes</b> à Paris."], ["vous (Anda / kalian)", "êtes", "Vous <b>êtes</b> professeur ?"], ["ils / elles (mereka)", "sont", "Ils <b>sont</b> amis."]], "after": "<b>tu</b> untuk teman & keluarga; <b>vous</b> untuk orang yang dihormati atau lebih dari satu orang. Kata sifat kebangsaan berubah sesuai jenis: <i>indonésien</i> (lk) / <i>indonésienne</i> (pr)."}, {"t": "dialog", "title": "À l'université", "lines": [["Claire", "👩", "Bonjour ! Je m'appelle Claire. Et toi, tu t'appelles comment ?", "Halo! Namaku Claire. Kamu, siapa namamu?"], ["Budi", "👦", "Bonjour Claire ! Je m'appelle Budi.", "Halo Claire! Namaku Budi."], ["Claire", "👩", "Tu viens d'où ?", "Kamu berasal dari mana?"], ["Budi", "👦", "Je viens d'Indonésie. J'habite à Lyon maintenant. Et toi ?", "Aku dari Indonesia. Sekarang aku tinggal di Lyon. Kamu?"], ["Claire", "👩", "Je suis française, de Marseille. Enchantée !", "Aku orang Prancis, dari Marseille. Senang berkenalan!"], ["Budi", "👦", "Enchanté !", "Senang berkenalan juga!"]]}, {"t": "vocab", "title": "Negara & bahasa", "cols": 4, "items": [["🇫🇷", "la France", "la frangs", "Prancis"], ["🇮🇩", "l'Indonésie", "lin-do-ne-zi", "Indonesia"], ["🇧🇪", "la Belgique", "la bel-zhik", "Belgia"], ["🇨🇦", "le Canada", "le ka-na-da", "Kanada"], ["🗣️", "le français", "le frang-se", "bahasa Prancis"], ["🗣️", "l'indonésien", "lin-do-ne-ziang", "bahasa Indonesia"], ["🗣️", "l'anglais", "lang-gle", "bahasa Inggris"], ["🗣️", "l'arabe", "la-rab", "bahasa Arab"]]}, {"t": "ex", "kind": "fill", "instr": "Lengkapi dengan être (suis, es, est, sommes, êtes, sont).", "ans": "1. suis · 2. es · 3. est · 4. sommes · 5. êtes/etes · 6. sont", "items": ["Je ___ étudiant.", "Tu ___ indonésienne ?", "Elle ___ à Paris.", "Nous ___ amis.", "Vous ___ professeur ?", "Ils ___ français."]}, {"t": "ex", "kind": "order", "instr": "Susun menjadi kalimat.", "ans": "1. Je m'appelle Budi. · 2. Je viens d'Indonésie. · 3. J'habite à Jakarta.", "items": ["m'appelle / Budi. / Je", "Je / d'Indonésie. / viens", "à / J'habite / Jakarta."]}]}, {"num": 3, "en": "Les nombres", "id": "Angka, umur & harga", "emoji": "🔢", "goals": ["Menghitung 0–100, termasuk 70–99 yang unik.", "Menyebut umur dengan avoir dan menanyakan harga."], "sections": [{"t": "vocab", "title": "0–16", "cols": 4, "items": [["0️⃣", "zéro", "ze-ro", "0"], ["1️⃣", "un", "ang", "1"], ["2️⃣", "deux", "dö", "2"], ["3️⃣", "trois", "trwa", "3"], ["4️⃣", "quatre", "katr", "4"], ["5️⃣", "cinq", "sangk", "5"], ["6️⃣", "six", "sis", "6"], ["7️⃣", "sept", "set", "7"], ["8️⃣", "huit", "üit", "8"], ["9️⃣", "neuf", "nöf", "9"], ["🔟", "dix", "dis", "10"], ["🔢", "onze", "onz", "11"], ["🔢", "douze", "duz", "12"], ["🔢", "treize", "trèz", "13"], ["🔢", "quatorze", "ka-torz", "14"], ["🔢", "quinze", "kangz", "15"], ["🔢", "seize", "sèz", "16"]]}, {"t": "grammar", "title": "17–100", "head": ["Angka", "Bahasa Prancis", "Arti harfiah"], "rows": [["17, 18, 19", "dix-sept, dix-huit, dix-neuf", "sepuluh-tujuh …"], ["20, 21, 22", "vingt, vingt et un, vingt-deux", ""], ["30, 40, 50, 60", "trente, quarante, cinquante, soixante", ""], ["70", "<b>soixante-dix</b>", "enam puluh-sepuluh"], ["71, 75", "soixante et onze, soixante-quinze", "60+11, 60+15"], ["80", "<b>quatre-vingts</b>", "empat-dua puluh (4×20)"], ["90, 99", "<b>quatre-vingt-dix</b>, quatre-vingt-dix-neuf", "4×20+10, 4×20+19"], ["100", "cent", ""]], "after": "Angka 70–99 dihitung dengan cara lama berbasis dua puluh. Di Belgia dan Swiss dipakai <i>septante</i> (70) dan <i>nonante</i> (90)."}, {"t": "phrases", "title": "Ungkapan dengan angka", "items": [["Tu as quel âge ? – J'ai vingt ans.", "Berapa umurmu? – Umurku 20 tahun. (pakai <i>avoir</i> = punya)", "tü a kel azh – zhe vang tang"], ["Ça coûte combien ? – Cinq euros.", "Berapa harganya? – 5 euro.", "sa kut kom-biang – sang kö-ro"]]}, {"t": "ex", "kind": "choice", "instr": "Quel nombre ?", "ans": "1. b · 2. b · 3. b · 4. b · 5. b", "items": ["70 = ...|septante-dix|soixante-dix|sept-dix|sept", "80 = ...|huitante|quatre-vingts|huit-dix|dix-huit", "17 = ...|sept-dix|dix-sept|soixante-dix-sept|sept", "21 = ...|vingt-un|vingt et un|un-vingt|onze", "«J'ai vingt ans» artinya ...|Saya punya 20 euro.|Umur saya 20 tahun.|Saya pukul 20.00.|Saya di nomor 20."]}]}, {"num": 4, "en": "La famille", "id": "Keluarga, artikel & avoir", "emoji": "👨‍👩‍👧", "goals": ["Menyebut anggota keluarga dengan artikel le/la.", "Memakai avoir dan kata milik mon/ma/mes."], "sections": [{"t": "vocab", "title": "La famille", "cols": 4, "items": [["👨", "le père", "le pèr", "ayah"], ["👩", "la mère", "la mèr", "ibu"], ["👦", "le frère", "le frèr", "saudara laki-laki"], ["👧", "la sœur", "la sör", "saudara perempuan"], ["👫", "les parents", "le pa-rang", "orang tua"], ["👴", "le grand-père", "le grang-pèr", "kakek"], ["👵", "la grand-mère", "la grang-mèr", "nenek"], ["👦", "le fils", "le fis", "anak laki-laki"], ["👧", "la fille", "la fiy", "anak perempuan"], ["🧒", "l'enfant", "lang-fang", "anak"], ["🧔", "l'oncle", "longkl", "paman"], ["👩‍🦱", "la tante", "la tangt", "bibi"]]}, {"t": "grammar", "title": "Artikel & kata milik", "head": ["", "Maskulin", "Feminin", "Jamak"], "rows": [["tentu (the)", "le (l' sebelum vokal)", "la (l')", "les"], ["tak tentu (a)", "un", "une", "des"], ["milikku", "mon", "ma (mon sebelum vokal)", "mes"], ["milikmu", "ton", "ta (ton)", "tes"], ["miliknya", "son", "sa (son)", "ses"]], "after": "Kata milik mengikuti jenis <b>benda yang dimiliki</b>, bukan pemiliknya: <i>son père</i> = ayahnya (ayah dia, entah lk/pr)."}, {"t": "grammar", "title": "avoir (punya)", "head": ["Subjek", "avoir"], "rows": [["j'", "ai"], ["tu", "as"], ["il / elle", "a"], ["nous", "avons"], ["vous", "avez"], ["ils / elles", "ont"]]}, {"t": "reading", "title": "Ma famille", "paras": ["Je m'appelle Sari. J'ai une grande famille. Mon père s'appelle Andi, il est médecin. Ma mère s'appelle Dewi, elle est professeure.", "J'ai deux frères et une sœur. Mes grands-parents habitent avec nous à Bandung."], "gloss": [["grande", "besar"], ["médecin", "dokter"], ["habitent", "tinggal (mereka)"], ["avec nous", "bersama kami"]]}, {"t": "ex", "kind": "choice", "instr": "Choisis la bonne réponse.", "ans": "1. b · 2. a · 3. b · 4. c · 5. b", "items": ["___ mère|le|la|les|un", "___ père|le|la|une|des", "C'est ___ sœur. (milikku)|mon|ma|mes|son", "Ce sont ___ parents. (milikku)|mon|ma|mes|ton", "Nous ___ deux enfants.|avez|avons|ont|ai"]}, {"t": "ex", "kind": "tf", "instr": "Vrai ou faux ? (Bacaan «Ma famille»)", "ans": "1. Vrai · 2. Faux · 3. Vrai", "items": ["Le père de Sari est médecin.", "Sari a deux sœurs.", "Les grands-parents habitent à Bandung."]}]}, {"num": 5, "en": "Les verbes au présent", "id": "Kata kerja -er, aller, faire & negasi", "emoji": "🏃", "goals": ["Mengonjugasikan kata kerja -er serta aller dan faire.", "Membuat kalimat negatif ne…pas dan pertanyaan."], "sections": [{"t": "grammar", "title": "Kata kerja -er (parler = berbicara)", "head": ["Subjek", "parler", "habiter", "Bunyi"], "rows": [["je / j'", "parl<b>e</b>", "habit<b>e</b>", "parl"], ["tu", "parl<b>es</b>", "habit<b>es</b>", "parl"], ["il / elle", "parl<b>e</b>", "habit<b>e</b>", "parl"], ["nous", "parl<b>ons</b>", "habit<b>ons</b>", "par-long"], ["vous", "parl<b>ez</b>", "habit<b>ez</b>", "par-le"], ["ils / elles", "parl<b>ent</b>", "habit<b>ent</b>", "parl (-ent tidak dibaca!)"]]}, {"t": "grammar", "title": "aller (pergi) & faire (melakukan)", "head": ["Subjek", "aller", "faire"], "rows": [["je", "vais", "fais"], ["tu", "vas", "fais"], ["il / elle", "va", "fait"], ["nous", "allons", "faisons"], ["vous", "allez", "faites"], ["ils / elles", "vont", "font"]], "after": "Negasi: <b>ne</b> + kata kerja + <b>pas</b>, misalnya <i>Je <b>ne</b> parle <b>pas</b> allemand.</i> Sebelum vokal, ne menjadi n': <i>Je <b>n'</b>habite <b>pas</b> ici.</i>"}, {"t": "vocab", "title": "Kata tanya", "cols": 4, "items": [["❓", "quoi ? / qu'est-ce que ?", "kwa / kès-ke", "apa"], ["🧑", "qui ?", "ki", "siapa"], ["📍", "où ?", "u", "di mana"], ["📅", "quand ?", "kang", "kapan"], ["🤔", "comment ?", "ko-mang", "bagaimana"], ["💭", "pourquoi ?", "pur-kwa", "mengapa"], ["💰", "combien ?", "kom-biang", "berapa"], ["✅", "est-ce que … ?", "ès-ke", "apakah"]]}, {"t": "ex", "kind": "fill", "instr": "Konjugasikan kata kerjanya.", "ans": "1. parle · 2. habitons · 3. parlez · 4. vont · 5. fais", "items": ["Je ___ français. (parler)", "Nous ___ à Paris. (habiter)", "Vous ___ arabe ? (parler)", "Ils ___ à l'école. (aller)", "Tu ___ du sport ? (faire)"]}, {"t": "ex", "kind": "choice", "instr": "Choisis la bonne réponse.", "ans": "1. b · 2. b · 3. a · 4. a", "items": ["Kalimat negatif yang benar adalah ...|Je parle pas anglais.|Je ne parle pas anglais.|Je pas parle anglais.|Ne je parle pas anglais.", "___ habites-tu ? – À Surabaya.|Quand|Où|Qui|Combien", "___ est-ce ? – C'est mon frère.|Qui|Où|Quand|Comment", "Bunyi «ils parlent» sama dengan ...|il parle|nous parlons|vous parlez|tu parlons"]}, {"t": "ex", "kind": "order", "instr": "Susun menjadi kalimat.", "ans": "1. Je ne mange pas de porc. · 2. Tu habites où ? · 3. Nous allons à la mosquée.", "items": ["Je / mange / pas / de porc. / ne", "habites / Tu / où ?", "allons / Nous / à la mosquée."]}]}, {"num": 6, "en": "Au restaurant", "id": "Di restoran & kafe", "emoji": "🍽️", "goals": ["Memesan dengan je voudrais dan meminta tagihan.", "Memakai artikel partitif du/de la/de l' dan menanyakan kehalalan."], "sections": [{"t": "vocab", "title": "Nourriture et boissons", "cols": 4, "items": [["🥐", "le croissant", "le krwa-sang", "croissant"], ["🍞", "le pain", "le pang", "roti"], ["🧀", "le fromage", "le fro-mazh", "keju"], ["💧", "l'eau", "lo", "air"], ["☕", "le café", "le ka-fe", "kopi"], ["🍵", "le thé", "le te", "teh"], ["🧃", "le jus", "le zhü", "jus"], ["🍗", "le poulet", "le pu-le", "ayam"], ["🐟", "le poisson", "le pwa-song", "ikan"], ["🥩", "la viande", "la viangd", "daging"], ["🍚", "le riz", "le ri", "nasi"], ["🥗", "la salade", "la sa-lad", "salad"]]}, {"t": "grammar", "title": "Artikel partitif (sebagian/sejumlah)", "head": ["Jenis", "Bentuk", "Contoh"], "rows": [["maskulin", "du", "Je mange <b>du</b> pain."], ["feminin", "de la", "Je mange <b>de la</b> viande."], ["sebelum vokal", "de l'", "Je bois <b>de l'</b>eau."], ["setelah negasi", "<b>de / d'</b>", "Je ne mange <b>pas de</b> porc. Je ne bois <b>pas d'</b>alcool."]]}, {"t": "phrases", "title": "Au restaurant", "items": [["Je voudrais un thé, s'il vous plaît.", "Saya mau teh.", "zhe vu-dre ang te, sil vu ple"], ["Qu'est-ce que vous recommandez ?", "Apa yang Anda rekomendasikan?", "kès-ke vu re-ko-mang-de"], ["L'addition, s'il vous plaît.", "Minta tagihannya.", "la-di-siong, sil vu ple"], ["Bon appétit !", "Selamat makan!", "bo-na-pe-ti"], ["C'est délicieux !", "Enak sekali!", "se de-li-siö"]]}, {"t": "note", "html": "<b>Il y a du porc dedans ?</b> (Apakah ada babinya?) · <b>Je ne mange pas de porc.</b> (Saya tidak makan babi.) · <b>Je ne bois pas d'alcool.</b> (Saya tidak minum alkohol.) · <b>C'est halal ?</b> (Apakah ini halal?) · Hati-hati dengan <i>jambon</i> dan <i>lardons</i> (babi), serta saus yang memakai <i>vin</i> (anggur). Di Prancis banyak toko daging <i>halal</i>.", "title": "🕌 Tips makan halal"}, {"t": "dialog", "title": "Au café", "lines": [["Serveur", "🧑‍🍳", "Bonjour madame, vous désirez ?", "Selamat siang, Bu, mau pesan apa?"], ["Rina", "🧕", "Je voudrais un croissant et un thé, s'il vous plaît.", "Saya mau satu croissant dan teh."], ["Serveur", "🧑‍🍳", "Très bien. Et avec ça ?", "Baik. Ada lagi?"], ["Rina", "🧕", "C'est tout, merci. Ça fait combien ?", "Sudah, terima kasih. Berapa semuanya?"], ["Serveur", "🧑‍🍳", "Ça fait cinq euros cinquante.", "Totalnya 5,50 euro."]]}, {"t": "ex", "kind": "choice", "instr": "Choisis la bonne réponse.", "ans": "1. c · 2. a · 3. b · 4. b · 5. a", "items": ["Je bois ___ eau.|du|de la|de l'|des", "Je mange ___ pain.|du|de la|de l'|le de", "Je ne mange pas ___ porc.|du|de|le|des", "Qu'est-ce que Rina commande ? (Dialog)|un café et un croissant|un croissant et un thé|du pain et du fromage|de l'eau", "Combien paie Rina ?|5,50 €|15,50 €|5,15 €|50 €"]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Choisis la bonne réponse.", "ans": "1. b · 2. b · 3. b · 4. b · 5. b · 6. b", "items": ["Je ___ indonésien.|es|suis|est|sommes", "Vous ___ deux enfants ?|avons|avez|ont|as", "C'est ___ mère.|mon|ma|mes|le", "Ils ___ au marché.|va|vont|allons|allez", "90 = ...|nonante|quatre-vingt-dix|neuf-dix|dix-neuf", "Je ne bois pas ___ alcool.|de l'|d'|du|l'"]}, {"t": "ex", "kind": "tf", "instr": "Vrai ou faux ?", "ans": "1. Vrai · 2. Faux · 3. Vrai", "items": ["Huruf mati di akhir kata Prancis biasanya tidak dibaca.", "«vous» hanya dipakai untuk banyak orang.", "Kata milik mengikuti jenis benda yang dimiliki."]}], "words": [{"e": "🇫🇷", "w": "la France", "p": "la frangs", "m": "Prancis", "u": 2}, {"e": "🇮🇩", "w": "l'Indonésie", "p": "lin-do-ne-zi", "m": "Indonesia", "u": 2}, {"e": "🇧🇪", "w": "la Belgique", "p": "la bel-zhik", "m": "Belgia", "u": 2}, {"e": "🇨🇦", "w": "le Canada", "p": "le ka-na-da", "m": "Kanada", "u": 2}, {"e": "🗣️", "w": "le français", "p": "le frang-se", "m": "bahasa Prancis", "u": 2}, {"e": "🗣️", "w": "l'indonésien", "p": "lin-do-ne-ziang", "m": "bahasa Indonesia