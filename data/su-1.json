{"id": "su-1", "kind": "lang", "lang": "su", "grade": null, "level": "umum", "tag": "Dasar", "badge": ["Sunda", "1"], "title": "Basa Sunda Dasar", "sub": "Salam, undak-usuk, keluarga, angka, pasar, kegiatan", "c": "#2B8A3E", "c2": "#E6F4EA", "c3": "#1B5E29", "emojis": "🙏 🪜 👨‍👩‍👧‍👦 🔢 🍲 ⏰", "intro": "<div class=\"note\"><div class=\"note-h\">📌 Tentang kursus ini</div>Bahasa Sunda dipakai oleh sekitar 40 juta orang di Jawa Barat dan Banten. Kursus ini memperkenalkan <b>undak-usuk basa</b> (tingkat tutur loma dan lemes) beserta kosakata sehari-hari. Huruf <b>é</b> dibaca seperti e pada \"enak\", dan <b>eu</b> adalah vokal khas Sunda yang dibaca seperti e pepet dengan bibir datar.</div>", "cando": ["Mengucapkan salam dalam bahasa Sunda.", "Membedakan basa loma (akrab) dan basa lemes (halus).", "Menyebut anggota keluarga dalam bahasa Sunda.", "Menghitung dalam bahasa Sunda.", "Menyebut makanan dan rasa dalam bahasa Sunda.", "Menceritakan kegiatan sehari-hari."], "text": {"labels": {"learn": ["📚", "Kecap", "Kosakata"], "talk": ["🗣️", "Paguneman", "Percakapan"], "read": ["📖", "Maca", "Membaca"], "practice": ["✏️", "Latihan", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Undak-usuk", "Tingkat tutur"], "write": ["📝", "Menulis", ""]}, "brand": "Basa Sunda", "unit_word": "pangajaran", "tip_prefix": "Pituduh:", "fun_h": "🌟 Naha anjeun terang?", "word_box": "Kotak Kata:", "true": "Leres", "false": "Lepat", "review_t": "Evaluasi Akhir", "review_s": "Uji kamampuh anjeun", "pron_note": "", "pron_html": ""}, "units": [{"num": 1, "en": "Salam", "id": "Salam dan sopan santun", "emoji": "🙏", "goals": ["Mengucapkan salam dalam bahasa Sunda.", "Memakai ungkapan sopan: punten, mangga, hatur nuhun."], "sections": [{"t": "phrases", "title": "Salam", "items": [["Wilujeng enjing.", "Selamat pagi."], ["Wilujeng siang.", "Selamat siang."], ["Wilujeng sonten.", "Selamat sore."], ["Wilujeng wengi.", "Selamat malam."], ["Wilujeng sumping.", "Selamat datang."], ["Kumaha damang?", "Apa kabar? (lemes/sopan)"], ["Pangestu, sae.", "Atas doa restunya, baik."], ["Kumaha, cageur?", "Apa kabar? (loma, kepada teman)"], ["Hatur nuhun.", "Terima kasih."], ["Sami-sami.", "Sama-sama."], ["Punten. — Mangga.", "Permisi. — Silakan."], ["Hapunten.", "Maaf."]]}, {"t": "vocab", "title": "Kecap salam", "cols": 3, "items": [["🙏", "hatur nuhun", "", "terima kasih"], ["✋", "punten", "", "permisi"], ["👉", "mangga", "", "silakan"], ["🙇", "hapunten", "", "maaf"], ["👍", "sae", "", "baik (lemes)"], ["💪", "damang", "", "sehat (lemes)"], ["🙋", "abdi", "", "saya (lemes)"], ["🫵", "anjeun", "", "kamu, Anda"]]}, {"t": "note", "html": "Bila bertamu, ucapkan <b>\"Punten!\"</b> di depan pintu. Tuan rumah akan menjawab <b>\"Mangga!\"</b> (silakan). Kebiasaan <i>punten–mangga</i> juga dipakai saat lewat di depan orang atau saat menawarkan sesuatu.", "title": "Punten – mangga"}, {"t": "dialog", "title": "Tepang sareng guru", "lines": [["Dede", "👦", "Wilujeng enjing, Bu. Kumaha damang?", "Selamat pagi, Bu. Apa kabar?"], ["Bu Guru", "👩‍🏫", "Pangestu, sae. Dede kumaha, damang?", "Atas doa restunya, baik. Dede apa kabar, sehat?"], ["Dede", "👦", "Alhamdulillah, sae. Hatur nuhun, Bu.", "Alhamdulillah, baik. Terima kasih, Bu."]]}, {"t": "ex", "kind": "choice", "instr": "Pilih anu leres. (Pilih yang benar)", "ans": "1. b · 2. a · 3. c · 4. b", "items": ["Malam hari bertemu tetangga, kamu menyapa ...|Wilujeng enjing|Wilujeng wengi|Wilujeng sumping|Wilujeng sonten", "Seseorang berkata \"Punten\". Kamu menjawab ...|Mangga|Hapunten|Sami-sami|Damang", "\"Hatur nuhun\" artinya ...|maaf|permisi|terima kasih|silakan", "Menanyakan kabar guru dengan sopan:|Kumaha, cageur?|Kumaha damang?|Mangga!|Sami-sami"]}]}, {"num": 2, "en": "Undak-usuk Basa", "id": "Tingkat tutur loma dan lemes", "emoji": "🪜", "goals": ["Membedakan basa loma (akrab) dan basa lemes (halus).", "Memakai kata lemes untuk orang lain dan untuk diri sendiri."], "sections": [{"t": "grammar", "title": "Undak-usuk basa", "head": ["Tingkat", "Dipakai kepada", "Contoh"], "rows": [["Loma (akrab)", "teman sebaya, adik", "Rek indit ka mana?"], ["Lemes (halus)", "orang tua, guru, orang yang dihormati", "Badé angkat ka mana?"]], "after": "Basa lemes punya dua bentuk: <b>lemes keur batur</b> (untuk orang lain) dan <b>lemes keur sorangan</b> (untuk diri sendiri, lebih merendah)."}, {"t": "grammar", "title": "Kecap dina undak-usuk", "head": ["Loma", "Lemes (orang lain)", "Lemes (diri sendiri)", "Arti"], "rows": [["dahar", "tuang", "neda", "makan"], ["indit", "angkat", "mios", "pergi"], ["datang", "sumping", "dongkap", "datang"], ["imah", "bumi", "rorompok", "rumah"], ["ngaran", "jenengan / wasta", "nami", "nama"], ["gering", "teu damang", "teu damang", "sakit"], ["maneh", "anjeun / salira", "–", "kamu"], ["aing / urang", "–", "abdi / sim kuring", "saya"]], "after": "Contoh: <i>Bapa nuju <b>tuang</b></i> (Bapak sedang makan), tetapi <i>Abdi nuju <b>neda</b></i> (saya sedang makan)."}, {"t": "vocab", "title": "Kecap lemes", "cols": 3, "items": [["🍛", "tuang", "", "makan (lemes, orang lain)"], ["🍽️", "neda", "", "makan (lemes, diri sendiri)"], ["🚶", "angkat", "", "pergi (lemes, orang lain)"], ["🏃", "sumping", "", "datang (lemes, orang lain)"], ["🏠", "bumi", "", "rumah (lemes, orang lain)"], ["🏡", "rorompok", "", "rumah (lemes, diri sendiri)"], ["🏷️", "jenengan", "", "nama (lemes, orang lain)"], ["🤒", "teu damang", "", "sakit (lemes)"]]}, {"t": "ex", "kind": "choice", "instr": "Pilih kecap anu merenah. (Pilih kata yang pantas)", "ans": "1. b · 2. b · 3. a · 4. a", "items": ["Bapa guru nuju ___. (makan)|dahar|tuang|neda|nyatu", "Abdi badé ___ ka pasar. (pergi, diri sendiri)|angkat|mios|indit-inditan|sumping", "Saha jenengan Bapa? artinya ...|Siapa nama Bapak?|Di mana rumah Bapak?|Bapak mau ke mana?|Bapak sakit apa?", "Loma tina \"bumi\" (rumah) nyaéta ...|imah|rorompok|pondok|kamar"]}, {"t": "ex", "kind": "match", "instr": "Jodohkeun loma jeung lemes (orang lain).", "ans": "1–c · 2–e · 3–a · 4–b · 5–d", "left": ["dahar", "indit", "datang", "imah", "gering"], "right": ["sumping", "bumi", "tuang", "teu damang", "angkat"]}]}, {"num": 3, "en": "Kulawarga", "id": "Keluarga", "emoji": "👨‍👩‍👧‍👦", "goals": ["Menyebut anggota keluarga dalam bahasa Sunda.", "Membaca teks pendek tentang keluarga."], "sections": [{"t": "vocab", "title": "Kulawarga", "cols": 3, "items": [["👨", "bapa / apa", "", "ayah"], ["👩", "ibu / ema", "", "ibu"], ["👴", "aki", "", "kakek"], ["👵", "nini", "", "nenek"], ["🧑", "lanceuk", "", "kakak"], ["🧒", "adi", "", "adik"], ["👦", "budak", "", "anak"], ["🧔", "mamang", "", "paman"], ["👩‍🦰", "bibi", "", "bibi"], ["🧑‍🤝‍🧑", "dulur", "", "saudara"], ["👪", "kulawarga", "", "keluarga"], ["👶", "orok", "", "bayi"]]}, {"t": "reading", "title": "Kulawarga Abdi", "paras": ["<div class=\"rtitle\">Kulawarga Abdi</div>Wasta abdi Dede. Abdi calik di Garut. Kulawarga abdi aya opat: bapa, ibu, lanceuk, sareng abdi. Bapa abdi patani, ari ibu abdi guru. Lanceuk abdi kuliah di Bandung. Unggal Minggu abdi sareng bapa angkat ka sawah. Abdi bogoh pisan ka kulawarga abdi."], "gloss": [["wasta", "nama"], ["calik", "tinggal (lemes)"], ["sareng", "dan, dengan"], ["unggal", "setiap"], ["bogoh pisan", "sayang sekali"]]}, {"t": "ex", "kind": "choice", "instr": "Jawab numutkeun bacaan. (Jawab sesuai bacaan)", "ans": "1. b · 2. b · 3. b · 4. c", "items": ["Dede calik di mana?|Bandung|Garut|Bogor|Tasik", "Kulawarga Dede aya sabaraha?|tilu|opat|lima|genep", "Ibu Dede damel naon?|patani|guru|dokter|padagang", "Saha anu kuliah di Bandung?|bapa|Dede|lanceukna|ibu"]}]}, {"num": 4, "en": "Wilangan", "id": "Angka", "emoji": "🔢", "goals": ["Menghitung dalam bahasa Sunda.", "Menanyakan jumlah dengan sabaraha."], "sections": [{"t": "vocab", "title": "Wilangan", "cols": 4, "items": [["1️⃣", "hiji", "", "satu"], ["2️⃣", "dua", "", "dua"], ["3️⃣", "tilu", "", "tiga"], ["4️⃣", "opat", "", "empat"], ["5️⃣", "lima", "", "lima"], ["6️⃣", "genep", "", "enam"], ["7️⃣", "tujuh", "", "tujuh"], ["8️⃣", "dalapan", "", "delapan"], ["9️⃣", "salapan", "", "sembilan"], ["🔟", "sapuluh", "", "sepuluh"], ["💯", "saratus", "", "seratus"], ["💴", "sarébu", "", "seribu"], ["❓", "sabaraha", "", "berapa"]]}, {"t": "grammar", "title": "Ngawangun wilangan", "head": ["Angka", "Basa Sunda"], "rows": [["11 · 12 · 15", "sabelas · dua belas · lima belas"], ["20 · 35", "dua puluh · tilu puluh lima"], ["100 · 250", "saratus · dua ratus lima puluh"], ["1.000 · 5.000", "sarébu · lima rébu"]], "after": "Awalan <b>sa-</b> berarti satu: sapuluh, sabelas, saratus, sarébu."}, {"t": "ex", "kind": "choice", "instr": "Pilih anu leres.", "ans": "1. a · 2. b · 3. b · 4. b · 5. b", "items": ["3 =|tilu|opat|genep|dua", "6 =|lima|genep|tujuh|dalapan", "Rp 5.000 =|lima ratus|lima rébu|lima puluh|lima belas", "\"Sabaraha?\" artinya ...|di mana?|berapa?|kapan?|siapa?", "9 =|dalapan|salapan|sapuluh|tujuh"]}]}, {"num": 5, "en": "Kadaharan jeung Pasar", "id": "Makanan dan pasar", "emoji": "🍲", "goals": ["Menyebut makanan dan rasa dalam bahasa Sunda.", "Berbelanja di pasar."], "sections": [{"t": "vocab", "title": "Kadaharan", "cols": 3, "items": [["🍚", "sangu", "", "nasi"], ["💧", "cai", "", "air"], ["🐟", "lauk", "", "ikan"], ["🐔", "hayam", "", "ayam"], ["🥚", "endog", "", "telur"], ["🥬", "angeun", "", "sayur (berkuah)"], ["🍬", "amis", "", "manis"], ["🌶️", "lada", "", "pedas"], ["🍋", "haseum", "", "asam"], ["😋", "ngeunah / raos", "", "enak (loma / lemes)"], ["💸", "mahal", "", "mahal"], ["🏷️", "mirah", "", "murah"]]}, {"t": "dialog", "title": "Di pasar", "lines": [["Dede", "👦", "Punten, Ceu. Hayamna sabaraha sakilo?", "Permisi, Kak. Ayamnya berapa sekilo?"], ["Ceu Imas", "🧕", "Tilu puluh lima rébu, Jang.", "Tiga puluh lima ribu, Dik."], ["Dede", "👦", "Duh, rada mahal. Tiasa kirang?", "Aduh, agak mahal. Bisa kurang?"], ["Ceu Imas", "🧕", "Mangga, tilu puluh rébu waé.", "Silakan, tiga puluh ribu saja."], ["Dede", "👦", "Hatur nuhun, Ceu.", "Terima kasih, Kak."]]}, {"t": "ex", "kind": "choice", "instr": "Pilih anu leres.", "ans": "1. b · 2. b · 3. b · 4. a", "items": ["\"Lada\" dalam bahasa Sunda artinya ...|lada (merica)|pedas|manis|asin", "\"Amis\" artinya ...|amis (bau ikan)|manis|asam|pahit", "Nasi dalam bahasa Sunda ...|sega|sangu|nasi|beas", "\"Tiasa kirang?\" artinya ...|Bisa kurang?|Berapa harganya?|Ada ayam?|Mau beli?"]}, {"t": "fun", "html": "Hati-hati dengan <b>\"false friends\"</b>! Dalam bahasa Sunda, <b>lada</b> berarti pedas dan <b>amis</b> berarti manis. Dalam bahasa Indonesia, lada adalah merica dan amis adalah bau ikan."}]}, {"num": 6, "en": "Kagiatan Sapopoé", "id": "Kegiatan sehari-hari", "emoji": "⏰", "goals": ["Menceritakan kegiatan sehari-hari.", "Memakai keterangan waktu: isuk, beurang, sore, peuting."], "sections": [{"t": "vocab", "title": "Kagiatan jeung waktu", "cols": 3, "items": [["⏰", "hudang", "", "bangun"], ["🚿", "mandi", "", "mandi"], ["📖", "diajar", "", "belajar"], ["⚽", "ulin", "", "bermain"], ["🏠", "uih / balik", "", "pulang (lemes / loma)"], ["😴", "saré", "", "tidur (loma)"], ["🌅", "isuk", "", "pagi"], ["☀️", "beurang", "", "siang"], ["🌇", "sore", "", "sore"], ["🌙", "peuting", "", "malam"], ["📅", "ayeuna", "", "sekarang"], ["⏮️", "kamari", "", "kemarin"], ["⏭️", "isukan", "", "besok"]]}, {"t": "reading", "title": "Poéan Dede", "paras": ["<div class=\"rtitle\">Poéan Dede</div>Unggal isuk Dede hudang jam lima. Satutasna mandi, manéhna sasarap sangu goréng. Jam tujuh Dede indit ka sakola. Beurang manéhna uih, tuluy ulin jeung babaturan. Peuting Dede diajar, terus saré jam salapan."], "gloss": [["satutasna", "setelah"], ["sasarap", "sarapan"], ["tuluy", "lalu"], ["babaturan", "teman-teman"]]}, {"t": "ex", "kind": "choice", "instr": "Pilih anu leres.", "ans": "1. b · 2. b · 3. c · 4. b", "items": ["Dede hudang jam sabaraha?|jam opat|jam lima|jam genep|jam tujuh", "Naon anu dilakukeun Dede peuting?|ulin|diajar|mandi|sasarap", "\"Isukan\" artinya ...|kemarin|pagi|besok|sekarang", "\"Beurang\" artinya ...|pagi|siang|sore|malam"]}, {"t": "ex", "kind": "tf", "instr": "Leres atanapi lepat? (Benar atau salah?)", "ans": "1. Leres · 2. Lepat · 3. Leres", "items": ["Dede indit ka sakola jam tujuh.", "Dede saré jam sapuluh.", "\"Ulin\" hartina bermain."]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Evaluasi akhir.", "ans": "1. b · 2. b · 3. b · 4. b · 5. a · 6. b", "items": ["Selamat datang =|Wilujeng enjing|Wilujeng sumping|Wilujeng wengi|Hatur nuhun", "\"Punten\" dijawab ...|Sami-sami|Mangga|Hapunten|Sae", "Bapa nuju ___. (makan, lemes)|dahar|tuang|neda|nyatu", "Kakak dalam bahasa Sunda ...|adi|lanceuk|aki|bibi", "8 =|dalapan|salapan|genep|tujuh", "\"Lada pisan!\" artinya ...|Manis sekali!|Pedas sekali!|Mahal sekali!|Enak sekali!"]}, {"t": "ex", "kind": "match", "instr": "Jodohkeun.", "ans": "1–c · 2–e · 3–a · 4–b · 5–d", "left": ["sangu", "cai", "hudang", "peuting", "mirah"], "right": ["bangun", "malam", "nasi", "murah", "air"]}], "words": [{"e": "🙏", "w": "hatur nuhun", "p": "", "m": "terima kasih", "u": 1}, {"e": "✋", "w": "punten", "p": "", "m": "permisi", "u": 1}, {"e": "👉", "w": "mangga", "p": "", "m": "silakan", "u": 1}, {"e": "🙇", "w": "hapunten", "p": "", "m": "maaf", "u": 1}, {"e": "👍", "w": "sae", "p": "", "m": "baik (lemes)", "u": 1}, {"e": "💪", "w": "damang", "p": "", "m": "sehat (lemes)", "u": 1}, {"e": "🙋", "w": "abdi", "p": "", "m": "saya (lemes)", "u": 1}, {"e": "🫵", "w": "anjeun", "p": "", "m": "kamu, Anda", "u": 1}, {"e": "🍛", "w": "tuang", "p": "", "m": "makan (lemes, orang lain)", "u": 2}, {"e": "🍽️", "w": "neda", "p": "", "m": "makan (lemes, diri sendiri)", "u": 2}, {"e": "🚶", "w": "angkat", "p": "", "m": "pergi (lemes, orang lain)", "u": 2}, {"e": "🏃", "w": "sumping", "p": "", "m": "datang (lemes, orang lain)", "u": 2}, {"e": "🏠", "w": "bumi", "p": "", "m": "rumah (lemes, orang lain)", "u": 2}, {"e": "🏡", "w": "rorompok", "p": "", "m": "rumah (lemes, diri sendiri)", "u": 2}, {"e": "🏷️", "w": "jenengan", "p": "", "m": "nama (lemes, orang lain)", "u": 2}, {"e": "🤒", "w": "teu dama