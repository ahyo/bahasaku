{"id": "zh-3", "lang": "zh", "grade": 3, "level": "sd", "title": "我爱汉语！", "sub": "Belajar sambil bermain · Untuk siswa Kelas 3 SD", "c": "#8E5CF7", "c2": "#EFE6FF", "c3": "#F15BB5", "emojis": "🏠 🥟 👘 ⏰ 🧧 🎨 🥢 🏮 🥮 🐼 🏸 ⭐", "intro": "", "cando": ["Menceritakan rumah dengan <b>在</b>.", "Menyebut makanan dan menyatakan lapar/haus.", "Menyebut pakaian dengan <b>穿</b> dan <b>戴</b>.", "Menceritakan kegiatan harian berurutan.", "Menyebut bulan, tanggal, musim, dan hobi."], "text": {"labels": {"learn": ["📚", "学一学！", "Ayo Belajar"], "talk": ["🗣️", "说一说！", "Ayo Berbicara"], "read": ["📖", "读一读！", "Ayo Membaca"], "practice": ["✏️", "练一练！", "Ayo Berlatih"], "sing": ["🎵", "唱一唱！", "Ayo Bernyanyi"], "play": ["🎲", "玩一玩！", "Ayo Bermain"], "grammar": ["🧩", "学句子！", "Ayo Menyusun Kalimat"], "write": ["📝", "写一写！", "Ayo Menulis"]}, "brand": "Asyik Belajar Bahasa Mandarin", "unit_word": "bab", "tip_prefix": "Kiko berkata:", "fun_h": "🌟 Tahukah Kamu? <small>你知道吗？</small>", "word_box": "Kotak Kata:", "true": "Benar", "false": "Salah", "review_t": "复习", "review_s": "Evaluasi — Ayo uji kemampuanmu!", "pron_note": "Tulisan latin di dalam garis miring, misalnya 猫 <span class=\"vp inl\">/māo/</span>, disebut <b>pinyin</b> — cara membaca huruf Mandarin (hanzi). Tanda di atas huruf vokal adalah <b>nada</b>: <b>ā</b> (nada 1, datar tinggi) · <b>á</b> (nada 2, naik) · <b>ǎ</b> (nada 3, turun lalu naik) · <b>à</b> (nada 4, turun tajam). Nada yang berbeda bisa membuat arti berbeda! <b>x</b> dibaca mirip “s”, <b>q</b> mirip “c”, <b>zh</b> mirip “j”, <b>c</b> seperti “ts”, <b>e</b> seperti “e” pada <i>emas</i>, dan <b>ü</b> seperti “yu” dengan bibir bulat. Dengarkan guru atau video berbahasa Mandarin untuk menirukan nadanya. 🎧", "pron_html": null}, "units": [{"num": 1, "en": "我的家", "id": "Rumahku", "emoji": "🏠", "goals": ["Menyebut ruangan dan benda di rumah.", "Bertanya dan menjawab: <b>……在哪儿？ — ……在厨房。</b>"], "sections": [{"t": "vocab", "title": "Ruangan — 房间", "items": [["🏠", "家", "jiā", "rumah"], ["🛋️", "客厅", "kètīng", "ruang tamu"], ["🛏️", "卧室", "wòshì", "kamar tidur"], ["🍳", "厨房", "chúfáng", "dapur"], ["🛁", "洗手间", "xǐshǒujiān", "kamar mandi/toilet"], ["🍽️", "饭厅", "fàntīng", "ruang makan"], ["🌷", "花园", "huāyuán", "taman"], ["🚗", "车库", "chēkù", "garasi"]], "cols": 4, "label": "learn", "dict": true}, {"t": "vocab", "title": "Benda di rumah — 家具", "items": [["🛏️", "床", "chuáng", "tempat tidur"], ["🛋️", "沙发", "shāfā", "sofa"], ["📺", "电视", "diànshì", "televisi"], ["🧊", "冰箱", "bīngxiāng", "kulkas"], ["🪟", "窗户", "chuānghu", "jendela"], ["🚪", "门", "mén", "pintu"], ["💡", "灯", "dēng", "lampu"], ["🪞", "镜子", "jìngzi", "cermin"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Di mana …?", "head": ["Bahasa Mandarin", "Pinyin", "Arti"], "rows": [["妈妈在哪儿？", "māma zài nǎr?", "Di mana ibu?"], ["妈妈在厨房。 🍳", "māma zài chúfáng", "Ibu di dapur."], ["爸爸在花园里。 🌷", "bàba zài huāyuán lǐ", "Ayah di taman."], ["电视在客厅里。 📺", "diànshì zài kètīng lǐ", "TV ada di ruang tamu."]], "after": "<b>在</b> (zài) = di/berada · <b>哪儿</b> (nǎr) = di mana · <b>里</b> (lǐ) = di dalam"}, {"t": "raw", "html": "<div class=\"reading ltr\"><div class=\"rpic\">🏡</div><div class=\"tl\"><div class=\"tar\">这是我的家。我的家不大，可是很漂亮。</div><div class=\"ttr\">zhè shì wǒ de jiā. wǒ de jiā bú dà, kěshì hěn piàoliang</div><div class=\"tid\">Ini rumahku. Rumahku tidak besar, tetapi sangat indah.</div></div><div class=\"tl\"><div class=\"tar\">我家有一个客厅、两个卧室、一个厨房和一个洗手间。</div><div class=\"ttr\">wǒ jiā yǒu yí ge kètīng, liǎng ge wòshì, yí ge chúfáng hé yí ge xǐshǒujiān</div><div class=\"tid\">Di rumahku ada satu ruang tamu, dua kamar tidur, satu dapur, dan satu kamar mandi.</div></div><div class=\"tl\"><div class=\"tar\">房子前面有一个小花园，花园里有很多花。 🌸</div><div class=\"ttr\">fángzi qiánmiàn yǒu yí ge xiǎo huāyuán, huāyuán lǐ yǒu hěn duō huā</div><div class=\"tid\">Di depan rumah ada taman kecil, di taman ada banyak bunga.</div></div><div class=\"tl\"><div class=\"tar\">晚上，我们在客厅看电视。</div><div class=\"ttr\">wǎnshang, wǒmen zài kètīng kàn diànshì</div><div class=\"tid\">Malam hari, kami menonton TV di ruang tamu.</div></div><div class=\"tl\"><div class=\"tar\">我爱我的家！ ❤️</div><div class=\"ttr\">wǒ ài wǒ de jiā!</div><div class=\"tid\">Aku cinta rumahku!</div></div><div class=\"gloss\"><b>📌 Kata penting:</b> 可是 = tetapi · 漂亮 = indah/cantik · 个 = kata bantu bilangan · 两 = dua (untuk jumlah)</div></div>", "label": "read", "title": "我的家 — Rumahku"}, {"t": "ex", "kind": "choice", "instr": "Jawab berdasarkan bacaan!", "ans": "1. b · 2. b · 3. b", "items": ["Berapa kamar tidur?|satu|dua|tiga", "Apa yang ada di depan rumah?|garasi|taman kecil|sungai", "Di mana mereka menonton TV?|di dapur|di ruang tamu|di kamar"]}, {"t": "ex", "kind": "match", "instr": "Di mana? Pasangkan!", "ans": "1–c, 2–d, 3–a, 4–b", "left": ["🛁 mandi", "🍳 memasak", "😴 tidur", "📺 menonton TV"], "right": ["卧室", "客厅", "洗手间", "厨房"]}, {"t": "ex", "kind": "draw", "instr": "Gambar kamarmu dan tulis nama bendanya dalam hanzi!", "ans": "Jawaban bebas.", "h": 140, "caps": ["我的卧室里有 ___ 、___ 和 ___ 。"]}, {"t": "fun", "html": "Rumah tradisional Tionghoa di Beijing disebut <b>四合院</b> (sìhéyuàn) — empat bangunan yang mengelilingi halaman di tengah. 🏯"}]}, {"num": 2, "en": "食物和饮料", "id": "Makanan dan Minuman", "emoji": "🍱", "goals": ["Menyebut makanan dan minuman.", "Menyatakan lapar dan haus: <b>我饿了 / 我渴了</b>.", "Bertanya: <b>你想吃什么？</b>"], "sections": [{"t": "vocab", "title": "Makanan — 食物", "items": [["🍚", "米饭", "mǐfàn", "nasi"], ["🍜", "面条", "miàntiáo", "mi"], ["🍞", "面包", "miànbāo", "roti"], ["🥚", "鸡蛋", "jīdàn", "telur"], ["🐟", "鱼", "yú", "ikan"], ["🍗", "鸡肉", "jīròu", "daging ayam"], ["🥦", "蔬菜", "shūcài", "sayur"], ["🥟", "饺子", "jiǎozi", "pangsit (jiaozi)"], ["🥯", "包子", "bāozi", "bakpao"], ["🥣", "汤", "tāng", "sup"]], "cols": 5, "label": "learn", "dict": true}, {"t": "vocab", "title": "Minuman — 饮料", "items": [["💧", "水", "shuǐ", "air"], ["🍵", "茶", "chá", "teh"], ["🥛", "牛奶", "niúnǎi", "susu"], ["🧃", "果汁", "guǒzhī", "jus"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Aku lapar!", "head": ["Bahasa Mandarin", "Pinyin", "Arti"], "rows": [["我饿了。 😫", "wǒ è le", "Aku lapar."], ["我渴了。 🥵", "wǒ kě le", "Aku haus."], ["你想吃什么？", "nǐ xiǎng chī shénme?", "Kamu mau makan apa?"], ["我想吃饺子。 🥟", "wǒ xiǎng chī jiǎozi", "Aku mau makan jiaozi."], ["你想喝什么？ — 我想喝果汁。", "nǐ xiǎng hē shénme? — wǒ xiǎng hē guǒzhī", "Mau minum apa? — Aku mau minum jus."], ["真好吃！ 😋", "zhēn hǎochī!", "Enak sekali!"]], "after": "<b>吃</b> (chī) = makan · <b>喝</b> (hē) = minum · <b>想</b> (xiǎng) = ingin · <b>了</b> (le) = menunjukkan keadaan baru."}, {"t": "dialog", "title": "Waktunya makan", "lines": [["Xiaolong", "👦", "妈妈，我饿了！", "māma, wǒ è le!", "Bu, aku lapar!"], ["Ibu", "👩", "你想吃什么？", "nǐ xiǎng chī shénme?", "Kamu mau makan apa?"], ["Xiaolong", "👦", "我想吃面条。我也渴了。", "wǒ xiǎng chī miàntiáo. wǒ yě kě le.", "Aku mau makan mi. Aku juga haus."], ["Ibu", "👩", "好，给你一杯水。", "hǎo, gěi nǐ yì bēi shuǐ.", "Baik, ini segelas air."], ["Xiaolong", "👦", "谢谢妈妈！面条真好吃！", "xièxie māma! miàntiáo zhēn hǎochī!", "Terima kasih, Bu! Minya enak sekali!"]]}, {"t": "ex", "kind": "match", "instr": "Pasangkan gambar dengan katanya!", "ans": "1–c, 2–e, 3–a, 4–d, 5–b", "left": ["🍚", "🍵", "🥚", "🥟", "🥛"], "right": ["鸡蛋", "牛奶", "米饭", "饺子", "茶"]}, {"t": "ex", "kind": "fill", "instr": "Lengkapi!", "ans": "1. 饿 · 2. 渴 · 3. 吃 · 4. 喝", "bank": ["饿", "渴", "吃", "喝"], "items": ["我 ___ 了，我想吃饭。", "我 ___ 了，我想喝水。", "你想 ___ 什么？ — 我想吃包子。", "你想 ___ 什么？ — 我想喝茶。"]}, {"t": "ex", "kind": "table", "instr": "Menu makananku! Tulis dalam hanzi.", "ans": "Jawaban bebas.", "head": ["Waktu", "Makanan", "Minuman"], "rows": ["早饭 (sarapan)| | ", "午饭 (makan siang)| | ", "晚饭 (makan malam)| | "]}, {"t": "fun", "html": "Orang Tionghoa makan dengan <b>筷子</b> (kuàizi = sumpit) sejak lebih dari 3.000 tahun lalu. Jangan menancapkan sumpit tegak di nasi, ya — itu dianggap tidak sopan! 🥢"}]}, {"num": 3, "en": "衣服", "id": "Pakaian", "emoji": "👕", "goals": ["Menyebut jenis pakaian.", "Memakai kata kerja <b>穿</b> (chuān) dan <b>戴</b> (dài)."], "sections": [{"t": "vocab", "title": "Pakaian — 衣服", "items": [["👔", "衬衫", "chènshān", "kemeja"], ["👕", "T恤", "T-xù", "kaos"], ["👖", "裤子", "kùzi", "celana panjang"], ["🩳", "短裤", "duǎnkù", "celana pendek"], ["👗", "裙子", "qúnzi", "rok/gaun"], ["🧥", "外套", "wàitào", "jaket"], ["🧢", "帽子", "màozi", "topi"], ["👟", "鞋子", "xiézi", "sepatu"], ["🧦", "袜子", "wàzi", "kaus kaki"], ["🎽", "校服", "xiàofú", "seragam sekolah"], ["👓", "眼镜", "yǎnjìng", "kacamata"], ["👘", "旗袍", "qípáo", "qipao (baju tradisional)"]], "cols": 6, "label": "learn", "dict": true}, {"t": "grammar", "title": "Memakai …", "head": ["Kata kerja", "Untuk", "Contoh", "Arti"], "rows": [["穿 (chuān)", "baju, celana, sepatu", "我穿白色的衬衫。", "Aku memakai kemeja putih."], ["戴 (dài)", "topi, kacamata, jam tangan", "他戴帽子。", "Dia memakai topi."]], "after": "Dalam bahasa Indonesia semuanya “memakai”, tetapi bahasa Mandarin membedakan <b>穿</b> (untuk yang dikenakan di badan/kaki) dan <b>戴</b> (untuk aksesori). 🤓"}, {"t": "raw", "html": "<div class=\"reading ltr\"><div class=\"rpic\">🧑‍🎓</div><div class=\"tl\"><div class=\"tar\">星期一，我穿白色的衬衫和红色的裤子。</div><div class=\"ttr\">xīngqīyī, wǒ chuān báisè de chènshān hé hóngsè de kùzi</div><div class=\"tid\">Hari Senin, aku memakai kemeja putih dan celana merah.</div></div><div class=\"tl\"><div class=\"tar\">我姐姐穿白色的衬衫和红色的裙子。</div><div class=\"ttr\">wǒ jiějie chuān báisè de chènshān hé hóngsè de qúnzi</div><div class=\"tid\">Kakak perempuanku memakai kemeja putih dan rok merah.</div></div><div class=\"tl\"><div class=\"tar\">我们穿黑色的鞋子和白色的袜子。</div><div class=\"ttr\">wǒmen chuān hēisè de xiézi hé báisè de wàzi</div><div class=\"tid\">Kami memakai sepatu hitam dan kaus kaki putih.</div></div><div class=\"tl\"><div class=\"tar\">天气很热，我也戴帽子。 ☀️</div><div class=\"ttr\">tiānqì hěn rè, wǒ yě dài màozi</div><div class=\"tid\">Cuacanya panas, aku juga memakai topi.</div></div><div class=\"gloss\"><b>📌 Kata penting:</b> 的 = (penghubung sifat–benda) · 天气 = cuaca · 也 = juga</div></div>", "label": "read", "title": "我的校服 — Seragam sekolahku"}, {"t": "ex", "kind": "tf", "instr": "Benar atau Salah?", "ans": "1. Benar · 2. Salah (rok merah) · 3. Benar · 4. Benar", "items": ["Pada hari Senin, penulis memakai celana merah.", "Kakaknya memakai rok biru.", "Mereka memakai sepatu hitam.", "Penulis memakai topi karena panas."]}, {"t": "ex", "kind": "circle", "instr": "Lingkari kata kerja yang benar!", "ans": "1. 戴 · 2. 穿 · 3. 穿 · 4. 戴", "items": ["我 ((穿 / 戴)) 帽子。", "他 ((穿 / 戴)) 鞋子。", "妹妹 ((穿 / 戴)) 裙子。", "爷爷 ((穿 / 戴)) 眼镜。"]}, {"t": "ex", "kind": "match", "instr": "Pasangkan gambar dengan katanya!", "ans": "1–c, 2–d, 3–e, 4–a, 5–b", "left": ["🧦", "👗", "🧢", "🧥", "🩳"], "right": ["外套", "短裤", "袜子", "裙子", "帽子"]}]}, {"num": 4, "en": "我的一天", "id": "Kegiatan Sehari-hari", "emoji": "⏰", "goals": ["Menyebut kegiatan sehari-hari.", "Bercerita berurutan: <b>先……然后……最后……</b>"], "sections": [{"t": "vocab", "title": "Kegiatan — 活动", "items": [["⏰", "起床", "qǐchuáng", "bangun tidur"], ["🪥", "刷牙", "shuāyá", "gosok gigi"], ["🧼", "洗脸", "xǐliǎn", "cuci muka"], ["🍳", "吃早饭", "chī zǎofàn", "sarapan"], ["🏫", "上学", "shàngxué", "berangkat sekolah"], ["📚", "上课", "shàngkè", "belajar di kelas"], ["⚽", "玩", "wán", "bermain"], ["🏠", "回家", "huíjiā", "pulang"], ["📝", "做作业", "zuò zuòyè", "mengerjakan PR"], ["🍽️", "吃晚饭", "chī wǎnfàn", "makan malam"], ["📖", "看书", "kàn shū", "membaca buku"], ["😴", "睡觉", "shuìjiào", "tidur"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Kata urutan", "head": ["Bahasa Mandarin", "Pinyin", "Arti"], "rows": [["先", "xiān", "pertama/dulu"], ["然后", "ránhòu", "kemudian"], ["最后", "zuìhòu", "terakhir"], ["每天", "měitiān", "setiap hari"]], "after": "Kata kerja bahasa Mandarin <b>tidak berubah</b> untuk aku, kamu, atau dia: 我起床, 他起床, 我们起床. Mudah sekali! 😊"}, {"t": "raw", "html": "<div class=\"reading ltr\"><div class=\"rpic\">🌅</div><div class=\"tl\"><div class=\"tar\">小明每天六点起床。</div><div class=\"ttr\">xiǎomíng měitiān liù diǎn qǐchuáng</div><div class=\"tid\">Xiaoming bangun jam enam setiap hari.</div></div><div class=\"tl\"><div class=\"tar\">他先刷牙、洗脸。</div><div class=\"ttr\">tā xiān shuāyá, xǐliǎn</div><div class=\"tid\">Pertama, dia gosok gigi dan cuci muka.</div></div><div class=\"tl\"><div class=\"tar\">然后，他吃早饭。他喝牛奶，吃面包。</div><div class=\"ttr\">ránhòu, tā chī zǎofàn. tā hē niúnǎi, chī miànbāo</div><div class=\"tid\">Kemudian dia sarapan. Dia minum susu dan makan roti.</div></div><div class=\"tl\"><div class=\"tar\">最后，他骑自行车去上学。 🚲</div><div class=\"ttr\">zuìhòu, tā qí zìxíngchē qù shàngxué</div><div class=\"tid\">Terakhir, dia naik sepeda ke sekolah.</div></div><div class=\"gloss\"><b>📌 Kata penting:</b> 点 = jam · 他 = dia (lk) · 骑自行车 = naik sepeda</div></div>", "label": "read", "title": "小明的早上 — Pagi Xiaoming"}, {"t": "ex", "kind": "order", "instr": "Urutkan kegiatan Xiaoming (1–4)!", "ans": "1 起床 · 2 刷牙 · 3 吃早饭 · 4 去上学", "items": [], "after": "<div class=\"scr\" style=\"line-height:2.4\"><span>☐ 吃早饭</span><span>☐ 起床</span><span>☐ 去上学</span><span>☐ 刷牙</span></div>"}, {"t": "ex", "kind": "match", "instr": "Pasangkan gambar dengan kegiatannya!", "ans": "1–c, 2–e, 3–d, 4–a, 5–b", "left": ["🪥", "😴", "📖", "⚽", "📝"], "right": ["玩", "做作业", "刷牙", "看书", "睡觉"]}, {"t": "ex", "kind": "write", "instr": "Ceritakan pagimu!", "ans": "Jawaban bebas.", "items": ["我先 ___ 。", "然后，我 ___ 。", "最后，我 ___ 。"]}]}, {"num": 5, "en": "月份和季节", "id": "Bulan dan Musim", "emoji": "🗓️", "goals": ["Menyebut 12 bulan dan 4 musim.", "Menyebut tanggal ulang tahun: <b>我的生日是……月……号。</b>"], "sections": [{"t": "vocab", "title": "Bulan — 月份", "items": [["1️⃣", "一月", "yīyuè", "Januari"], ["2️⃣", "二月", "èryuè", "Februari"], ["3️⃣", "三月", "sānyuè", "Maret"], ["4️⃣", "四月", "sìyuè", "April"], ["5️⃣", "五月", "wǔyuè", "Mei"], ["6️⃣", "六月", "liùyuè", "Juni"], ["7️⃣", "七月", "qīyuè", "Juli"], ["8️⃣", "八月", "bāyuè", "Agustus"], ["9️⃣", "九月", "jiǔyuè", "September"], ["🔟", "十月", "shíyuè", "Oktober"], ["🍂", "十一月", "shíyīyuè", "November"], ["🎄", "十