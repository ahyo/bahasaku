{"id": "pt-1", "kind": "lang", "lang": "pt", "grade": null, "level": "umum", "tag": "A1", "badge": ["Level", "A1"], "title": "Bahasa Portugis Pemula", "sub": "Pelafalan, salam, ser/estar, angka, keluarga, kata kerja, restoran", "c": "#2B8A3E", "c2": "#EBFBEE", "c3": "#1B5E2A", "emojis": "👋 🪪 🔢 👨‍👩‍👧 🏃 🍽️", "intro": "<div class=\"note\"><div class=\"note-h\">📌 Tentang kursus ini</div>Bahasa Portugis <b>Brasil</b> dari nol, setara <b>A1</b>. Bahasa ini juga dipakai di Portugal, Angola, Mozambik, dan Timor Leste, serta menyumbang banyak kata ke bahasa Indonesia.</div>", "cando": ["Membaca huruf khas bahasa Portugis (ão, nh, lh, ç, r).", "Memperkenalkan diri, asal, dan tempat tinggal.", "Menghitung 0–100.", "Menyebut anggota keluarga dengan artikel o/a.", "Mengonjugasikan kata kerja beraturan -ar, -er, -ir.", "Memesan makanan dan minuman serta meminta tagihan."], "text": {"labels": {"learn": ["📚", "Vocabulário", "Kosakata"], "talk": ["🗣️", "Diálogo", "Percakapan"], "read": ["📖", "Leitura", "Membaca"], "practice": ["✏️", "Exercícios", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Gramática", "Tata Bahasa"], "write": ["📝", "Menulis", ""]}, "brand": "Belajar Bahasa Portugis", "unit_word": "unit", "tip_prefix": "Tips:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Verdadeiro", "false": "Falso", "review_t": "Revisão · Evaluasi", "review_s": "Uji kemampuanmu", "pron_note": "", "pron_html": "<div class=\"note\"><div class=\"note-h\">🔊 Cara baca</div>Kursus ini memakai <b>Portugis Brasil</b>, varian dengan penutur terbanyak. Cara baca ditulis sederhana, misalnya <i>obrigado</i> = <i>o-bri-ga-du</i>. Dengarkan juga suaranya dengan tombol 🔊.</div>"}, "units": [{"num": 1, "en": "Pronúncia e cumprimentos", "id": "Pelafalan & salam", "emoji": "👋", "goals": ["Membaca huruf khas bahasa Portugis (ão, nh, lh, ç, r).", "Menyapa, berterima kasih, dan berpamitan."], "sections": [{"t": "note", "html": "Bahasa Portugis dituturkan sekitar <b>260 juta orang</b> di Brasil, Portugal, Angola, Mozambik, dan <b>Timor Leste</b>, tetangga Indonesia. Banyak kata Indonesia berasal dari bahasa Portugis: <i>sabun (sabão), meja (mesa), jendela (janela), bendera (bandeira), sepatu (sapato)</i>.", "title": "Mengenal bahasa Portugis"}, {"t": "grammar", "title": "Huruf yang perlu diperhatikan (Brasil)", "head": ["Tulisan", "Dibaca", "Contoh"], "rows": [["ão, õe, ã", "bunyi sengau", "não (naung), pão (paung)"], ["nh", "ny", "amanhã (a-ma-nyang)"], ["lh", "ly", "filho (fi-lyu), trabalho (tra-ba-lyu)"], ["ç", "s", "praça (pra-sa), açúcar (a-su-kar)"], ["ch", "sy", "chá (sya), chuva (syu-va)"], ["j, g + e/i", "zh (j lembut)", "hoje (o-zhi), gente (zhen-tsyi)"], ["r di awal, rr", "h (seperti h kuat)", "Rio (hi-u), carro (ka-hu)"], ["-o, -e di akhir kata", "u, i", "obrigado (o-bri-ga-du), leite (lei-tsyi)"], ["t, d + i/e akhir", "tsy, dzy", "tia (tsyi-a), dia (dzyi-a), noite (noi-tsyi)"], ["s di antara vokal", "z", "casa (ka-za)"]]}, {"t": "phrases", "title": "Salam & sopan santun", "items": [["Oi! / Olá!", "Hai! / Halo!", "oi / o-la"], ["Bom dia.", "Selamat pagi.", "bong dzyi-a"], ["Boa tarde.", "Selamat siang/sore.", "bo-a tar-dzyi"], ["Boa noite.", "Selamat malam.", "bo-a noi-tsyi"], ["Tudo bem? – Tudo bem, e você?", "Apa kabar? – Baik, kamu?", "tu-du beng – tu-du beng, i vo-se"], ["Por favor.", "Tolong / silakan.", "pur fa-vor"], ["Obrigado / Obrigada. – De nada.", "Terima kasih (penutur lk / pr). – Sama-sama.", "o-bri-ga-du / o-bri-ga-da – dzyi na-da"], ["Com licença. / Desculpe.", "Permisi. / Maaf.", "kong li-sen-sa / dis-kul-pi"], ["Tchau! / Até logo!", "Dah! / Sampai nanti!", "tsyau / a-te lo-gu"]]}, {"t": "ex", "kind": "choice", "instr": "Escolha a resposta certa.", "ans": "1. b · 2. b · 3. b · 4. b · 5. a", "items": ["Gabungan nh pada «amanhã» dibaca ...|nh|ny|n|ng", "Huruf r pada «Rio» (Brasil) dibaca seperti ...|r|h|l|rr bergetar", "Perempuan mengucapkan terima kasih dengan ...|Obrigado|Obrigada|De nada|Desculpe", "Huruf ç pada «praça» dibaca ...|k|s|c|ch", "Kata Indonesia «meja» berasal dari bahasa Portugis ...|mesa|mesma|mexa|meia"]}]}, {"num": 2, "en": "Apresentar-se", "id": "Perkenalan: ser & estar", "emoji": "🪪", "goals": ["Memperkenalkan diri, asal, dan tempat tinggal.", "Membedakan ser dan estar."], "sections": [{"t": "grammar", "title": "ser & estar (Brasil)", "head": ["Subjek", "ser", "estar"], "rows": [["eu (saya)", "sou", "estou"], ["você / ele / ela (kamu / dia)", "é", "está"], ["nós (kami)", "somos", "estamos"], ["vocês / eles / elas (kalian / mereka)", "são", "estão"]], "after": "Di Brasil, <b>você</b> (kamu) memakai kata kerja yang sama dengan <i>ele/ela</i>. <b>ser</b> = identitas, asal, profesi: <i>Sou da Indonésia.</i> <b>estar</b> = letak & keadaan sementara: <i>Estou em São Paulo. Estou cansado.</i>"}, {"t": "dialog", "title": "Na universidade", "lines": [["Lucas", "👦", "Oi! Meu nome é Lucas. E você, como se chama?", "Hai! Namaku Lucas. Kamu, siapa namamu?"], ["Rina", "🧕", "Oi, Lucas! Eu me chamo Rina.", "Hai, Lucas! Namaku Rina."], ["Lucas", "👦", "De onde você é?", "Kamu dari mana?"], ["Rina", "🧕", "Sou da Indonésia. Moro em São Paulo agora. E você?", "Aku dari Indonesia. Sekarang aku tinggal di São Paulo. Kamu?"], ["Lucas", "👦", "Sou do Rio de Janeiro. Muito prazer!", "Aku dari Rio de Janeiro. Senang berkenalan!"], ["Rina", "🧕", "O prazer é meu!", "Aku juga senang!"]]}, {"t": "vocab", "title": "Negara & bahasa", "cols": 4, "items": [["🇧🇷", "o Brasil", "u bra-ziu", "Brasil"], ["🇵🇹", "Portugal", "por-tu-gau", "Portugal"], ["🇮🇩", "a Indonésia", "a in-do-ne-zia", "Indonesia"], ["🇹🇱", "Timor-Leste", "ti-mor les-tsyi", "Timor Leste"], ["🗣️", "o português", "u por-tu-ges", "bahasa Portugis"], ["🗣️", "o indonésio", "u in-do-ne-ziu", "bahasa Indonesia"], ["🗣️", "o inglês", "u ing-gles", "bahasa Inggris"], ["🗣️", "o árabe", "u a-ra-bi", "bahasa Arab"]]}, {"t": "ex", "kind": "fill", "instr": "Ser atau estar? Lengkapi kalimatnya.", "ans": "1. sou · 2. é/e · 3. estamos · 4. são/sao · 5. estou", "items": ["Eu ___ da Indonésia. (ser)", "Você ___ estudante? (ser)", "Nós ___ em Lisboa. (estar)", "Eles ___ professores. (ser)", "Eu ___ cansada. (estar)"]}, {"t": "ex", "kind": "order", "instr": "Susun menjadi kalimat.", "ans": "1. Meu nome é Rina. · 2. De onde você é? · 3. Moro em Jacarta.", "items": ["Rina. / Meu / é / nome", "De / onde / é? / você", "em / Moro / Jacarta."]}]}, {"num": 3, "en": "Números", "id": "Angka, umur & harga", "emoji": "🔢", "goals": ["Menghitung 0–100.", "Menyebut umur dengan ter dan menanyakan harga."], "sections": [{"t": "vocab", "title": "0–15", "cols": 4, "items": [["0️⃣", "zero", "ze-ru", "0"], ["1️⃣", "um / uma", "ung / u-ma", "1"], ["2️⃣", "dois / duas", "dois / du-as", "2"], ["3️⃣", "três", "tres", "3"], ["4️⃣", "quatro", "kua-tru", "4"], ["5️⃣", "cinco", "sing-ku", "5"], ["6️⃣", "seis", "seis", "6"], ["7️⃣", "sete", "se-tsyi", "7"], ["8️⃣", "oito", "oi-tu", "8"], ["9️⃣", "nove", "no-vi", "9"], ["🔟", "dez", "dez", "10"], ["🔢", "onze", "ong-zi", "11"], ["🔢", "doze", "do-zi", "12"], ["🔢", "treze", "tre-zi", "13"], ["🔢", "catorze", "ka-tor-zi", "14"], ["🔢", "quinze", "king-zi", "15"]]}, {"t": "grammar", "title": "16–100", "head": ["Angka", "Bahasa Portugis", "Catatan"], "rows": [["16–19", "dezesseis, dezessete, dezoito, dezenove", "ejaan Brasil"], ["20, 21", "vinte, vinte e um", "puluhan + <b>e</b> + satuan"], ["30–60", "trinta, quarenta, cinquenta, sessenta", ""], ["70–90", "setenta, oitenta, noventa", ""], ["100", "cem", ""]], "after": "Angka 1 dan 2 punya bentuk feminin: <i>um livro, <b>uma</b> casa; dois livros, <b>duas</b> casas</i>."}, {"t": "phrases", "title": "Ungkapan dengan angka", "items": [["Quantos anos você tem? – Tenho vinte anos.", "Berapa umurmu? – Umurku 20 tahun. (pakai <i>ter</i> = punya)", "kuan-tus a-nyus vo-se teng – te-nyu ving-tsyi a-nyus"], ["Quanto custa? – Custa dez reais.", "Berapa harganya? – 10 real.", "kuan-tu kus-ta – kus-ta dez he-ais"]]}, {"t": "ex", "kind": "choice", "instr": "Qual é o número?", "ans": "1. b · 2. b · 3. b · 4. b", "items": ["16 = ...|seisdez|dezesseis|sessenta|seis", "21 = ...|vinte um|vinte e um|um e vinte|onze", "2 casas = ...|dois casas|duas casas|dez casas|doze casas", "90 = ...|nove|noventa|dezenove|novecentos"]}]}, {"num": 4, "en": "A família", "id": "Keluarga, artikel & ter", "emoji": "👨‍👩‍👧", "goals": ["Menyebut anggota keluarga dengan artikel o/a.", "Memakai ter, kata milik, dan gabungan do/da/no/na."], "sections": [{"t": "vocab", "title": "A família", "cols": 4, "items": [["👨", "o pai", "u pai", "ayah"], ["👩", "a mãe", "a maing", "ibu"], ["👦", "o irmão", "u ir-maung", "saudara laki-laki"], ["👧", "a irmã", "a ir-mang", "saudara perempuan"], ["👫", "os pais", "us pais", "orang tua"], ["👴", "o avô", "u a-vo", "kakek"], ["👵", "a avó", "a a-vo", "nenek"], ["👦", "o filho", "u fi-lyu", "anak laki-laki"], ["👧", "a filha", "a fi-lya", "anak perempuan"], ["🧔", "o tio", "u tsyi-u", "paman"], ["👩‍🦱", "a tia", "a tsyi-a", "bibi"], ["🧒", "o primo", "u pri-mu", "sepupu"]]}, {"t": "grammar", "title": "Artikel, milik & ter", "head": ["", "Maskulin", "Feminin"], "rows": [["tentu (the)", "o / os", "a / as"], ["tak tentu (a)", "um / uns", "uma / umas"], ["milikku", "meu / meus", "minha / minhas"], ["milikmu / miliknya", "seu / seus", "sua / suas"], ["de + artikel", "do / dos", "da / das"], ["em + artikel", "no / nos", "na / nas"]], "after": "<b>ter</b> (punya): eu <b>tenho</b>, você/ele/ela <b>tem</b>, nós <b>temos</b>, vocês/eles <b>têm</b>. Gabungan: <i>Sou <b>do</b> Brasil</i> (de + o), <i>Moro <b>na</b> Indonésia</i> (em + a)."}, {"t": "reading", "title": "Minha família", "paras": ["Meu nome é Sari. Tenho uma família grande. Meu pai se chama Andi, ele é médico. Minha mãe se chama Dewi, ela é professora.", "Tenho dois irmãos e uma irmã. Meus avós moram com a gente em Bandung."], "gloss": [["grande", "besar"], ["médico", "dokter"], ["moram", "tinggal (mereka)"], ["a gente", "kami (informal)"]]}, {"t": "ex", "kind": "choice", "instr": "Escolha a resposta certa.", "ans": "1. b · 2. a · 3. b · 4. b · 5. b", "items": ["___ mãe|o|a|os|um", "___ pai|o|a|as|uma", "Esta é ___ irmã. (milikku)|meu|minha|meus|seu", "Eu ___ dois irmãos.|tem|tenho|temos|têm", "Sou ___ Brasil.|de o|do|da|no"]}, {"t": "ex", "kind": "tf", "instr": "Verdadeiro ou falso? (Bacaan «Minha família»)", "ans": "1. Verdadeiro · 2. Falso · 3. Verdadeiro", "items": ["O pai de Sari é médico.", "Sari tem duas irmãs.", "Os avós moram em Bandung."]}]}, {"num": 5, "en": "Verbos no presente", "id": "Kata kerja -ar, -er, -ir & kalimat tanya", "emoji": "🏃", "goals": ["Mengonjugasikan kata kerja beraturan -ar, -er, -ir.", "Membuat kalimat negatif dan pertanyaan."], "sections": [{"t": "grammar", "title": "Kata kerja beraturan (Brasil)", "head": ["Subjek", "falar (berbicara)", "comer (makan)", "abrir (membuka)"], "rows": [["eu", "fal<b>o</b>", "com<b>o</b>", "abr<b>o</b>"], ["você / ele / ela", "fal<b>a</b>", "com<b>e</b>", "abr<b>e</b>"], ["nós", "fal<b>amos</b>", "com<b>emos</b>", "abr<b>imos</b>"], ["vocês / eles / elas", "fal<b>am</b>", "com<b>em</b>", "abr<b>em</b>"]], "after": "Kalimat negatif: <b>não</b> + kata kerja, misalnya <i>Não como carne de porco.</i>"}, {"t": "vocab", "title": "Kata tanya", "cols": 4, "items": [["❓", "o que?", "u ki", "apa"], ["🧑", "quem?", "keng", "siapa"], ["📍", "onde?", "ong-dzyi", "di mana"], ["📅", "quando?", "kuan-du", "kapan"], ["🤔", "como?", "ko-mu", "bagaimana"], ["💭", "por que?", "pur ke", "mengapa"], ["💰", "quanto?", "kuan-tu", "berapa"], ["🧭", "aonde?", "a-ong-dzyi", "ke mana"]]}, {"t": "ex", "kind": "fill", "instr": "Konjugasikan kata kerjanya.", "ans": "1. falo · 2. come · 3. moramos · 4. abrem · 5. estuda", "items": ["Eu ___ português. (falar)", "Você ___ arroz? (comer)", "Nós ___ em Recife. (morar)", "Eles ___ a porta. (abrir)", "Ela ___ inglês. (estudar)"]}, {"t": "ex", "kind": "choice", "instr": "Escolha a resposta certa.", "ans": "1. b · 2. a · 3. b", "items": ["___ você mora? – Em Jacarta.|O que|Onde|Quando|Quem", "___ é ele? – É meu irmão.|Quem|Onde|Como|Quanto", "Kalimat negatif yang benar adalah ...|Eu como não carne.|Eu não como carne.|Não eu como carne.|Eu como carne não não."]}, {"t": "ex", "kind": "order", "instr": "Susun menjadi kalimat.", "ans": "1. Eu não bebo álcool. · 2. Onde você mora? · 3. Nós falamos indonésio.", "items": ["álcool. / Eu / bebo / não", "Onde / mora? / você", "falamos / Nós / indonésio."]}]}, {"num": 6, "en": "No restaurante", "id": "Di restoran", "emoji": "🍽️", "goals": ["Memesan makanan dan minuman serta meminta tagihan.", "Menanyakan kehalalan makanan."], "sections": [{"t": "vocab", "title": "Comida e bebida", "cols": 4, "items": [["💧", "a água", "a a-gua", "air"], ["☕", "o café", "u ka-fe", "kopi"], ["🧃", "o suco", "u su-ku", "jus"], ["🍞", "o pão", "u paung", "roti"], ["🍚", "o arroz", "u a-hoz", "nasi"], ["🫘", "o feijão", "u fei-zhaung", "kacang merah"], ["🍗", "o frango", "u frang-gu", "ayam"], ["🐟", "o peixe", "u pei-syi", "ikan"], ["🥩", "a carne", "a kar-ni", "daging"], ["🥗", "a salada", "a sa-la-da", "salad"], ["🍲", "a sopa", "a so-pa", "sup"], ["🍍", "a fruta", "a fru-ta", "buah"]]}, {"t": "phrases", "title": "No restaurante", "items": [["Eu queria um suco de laranja, por favor.", "Saya mau jus jeruk.", "eu ke-ri-a ung su-ku dzyi la-rang-zha, pur fa-vor"], ["O que você recomenda?", "Apa yang Anda rekomendasikan?", "u ki vo-se he-ko-meng-da"], ["A conta, por favor.", "Minta tagihannya.", "a kong-ta, pur fa-vor"], ["Bom apetite!", "Selamat makan!", "bong a-pe-tsyi-tsyi"], ["Está delicioso!", "Enak sekali!", "is-ta de-li-si-o-zu"]]}, {"t": "note", "html": "<b>Tem carne de porco?</b> (Apakah ada daging babi?) · <b>Não como carne de porco.</b> (Saya tidak makan babi.) · <b>Não bebo álcool.</b> (Saya tidak minum alkohol.) · <b>É halal?</b> (Apakah halal?) · Di Brasil, <i>churrasco</i> (BBQ) sering mencampur daging sapi dan babi, jadi tanyakan dulu. Brasil juga salah satu pengekspor daging <i>halal</i> terbesar di dunia.", "title": "🕌 Tips makan halal"}, {"t": "dialog", "title": "No restaurante", "lines": [["Garçom", "🧑‍🍳", "Boa tarde! O que vocês vão beber?", "Selamat siang! Mau minum apa?"], ["Rina", "🧕", "Um suco de laranja, por favor. O feijão tem carne de porco?", "Jus jeruk. Apakah kacangnya ada daging babi?"], ["Garçom", "🧑‍🍳", "A feijoada tem, mas o prato de frango com arroz e feijão não tem.", "Feijoada ada, tapi menu ayam dengan nasi dan kacang tidak ada."], ["Rina", "🧕", "Então eu queria o prato de frango.", "Kalau begitu saya mau menu ayam."], ["Garçom", "🧑‍🍳", "Perfeito. Bom apetite!", "Baik. Selamat makan!"]]}, {"t": "ex", "kind": "choice", "instr": "Perguntas sobre o diálogo", "ans": "1. b · 2. b · 3. b", "items": ["O que Rina bebe?|café|suco de laranja|água|chá", "O que Rina come?|feijoada|prato de frango|peixe|sopa", "«A conta, por favor» artinya ...|Hitung sampai sepuluh.|Minta tagihannya.|Tolong menunya.|Selamat makan."]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Escolha a resposta certa.", "ans": "1. a · 2. b · 3. b · 4. b · 5. d", "items": ["Eu ___ da Indonésia.|sou|estou|é|são", "Nós ___ em São Paulo agora.|somos|estamos|são|está", "Quantos anos você ___?|é|tem|está|tenho", "Esta é ___ mãe.|meu|minha|meus|o", "Eles ___ português.|fala|falo|falamos|falam"]}, {"t": "ex", "kind": "tf", "instr": "Verdadeiro ou falso?", "ans": "1. Verdadeiro · 2. Falso · 3. Verdadeiro", "items": ["Perempuan mengucapkan «Obrigada».", "Huruf r di awal kata Brasil dibaca seperti r bergetar.", "Kata Indonesia «sepatu» berasal dari bahasa Portugis «sapato»."]}], "words": [{"e": "🇧🇷", "w": "o Brasil", "p": "u bra-ziu", "m": "Brasil", "u": 2}, {"e": "🇵🇹", "w": "Portugal", "p": "por-tu-gau", "m": "Portugal", "u": 2}, {"e": "🇮🇩", "w": "a Indonésia", "p": "a in-do-ne-zia", "m": "Indonesia", "u": 2}, {"e": "🇹🇱", "w": "Timor-Leste", "p": "ti-mor les-tsyi", "m": "Timor Leste", "u": 2}, {"e": "🗣️", "w": "o português", "p": "u por-tu-ges", "m": "bahasa Portugis", "u": 