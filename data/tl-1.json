{"id": "tl-1", "kind": "lang", "lang": "tl", "grade": null, "level": "umum", "tag": "Pemula", "badge": ["Level", "1"], "title": "Bahasa Tagalog (Filipino) Pemula", "sub": "Salam & po, kami/tayo, angka, keluarga, aspek -um-, makanan", "c": "#5F3DC4", "c2": "#F3F0FF", "c3": "#3B2486", "emojis": "👋 🪪 🔢 👨‍👩‍👧 🏃 🍲", "intro": "<div class=\"note\"><div class=\"note-h\">📌 Tentang kursus ini</div>Bahasa Filipino (Tagalog), saudara serumpun bahasa Indonesia. Kursus ini menunjukkan banyak kata yang mirip, kata ganti kami/tayo, dan sisipan -um- yang khas.</div>", "cando": ["Menyapa dan berterima kasih dengan sopan (po/opo).", "Memperkenalkan nama dan asal.", "Menghitung 1–100 dalam bahasa Tagalog.", "Menyebut anggota keluarga, termasuk kuya dan ate.", "Memahami aspek kata kerja (selesai, sedang, akan) dengan sisipan -um-.", "Memesan makanan dan meminta tagihan."], "text": {"labels": {"learn": ["📚", "Talasalitaan", "Kosakata"], "talk": ["🗣️", "Usapan", "Percakapan"], "read": ["📖", "Pagbasa", "Membaca"], "practice": ["✏️", "Pagsasanay", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Balarila", "Tata Bahasa"], "write": ["📝", "Menulis", ""]}, "brand": "Belajar Bahasa Tagalog", "unit_word": "unit", "tip_prefix": "Tips:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Tama", "false": "Mali", "review_t": "Balik-aral · Evaluasi", "review_s": "Uji kemampuanmu", "pron_note": "", "pron_html": "<div class=\"note\"><div class=\"note-h\">🔊 Cara baca</div>Bahasa Tagalog dibaca seperti tulisannya. <b>ng</b> dibaca <i>nang</i> dan <b>mga</b> dibaca <i>ma-nga</i>. Dengarkan juga suaranya dengan tombol 🔊.</div>"}, "units": [{"num": 1, "en": "Pagbati", "id": "Salam & kata serumpun", "emoji": "👋", "goals": ["Menyapa dan berterima kasih dengan sopan (po/opo).", "Mengenal kata Tagalog yang mirip bahasa Indonesia."], "sections": [{"t": "note", "html": "Bahasa <b>Filipino</b> (berbasis Tagalog) dituturkan lebih dari <b>80 juta orang</b> di Filipina. Bahasa ini satu rumpun Austronesia dengan bahasa Indonesia, sehingga banyak kata yang mirip: <i>mata, anak, langit, bulan, lima, apat (empat), ulo (hulu = kepala), bunso (bungsu), sakit, mahal</i>. Banyak juga kata serapan Spanyol: <i>mesa, silya, kutsara</i>.", "title": "Mengenal bahasa Tagalog"}, {"t": "phrases", "title": "Salam & sopan santun", "items": [["Kumusta ka? – Mabuti, salamat!", "Apa kabar? – Baik, terima kasih!", "ku-mus-ta ka – ma-bu-ti, sa-la-mat"], ["Magandang umaga / tanghali / hapon / gabi!", "Selamat pagi / siang / sore / malam!", "ma-gan-dang u-ma-ga"], ["Salamat po! – Walang anuman.", "Terima kasih (sopan)! – Sama-sama.", "sa-la-mat po – wa-lang a-nu-man"], ["Oo / Opo · Hindi / Hindi po", "Ya / Ya (sopan) · Tidak / Tidak (sopan)", "o-o / o-po · hin-di"], ["Pasensya na. / Paumanhin.", "Maaf.", "pa-sen-sya na"], ["Paalam! / Ingat!", "Selamat tinggal! / Hati-hati!", "pa-a-lam / i-ngat"]]}, {"t": "grammar", "title": "Partikel sopan po / opo", "head": ["Situasi", "Contoh"], "rows": [["kepada orang tua / yang dihormati", "Salamat <b>po</b>. · <b>Opo</b>, Lola."], ["kepada teman", "Salamat! · Oo!"]]}, {"t": "ex", "kind": "choice", "instr": "Piliin ang tamang sagot.", "ans": "1. b · 2. a · 3. b · 4. c", "items": ["«Salamat» artinya ...|selamat|terima kasih|maaf|halo", "Kata Tagalog «anak» artinya ...|anak|ayah|teman|rumah", "Jawaban sopan «ya» kepada orang tua adalah ...|Oo|Opo|Hindi|Ingat", "«Magandang gabi» diucapkan pada ...|pagi|siang|malam|sore"]}]}, {"num": 2, "en": "Pagpapakilala", "id": "Perkenalan & kata ganti", "emoji": "🪪", "goals": ["Memperkenalkan nama dan asal.", "Membedakan kami (eksklusif) dan tayo (inklusif) seperti bahasa Indonesia."], "sections": [{"t": "grammar", "title": "Kata ganti", "head": ["Tagalog", "Arti", "Catatan"], "rows": [["ako", "saya", ""], ["ikaw / ka", "kamu", "ka setelah kata kerja: Kumusta <b>ka</b>?"], ["siya", "dia", ""], ["kami", "kami (tanpa lawan bicara)", "sama seperti bahasa Indonesia!"], ["tayo", "kita (termasuk lawan bicara)", "sama seperti bahasa Indonesia!"], ["kayo", "kalian / Anda (sopan)", ""], ["sila", "mereka", ""]], "after": "Urutan kalimat Tagalog sering <b>predikat dulu</b>: <i>Estudyante ako</i> = Saya pelajar (harfiah: pelajar saya). Nama orang didahului <b>si</b>: <i>Ako si Budi</i>."}, {"t": "dialog", "title": "Sa unibersidad", "lines": [["Maria", "👩", "Kumusta! Ako si Maria. Ano ang pangalan mo?", "Halo! Aku Maria. Siapa namamu?"], ["Budi", "👦", "Kumusta, Maria! Ako si Budi.", "Halo, Maria! Aku Budi."], ["Maria", "👩", "Taga-saan ka?", "Kamu orang mana?"], ["Budi", "👦", "Taga-Indonesia ako. Nakatira ako sa Maynila ngayon.", "Aku orang Indonesia. Sekarang aku tinggal di Manila."], ["Maria", "👩", "Ikinagagalak kitang makilala!", "Senang berkenalan denganmu!"]]}, {"t": "ex", "kind": "choice", "instr": "Piliin ang tamang sagot.", "ans": "1. b · 2. b · 3. b", "items": ["«Ano ang pangalan mo?» artinya ...|Kamu dari mana?|Siapa namamu?|Apa kabar?|Berapa umurmu?", "«kita» (termasuk lawan bicara) dalam Tagalog adalah ...|kami|tayo|kayo|sila", "«Taga-Indonesia ako» artinya ...|Saya ke Indonesia.|Saya orang Indonesia.|Saya suka Indonesia.|Saya di Indonesia."]}, {"t": "ex", "kind": "order", "instr": "Susun menjadi kalimat.", "ans": "1. Ako si Budi. · 2. Taga-Indonesia ako. · 3. Nakatira ako sa Jakarta.", "items": ["si / Budi. / Ako", "ako. / Taga-Indonesia", "Jakarta. / sa / ako / Nakatira"]}]}, {"num": 3, "en": "Mga numero", "id": "Angka, umur & harga", "emoji": "🔢", "goals": ["Menghitung 1–100 dalam bahasa Tagalog.", "Mengenal angka Spanyol yang dipakai untuk harga dan jam."], "sections": [{"t": "vocab", "title": "1–10", "cols": 5, "items": [["1️⃣", "isa", "i-sa", "1"], ["2️⃣", "dalawa", "da-la-wa", "2"], ["3️⃣", "tatlo", "tat-lo", "3"], ["4️⃣", "apat", "a-pat", "4 (empat)"], ["5️⃣", "lima", "li-ma", "5 (lima)"], ["6️⃣", "anim", "a-nim", "6 (enam)"], ["7️⃣", "pito", "pi-to", "7 (pitu, Jawa)"], ["8️⃣", "walo", "wa-lo", "8 (wolu, Jawa)"], ["9️⃣", "siyam", "si-yam", "9"], ["🔟", "sampu", "sam-pu", "10"]]}, {"t": "grammar", "title": "Puluhan", "head": ["Angka", "Tagalog"], "rows": [["11", "labing-isa"], ["20", "dalawampu"], ["21", "dalawampu't isa"], ["30, 50", "tatlumpu, limampu"], ["100", "isandaan"]], "after": "Dalam kehidupan sehari-hari, harga dan jam sering memakai <b>angka Spanyol</b>: <i>singkuwenta pesos</i> (50 peso), <i>alas-tres</i> (pukul tiga)."}, {"t": "phrases", "title": "Ungkapan dengan angka", "items": [["Ilang taon ka na? – Dalawampung taon na ako.", "Berapa umurmu? – Aku 20 tahun.", "i-lang ta-on ka na"], ["Magkano ito? – Limampung piso.", "Ini berapa? – 50 peso.", "mag-ka-no i-to"]]}, {"t": "ex", "kind": "choice", "instr": "Piliin ang tamang sagot.", "ans": "1. b · 2. b · 3. b", "items": ["apat = ...|3|4|5|6", "lima = ...|4|5|6|7", "«Magkano?» artinya ...|Kapan?|Berapa harganya?|Di mana?|Siapa?"]}]}, {"num": 4, "en": "Pamilya", "id": "Keluarga & may (punya)", "emoji": "👨‍👩‍👧", "goals": ["Menyebut anggota keluarga, termasuk kuya dan ate.", "Memakai may (punya) dan kata milik ko/mo."], "sections": [{"t": "vocab", "title": "Pamilya", "cols": 4, "items": [["👨", "tatay / ama", "ta-tai", "ayah"], ["👩", "nanay / ina", "na-nai", "ibu"], ["👦", "kuya", "ku-ya", "kakak laki-laki"], ["👧", "ate", "a-te", "kakak perempuan"], ["🧒", "bunso", "bun-so", "si bungsu"], ["👫", "kapatid", "ka-pa-tid", "saudara kandung"], ["👴", "lolo", "lo-lo", "kakek"], ["👵", "lola", "lo-la", "nenek"], ["👶", "anak", "a-nak", "anak"], ["💍", "asawa", "a-sa-wa", "suami / istri"], ["🧔", "tito", "ti-to", "paman"], ["👩‍🦱", "tita", "ti-ta", "bibi"]]}, {"t": "grammar", "title": "Milik & punya", "head": ["Pola", "Contoh", "Arti"], "rows": [["… ko (milikku)", "nanay <b>ko</b>", "ibuku"], ["… mo (milikmu)", "kuya <b>mo</b>", "kakakmu"], ["may … (ada/punya)", "<b>May</b> dalawa akong kapatid.", "Aku punya dua saudara."], ["wala (tidak ada)", "<b>Wala</b> akong kotse.", "Aku tidak punya mobil."]]}, {"t": "ex", "kind": "choice", "instr": "Piliin ang tamang sagot.", "ans": "1. b · 2. b · 3. a", "items": ["«ate» artinya ...|adik|kakak perempuan|ibu|nenek", "«nanay ko» artinya ...|ibumu|ibuku|ibunya|nenekku", "«bunso» mirip kata Indonesia ...|bungsu|bunda|bunga|busur"]}]}, {"num": 5, "en": "Mga pandiwa", "id": "Kata kerja & aspek", "emoji": "🏃", "goals": ["Memahami aspek kata kerja (selesai, sedang, akan) dengan sisipan -um-.", "Membuat kalimat negatif dan pertanyaan."], "sections": [{"t": "grammar", "title": "Kata kerja -um- (kain = makan)", "head": ["Aspek", "Bentuk", "Arti"], "rows": [["infinitif", "k<b>um</b>ain", "makan"], ["selesai (sudah)", "k<b>um</b>ain", "sudah makan"], ["sedang / kebiasaan", "k<b>um</b>a<b>ka</b>in", "sedang makan"], ["akan", "<b>ka</b>kain", "akan makan"]], "after": "Seperti bahasa Indonesia yang punya sisipan (<i>gemetar, gerigi</i>), bahasa Tagalog memakai sisipan <b>-um-</b>. Contoh lain: inom → <b>um</b>inom (minum), punta → p<b>um</b>unta (pergi). Negatif: <b>hindi</b> (<i>Hindi ako kumakain ng baboy</i>). Kata tanya: <b>ano</b> (apa), <b>sino</b> (siapa), <b>saan</b> (di mana), <b>kailan</b> (kapan), <b>paano</b> (bagaimana), <b>bakit</b> (mengapa)."}, {"t": "ex", "kind": "choice", "instr": "Piliin ang tamang sagot.", "ans": "1. b · 2. c · 3. b · 4. a", "items": ["«Kumakain ako» artinya ...|Aku sudah makan.|Aku sedang makan.|Aku akan makan.|Aku tidak makan.", "«Kakain ako» artinya ...|Aku sudah makan.|Aku sedang makan.|Aku akan makan.|Aku tidak makan.", "«saan» artinya ...|kapan|di mana|siapa|mengapa", "«bakit» artinya ...|mengapa|bagaimana|apa|berapa"]}]}, {"num": 6, "en": "Sa kainan", "id": "Di restoran", "emoji": "🍲", "goals": ["Memesan makanan dan meminta tagihan.", "Menanyakan kandungan babi."], "sections": [{"t": "vocab", "title": "Pagkain", "cols": 4, "items": [["💧", "tubig", "tu-big", "air"], ["🍚", "kanin", "ka-nin", "nasi"], ["🍞", "tinapay", "ti-na-pai", "roti"], ["🍗", "manok", "ma-nok", "ayam"], ["🐟", "isda", "is-da", "ikan"], ["🥩", "karne", "kar-ne", "daging"], ["🐖", "baboy", "ba-boi", "babi"], ["🐄", "baka", "ba-ka", "sapi"], ["🥬", "gulay", "gu-lai", "sayur"], ["🍌", "prutas", "pru-tas", "buah"], ["☕", "kape", "ka-pe", "kopi"], ["😋", "masarap", "ma-sa-rap", "enak"]]}, {"t": "phrases", "title": "Sa kainan", "items": [["Isang manok at kanin po.", "Satu ayam dan nasi.", "i-sang ma-nok at ka-nin po"], ["Magkano lahat?", "Berapa semuanya?", "mag-ka-no la-hat"], ["Bill po. / Paki-bill po.", "Minta tagihannya.", "bil po"], ["Ang sarap!", "Enak sekali!", "ang sa-rap"]]}, {"t": "note", "html": "Masakan Filipina <b>sering memakai babi</b> (adobo, lechon, sisig), jadi tanyakan dulu: <b>May baboy ba ito?</b> (Apakah ini ada babinya?) · <b>Hindi ako kumakain ng baboy.</b> (Aku tidak makan babi.) · <b>Halal ba ito?</b> · Di Mindanao (wilayah Bangsamoro) banyak makanan halal.", "title": "🕌 Tips makan halal"}, {"t": "dialog", "title": "Sa kainan", "lines": [["Waiter", "🧑‍🍳", "Magandang tanghali po! Ano po ang order ninyo?", "Selamat siang! Mau pesan apa?"], ["Rina", "🧕", "May baboy ba ang adobo?", "Apakah adobonya ada babi?"], ["Waiter", "🧑‍🍳", "Opo, pero may chicken adobo rin po kami.", "Ya, tetapi kami juga punya adobo ayam."], ["Rina", "🧕", "Sige, isang chicken adobo at kanin po.", "Baik, satu adobo ayam dan nasi."]]}, {"t": "ex", "kind": "choice", "instr": "Piliin ang tamang sagot.", "ans": "1. b · 2. b · 3. b", "items": ["«baboy» artinya ...|sapi|babi|ayam|kambing", "Rina memesan ...|adobo babi|adobo ayam dan nasi|lechon|ikan", "«masarap» artinya ...|mahal|enak|pedas|panas"]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Piliin ang tamang sagot.", "ans": "1. b · 2. a · 3. b · 4. a", "items": ["«Salamat po» artinya ...|Selamat pagi|Terima kasih (sopan)|Maaf|Sampai jumpa", "«kuya» artinya ...|kakak laki-laki|adik|paman|kakek", "«tayo» artinya ...|kami|kita|kalian|mereka", "«Kumain ako» artinya ...|Aku sudah makan.|Aku akan makan.|Aku sedang makan.|Aku tidak makan."]}, {"t": "ex", "kind": "tf", "instr": "Tama o mali?", "ans": "1. Tama · 2. Tama · 3. Mali", "items": ["Bahasa Tagalog serumpun dengan bahasa Indonesia.", "Kata «po» dipakai untuk bersikap sopan.", "«baboy» berarti sapi."]}], "words": [{"e": "1️⃣", "w": "isa", "p": "i-sa", "m": "1", "u": 3}, {"e": "2️⃣", "w": "dalawa", "p": "da-la-wa", "m": "2", "u": 3}, {"e": "3️⃣", "w": "tatlo", "p": "tat-lo", "m": "3", "u": 3}, {"e": "4️⃣", "w": "apat", "p": "a-pat", "m": "4 (empat)", "u": 3}, {"e": "5️⃣", "w": "lima", "p": "li-ma", "m": "5 (lima)", "u": 3}, {"e": "6️⃣", "w": "anim", "p": "a-nim", "m": "6 (enam)", "u": 3}, {"e": "7️⃣", "w": "pito", "p": "pi-to", "m": "7 (pitu, Jawa)", "u": 3}, {"e": "8️⃣", "w": "walo", "p": "wa-lo", "m": "8 (wolu, Jawa)", "u": 3}, {"e": "9️⃣", "w": "siyam", "p": "si-yam", "m": "9", "u": 3}, {"e": "🔟", "w": "sampu", "p": "sam-pu", "m": "10", "u": 3}, {"e": "👨", "w": "tatay / ama", "p": "ta-tai", "m": "ayah", "u": 4}, {"e": "👩", "w": "nanay / ina", "p": "na-nai", "m": "ibu", "u": 4}, {"e": "👦", "w": "kuya", "p": "ku-ya", "m": "kakak laki-laki", "u": 4}, {"e": "👧", "w": "ate", "p": "a-te", "m": "kakak perempuan", "u": 4}, {"e": "🧒", "w": "bunso", "p": "bun-so", "m": "si bungsu", "u": 4}, {"e": "👫", "w": "kapatid", "p": "ka-pa-tid", "m": "saudara kandung", "u": 4}, {"e": "👴", "w": "lolo", "p": "lo-lo", "m": "kakek", "u": 4}, {"e": "👵", "w": "lola", "p": "lo-la", "m": "nenek", "u": 4}, {"e": "👶", "w": "anak", "p": "a-nak", "m": "anak", "u": 4}, {"e": "💍", "w": "asawa", "p": "a-sa-wa", "m": "suami / istri", "u": 4}, {"e": "🧔", "w": "tito", "p": "ti-to", "m": "paman", "u": 4}, {"e": "👩‍🦱", "w": "tita", "p": "ti-ta", "m": "bibi", "u": 4}, {"e": "💧", "w": "tubig", "p": "tu-big", "m": "air", "u": 6}, {"e": "🍚", "w": "kanin", "p": "ka-nin", "m": "nasi", "u": 6}, {"e": "🍞", "w": "tinapay", "p": "ti-na-pai", "m": "roti", "u": 6}, {"e": "🍗", "w": "manok", "p": "ma-nok", "m": "ayam", "u": 6}, {"e": "🐟", "w": "isda", "p": "is-da", "m": "ikan", "u": 6}, {"e": "🥩", "w": "karne", "p": "kar-ne", "m": "daging", "u": 6}, {"e": "🐖", "w": "baboy", "p": "ba-boi", "m": "babi", "u": 6}, {"e": "🐄", "w": "baka", "p": "ba-ka", "m": "sapi", "u": 6}, {"e": "🥬", "w": "gulay", "p": "gu-lai", "m": "sayur", "u": 6}, {"e": "🍌", "w": "prutas", "p": "pru-tas", "m": "buah", "u": 6}, {"e": "☕", "w": "kape", "p": "ka-pe", "m": "kopi", "u": 6}, {"e": "😋", "w": "masarap", "p": "ma-sa-rap", "m": "enak", "u": 6}]}