{"id": "ja-1", "lang": "ja", "grade": 1, "level": "sd", "title": "こんにちは！", "sub": "Belajar sambil bermain · Untuk siswa Kelas 1 SD", "c": "#E8436A", "c2": "#FDE3EA", "c3": "#F7A1B5", "emojis": "🌸 🗻 🍙 ⭐ 🐱 🎏 🎨 👋 🍡 🐰 🔢 🏯", "intro": "", "cando": ["Membaca 46 huruf hiragana.", "Menyapa dan memperkenalkan diri.", "Berhitung 1–10 dan menyebut umur.", "Menyebut warna, anggota keluarga, dan anggota tubuh.", "Memakai <b>〜は 〜です</b>."], "text": {"labels": {"learn": ["📚", "まなぼう！", "Ayo Belajar"], "talk": ["🗣️", "はなそう！", "Ayo Berbicara"], "read": ["📖", "よもう！", "Ayo Membaca"], "practice": ["✏️", "れんしゅう！", "Ayo Berlatih"], "sing": ["🎵", "うたおう！", "Ayo Bernyanyi"], "play": ["🎲", "あそぼう！", "Ayo Bermain"], "grammar": ["🧩", "ぶんをつくろう！", "Ayo Menyusun Kalimat"], "write": ["📝", "かこう！", "Ayo Menulis"]}, "brand": "Asyik Belajar Bahasa Jepang", "unit_word": "bab", "tip_prefix": "Kiko berkata:", "fun_h": "🌟 Tahukah Kamu? <small>しってる？</small>", "word_box": "Kotak Kata:", "true": "Benar", "false": "Salah", "review_t": "ふくしゅう", "review_s": "Evaluasi — Ayo uji kemampuanmu!", "pron_note": "Tulisan latin di dalam garis miring, misalnya ねこ <span class=\"vp inl\">/neko/</span>, disebut <b>romaji</b> — cara membaca huruf Jepang. Vokal ganda (<b>aa, ii, uu, ee, oo</b>) dibaca <b>panjang</b>. <b>shi</b> dibaca “si”, <b>chi</b> dibaca “ci”, <b>tsu</b> dibaca “tsu”, <b>fu</b> di antara “fu” dan “hu”, dan <b>ん</b> (n) dibaca “n/ng”. Huruf kecil di atas kanji disebut <b>furigana</b> (cara baca kanji). Biasakan membaca hiragana dan katakana, lalu dengarkan guru atau video berbahasa Jepang. 🎧", "pron_html": null}, "units": [{"num": 1, "en": "ひらがな", "id": "Huruf Hiragana", "emoji": "🔤", "goals": ["Mengenal 46 huruf hiragana.", "Membaca kata-kata pendek dalam hiragana."], "sections": [{"t": "raw", "html": "<div class=\"sgrid\" style=\"--sc:5\"><div class=\"scard\"><div class=\"sch\">あ</div><div class=\"sn\">a</div><div class=\"se\">🐜</div><div class=\"swd\">あり · semut</div></div><div class=\"scard\"><div class=\"sch\">い</div><div class=\"sn\">i</div><div class=\"se\">🐶</div><div class=\"swd\">いぬ · anjing</div></div><div class=\"scard\"><div class=\"sch\">う</div><div class=\"sn\">u</div><div class=\"se\">🐰</div><div class=\"swd\">うさぎ · kelinci</div></div><div class=\"scard\"><div class=\"sch\">え</div><div class=\"sn\">e</div><div class=\"se\">✏️</div><div class=\"swd\">えんぴつ · pensil</div></div><div class=\"scard\"><div class=\"sch\">お</div><div class=\"sn\">o</div><div class=\"se\">🍙</div><div class=\"swd\">おにぎり · nasi kepal</div></div><div class=\"scard\"><div class=\"sch\">か</div><div class=\"sn\">ka</div><div class=\"se\">☂️</div><div class=\"swd\">かさ · payung</div></div><div class=\"scard\"><div class=\"sch\">き</div><div class=\"sn\">ki</div><div class=\"se\">🌳</div><div class=\"swd\">き · pohon</div></div><div class=\"scard\"><div class=\"sch\">く</div><div class=\"sn\">ku</div><div class=\"se\">🐻</div><div class=\"swd\">くま · beruang</div></div><div class=\"scard\"><div class=\"sch\">け</div><div class=\"sn\">ke</div><div class=\"se\">🐛</div><div class=\"swd\">けむし · ulat</div></div><div class=\"scard\"><div class=\"sch\">こ</div><div class=\"sn\">ko</div><div class=\"se\">🧊</div><div class=\"swd\">こおり · es</div></div><div class=\"scard\"><div class=\"sch\">さ</div><div class=\"sn\">sa</div><div class=\"se\">🐟</div><div class=\"swd\">さかな · ikan</div></div><div class=\"scard\"><div class=\"sch\">し</div><div class=\"sn\">shi</div><div class=\"se\">🦌</div><div class=\"swd\">しか · rusa</div></div><div class=\"scard\"><div class=\"sch\">す</div><div class=\"sn\">su</div><div class=\"se\">🍉</div><div class=\"swd\">すいか · semangka</div></div><div class=\"scard\"><div class=\"sch\">せ</div><div class=\"sn\">se</div><div class=\"se\">🦗</div><div class=\"swd\">せみ · tonggeret</div></div><div class=\"scard\"><div class=\"sch\">そ</div><div class=\"sn\">so</div><div class=\"se\">🌤️</div><div class=\"swd\">そら · langit</div></div><div class=\"scard\"><div class=\"sch\">た</div><div class=\"sn\">ta</div><div class=\"se\">🥚</div><div class=\"swd\">たまご · telur</div></div><div class=\"scard\"><div class=\"sch\">ち</div><div class=\"sn\">chi</div><div class=\"se\">🗺️</div><div class=\"swd\">ちず · peta</div></div><div class=\"scard\"><div class=\"sch\">つ</div><div class=\"sn\">tsu</div><div class=\"se\">🌙</div><div class=\"swd\">つき · bulan</div></div><div class=\"scard\"><div class=\"sch\">て</div><div class=\"sn\">te</div><div class=\"se\">✋</div><div class=\"swd\">て · tangan</div></div><div class=\"scard\"><div class=\"sch\">と</div><div class=\"sn\">to</div><div class=\"se\">🐦</div><div class=\"swd\">とり · burung</div></div><div class=\"scard\"><div class=\"sch\">な</div><div class=\"sn\">na</div><div class=\"se\">🍆</div><div class=\"swd\">なす · terong</div></div><div class=\"scard\"><div class=\"sch\">に</div><div class=\"sn\">ni</div><div class=\"se\">🥕</div><div class=\"swd\">にんじん · wortel</div></div><div class=\"scard\"><div class=\"sch\">ぬ</div><div class=\"sn\">nu</div><div class=\"se\">🧸</div><div class=\"swd\">ぬいぐるみ · boneka</div></div><div class=\"scard\"><div class=\"sch\">ね</div><div class=\"sn\">ne</div><div class=\"se\">🐱</div><div class=\"swd\">ねこ · kucing</div></div><div class=\"scard\"><div class=\"sch\">の</div><div class=\"sn\">no</div><div class=\"se\">🥤</div><div class=\"swd\">のみもの · minuman</div></div><div class=\"scard\"><div class=\"sch\">は</div><div class=\"sn\">ha</div><div class=\"se\">🌸</div><div class=\"swd\">はな · bunga</div></div><div class=\"scard\"><div class=\"sch\">ひ</div><div class=\"sn\">hi</div><div class=\"se\">🐤</div><div class=\"swd\">ひよこ · anak ayam</div></div><div class=\"scard\"><div class=\"sch\">ふ</div><div class=\"sn\">fu</div><div class=\"se\">🚢</div><div class=\"swd\">ふね · kapal</div></div><div class=\"scard\"><div class=\"sch\">へ</div><div class=\"sn\">he</div><div class=\"se\">🐍</div><div class=\"swd\">へび · ular</div></div><div class=\"scard\"><div class=\"sch\">ほ</div><div class=\"sn\">ho</div><div class=\"se\">⭐</div><div class=\"swd\">ほし · bintang</div></div><div class=\"scard\"><div class=\"sch\">ま</div><div class=\"sn\">ma</div><div class=\"se\">🪟</div><div class=\"swd\">まど · jendela</div></div><div class=\"scard\"><div class=\"sch\">み</div><div class=\"sn\">mi</div><div class=\"se\">🍊</div><div class=\"swd\">みかん · jeruk</div></div><div class=\"scard\"><div class=\"sch\">む</div><div class=\"sn\">mu</div><div class=\"se\">🐞</div><div class=\"swd\">むし · serangga</div></div><div class=\"scard\"><div class=\"sch\">め</div><div class=\"sn\">me</div><div class=\"se\">👁️</div><div class=\"swd\">め · mata</div></div><div class=\"scard\"><div class=\"sch\">も</div><div class=\"sn\">mo</div><div class=\"se\">🍑</div><div class=\"swd\">もも · persik</div></div><div class=\"scard\"><div class=\"sch\">や</div><div class=\"sn\">ya</div><div class=\"se\">⛰️</div><div class=\"swd\">やま · gunung</div></div><div class=\"scard empty\"></div><div class=\"scard\"><div class=\"sch\">ゆ</div><div class=\"sn\">yu</div><div class=\"se\">❄️</div><div class=\"swd\">ゆき · salju</div></div><div class=\"scard empty\"></div><div class=\"scard\"><div class=\"sch\">よ</div><div class=\"sn\">yo</div><div class=\"se\">🌃</div><div class=\"swd\">よる · malam</div></div><div class=\"scard\"><div class=\"sch\">ら</div><div class=\"sn\">ra</div><div class=\"se\">🎺</div><div class=\"swd\">らっぱ · terompet</div></div><div class=\"scard\"><div class=\"sch\">り</div><div class=\"sn\">ri</div><div class=\"se\">🍎</div><div class=\"swd\">りんご · apel</div></div><div class=\"scard\"><div class=\"sch\">る</div><div class=\"sn\">ru</div><div class=\"se\">🚗</div><div class=\"swd\">くるま · mobil</div></div><div class=\"scard\"><div class=\"sch\">れ</div><div class=\"sn\">re</div><div class=\"se\">🍋</div><div class=\"swd\">れもん · lemon</div></div><div class=\"scard\"><div class=\"sch\">ろ</div><div class=\"sn\">ro</div><div class=\"se\">🕯️</div><div class=\"swd\">ろうそく · lilin</div></div><div class=\"scard\"><div class=\"sch\">わ</div><div class=\"sn\">wa</div><div class=\"se\">🐊</div><div class=\"swd\">わに · buaya</div></div><div class=\"scard empty\"></div><div class=\"scard empty\"></div><div class=\"scard empty\"></div><div class=\"scard\"><div class=\"sch\">を</div><div class=\"sn\">o</div><div class=\"se\">🔗</div><div class=\"swd\">(partikel)</div></div><div class=\"scard\"><div class=\"sch\">ん</div><div class=\"sn\">n</div><div class=\"se\">📖</div><div class=\"swd\">ほん · buku</div></div><div class=\"scard empty\"></div><div class=\"scard empty\"></div><div class=\"scard empty\"></div><div class=\"scard empty\"></div></div>", "label": "learn", "title": "Tabel hiragana (dibaca dari kiri ke kanan: a–i–u–e–o)"}, {"t": "note", "html": "<ul><li>Bahasa Jepang memakai <b>tiga</b> jenis huruf: <b>hiragana</b> (ひらがな), <b>katakana</b> (カタカナ), dan <b>kanji</b> (漢字).</li><li>Setiap huruf hiragana adalah <b>satu suku kata</b>: か = ka, ね = ne, こ = ko → ねこ = <b>neko</b> (kucing).</li><li>Tanda <b>゛</b> (tenten) mengubah bunyi: か → が (ga), さ → ざ (za), た → だ (da), は → ば (ba). Tanda <b>゜</b> (maru): は → ぱ (pa).</li></ul>", "title": "Ingat, ya!"}, {"t": "raw", "html": "<div class=\"song\"><div class=\"notes\">🎶</div><div class=\"lyr\"><div>あ い う え お</div><div class=\"str\">a i u e o</div><div>か き く け こ</div><div class=\"str\">ka ki ku ke ko</div><div>さ し す せ そ</div><div class=\"str\">sa shi su se so</div><div>た ち つ て と</div><div class=\"str\">ta chi tsu te to</div></div><div class=\"sinfo\">Nyanyikan dengan nada bebas sambil menunjuk hurufnya. Lanjutkan sampai baris ん!</div></div>", "label": "sing", "title": "Lagu A-I-U-E-O 🎶"}, {"t": "ex", "kind": "match", "instr": "Pasangkan huruf dengan bunyinya!", "ans": "1–c, 2–e, 3–a, 4–d, 5–b", "left": ["ね", "す", "き", "ほ", "み"], "right": ["ki", "mi", "ne", "ho", "su"]}, {"t": "ex", "kind": "fill", "instr": "Tulis cara bacanya (romaji)!", "ans": "1. neko · 2. inu · 3. sakana · 4. ringo · 5. hoshi", "items": ["ねこ = ___", "いぬ = ___", "さかな = ___", "りんご = ___", "ほし = ___"]}, {"t": "ex", "kind": "circle", "instr": "Lingkari huruf pertama dari kata ini!", "ans": "1. く · 2. さ · 3. り · 4. つ", "items": ["🐻 くま ((く / し))", "🐟 さかな ((さ / ち))", "🍎 りんご ((り / い))", "🌙 つき ((つ / う))"]}, {"t": "ex", "kind": "write", "instr": "Ayo menulis! Tiru hurufnya 5 kali.", "ans": "Periksa bentuk huruf anak.", "items": ["あ", "き", "ね", "ん"]}, {"t": "fun", "html": "Huruf hiragana berasal dari kanji yang ditulis dengan cepat dan melengkung. Misalnya <b>あ</b> berasal dari kanji <b>安</b>. ✍️"}]}, {"num": 2, "en": "あいさつ", "id": "Salam dan Perkenalan", "emoji": "👋", "goals": ["Mengucapkan salam pada pagi, siang, dan malam.", "Memperkenalkan diri: <b>わたしは … です。</b>", "Mengucapkan terima kasih dan maaf."], "sections": [{"t": "phrases", "title": "Salam — あいさつ", "items": [["おはよう ございます。 🌅", "Selamat pagi.", "ohayoo gozaimasu"], ["こんにちは。 ☀️", "Halo / Selamat siang.", "konnichiwa"], ["こんばんは。 🌆", "Selamat malam. (saat bertemu)", "konbanwa"], ["おやすみなさい。 🌙", "Selamat tidur.", "oyasuminasai"], ["さようなら。 👋", "Selamat tinggal.", "sayoonara"], ["またね！", "Sampai jumpa! (kepada teman)", "mata ne"]], "label": "learn"}, {"t": "phrases", "title": "Kata-kata ajaib ✨", "items": [["ありがとう ございます。", "Terima kasih.", "arigatoo gozaimasu"], ["どういたしまして。", "Sama-sama.", "doo itashimashite"], ["ごめんなさい。", "Maaf.", "gomennasai"], ["すみません。", "Permisi / maaf.", "sumimasen"], ["はじめまして。", "Senang berkenalan. (pertama kali bertemu)", "hajimemashite"], ["よろしく おねがいします。", "Mohon bantuannya / salam kenal.", "yoroshiku onegaishimasu"]], "label": "learn"}, {"t": "dialog", "title": "Berkenalan", "lines": [["Yuki", "👧", "はじめまして。わたしは ゆきです。", "hajimemashite. watashi wa yuki desu.", "Senang berkenalan. Aku Yuki."], ["Kenta", "👦", "はじめまして。ぼくは けんたです。", "hajimemashite. boku wa kenta desu.", "Senang berkenalan. Aku Kenta."], ["Yuki", "👧", "よろしく おねがいします。", "yoroshiku onegaishimasu.", "Salam kenal."], ["Kenta", "👦", "こちらこそ、よろしく！", "kochira koso, yoroshiku!", "Salam kenal juga!"], ["Yuki", "👧", "おげんきですか？", "ogenki desu ka?", "Apa kabar?"], ["Kenta", "👦", "はい、げんきです！", "hai, genki desu!", "Ya, baik!"]]}, {"t": "grammar", "title": "Aku …", "head": ["Bahasa Jepang", "Romaji", "Arti"], "rows": [["わたしは ゆきです。", "watashi wa yuki desu", "Aku Yuki."], ["ぼくは けんたです。", "boku wa kenta desu", "Aku Kenta. (anak laki-laki)"], ["おなまえは？", "onamae wa?", "Siapa namamu?"], ["〜です。", "… desu", "… adalah / ini …"]], "after": "Huruf <b>は</b> sebagai kata sambung dibaca <b>wa</b>, bukan “ha”. · <b>わたし</b> = aku (umum) · <b>ぼく</b> = aku (anak laki-laki). Orang Jepang biasanya <b>membungkuk</b> saat memberi salam. 🙇"}, {"t": "ex", "kind": "match", "instr": "Pasangkan salam dengan waktunya!", "ans": "1–b, 2–d, 3–c, 4–a", "left": ["🌅 pagi", "☀️ siang", "🌆 malam (bertemu)", "🌙 mau tidur"], "right": ["おやすみなさい", "おはよう ございます", "こんばんは", "こんにちは"]}, {"t": "ex", "kind": "choice", "instr": "Pilih jawaban yang benar!", "ans": "1. b · 2. a · 3. b", "items": ["Temanmu memberi hadiah. Kamu berkata …|ごめんなさい|ありがとう|こんばんは", "Temanmu berkata ありがとう. Kamu menjawab …|どういたしまして|おはよう|さようなら", "Pertama kali bertemu seseorang, kamu berkata …|おやすみなさい|はじめまして|またね"]}, {"t": "ex", "kind": "write", "instr": "Perkenalkan dirimu!", "ans": "Jawaban bebas.", "items": ["わたしは / ぼくは ___ です。"]}, {"t": "fun", "html": "Di Jepang, orang jarang berjabat tangan. Mereka memberi salam dengan <b>membungkuk</b> (おじぎ, ojigi). Semakin dalam bungkukannya, semakin sopan! 🙇"}]}, {"num": 3, "en": "かず 1〜10", "id": "Bilangan 1 sampai 10", "emoji": "🔢", "goals": ["Menyebut bilangan 1–10 dan mengenal kanji angka.", "Menyebut umur: <b>… さいです。</b>"], "sections": [{"t": "vocab", "title": "Bilangan — かず", "items": [["一", "いち", "ichi", "satu (1)"], ["二", "に", "ni", "dua (2)"], ["三", "さん", "san", "tiga (3)"], ["四", "よん / し", "yon / shi", "empat (4)"], ["五", "ご", "go", "lima (5)"], ["六", "ろく", "roku", "enam (6)"], ["七", "なな / しち", "nana / shichi", "tujuh (7)"], ["八", "はち", "hachi", "delapan (8)"], ["九", "きゅう / く", "kyuu / ku", "sembilan (9)"], ["十", "じゅう", "juu", "sepuluh (10)"]], "cols": 5, "label": "learn", "dict": true}, {"t": "grammar", "title": "Berapa umurmu?", "head": ["Bahasa Jepang", "Romaji", "Arti"], "rows": [["なんさいですか？", "nansai desu ka?", "Berapa umurmu?"], ["ろくさいです。", "rokusai desu", "Enam tahun."], ["ななさいです。", "nanasai desu", "Tujuh tahun."], ["はっさいです。", "hassai desu", "Delapan tahun."]], "after": "<b>さい</b> (sai) = tahun (umur). Hati-hati: 8 tahun = <b>はっさい</b> (hassai), bukan “hachisai”."}, {"t": "raw", "html": "<div class=\"song\"><div class=\"notes\">🎶</div><div class=\"lyr\"><div>いち、に、さん、し、ご</div><div class=\"str\">ichi, ni, san, shi, go</div><div>ろく、しち、はち、きゅう、じゅう！</div><div class=\"str\">roku, shichi, hachi, kyuu, juu!</div></div><div class=\"sinfo\">Berhitung sambil bertepuk tangan. 👏</div></div>", "label": "sing", "title": "Ayo berhitung! 🎶"}, {"t": "ex", "kind": "count", "instr": "Hitung, lalu tulis bilangannya dalam hiragana!", "ans": "🐟 さん · 🌸 ご · 🚗 に · 🍌 なな/しち · ⭐ よん/し · 🐤 ろく", "items": ["🐟|3", "🌸|5", "🚗|2", "🍌|7", "⭐|4", "🐤|6"]}, {"t": "ex", "kind": "match", "instr": "Pasangkan kanji dengan cara bacanya!", "ans": "1–d, 2–a, 3–e, 4–c, 5–b", "left": ["八", "一", "十", "六", "九"], "right": ["いち", "きゅう", "ろく", "はち", "じゅう"]}, {"t": "ex", "kind": "fill", "instr": "Lanjutkan urutannya!", "ans": "1. さん · 2. ろく · 3. じゅう", "items": ["いち、に、___", "ご、___、なな", "はち、きゅう、___"]}, {"t": "fun", "html": "Orang Jepang sering menghindari angka <b>4</b> karena salah satu cara bacanya, <b>し</b> (shi), bunyinya sama dengan kata <b>“mati”</b>. Karena itu 4 lebih sering dibaca <b>よん</b> (yon). 🤫"}]}, {"num": 4, "en": "いろ", "id": "Warna-warni", "emoji": "🎨", "goals": ["Menyebut 12 warna dalam bahasa Jepang.", "Bertanya dan menjawab: <b>なにいろですか？</b>"], "sections": [{"t": "vocab", "title": "Warna — いろ", "items": [["<i class=\"sw\" style=\"background:#e63946\"></i>", "あか", "aka", "merah"], ["<i class=\"sw\" style=\"background:#1e6fe0\"></i>", "あお", "ao", "biru"], ["<i class=\"sw\" style=\"background:#ffd60a\"></i>", "きいろ", "kiiro", "kuning"], ["<i class=\"sw\" style=\"background:#2dc653\"></i>", "みどり", "midori", "hijau"], ["<i class=\"sw\" style=\"background:#fff\"></i>", "しろ", "shiro", "putih"], ["<i class=\"sw\" style=\"background:#111\"></i>", "くろ", "kuro", "hitam"], ["<i class=\"sw\" style=\"background:#ff8fab\"></i>", "ピンク", "pinku", "merah muda"], ["<i class=\"sw\" style=\"background:#fb8500\"></i>", "オレンジ", "orenji", "oranye"], ["<i class=\"sw\" style=\"background:#8338ec\"></i>", "むらさき", "murasaki", "ungu"], ["<i class=\"sw\" style=\"background:#8d5524\"></i>", "ちゃいろ", "chairo", "cokelat"], ["<i class=\"sw\" style=\"background:#9aa0a6\"></i>", "はいいろ", "haiiro", "abu-abu"], ["<i class=\"sw\" style=\"background:#6ec1ff\"></i>", "みずいろ", "mizuiro", "biru muda"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Apa warnanya?", "head": ["Bahasa Jepang", "Romaji", "Arti"], "rows": [["これは なにいろですか？", "kore wa nani iro desu ka?", "Ini warna apa?"], ["あかです。 🍎", "aka desu", "Merah."], ["バナナは きいろです。 🍌", "banana wa kiiro desu", "Pisang (warnanya) kuning."], ["わたしの すきな いろは あおです。 💙", "watashi no suki na iro wa ao desu", "Warna kesukaanku biru."]], "after": "<b>これ</b> (kore) = ini · <b>なにいろ</b> (nani iro) = warna apa · <b>すきな いろ</b> = warna kesukaan."}, {"t": "dialog", "title": "Warna kesukaanku", "lines": [["Hana", "👧", "すきな いろは なんですか？", "suki na iro wa nan desu ka?", "Warna kesukaanmu apa?"], ["Sora", "👦", "あおです。はなちゃんは？", "ao desu. hana-chan wa?", "Biru. Kalau Hana?"], ["Hana", "👧", "わたしは ピンクが すきです！", "watashi wa pinku ga suki desu!", "Aku suka merah muda!"]]}, {"t": "ex", "kind": "colorit", "instr": "Warnai sesuai warna yang tertulis! 🖍️", "ans": "Merah, biru, kuning, hijau, merah muda, ungu.", "items": ["あか|circle", "あお|square", "きいろ|star", "みどり|triangle", "ピンク|heart", "むらさき|oval"]}, {"t": "ex", "kind": "fill", "instr": "なにいろですか？ Tulis warnanya!", "ans": "1. きいろ · 2. あか · 3. みどり · 4. しろ · 5. むらさき", "bank": ["きいろ", "あか", "みどり", "しろ", "むらさき"], "items": ["🍌 バナナは ___ です。", "🍎 りんごは ___ です。", "🐸 かえるは ___ です。", "☁️ くもは ___ です。", "🍆 なすは ___ です。"]}, {"t": "fun", "html": "Di Jepang, lampu lalu lintas yang hijau disebut <b>あお</b> (biru)! Dulu kata あお dipakai untuk warna biru dan hijau. 🚦"}]}, {"num": 5, "en": "かぞく", "id": "Keluargaku", "emoji": "👨‍👩‍👧‍👦", "goals": ["Menyebut anggota keluarga.", "Memperkenalkan keluarga: <b>これは わたしの … です。</b>"], "sections": [{"t": "vocab", "title": "Keluarga — かぞく", "items": [["👨", "おとうさん", "otoosan", "ayah"], ["👩", "おかあさん", "okaasan", "ibu"], ["👦", "おにいさん", "oniisan", "kakak laki-laki"], ["👧", "おねえさん", "oneesan", "kakak perempuan"], ["🧒", "おとうと", "otooto", "adik laki-laki"], ["👶", "いもうと", "imooto", "adik perempuan"], ["👴", "おじいさん", "ojiisan", "kakek"], ["👵", "おばあさん", "obaasan", "nenek"], ["🍼", "あかちゃん", "akachan", "bayi"], ["👨‍👩‍👧", "かぞく", "kazoku", "keluarga"], ["🙋", "わたし", "watashi", "aku"], ["❤️", "だいすき", "daisuki", "sangat suka/sayang"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Ini ayahku", "head": ["Bahasa Jepang", "Romaji", "Arti"], "rows": [["これは わたしの おとうさんです。", "kore wa watashi no otoosan desu", "Ini ayahku."], ["これは わたしの おかあさんです。", "kore wa watashi no okaasan desu", "Ini ibuku."], ["かぞくは よにんです。", "kazoku wa yonin desu", "Keluargaku empat orang."]], "after": "<b>わたしの</b> = milikku / -ku. · <b>の</b> (no) = milik. · Bahasa Jepang punya kata berbeda untuk kakak (おにいさん, おねえさん) dan adik (おとうと, いもうと)."}, {"t": "raw", "html": "<div class=\"reading ltr\"><div class=\"rpic\">👨‍👩‍👧‍👦</div><div class=\"tl\"><div class=\"tar\">わたしの なまえは はなです。</div><div class=\"ttr\">watashi no namae wa hana desu</div><div class=\"tid\">Namaku Hana.</div></div><div class=\"tl\"><div class=\"tar\">かぞくは よにんです。</div><div class=\"ttr\">kazoku wa yonin desu</div><div class=\"tid\">Keluargaku empat orang.</div></div><div class=\"tl\"><div class=\"tar\">おとうさんと おかあさんと おとうとが います。</div><div class=\"ttr\">otoosan to okaasan to otooto ga imasu</div><div class=\"tid\">Ada ayah, ibu, dan adik laki-laki.</div></div><div class=\"tl\"><div class=\"tar\">おとうとの なまえは たろうです。</div><div class=\"ttr\">otooto no namae wa taroo desu</div><div class=\"tid\">Nama adikku Taro.</div></div><div class=\"tl\"><div class=\"tar\">わたしは かぞくが だいすきです！ ❤️</div><div class=\"ttr\">watashi wa kazoku ga daisuki desu!</div><div class=\"tid\">Aku sangat sayang keluargaku!</div></div><div class=\"gloss\"><b>📌 Kata penting:</b> なまえ = nama · よにん = empat orang · と = dan · います = ada (orang/hewan)</div></div>", "label": "read", "title": "わたしの かぞく — Keluargaku"}, {"t": "ex", "kind": "tf", "instr": "Benar atau Salah?", "ans": "1. Benar · 2. Salah (empat orang) · 3. Benar · 4. Benar", "items": ["Nama anak itu Hana.", "Keluarganya lima orang.", "Hana punya adik laki-laki.", "Nama adiknya Taro."]}, {"t": "ex", "kind": "match", "instr": "Pasangkan gambar dengan katanya!", "ans": "1–c, 2–a, 3–e, 4–b, 5–d", "left": ["👴", "👩", "🍼", "👧", "👨"], "right": ["おかあさん", "おねえさん", "おじいさん", "おとうさん", "あかちゃん"]}, {"t": "ex", "kind": "draw", "instr": "Gambar keluargamu dan lengkapi kalimatnya!", "ans": "Jawaban bebas.", "h": 140, "caps": ["これは わたしの ___ です。", "かぞくは ___ にんです。"]}, {"t": "fun", "html": "Saat bercerita tentang keluarga sendiri kepada orang lain, orang Jepang memakai kata yang lebih sederhana: <b>ちち</b> (ayahku) dan <b>はは</b> (ibuku). Ini tanda sopan santun! 🙇"}]}, {"num": 6, "en": "からだ", "id": "Anggota Tubuh", "emoji": "🧍", "goals": ["Menyebut anggota tubuh.", "Mengikuti perintah sederhana: <b>〜を さわって！</b>"], "sections": [{"t": "vocab", "title": "Anggota tubuh — からだ", "items": [["🙂", "あたま", "atama", "kepala"], ["💇", "かみ", "kami", "rambut"], ["👁️", "め", "me", "mata"], ["👂", "みみ", "mimi", "telinga"], ["👃", "はな", "hana", "hidung"], ["👄", "くち", "kuchi", "mulut"], ["🦷", "は", "ha", "gigi"], ["😊", "かお", "kao", "wajah"], ["✋", "て", "te", "tangan"], ["🦶", "あし", "ashi", "kaki"], ["👆", "ゆび", "yubi", "jari"], ["🫃", "おなか", "onaka", "perut"]], "cols": 6, "label": "learn", "dict": true}, {"t": "phrases", "title": "Permainan perintah", "items": [["はなを さわって！ 👃", "Sentuhlah hidungmu!", 