{"id": "tr-1", "kind": "lang", "lang": "tr", "grade": null, "level": "umum", "tag": "A1", "badge": ["Level", "A1"], "title": "Bahasa Turki Pemula", "sub": "Pelafalan, salam, akhiran, angka, keluarga, kata kerja -iyor, restoran", "c": "#E03131", "c2": "#FFF5F5", "c3": "#8A1C1C", "emojis": "👋 🪪 🔢 👨‍👩‍👧 🏃 🥙", "intro": "<div class=\"note\"><div class=\"note-h\">📌 Tentang kursus ini</div>Bahasa Turki dari nol, setara <b>A1</b>. Ejaannya sangat teratur dan banyak kosakatanya berasal dari bahasa Arab. Cocok bagi yang ingin kuliah (beasiswa <i>Türkiye Bursları</i>) atau berwisata ke Turki.</div>", "cando": ["Membaca huruf khas bahasa Turki (c, ç, ş, ğ, ı, ö, ü).", "Memperkenalkan nama, asal, dan tempat tinggal.", "Menghitung 0–100 (sangat teratur).", "Menyebut anggota keluarga.", "Membentuk kata kerja waktu sekarang dengan akhiran -iyor.", "Memesan makanan dan meminta tagihan."], "text": {"labels": {"learn": ["📚", "Kelimeler", "Kosakata"], "talk": ["🗣️", "Diyalog", "Percakapan"], "read": ["📖", "Okuma", "Membaca"], "practice": ["✏️", "Alıştırmalar", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Dil bilgisi", "Tata Bahasa"], "write": ["📝", "Menulis", ""]}, "brand": "Belajar Bahasa Turki", "unit_word": "unit", "tip_prefix": "Tips:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Doğru", "false": "Yanlış", "review_t": "Tekrar · Evaluasi", "review_s": "Uji kemampuanmu", "pron_note": "", "pron_html": "<div class=\"note\"><div class=\"note-h\">🔊 Cara baca</div>Cara baca ditulis sederhana, misalnya <i>çay</i> = <i>cai</i> dan <i>cami</i> = <i>jaa-mi</i>. Huruf <b>ı</b> (tanpa titik) dibaca seperti e pada <i>emas</i>. Dengarkan juga suaranya dengan tombol 🔊.</div>"}, "units": [{"num": 1, "en": "Telaffuz ve selamlaşma", "id": "Pelafalan & salam", "emoji": "👋", "goals": ["Membaca huruf khas bahasa Turki (c, ç, ş, ğ, ı, ö, ü).", "Menyapa, berterima kasih, dan berpamitan."], "sections": [{"t": "note", "html": "Bahasa Turki dituturkan sekitar <b>85 juta orang</b>. Ejaannya sangat teratur: <b>satu huruf = satu bunyi</b>. Banyak katanya berasal dari bahasa Arab sehingga mirip bahasa Indonesia: <i>kitap (kitab), saat (jam), dünya (dunia), hayat (hidup), insan (manusia), merhaba (dari marhaban)</i>. Ciri khasnya <b>harmoni vokal</b>: akhiran menyesuaikan vokal kata dasar, misalnya <i>ev<b>ler</b></i> (rumah-rumah) dan <i>kitap<b>lar</b></i> (buku-buku).", "title": "Mengenal bahasa Turki"}, {"t": "grammar", "title": "Huruf yang perlu diperhatikan", "head": ["Huruf", "Dibaca", "Contoh"], "rows": [["c", "j", "cami (jaa-mi) = masjid"], ["ç", "c", "çay (cai) = teh"], ["ş", "sy", "şeker (sye-ker) = gula"], ["ğ", "tidak dibaca, memanjangkan vokal", "dağ (daa) = gunung"], ["ı", "e pepet (seperti emas)", "ılık (e-lek) = hangat"], ["ö", "e dengan bibir bulat", "göz (göz) = mata"], ["ü", "i dengan bibir bulat", "gül (gül) = mawar"], ["j", "zh (jarang)", "Japonya"]]}, {"t": "phrases", "title": "Salam & sopan santun", "items": [["Merhaba!", "Halo!", "mer-ha-ba"], ["Selamünaleyküm! – Aleykümselam!", "Assalamu'alaikum! – Wa'alaikumussalam!", "se-la-mü-na-lei-küm"], ["Günaydın!", "Selamat pagi!", "gü-nai-den"], ["İyi akşamlar!", "Selamat malam!", "i-yi ak-syam-lar"], ["Nasılsın? – İyiyim, teşekkürler. Sen nasılsın?", "Apa kabar? – Baik, terima kasih. Kamu?", "na-sel-sen – i-yi-yim, te-syek-kür-ler"], ["Lütfen.", "Tolong / silakan.", "lüt-fen"], ["Teşekkür ederim! – Rica ederim!", "Terima kasih! – Sama-sama!", "te-syek-kür e-de-rim – ri-ja e-de-rim"], ["Affedersiniz!", "Permisi / maaf!", "af-fe-der-si-niz"], ["Hoşça kal! – Güle güle!", "Selamat tinggal! (yang pergi) – Selamat jalan! (yang tinggal)", "hosy-ca kal – gü-le gü-le"]]}, {"t": "ex", "kind": "choice", "instr": "Doğru cevabı seç.", "ans": "1. b · 2. a · 3. b · 4. b · 5. a", "items": ["Huruf c pada «cami» dibaca ...|c|j|k|s", "Huruf ç pada «çay» dibaca ...|c|j|s|k", "Kata «kitap» artinya ...|kita|kitab/buku|pintu|waktu", "Orang yang pergi mengucapkan «Hoşça kal», yang tinggal menjawab ...|Merhaba|Güle güle|Günaydın|Lütfen", "Jawaban untuk «Teşekkür ederim» adalah ...|Rica ederim|Nasılsın|Merhaba|Hoşça kal"]}]}, {"num": 2, "en": "Tanışma", "id": "Perkenalan & akhiran \"adalah\"", "emoji": "🪪", "goals": ["Memperkenalkan nama, asal, dan tempat tinggal.", "Memakai akhiran pengganti \"adalah\" (-(y)im, -sin …) dengan harmoni vokal."], "sections": [{"t": "grammar", "title": "Bahasa Turki tidak punya kata \"adalah\": dipakai akhiran", "head": ["Subjek", "öğrenci (i)", "doktor (o/u)", "Türk (ü)"], "rows": [["ben (saya)", "öğrenci<b>yim</b>", "doktor<b>um</b>", "Türk<b>üm</b>"], ["sen (kamu)", "öğrenci<b>sin</b>", "doktor<b>sun</b>", "Türk<b>sün</b>"], ["o (dia)", "öğrenci", "doktor", "Türk"], ["biz (kami)", "öğrenci<b>yiz</b>", "doktor<b>uz</b>", "Türk<b>üz</b>"], ["siz (Anda/kalian)", "öğrenci<b>siniz</b>", "doktor<b>sunuz</b>", "Türk<b>sünüz</b>"]], "after": "Vokal akhiran mengikuti vokal terakhir kata (harmoni vokal). Contohnya <i>Endonezyalı<b>yım</b></i> = Saya orang Indonesia. <b>sen</b> untuk teman, <b>siz</b> untuk sapaan sopan atau banyak orang."}, {"t": "dialog", "title": "Üniversitede", "lines": [["Elif", "👩", "Merhaba! Benim adım Elif. Senin adın ne?", "Halo! Namaku Elif. Siapa namamu?"], ["Budi", "👦", "Merhaba Elif! Benim adım Budi.", "Halo Elif! Namaku Budi."], ["Elif", "👩", "Nerelisin?", "Kamu orang mana?"], ["Budi", "👦", "Endonezyalıyım. Şimdi İstanbul'da oturuyorum.", "Aku orang Indonesia. Sekarang aku tinggal di Istanbul."], ["Elif", "👩", "Memnun oldum!", "Senang berkenalan!"], ["Budi", "👦", "Ben de memnun oldum!", "Aku juga senang!"]]}, {"t": "ex", "kind": "choice", "instr": "Doğru cevabı seç.", "ans": "1. b · 2. a · 3. b · 4. a", "items": ["Ben öğrenci___.|sin|yim|um|üm", "Sen doktor___.|sun|sin|um|yim", "«Nerelisin?» artinya ...|Kamu tinggal di mana?|Kamu orang mana?|Siapa namamu?|Apa kabar?", "«Benim adım Budi» artinya ...|Namaku Budi.|Aku dan Budi.|Budi temanku.|Budi di sini."]}, {"t": "ex", "kind": "order", "instr": "Susun menjadi kalimat.", "ans": "1. Benim adım Rina. · 2. Ben Endonezyalıyım. · 3. Cakarta'da oturuyorum.", "items": ["adım / Rina. / Benim", "Endonezyalıyım. / Ben", "oturuyorum. / Cakarta'da"]}]}, {"num": 3, "en": "Sayılar", "id": "Angka, umur & harga", "emoji": "🔢", "goals": ["Menghitung 0–100 (sangat teratur).", "Menyebut umur dan menanyakan harga."], "sections": [{"t": "vocab", "title": "0–10", "cols": 4, "items": [["0️⃣", "sıfır", "se-fer", "0"], ["1️⃣", "bir", "bir", "1"], ["2️⃣", "iki", "i-ki", "2"], ["3️⃣", "üç", "üc", "3"], ["4️⃣", "dört", "dört", "4"], ["5️⃣", "beş", "besy", "5"], ["6️⃣", "altı", "al-te", "6"], ["7️⃣", "yedi", "ye-di", "7"], ["8️⃣", "sekiz", "se-kiz", "8"], ["9️⃣", "dokuz", "do-kuz", "9"], ["🔟", "on", "on", "10"]]}, {"t": "grammar", "title": "11–100: tinggal digabung", "head": ["Angka", "Bahasa Turki"], "rows": [["11, 12, 15", "on bir, on iki, on beş"], ["20, 21", "yirmi, yirmi bir"], ["30, 40, 50", "otuz, kırk, elli"], ["60, 70, 80, 90", "altmış, yetmiş, seksen, doksan"], ["100", "yüz"], ["99", "doksan dokuz"]], "after": "Tidak ada pengecualian: puluhan + satuan, persis seperti bahasa Indonesia."}, {"t": "phrases", "title": "Ungkapan dengan angka", "items": [["Kaç yaşındasın? – Yirmi yaşındayım.", "Berapa umurmu? – Umurku 20 tahun.", "kac ya-syen-da-sen – yir-mi ya-syen-da-yem"], ["Bu ne kadar? – On lira.", "Ini berapa? – 10 lira.", "bu ne ka-dar – on li-ra"]]}, {"t": "ex", "kind": "choice", "instr": "Hangi sayı?", "ans": "1. b · 2. b · 3. a · 4. b", "items": ["15 = ...|beş on|on beş|elli|beşon", "40 = ...|dört on|kırk|dörtlü|on dört", "27 = ...|yirmi yedi|yedi yirmi|yetmiş iki|on yedi", "100 = ...|bin|yüz|on|doksan"]}]}, {"num": 4, "en": "Aile", "id": "Keluarga, akhiran milik & var/yok", "emoji": "👨‍👩‍👧", "goals": ["Menyebut anggota keluarga.", "Memakai akhiran milik (-im, -in) serta var (ada/punya) dan yok (tidak ada)."], "sections": [{"t": "vocab", "title": "Aile", "cols": 4, "items": [["👩", "anne", "an-ne", "ibu"], ["👨", "baba", "ba-ba", "ayah"], ["👦", "abi / ağabey", "a-bi", "kakak laki-laki"], ["👧", "abla", "ab-la", "kakak perempuan"], ["🧒", "kardeş", "kar-desy", "saudara, adik"], ["👴", "dede", "de-de", "kakek"], ["👵", "nine / babaanne", "ni-ne", "nenek"], ["👦", "oğul", "o-ul", "anak laki-laki"], ["👧", "kız", "kez", "anak perempuan"], ["🧔", "amca", "am-ja", "paman (saudara ayah)"], ["👩‍🦱", "teyze", "tei-ze", "bibi (saudara ibu)"], ["💍", "evli", "ev-li", "menikah"]]}, {"t": "grammar", "title": "Akhiran milik & var/yok", "head": ["Bentuk", "Contoh", "Arti"], "rows": [["-(i)m (milikku)", "anne<b>m</b>, baba<b>m</b>, kardeş<b>im</b>", "ibuku, ayahku, saudaraku"], ["-(i)n (milikmu)", "anne<b>n</b>, kardeş<b>in</b>", "ibumu, saudaramu"], ["… var", "İki kardeşim <b>var</b>.", "Saya punya dua saudara."], ["… yok", "Arabam <b>yok</b>.", "Saya tidak punya mobil."]], "after": "Bahasa Turki <b>tidak punya artikel dan jenis kelamin kata</b>. Kata <i>o</i> berarti dia (lk/pr) sekaligus itu."}, {"t": "ex", "kind": "choice", "instr": "Doğru cevabı seç.", "ans": "1. b · 2. a · 3. b · 4. b", "items": ["«annem» artinya ...|ibumu|ibuku|ibunya|ibu-ibu", "«İki kardeşim var» artinya ...|Saya punya dua saudara.|Saya tidak punya saudara.|Dua saudara saya pergi.|Saudara saya dua tahun.", "Kakak perempuan dalam bahasa Turki adalah ...|abi|abla|amca|anne", "«Arabam yok» artinya ...|Mobil saya bagus.|Saya tidak punya mobil.|Saya punya mobil.|Mobilnya di sini."]}]}, {"num": 5, "en": "Fiiller", "id": "Kata kerja sekarang (-iyor) & SOP", "emoji": "🏃", "goals": ["Membentuk kata kerja waktu sekarang dengan akhiran -iyor.", "Menyusun kalimat subjek–objek–predikat dan bentuk negatif."], "sections": [{"t": "grammar", "title": "Waktu sekarang: akar + (i/ı/u/ü)yor + orang", "head": ["Subjek", "gelmek (datang)", "konuşmak (berbicara)", "Negatif"], "rows": [["ben", "geliyorum", "konuşuyorum", "gel<b>m</b>iyorum"], ["sen", "geliyorsun", "konuşuyorsun", "gelmiyorsun"], ["o", "geliyor", "konuşuyor", "gelmiyor"], ["biz", "geliyoruz", "konuşuyoruz", "gelmiyoruz"], ["siz", "geliyorsunuz", "konuşuyorsunuz", "gelmiyorsunuz"], ["onlar", "geliyorlar", "konuşuyorlar", "gelmiyorlar"]], "after": "Urutan kalimat <b>S–O–P</b> (kata kerja di akhir): <i>Ben Türkçe öğreniyorum</i> = Saya belajar bahasa Turki. Kata tanya: <b>ne</b> (apa), <b>kim</b> (siapa), <b>nerede</b> (di mana), <b>ne zaman</b> (kapan), <b>nasıl</b> (bagaimana), <b>neden</b> (mengapa), <b>kaç</b> (berapa)."}, {"t": "ex", "kind": "choice", "instr": "Doğru cevabı seç.", "ans": "1. b · 2. b · 3. b · 4. b", "items": ["Ben Türkçe ___. (öğrenmek)|öğreniyorsun|öğreniyorum|öğreniyor|öğreniyoruz", "Biz çay ___. (içmek)|içiyorum|içiyoruz|içiyorlar|içiyorsun", "«Gelmiyorum» artinya ...|Saya datang.|Saya tidak datang.|Dia datang.|Kamu tidak datang.", "Kalimat yang urutannya benar adalah ...|Ben öğreniyorum Türkçe.|Ben Türkçe öğreniyorum.|Öğreniyorum ben Türkçe.|Türkçe ben öğreniyorum ben."]}, {"t": "ex", "kind": "order", "instr": "Susun menjadi kalimat (kata kerja di akhir).", "ans": "1. Ben çay içiyorum. · 2. Ahmet kitap okuyor. · 3. Biz Türkçe öğreniyoruz.", "items": ["çay / içiyorum. / Ben", "Ahmet / okuyor. / kitap", "Türkçe / Biz / öğreniyoruz."]}]}, {"num": 6, "en": "Lokantada", "id": "Di restoran", "emoji": "🥙", "goals": ["Memesan makanan dan meminta tagihan.", "Mengenal makanan khas Turki."], "sections": [{"t": "vocab", "title": "Yiyecek ve içecek", "cols": 4, "items": [["💧", "su", "su", "air"], ["🍵", "çay", "cai", "teh"], ["☕", "kahve", "kah-ve", "kopi"], ["🥛", "ayran", "ai-ran", "minuman yoghurt asin"], ["🍞", "ekmek", "ek-mek", "roti"], ["🍚", "pilav", "pi-lav", "nasi"], ["🍗", "tavuk", "ta-vuk", "ayam"], ["🐟", "balık", "ba-lek", "ikan"], ["🥩", "et", "et", "daging"], ["🍲", "çorba", "cor-ba", "sup"], ["🥙", "kebap", "ke-bap", "kebab"], ["🍯", "baklava", "bak-la-va", "baklava"]]}, {"t": "phrases", "title": "Lokantada", "items": [["Bir çay, lütfen.", "Satu teh.", "bir cai, lüt-fen"], ["Ne tavsiye edersiniz?", "Apa yang Anda rekomendasikan?", "ne tav-si-ye e-der-si-niz"], ["Hesap, lütfen!", "Minta tagihannya!", "he-sap, lüt-fen"], ["Afiyet olsun!", "Selamat makan!", "a-fi-yet ol-sun"], ["Çok lezzetli!", "Enak sekali!", "cok lez-zet-li"]]}, {"t": "note", "html": "Sebagian besar makanan di Turki <b>halal</b>, tetapi alkohol (<i>rakı, bira</i>) tetap dijual. Ungkapan berguna: <b>Domuz eti var mı?</b> (Ada daging babi?) · <b>Alkol içmiyorum.</b> (Saya tidak minum alkohol.)", "title": "🕌 Tips makan halal"}, {"t": "dialog", "title": "Lokantada", "lines": [["Garson", "🧑‍🍳", "Hoş geldiniz! Ne alırsınız?", "Selamat datang! Mau pesan apa?"], ["Rina", "🧕", "Bir mercimek çorbası ve bir tavuk kebap, lütfen.", "Satu sup lentil dan satu kebab ayam."], ["Garson", "🧑‍🍳", "İçecek olarak ne istersiniz?", "Untuk minumnya mau apa?"], ["Rina", "🧕", "Bir ayran, lütfen.", "Satu ayran."], ["Garson", "🧑‍🍳", "Tabii. Afiyet olsun!", "Baik. Selamat makan!"]]}, {"t": "ex", "kind": "choice", "instr": "Diyalog hakkında", "ans": "1. b · 2. b · 3. b", "items": ["Rina ne içiyor?|çay|ayran|kahve|su", "Rina hangi kebabı istiyor?|et kebap|tavuk kebap|balık kebap|döner", "«Hesap, lütfen!» artinya ...|Minta menunya!|Minta tagihannya!|Hitung sampai sepuluh!|Selamat makan!"]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Doğru cevabı seç.", "ans": "1. b · 2. b · 3. b · 4. b · 5. b", "items": ["Ben Endonezyalı___.|sın|yım|yiz|sunuz", "İki kardeşim ___.|yok|var|değil|bir", "Sen Türkçe ___. (konuşmak)|konuşuyorum|konuşuyorsun|konuşuyor|konuşuyoruz", "50 = ...|beş on|elli|on beş|yüz", "Huruf ş dibaca ...|s|sy|c|j"]}, {"t": "ex", "kind": "tf", "instr": "Doğru mu, yanlış mı?", "ans": "1. Doğru · 2. Yanlış · 3. Doğru", "items": ["Kalimat bahasa Turki biasanya diakhiri kata kerja.", "Bahasa Turki punya artikel seperti der/die/das.", "«kitap» berasal dari bahasa Arab."]}], "words": [{"e": "0️⃣", "w": "sıfır", "p": "se-fer", "m": "0", "u": 3}, {"e": "1️⃣", "w": "bir", "p": "bir", "m": "1", "u": 3}, {"e": "2️⃣", "w": "iki", "p": "i-ki", "m": "2", "u": 3}, {"e": "3️⃣", "w": "üç", "p": "üc", "m": "3", "u": 3}, {"e": "4️⃣", "w": "dört", "p": "dört", "m": "4", "u": 3}, {"e": "5️⃣", "w": "beş", "p": "besy", "m": "5", "u": 3}, {"e": "6️⃣", "w": "altı", "p": "al-te", "m": "6", "u": 3}, {"e": "7️⃣", "w": "yedi", "p": "ye-di", "m": "7", "u": 3}, {"e": "8️⃣", "w": "sekiz", "p": "se-kiz", "m": "8", "u": 3}, {"e": "9️⃣", "w": "dokuz", "p": "do-kuz", "m": "9", "u": 3}, {"e": "🔟", "w": "on", "p": "on", "m": "10", "u": 3}, {"e": "👩", "w": "anne", "p": "an-ne", "m": "ibu", "u": 4}, {"e": "👨", "w": "baba", "p": "ba-ba", "m": "ayah", "u": 4}, {"e": "👦", "w": "abi / ağabey", "p": "a-bi", "m": "kakak laki-laki", "u": 4}, {"e": "👧", "w": "abla", "p": "ab-la", "m": "kakak perempuan", "u": 4}, {"e": "🧒", "w": "kardeş", "p": "kar-desy", "m": "saudara, adik", "u": 4}, {"e": "👴", "w": "dede", "p": "de-de", "m": "kakek", "u": 4}, {"e": "👵", "w": "nine / babaanne", "p": "ni-ne", "m": "nenek", "u": 4}, {"e": "👦", "w": "oğul", "p": "o-ul", "m": "anak laki-laki", "u": 4}, {"e": "👧", "w": "kız", "p": "kez", "m": "anak perempuan", "u": 4}, {"e": "🧔", "w": "amca", "p": "am-ja", "m": "paman (saudara ayah)", "u": 4}, {"e": "👩‍🦱", "w": "teyze", "p": "tei-ze", "m": "bibi (saudara ibu)", "u": 4}, {"e": "💍", "w": "evli", "p": "ev-li", "m": "menikah", "u": 4}, {"e": "💧", "w": "su", "p": "su", "m": "air", "u": 6}, {"e": "🍵", "w": "çay", "p": "cai", "m": "teh", "u": 6}, {"e": "☕", "w": "kahve", "p": "kah-ve", "m": "kopi", "u": 6}, {"e": "🥛", "w": "ayran", "p": "ai-ran", "m": "minuman yoghurt asin", "u": 6}, {"e": "🍞", "w": "ekmek", "p": "ek-mek", "m": "roti", "u": 6}, {"e": "🍚", "w": "pilav", "p": "pi-lav", "m": "nasi", "u": 6}, {"e": "🍗", "w": "tavuk", "p": "ta-vuk", "m": "ayam", "u": 6}, {"e": "🐟", "w": "balık", "p": "ba-lek", "m": "ikan", "u": 6}, {"e": "🥩", "w": "et", "p": "et", "m": "daging", "u": 6}, {"e": "🍲", "w": "çorba", "p": "cor-ba", "m": "sup", "u": 6}, {"e": "🥙", "w": "kebap", "p": "ke-bap", "m": "kebab", "u": 6}, {"e": "🍯", "w": "baklava", "p": "bak-la-va", "m": "baklava", "u": 6}]}