{"id": "zh-hsk1", "kind": "lang", "lang": "zh", "grade": null, "level": "ujian", "tag": "HSK 1", "badge": ["HSK", "1"], "title": "Persiapan HSK 1", "sub": "Salam, angka, keluarga, makanan, tempat, cuaca", "c": "#E8590C", "c2": "#FFF0E6", "c3": "#A33B05", "emojis": "👋 🕒 👨‍👩‍👧 🍜 🚕 🌦️", "intro": "<div class=\"note\"><div class=\"note-h\">📌 HSK 1</div>Level pertama <b>Hanyu Shuiping Kaoshi</b>. Kosakatanya sekitar 150 kata. Soal terdiri atas <b>menyimak</b> dan <b>membaca</b>, dan semua soal dilengkapi pinyin.</div>", "cando": ["Menyapa, berterima kasih, dan meminta maaf.", "Menyebut angka, tanggal, hari, dan jam.", "Menyebut anggota keluarga.", "Memesan makanan dan minuman.", "Menyatakan lokasi dengan 在.", "Membicarakan cuaca dengan 很 dan 太…了."], "text": {"labels": {"learn": ["📚", "生词", "Kosakata"], "talk": ["🗣️", "会话", "Percakapan"], "read": ["📖", "阅读", "Membaca"], "practice": ["✏️", "练习", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "语法", "Tata Bahasa"], "write": ["📝", "Menulis", ""]}, "brand": "Persiapan HSK", "unit_word": "unit", "tip_prefix": "Tips:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Benar", "false": "Salah", "review_t": "模拟考试 · Simulasi", "review_s": "Soal campuran gaya HSK", "pron_note": "", "pron_html": ""}, "units": [{"num": 1, "en": "你好！", "id": "Salam dan perkenalan", "emoji": "👋", "goals": ["Menyapa, berterima kasih, dan meminta maaf.", "Memperkenalkan diri dengan 叫 dan 是."], "sections": [{"t": "vocab", "title": "Salam dan kata ganti", "cols": 4, "items": [["👋", "你好", "nǐ hǎo", "halo"], ["🙏", "谢谢", "xièxie", "terima kasih"], ["😊", "不客气", "bú kèqi", "sama-sama"], ["🙇", "对不起", "duìbuqǐ", "maaf"], ["👌", "没关系", "méi guānxi", "tidak apa-apa"], ["👋", "再见", "zàijiàn", "sampai jumpa"], ["🙋", "我", "wǒ", "saya"], ["👉", "你", "nǐ", "kamu"], ["👨", "他", "tā", "dia (lk)"], ["👩", "她", "tā", "dia (pr)"], ["🏷️", "名字", "míngzi", "nama"], ["📛", "叫", "jiào", "bernama"], ["🟰", "是", "shì", "adalah"], ["🧑‍🎓", "学生", "xuésheng", "pelajar"], ["👨‍🏫", "老师", "lǎoshī", "guru"], ["🇨🇳", "中国人", "Zhōngguó rén", "orang Tiongkok"]]}, {"t": "grammar", "title": "Pola kalimat", "head": ["Pola", "Contoh", "Arti"], "rows": [["A 是 B", "我是学生。", "Saya pelajar."], ["A 不是 B", "他不是老师。", "Dia bukan guru."], ["…吗？", "你是中国人吗？", "Apakah kamu orang Tiongkok?"], ["叫 + nama", "我叫王明。", "Nama saya Wang Ming."], ["什么", "你叫什么名字？", "Siapa namamu?"]], "after": "Partikel <b>吗</b> di akhir kalimat mengubah pernyataan menjadi pertanyaan ya/tidak. Kalimat yang memakai 什么 tidak perlu 吗."}, {"t": "dialog", "title": "认识你很高兴", "lines": [["王明", "👦", "你好！我叫王明。你叫什么名字？", "Nǐ hǎo! Wǒ jiào Wáng Míng. Nǐ jiào shénme míngzi?", "Halo! Saya Wang Ming. Siapa namamu?"], ["Sari", "👧", "你好！我叫Sari。我是印度尼西亚人。", "Nǐ hǎo! Wǒ jiào Sari. Wǒ shì Yìndùníxīyà rén.", "Halo! Saya Sari. Saya orang Indonesia."], ["王明", "👦", "你是学生吗？", "Nǐ shì xuésheng ma?", "Kamu pelajar?"], ["Sari", "👧", "是，我是学生。认识你很高兴！", "Shì, wǒ shì xuésheng. Rènshi nǐ hěn gāoxìng!", "Ya, saya pelajar. Senang berkenalan!"]]}, {"t": "ex", "kind": "choice", "instr": "选择正确答案。Pilih jawaban yang tepat.", "ans": "1. a · 2. b · 3. b · 4. a · 5. a", "items": ["谢谢！— ___|不客气。|对不起。|再见。|你好。", "对不起！— ___|谢谢。|没关系。|是。|叫。", "你叫___名字？|吗|什么|是|不", "他___老师。(bukan)|不是|是不|没是|不叫", "\"Apakah kamu pelajar?\"|你是学生吗？|你是学生什么？|你学生吗？|吗你是学生？"]}, {"t": "ex", "kind": "match", "instr": "Jodohkan.", "ans": "1–d · 2–c · 3–b · 4–e · 5–a", "left": ["老师", "名字", "再见", "学生", "没关系"], "right": ["tidak apa-apa", "sampai jumpa", "nama", "guru", "pelajar"]}]}, {"num": 2, "en": "数字和时间", "id": "Angka dan waktu", "emoji": "🕒", "goals": ["Menyebut angka, tanggal, hari, dan jam.", "Bertanya dengan 几."], "sections": [{"t": "vocab", "title": "Waktu", "cols": 3, "items": [["📅", "今天", "jīntiān", "hari ini"], ["⏭️", "明天", "míngtiān", "besok"], ["⏮️", "昨天", "zuótiān", "kemarin"], ["🗓️", "星期", "xīngqī", "minggu, hari (Senin dst.)"], ["📆", "号", "hào", "tanggal"], ["🌙", "月", "yuè", "bulan"], ["🎆", "年", "nián", "tahun"], ["⏰", "现在", "xiànzài", "sekarang"], ["🕐", "点", "diǎn", "jam (pukul)"], ["⏱️", "分钟", "fēnzhōng", "menit"], ["❓", "几", "jǐ", "berapa (kecil)"], ["🎂", "岁", "suì", "tahun (umur)"]]}, {"t": "grammar", "title": "Menyebut waktu", "head": ["Pola", "Contoh", "Arti"], "rows": [["… 年 … 月 … 号", "二〇二六年十月三号", "3 Oktober 2026"], ["星期 + angka", "星期一 … 星期六 · 星期天", "Senin … Sabtu · Minggu"], ["… 点 … 分", "八点十分 · 九点半", "8.10 · 9.30"], ["几 + kata bantu?", "现在几点？· 你几岁？", "Jam berapa? · Umurmu berapa?"]], "after": "Urutan waktu dalam bahasa Mandarin selalu dari besar ke kecil: tahun → bulan → tanggal → hari → jam."}, {"t": "dialog", "title": "现在几点？", "lines": [["Sari", "👧", "现在几点？", "Xiànzài jǐ diǎn?", "Sekarang jam berapa?"], ["王明", "👦", "现在七点半。", "Xiànzài qī diǎn bàn.", "Sekarang jam setengah delapan."], ["Sari", "👧", "今天星期几？", "Jīntiān xīngqī jǐ?", "Hari ini hari apa?"], ["王明", "👦", "今天星期五。明天星期六！", "Jīntiān xīngqīwǔ. Míngtiān xīngqīliù!", "Hari ini Jumat. Besok Sabtu!"]]}, {"t": "ex", "kind": "choice", "instr": "选择正确答案。", "ans": "1. c · 2. a · 3. b · 4. c · 5. a", "items": ["星期天 artinya ...|Senin|Sabtu|Minggu|Jumat", "9.30 = ...|九点半|九点三|半九点|三十点九", "你几岁？— 我十五___。|年|岁|号|点", "\"Besok\" =|昨天|今天|明天|现在", "十月三号 artinya ...|3 Oktober|10 Maret|13 Oktober|Oktober tahun 3"]}]}, {"num": 3, "en": "我的家", "id": "Keluarga", "emoji": "👨‍👩‍👧", "goals": ["Menyebut anggota keluarga.", "Memakai 有、没有, dan kata bantu bilangan 个."], "sections": [{"t": "vocab", "title": "Keluarga", "cols": 3, "items": [["👨", "爸爸", "bàba", "ayah"], ["👩", "妈妈", "māma", "ibu"], ["👦", "儿子", "érzi", "anak laki-laki"], ["👧", "女儿", "nǚ'ér", "anak perempuan"], ["🏠", "家", "jiā", "rumah, keluarga"], ["✅", "有", "yǒu", "punya, ada"], ["❌", "没有", "méiyǒu", "tidak punya"], ["1️⃣", "个", "gè", "kata bantu umum"], ["🐶", "狗", "gǒu", "anjing"], ["🐱", "猫", "māo", "kucing"], ["👫", "朋友", "péngyou", "teman"], ["🧑‍⚕️", "医生", "yīshēng", "dokter"]]}, {"t": "grammar", "title": "有 dan 没有", "head": ["Pola", "Contoh", "Arti"], "rows": [["A 有 + bilangan + 个 + B", "我有两个哥哥。", "Saya punya dua kakak laki-laki."], ["A 没有 B", "我没有猫。", "Saya tidak punya kucing."], ["…有几个…？", "你家有几个人？", "Keluargamu ada berapa orang?"], ["两 vs 二", "两个人 · 二月", "dua orang (dengan kata bantu) · Februari"]], "after": "Kata 有 diingkari dengan <b>没</b>, bukan 不. Bentuk ✗ 不有 salah."}, {"t": "reading", "title": "我的家", "paras": ["<div class=\"rtitle\">我的家</div>我家有四个人：爸爸、妈妈、妹妹和我。我爸爸是医生，我妈妈是老师。我妹妹八岁，她是学生。我们家有一只猫，没有狗。我很爱我的家！"], "gloss": [["妹妹", "adik perempuan"], ["和", "dan"], ["只", "kata bantu untuk hewan"], ["爱", "cinta"]]}, {"t": "ex", "kind": "choice", "instr": "根据短文回答。Jawab berdasarkan teks.", "ans": "1. b · 2. c · 3. b · 4. b", "items": ["Berapa orang di keluarga penulis?|三个|四个|五个|两个", "Apa pekerjaan ibunya?|医生|学生|老师|没有", "Hewan apa yang mereka punya?|一只狗|一只猫|两只猫|没有", "我___猫。 (tidak punya)|不有|没有|不是|没是"]}]}, {"num": 4, "en": "吃什么？", "id": "Makan, minum, dan belanja", "emoji": "🍜", "goals": ["Memesan makanan dan minuman.", "Menanyakan harga dengan 多少钱."], "sections": [{"t": "vocab", "title": "Makanan dan belanja", "cols": 3, "items": [["🍚", "米饭", "mǐfàn", "nasi"], ["🥬", "菜", "cài", "sayur, lauk"], ["🍎", "苹果", "píngguǒ", "apel"], ["🍇", "水果", "shuǐguǒ", "buah"], ["🍵", "茶", "chá", "teh"], ["💧", "水", "shuǐ", "air"], ["🍽️", "吃", "chī", "makan"], ["🥤", "喝", "hē", "minum"], ["💭", "想", "xiǎng", "ingin"], ["❤️", "喜欢", "xǐhuan", "suka"], ["🛒", "买", "mǎi", "membeli"], ["💰", "钱", "qián", "uang"], ["💴", "块", "kuài", "yuan (lisan)"], ["❓", "多少", "duōshao", "berapa (banyak)"]]}, {"t": "phrases", "title": "Ungkapan di restoran dan toko", "items": [["你想吃什么？", "Kamu ingin makan apa?", "Nǐ xiǎng chī shénme?"], ["我想喝茶。", "Saya ingin minum teh.", "Wǒ xiǎng hē chá."], ["苹果多少钱？", "Apel berapa harganya?", "Píngguǒ duōshao qián?"], ["十块。", "Sepuluh yuan.", "Shí kuài."], ["太贵了！", "Terlalu mahal!", "Tài guì le!"]]}, {"t": "ex", "kind": "choice", "instr": "选择正确答案。", "ans": "1. b · 2. b · 3. c · 4. a", "items": ["我想___茶。|吃|喝|买|看", "这个___钱？|几|多少|什么|哪", "我喜欢吃___。|水|茶|米饭|钱", "\"Terlalu mahal