{"id": "en-3", "lang": "en", "grade": 3, "level": "sd", "title": "Smart English!", "sub": "Belajar sambil bermain · Untuk siswa Kelas 3 SD", "c": "#1FA971", "c2": "#DDF5EA", "c3": "#7BD389", "emojis": "🏠 🍱 👕 ⏰ 🗓️ 🎨 🚲 🎂 ⚽ 🍜 🎤 🌻", "intro": "", "cando": ["Menceritakan rumah dan ruangan-ruangannya.", "Menawarkan makanan dan menyebut rasa.", "Menjelaskan pakaian yang dipakai seseorang.", "Menceritakan kegiatan sehari-hari secara berurutan.", "Menyebut bulan, tanggal ulang tahun, dan hobi."], "text": {"labels": {"learn": ["📚", "Let's Learn!", "Ayo Belajar"], "talk": ["🗣️", "Let's Talk!", "Ayo Berbicara"], "read": ["📖", "Let's Read!", "Ayo Membaca"], "practice": ["✏️", "Let's Practice!", "Ayo Berlatih"], "sing": ["🎵", "Let's Sing!", "Ayo Bernyanyi"], "play": ["🎲", "Let's Play!", "Ayo Bermain"], "grammar": ["🧩", "Let's Build Sentences!", "Ayo Menyusun Kalimat"], "write": ["📝", "Let's Write!", "Ayo Menulis"]}, "brand": "Fun English", "unit_word": "unit", "tip_prefix": "Kiko says:", "fun_h": "🌟 Fun Fact! <small>Tahukah kamu?</small>", "word_box": "Word Box:", "true": "True", "false": "False", "review_t": "Review Time!", "review_s": "Evaluasi — Ayo uji kemampuanmu!", "pron_note": "Tulisan di dalam garis miring, misalnya <b>apple</b> <span class=\"vp inl\">/é-pel/</span>, adalah <b>cara mengucapkan</b> kata itu. Bacalah seperti membaca tulisan bahasa Indonesia. Huruf <b>é</b> dibaca seperti “e” pada kata <i>“bebek”</i>, sedangkan <b>e</b> biasa dibaca seperti “e” pada kata <i>“emas”</i>. Tanda ini hanya bantuan — cara terbaik tetap <b>mendengarkan</b> guru, orang tua, lagu, atau video berbahasa Inggris. 🎧", "pron_html": null}, "units": [{"num": 1, "en": "My House", "id": "Rumahku", "emoji": "🏠", "goals": ["Menyebut ruangan dan benda di rumah.", "Menjawab <b>Where is …? — He/She is in the …</b>"], "sections": [{"t": "vocab", "title": "Rooms — Ruangan", "items": [["🛋️", "living room", "li-ving rum", "ruang tamu / keluarga"], ["🛏️", "bedroom", "bed-rum", "kamar tidur"], ["🍳", "kitchen", "ki-chen", "dapur"], ["🛁", "bathroom", "bath-rum", "kamar mandi"], ["🍽️", "dining room", "dai-ning rum", "ruang makan"], ["🚗", "garage", "ge-raj", "garasi"], ["🌷", "garden", "gar-den", "kebun / taman"], ["🏡", "yard", "yard", "halaman"]], "cols": 4, "label": "learn", "dict": true}, {"t": "vocab", "title": "Things at home — Benda di rumah", "items": [["🛏️", "bed", "bed", "tempat tidur"], ["🛋️", "sofa", "sou-fa", "sofa"], ["📺", "television / TV", "te-le-vi-shen / ti-vi", "televisi"], ["💡", "lamp", "lemp", "lampu"], ["🧊", "refrigerator / fridge", "frij", "kulkas"], ["🪞", "mirror", "mi-ror", "cermin"], ["🚿", "shower", "sya-wer", "pancuran"], ["🪴", "plant", "plent", "tanaman"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Where is…?", "head": ["Question", "Answer", "Arti"], "rows": [["Where is Mother?", "**She is in the** kitchen. 🍳", "Ibu ada di dapur."], ["Where is Father?", "**He is in the** garage. 🚗", "Ayah ada di garasi."], ["Where is the TV?", "**It is in the** living room. 📺", "TV ada di ruang keluarga."], ["Where are you?", "**I am in the** bedroom. 🛏️", "Aku ada di kamar tidur."]], "after": "<b>He</b> = dia (laki-laki) · <b>She</b> = dia (perempuan) · <b>It</b> = benda/hewan · <b>in the</b> = di dalam"}, {"t": "reading", "title": "My Lovely House 🏡", "paras": ["Hi, I am **Kiara**. This is my house. It is small but lovely.", "My house has a living room, two bedrooms, a kitchen, and a bathroom. There is a small garden in front of my house. It has many flowers. 🌸", "My favorite room is my bedroom. It is pink! There is a bed, a desk, and a lamp in my bedroom.", "In the evening, my family watches TV together in the living room. I love my house! ❤️"], "gloss": [["lovely", "indah / menyenangkan"], ["in front of", "di depan"], ["together", "bersama-sama"], ["desk", "meja belajar"]], "pic": "🏡"}, {"t": "ex", "kind": "choice", "instr": "Jawab pertanyaan tentang bacaan!", "ans": "1. b · 2. b · 3. a · 4. c", "items": ["How many bedrooms are in Kiara's house?|one|two|three", "What is in front of her house?|a garage|a garden|a kitchen", "What color is her bedroom?|pink|blue|white", "Where does the family watch TV?|in the kitchen|in the bedroom|in the living room"]}, {"t": "ex", "kind": "match", "instr": "Di ruangan mana? Pasangkan!", "ans": "1–c, 2–d, 3–a, 4–b", "left": ["🛁 take a bath", "🍳 cook", "😴 sleep", "🚗 park the car"], "right": ["bedroom", "garage", "bathroom", "kitchen"]}, {"t": "ex", "kind": "fill", "instr": "Lengkapi dengan <b>He, She,</b> atau <b>It</b>!", "ans": "1. She · 2. It · 3. He · 4. She", "items": ["Where is Grandma? ___ is in the garden.", "Where is the cat? ___ is on the sofa.", "Where is Uncle Joni? ___ is in the living room.", "Where is my sister? ___ is in the bathroom."]}, {"t": "ex", "kind": "draw", "instr": "Gambar denah kamarmu, lalu tulis nama bendanya dalam bahasa Inggris!", "ans": "Jawaban bebas.", "h": 150, "caps": ["In my bedroom, there is a ___ , a ___ , and a ___ ."]}]}, {"num": 2, "en": "Food and Drinks", "id": "Makanan dan Minuman", "emoji": "🍱", "goals": ["Menyebut makanan dan minuman.", "Menyatakan lapar/haus dan menawarkan makanan.", "Menyebut rasa makanan."], "sections": [{"t": "vocab", "title": "Food — Makanan", "items": [["🍚", "rice", "rais", "nasi"], ["🍞", "bread", "bred", "roti"], ["🍜", "noodles", "nu-dels", "mi"], ["🍳", "fried egg", "fraid eg", "telur ceplok"], ["🍗", "fried chicken", "fraid chi-ken", "ayam goreng"], ["🥣", "soup", "sup", "sup"], ["🍰", "cake", "keik", "kue"], ["🍪", "cookie", "ku-ki", "biskuit"], ["🥗", "salad", "sa-led", "salad"], ["🍢", "satay", "sa-tei", "sate"], ["🐟", "fish", "fish", "ikan"], ["🥦", "vegetables", "ve-je-te-bels", "sayuran"]], "cols": 4, "label": "learn", "dict": true}, {"t": "vocab", "title": "Drinks — Minuman", "items": [["🥛", "milk", "milk", "susu"], ["💧", "water", "wo-ter", "air"], ["🍵", "tea", "tii", "teh"], ["🧃", "juice", "juus", "jus"]], "cols": 4, "label": "learn", "dict": true}, {"t": "vocab", "title": "Tastes — Rasa", "items": [["🍬", "sweet", "swiit", "manis"], ["🧂", "salty", "sol-ti", "asin"], ["🍋", "sour", "sau-er", "asam"], ["🌶️", "spicy", "spai-si", "pedas"], ["☕", "bitter", "bi-ter", "pahit"], ["😋", "delicious", "di-li-shes", "lezat"]], "cols": 4, "label": "learn", "dict": true}, {"t": "dialog", "title": "I am hungry! — Aku lapar!", "lines": [["Dimas", "👦", "Mom, I am hungry. 😫", "Bu, aku lapar."], ["Mom", "👩", "Would you like some fried rice?", "Mau nasi goreng?"], ["Dimas", "👦", "Yes, please! And a glass of water, please. I am thirsty.", "Ya, mau! Dan segelas air, ya. Aku haus."], ["Mom", "👩", "Here you are.", "Ini dia."], ["Dimas", "👦", "Thank you, Mom. It's delicious! 😋", "Terima kasih, Bu. Enak sekali!"]]}, {"t": "grammar", "title": "Offering food — Menawarkan makanan", "head": ["English", "Arti"], "rows": [["**Would you like** some cake?", "Kamu mau kue?"], ["**Yes, please.** 👍", "Ya, mau. Terima kasih."], ["**No, thank you.** 🙅", "Tidak, terima kasih."], ["I am **hungry**. / I am **thirsty**.", "Aku lapar. / Aku haus."], ["**What is your favorite food?**", "Apa makanan kesukaanmu?"]], "after": null}, {"t": "note", "html": "Kata <b>a glass of</b> (segelas), <b>a cup of</b> (secangkir), <b>a bowl of</b> (semangkuk), dan <b>a plate of</b> (sepiring):<ul><li>a glass of <b>milk</b> 🥛 · a cup of <b>tea</b> 🍵</li><li>a bowl of <b>soup</b> 🥣 · a plate of <b>rice</b> 🍚</li></ul>", "title": "Ingat, ya!"}, {"t": "ex", "kind": "match", "instr": "Pasangkan makanan dengan rasanya!", "ans": "1–c, 2–d, 3–b, 4–a", "left": ["🍬 candy", "🍋 lemon", "🌶️ chili", "🧂 salt"], "right": ["salty", "spicy", "sweet", "sour"]}, {"t": "ex", "kind": "fill", "instr": "Lengkapi dengan kata yang tepat!", "ans": "1. thirsty · 2. hungry · 3. please · 4. bowl · 5. glass", "bank": ["glass", "bowl", "hungry", "thirsty", "please"], "items": ["I want to drink. I am ___ .", "I want to eat. I am ___ .", "Would you like some juice? — Yes, ___ .", "Can I have a ___ of soup?", "She drinks a ___ of milk every morning."]}, {"t": "ex", "kind": "table", "instr": "My healthy plate! Tulis makanan untuk sarapan, makan siang, dan makan malam.", "ans": "Jawaban bebas, contoh: breakfast – bread, milk.", "head": ["Meal", "Food 🍽️", "Drink 🥤"], "rows": ["breakfast (sarapan)| | ", "lunch (makan siang)| | ", "dinner (makan malam)| | "]}, {"t": "fun", "html": "Nasi goreng dan sate dari Indonesia termasuk makanan paling enak di dunia menurut banyak orang. Di luar negeri, namanya tetap “<b>nasi goreng</b>” dan “<b>satay</b>”! 🇮🇩"}]}, {"num": 3, "en": "Clothes", "id": "Pakaian", "emoji": "👕", "goals": ["Menyebut jenis pakaian.", "Menjelaskan pakaian seseorang: <b>She is wearing …</b>"], "sections": [{"t": "vocab", "title": "Clothes — Pakaian", "items": [["👕", "T-shirt", "ti-shert", "kaos"], ["👔", "shirt", "shert", "kemeja"], ["👖", "trousers / pants", "trau-sers / pents", "celana panjang"], ["🩳", "shorts", "shorts", "celana pendek"], ["👗", "dress", "dres", "gaun"], ["🩱", "swimsuit", "swim-suut", "baju renang"], ["🧥", "jacket", "je-ket", "jaket"], ["🧢", "cap", "kep", "topi (pet)"], ["👒", "hat", "het", "topi"], ["👟", "shoes", "syuus", "sepatu"], ["🧦", "socks", "soks", "kaus kaki"], ["🧣", "scarf", "skarf", "syal"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "What is she wearing?", "head": ["Question", "Answer"], "rows": [["What is Rina wearing? 👧", "She **is wearing** a pink dress."], ["What is Adi wearing? 👦", "He **is wearing** a blue T-shirt and shorts."], ["What are you wearing?", "I **am wearing** my school uniform. 🏫"]], "after": "<b>wear</b> = memakai. Urutannya: <b>warna + pakaian</b> → a <b>red</b> jacket, <b>black</b> shoes."}, {"t": "note", "html": "Beberapa pakaian selalu <b>jamak</b> (berpasangan), jadi pakai <b>are</b>/<b>they</b>: <i>trousers, shorts, shoes, socks</i>.<br>Contoh: My shoes <b>are</b> white. — Sepatuku putih.", "title": "Ingat, ya!"}, {"t": "reading", "title": "My School Uniform 🇮🇩", "paras": ["In Indonesia, elementary school students wear a uniform.", "On Monday, I wear a white shirt and red shorts. My sister wears a white shirt and a red skirt. We also wear a red tie, a belt, black shoes, and white socks.", "On Friday, some schools wear a batik uniform. On Saturday, I wear my scout uniform. It is brown. ⚜️"], "gloss": [["uniform", "seragam"], ["skirt", "rok"], ["tie", "dasi"], ["belt", "ikat pinggang"], ["scout", "pramuka"]], "pic": "🧑‍🎓"}, {"t": "ex", "kind": "tf", "instr": "Baca bacaan di atas. True atau False?", "ans": "1. True · 2. False (red skirt) · 3. True · 4. False (brown)", "items": ["The boy wears red shorts on Monday.", "The sister wears red trousers.", "They wear black shoes.", "The scout uniform is green."]}, {"t": "ex", "kind": "fill", "instr": "Apa yang mereka pakai? Lengkapi!", "ans": "1. dress · 2. cap · 3. trousers/pants · 4. jacket", "items": ["👧 She is wearing a yellow ___ . 👗", "👦 He is wearing a green ___ . 🧢", "🧒 He is wearing brown ___ . 👖", "It's cold! I am wearing a ___ . 🧥"]}, {"t": "ex", "kind": "circle", "instr": "Lingkari kata yang benar!", "ans": "1. raincoat (jas hujan) · 2. hat · 3. are", "items": ["It is raining. I wear a ((raincoat / swimsuit)).", "It is sunny at the beach. I wear a ((scarf / hat)).", "My shoes ((is / are)) new."]}, {"t": "ex", "kind": "draw", "instr": "Dress up! Gambar dirimu dengan baju favoritmu, lalu tulis kalimatnya.", "ans": "Jawaban bebas.", "h": 150, "caps": ["I am wearing a ___ ___ and ___ ___ ."]}]}, {"num": 4, "en": "My Daily Activities", "id": "Kegiatan Sehari-hariku", "emoji": "⏰", "goals": ["Menyebut kegiatan sehari-hari.", "Menceritakan kegiatan dengan urutan: <b>first, then, after that</b>."], "sections": [{"t": "vocab", "title": "Daily activities — Kegiatan harian", "items": [["⏰", "wake up", "weik ap", "bangun tidur"], ["🛁", "take a bath", "teik e bath", "mandi"], ["🪥", "brush my teeth", "brash mai tiith", "menggosok gigi"], ["👕", "get dressed", "get drest", "berpakaian"], ["🍳", "eat breakfast", "iit brek-fest", "sarapan"], ["🏫", "go to school", "gou tu skuul", "pergi ke sekolah"], ["📚", "study", "sta-di", "belajar"], ["⚽", "play", "plei", "bermain"], ["🏠", "go home", "gou houm", "pulang"], ["🤲", "pray", "prei", "berdoa / salat"], ["📝", "do homework", "du houm-werk", "mengerjakan PR"], ["😴", "go to bed / sleep", "gou tu bed / sliip", "tidur"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Telling my routine — Menceritakan rutinitas", "head": ["Kata urutan", "Contoh kalimat"], "rows": [["**First,** (pertama)", "First, I wake up at five o'clock."], ["**Then,** (lalu)", "Then, I take a bath and brush my teeth."], ["**After that,** (setelah itu)", "After that, I eat breakfast with my family."], ["**Finally,** (akhirnya)", "Finally, I go to school. 🏫"]], "after": null}, {"t": "reading", "title": "Beni's Morning 🌅", "paras": ["Beni wakes up early every day. First, he prays and makes his bed.", "Then, he takes a bath and brushes his teeth. After that, he wears his school uniform and eats breakfast. He eats bread and drinks milk.", "Finally, he says goodbye to his parents and goes to school by bicycle. 🚲"], "gloss": [["early", "pagi-pagi"], ["makes his bed", "merapikan tempat tidur"], ["parents", "orang tua"], ["by bicycle", "naik sepeda"]], "pic": "🚲"}, {"t": "note", "html": "Saat bercerita tentang <b>orang lain</b> (he/she), kata kerjanya ditambah <b>-s</b> atau <b>-es</b>:<ul><li>I wake up → Beni wake<b>s</b> up</li><li>I brush → he brush<b>es</b></li><li>I go → she go<b>es</b></li></ul>Kamu akan belajar lebih banyak tentang ini di kelas 5. 😉", "title": "Ingat, ya!"}, {"t": "ex", "kind": "order", "instr": "Urutkan kegiatan Beni! Tulis nomor 1–5 di kotak.", "ans": "1 wakes up · 2 takes a bath · 3 wears his uniform · 4 eats breakfast · 5 goes to school", "items": [], "after": "<div class=\"scr\" style=\"line-height:2.2\"><span>☐ eats breakfast</span><span>☐ wakes up</span><span>☐ goes to school</span><span>☐ takes a bath</span><span>☐ wears his uniform</span></div>"}, {"t": "ex", "kind": "match", "instr": "Pasangkan gambar dengan kegiatan!", "ans": "1–c, 2–e, 3–d, 4–a, 5–b", "left": ["🪥", "📝", "😴", "🛁", "🍳"], "right": ["take a bath", "eat breakfast", "brush my teeth", "go to bed", "do homework"]}, {"t": "ex", "kind": "write", "instr": "Ceritakan pagimu! Gunakan <b>First, Then, After that, Finally</b>.", "ans": "Jawaban bebas.", "items": ["First, I ___ .", "Then, I ___ .", "After that, I ___ .", "Finally, I ___ ."]}, {"t": "song", "title": "This Is the Way 🎶", "lines": ["This is the way we brush our teeth,", "Brush our teeth, brush our teeth,", "This is the way we brush our teeth,", "So early in the morning! 🪥", "(…wash our face… comb our hair… go to school…)"], "info": "Nada lagu tradisional <i>“Here We Go Round the Mulberry Bush”</i>. Peragakan gerakannya!"}]}, {"num": 5, "en": "Months of the Year", "id": "Nama-nama Bulan", "emoji": "🗓️", "goals": ["Menyebut 12 bulan secara berurutan.", "Bertanya dan menjawab tentang ulang tahun.", "Mengenal bilangan urutan (1st, 2nd, 3rd …)."], "sections": [{"t": "vocab", "title": "Months — Bulan", "items": [["🎆", "January", "jen-yu-e-ri", "Januari"], ["💝", "February", "feb-ru-e-ri", "Februari"], ["🌱", "March", "march", "Maret"], ["🌧️", "April", "ei-pril", "April"], ["🌼", "May", "mei", "Mei"], ["🏖️", "June", "juun", "Juni"], ["📚", "July", "ju-lai", "Juli"], ["🇮🇩", "August", "o-gast", "Agustus"], ["🍂", "September", "sep-tem-ber", "September"], ["🎃", "October", "ok-tou-ber", "Oktober"], ["☔", "November", "no-vem-ber", "November"], ["🎄", "December", "di-sem-ber", "Desember"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "When is your birthday?", "head": ["Question", "Answer"], "rows": [["When is your birthday? 🎂", "My birthday is **in** May."], ["When is Independence Day? 🇮🇩", "It is **on** August 17th."], ["What month is it now?", "It is September."]], "after": "<b>in</b> + bulan → <i>in May</i> · <b>on</b> + tanggal → <i>on May 5th</i>. Nama bulan selalu diawali <b>huruf kapital</b>."}, {"t": "phrases", "title": "Ordinal numbers — Bilangan urutan", "items": [["1st — **first** /ferst/", "ke-1 / pertama"], ["2nd — **second** /se-kend/", "ke-2 / kedua"], ["3rd — **third** /therd/", "ke-3 / ketiga"], ["4th — **fourth** /forth/", "ke-4"], ["5th — **fifth** /fifth/", "ke-5"], ["10th — **tenth** /tenth/", "ke-10"], ["17th — **seventeenth**", "ke-17"], ["21st — **twenty-first**", "ke-21"], ["31st — **thirty-first**", "ke-31"]], "label": "learn"}, {"t": "dialog", "title": "Birthday party invitation 🎉", "lines": [["Lina", "👧", "Andi, when is your birthday?", "Andi, kapan ulang tahunmu?"], ["Andi", "👦", "My birthday is on October 2nd. And yours?", "Ulang tahunku tanggal 2 Oktober. Kalau kamu?"], ["Lina", "👧", "My birthday is in March. It's on March 21st.", "Ulang tahunku bulan Maret, tanggal 21."], ["Andi", "👦", "Happy early birthday, Lina! 🎂", "Selamat ulang tahun lebih awal, Lina!"]]}, {"t": "song", "title": "The Months Song 🎶", "lines": ["January, February, March and April,", "May and June and July,", "August, September, October, November,", "December — then say goodbye! 👋"], "info": "Nyanyikan dengan cepat, lalu lebih cepat lagi!"}, {"t": "ex", "kind": "fill", "instr": "Tulis bulan yang hilang!", "ans": "1. February · 2. June · 3. September · 4. December", "items": ["January → ___ → March", "May → ___ → July", "___ → October → November", "November → ___ → January"]}, {"t": "ex", "kind": "choice", "instr": "Pilih jawaban yang benar!", "ans": "1. b · 2. a · 3. c · 4. b", "items": ["Indonesia's Independence Day is in …|June|August|April", "The first month of the year is …|January|December|March", "My birthday is ___ July.|on|at|in", "The 12th month is …|November|December|October"]}, {"t": "ex", "kind": "table", "instr": "Birthday survey! Tanyakan 4 temanmu: “When is your birthday?”", "ans": "Jawaban bebas.", "head": ["Name", "Birthday (month)", "Date"], "rows": [" | | ", " | | ", " | | ", " | | "]}, {"t": "fun", "html": "Tanggal <b>21 April</b> kita memperingati Hari Kartini, dan tanggal <b>2 Mei</b> adalah Hari Pendidikan Nasional. Dalam bahasa Inggris: <i>Kartini Day is on April 21st.</i>"}]}, {"num": 6, "en": "My Hobbies", "id": "Hobiku", "emoji": "🎨", "goals": ["Menyebut macam-macam hobi.", "Bertanya dan menjawab <b>What is your hobby?</b>", "Menyatakan kemampuan dengan <b>can / can't</b>."], "sections": [{"t": "vocab", "title": "Hobbies — Hobi", "items": [["📚", "reading", "rii-ding", "membaca"], ["🎨", "drawing", "dro-ing", "menggambar"], ["🎤", "singing", "sing-ing", "bernyanyi"], ["💃", "dancing", "den-sing", "menari"], ["🏊", "swimming", "swim-ing", "berenang"], ["🚴", "cycling", "sai-kling", "bersepeda"], ["⚽", "playing football", "plei-ing fut-bol", "bermain sepak bola"], ["🍳", "cooking", "ku-king", "memasak"], ["🌱", "gardening", "gar-de-ning", "berkebun"], ["🎣", "fishing", "fi-shing", "memancing"], ["🏸", "playing badminton", "plei-ing bed-min-ton", "bermain bulu tangkis"], ["🎸", "playing the guitar", "plei-ing de gi-tar", "bermain gitar"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Talking about hobbies", "head": ["English", "Arti"], "rows": [["What is your hobby?", "Apa hobimu?"], ["My hobby is **drawing**. 🎨", "Hobiku menggambar."], ["I like **swimming**. 🏊", "Aku suka berenang."], ["I **can** ride a bicycle. ✅", "Aku **bisa** naik sepeda."], ["I **can't** swim. ❌", "Aku **tidak bisa** berenang."], ["**Can** you dance? — Yes, I can. / No, I can't.", "Bisakah kamu menari?"]], "after": "Setelah <b>like</b> dan <b>My hobby is</b>, kata kerja ditambah <b>-ing</b>: read → read<b>ing</b>, swim → swim<b>ming</b>, dance → danc<b>ing</b>."}, {"t": "dialog", "title": "Let's play together! — Ayo main bersama!", "lines": [["Raka", "👦", "What is your hobby, Salsa?", "Apa hobimu, Salsa?"], ["Salsa", "👧", "My hobby is playing badminton. And you?", "Hobiku bermain bulu tangkis. Kalau kamu?"], ["Raka", "👦", "I like playing football. Can you play football?", "Aku suka bermain sepak bola. Kamu bisa main sepak bola?"], ["Salsa", "👧", "Yes, I can! Let's play together this afternoon!", "Ya, bisa! Ayo main bersama sore ini!"], ["Raka", "👦", "Great idea! 👍", "Ide bagus!"]]}, {"t": "reading", "title": "Meet My Friends 👫", "paras": ["I have three best friends. **Nia** likes reading. She reads a book every day. 📚", "**Joko** likes cycling. He can ride a bicycle very fast! 🚴 **Putri** likes singing and dancing. She can sing very well. 🎤", "And me? My hobby is drawing. I can draw animals and flowers. What about you? 🎨"], "gloss": [["every day", "setiap hari"], ["very fast", "sangat cepat"], ["very well", "sangat baik"]], "pic": "👫"}, {"t": "ex", "kind": "match", "instr": "Siapa hobinya apa? Pasangkan sesuai bacaan!", "ans": "1–c, 2–d, 3–a, 4–b", "left": ["Nia", "Joko", "Putri", "The writer (penulis)"], "right": ["singing and dancing", "drawing", "reading", "cycling"]}, {"t": "ex", "kind": "fill", "instr": "Tambahkan <b>-ing</b>!", "ans": "1. reading · 2. singing · 3. cooking · 4. dancing · 5. swimming", "items": ["read → ___", "sing → ___", "cook → ___", "dance → ___", "swim → ___"]}, {"t": "ex", "kind": "table", "instr": "What can you do? Beri tanda ✓ untuk <b>I can</b> dan ✗ untuk <b>I can't</b>.", "ans": "Jawaban bebas.", "head": ["Activity", "Me", "My friend: ______"], "rows": ["🏊 swim| | ", "🚴 ride a bicycle| | ", "🍳 cook noodles| | ", "🎤 sing an English song| | "]}, {"t": "ex", "kind": "write", "instr": "Tulis tentang hobimu!", "ans": "Jawaban bebas.", "items": ["My hobby is ___ .", "I can ___ , but I can't ___ ."]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Pilih jawaban yang benar!", "ans": "1. b · 2. c · 3. b · 4. b · 5. a · 6. a · 7. a · 8. b", "items": ["We cook in the …|bedroom|kitchen|garage", "Where is Father? — ___ is in the garden.|She|It|He", "I want to drink. I am …|hungry|thirsty|sleepy", "Lemon tastes …|sweet|sour|salty", "It is cold. I wear a …|jacket|swimsuit|shorts", "After I wake up, I … 🪥|brush my teeth|go to bed|go ho