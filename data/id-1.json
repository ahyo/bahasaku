{"id": "id-1", "kind": "lang", "lang": "id", "grade": null, "level": "umum", "tag": "BIPA 1", "badge": ["BIPA", "1"], "title": "Bahasa Indonesia for Foreigners", "sub": "BIPA 1 · greetings, numbers, food, directions, daily life", "c": "#E03131", "c2": "#FDECEC", "c3": "#9B1C1C", "emojis": "👋 🪪 🛍️ 🍛 🛵 ⏰", "intro": "<div class=\"note\"><div class=\"note-h\">📌 BIPA (Bahasa Indonesia bagi Penutur Asing)</div>Explanations are in <b>English</b>, so you can share this course with foreign friends, exchange students, or expat colleagues. Indonesian uses the Latin alphabet, has no verb tenses or grammatical gender, and is pronounced just as it is written.</div>", "cando": ["Greet people at different times of the day.", "Introduce yourself: name, country, job, and where you live.", "Count from 1 to 1,000,000.", "Order food and drinks at a warung or restaurant.", "Ask for and give simple directions.", "Tell the time and talk about daily activities."], "text": {"labels": {"learn": ["📚", "Kosakata", "Vocabulary"], "talk": ["🗣️", "Percakapan", "Conversation"], "read": ["📖", "Membaca", "Reading"], "practice": ["✏️", "Latihan", "Practice"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Tata Bahasa", "Grammar"], "write": ["📝", "Menulis", ""]}, "brand": "BIPA", "unit_word": "unit", "tip_prefix": "Tip:", "fun_h": "🌟 Did you know?", "word_box": "Kotak Kata:", "true": "True", "false": "False", "review_t": "Final Review", "review_s": "Check your progress", "pron_note": "", "pron_html": ""}, "units": [{"num": 1, "en": "Salam", "id": "Greetings", "emoji": "👋", "goals": ["Greet people at different times of the day.", "Say thank you, sorry, and goodbye politely."], "sections": [{"t": "vocab", "title": "Greetings", "cols": 3, "items": [["🌅", "selamat pagi", "", "good morning (until ±11:00)"], ["☀️", "selamat siang", "", "good day (±11:00–15:00)"], ["🌇", "selamat sore", "", "good afternoon (±15:00–18:00)"], ["🌙", "selamat malam", "", "good evening / night"], ["🙂", "apa kabar?", "", "how are you?"], ["👍", "baik", "", "fine, good"], ["🙏", "terima kasih", "", "thank you"], ["😊", "sama-sama", "", "you're welcome"], ["🙇", "maaf", "", "sorry"], ["✋", "permisi", "", "excuse me"], ["👋", "sampai jumpa", "", "see you"], ["🛣️", "selamat jalan", "", "goodbye (to someone leaving)"]]}, {"t": "dialog", "title": "Di kampus", "lines": [["Emma", "👩", "Selamat pagi, Pak!", "Good morning, Sir!"], ["Pak Budi", "👨‍🏫", "Selamat pagi! Apa kabar?", "Good morning! How are you?"], ["Emma", "👩", "Baik, terima kasih. Bapak apa kabar?", "Fine, thank you. How are you, Sir?"], ["Pak Budi", "👨‍🏫", "Baik juga. Sampai jumpa di kelas!", "I'm fine too. See you in class!"]]}, {"t": "note", "html": "Indonesians address adults politely with <b>Bapak/Pak</b> (Mr./Sir) and <b>Ibu/Bu</b> (Mrs./Madam), even when they are strangers. Young people are called <b>Mas</b> (young man) or <b>Mbak</b> (young woman), especially in Java.", "title": "Polite address"}, {"t": "ex", "kind": "choice", "instr": "Choose the right expression.", "ans": "1. b · 2. c · 3. a · 4. b", "items": ["It is 8 a.m. You meet your teacher. You say ...|Selamat malam|Selamat pagi|Selamat sore|Selamat jalan", "Someone says \"Terima kasih\". You answer ...|Maaf|Permisi|Sama-sama|Apa kabar", "You want to pass through a crowd. You say ...|Permisi|Sama-sama|Selamat siang|Baik", "It is 7 p.m. You greet a friend ...|Selamat sore|Selamat malam|Selamat pagi|Selamat siang"]}, {"t": "ex", "kind": "match", "instr": "Match.", "ans": "1–b · 2–a · 3–d · 4–e · 5–c", "left": ["terima kasih", "maaf", "sampai jumpa", "baik", "permisi"], "right": ["sorry", "thank you", "excuse me", "see you", "fine"]}]}, {"num": 2, "en": "Perkenalan", "id": "Introducing yourself", "emoji": "🪪", "goals": ["Introduce yourself: name, country, job, and where you live.", "Use personal pronouns, including kami vs. kita."], "sections": [{"t": "grammar", "title": "Personal pronouns", "head": ["Indonesian", "English", "Note"], "rows": [["saya / aku", "I", "saya = polite, aku = casual"], ["Anda / kamu", "you", "Anda = formal, kamu = casual"], ["dia / beliau", "he, she", "beliau = respectful"], ["kami", "we (not including the listener)", "Kami dari Australia. (we, not you)"], ["kita", "we (including the listener)", "Ayo kita makan! (you and I)"], ["mereka", "they", ""]], "after": "Indonesian has no gender in pronouns and verbs do not change: <b>saya makan, dia makan, mereka makan</b>."}, {"t": "phrases", "title": "Useful sentences", "items": [["Nama saya Emma.", "My name is Emma."], ["Saya dari Australia.", "I am from Australia."], ["Saya tinggal di Yogyakarta.", "I live in Yogyakarta."], ["Saya mahasiswa.", "I am a university student."], ["Siapa nama Anda?", "What is your name?"], ["Anda dari mana?", "Where are you from?"], ["Senang berkenalan dengan Anda.", "Nice to meet you."]]}, {"t": "vocab", "title": "Jobs & countries", "cols": 3, "items": [["🧑‍🎓", "mahasiswa", "", "university student"], ["👨‍🏫", "guru", "", "teacher"], ["🧑‍⚕️", "dokter", "", "doctor"], ["💼", "karyawan", "", "employee"], ["🧳", "turis", "", "tourist"], ["🌏", "negara", "", "country"], ["🏙️", "kota", "", "city"], ["🏠", "tinggal", "", "to live, to stay"]]}, {"t": "ex", "kind": "choice", "instr": "Choose the right word.", "ans": "1. b · 2. b · 3. a · 4. b", "items": ["Your friend and you will eat together. \"Ayo ___ makan!\"|kami|kita|mereka|Anda", "You tell a waiter: \"___ dari Jepang.\" (my friends and I)|Kita|Kami|Dia|Mereka", "\"Where are you from?\"|Anda dari mana?|Siapa nama Anda?|Anda tinggal di sini?|Apa kabar?", "Polite \"you\" to an older stranger:|kamu|Anda / Bapak / Ibu|aku|dia"]}, {"t": "ex", "kind": "fill", "instr": "Complete the sentences.", "ans": "1. saya · 2. tinggal · 3. berkenalan", "items": ["Nama ___ Kenji. (my)", "Saya ___ di Bandung. (live)", "Senang ___ dengan Anda."]}]}, {"num": 3, "en": "Angka dan Belanja", "id": "Numbers and shopping", "emoji": "🛍️", "goals": ["Count from 1 to 1,000,000.", "Ask for prices and bargain at a traditional market."], "sections": [{"t": "vocab", "title": "Numbers", "cols": 4, "items": [["1️⃣", "satu", "", "one"], ["2️⃣", "dua", "", "two"], ["3️⃣", "tiga", "", "three"], ["4️⃣", "empat", "", "four"], ["5️⃣", "lima", "", "five"], ["6️⃣", "enam", "", "six"], ["7️⃣", "tujuh", "", "seven"], ["8️⃣", "delapan", "", "eight"], ["9️⃣", "sembilan", "", "nine"], ["🔟", "sepuluh", "", "ten"], ["💯", "seratus", "", "one hundred"], ["💴", "seribu", "", "one thousand"]]}, {"t": "grammar", "title": "Building numbers", "head": ["Rule", "Example", "Number"], "rows": [["11–19: + belas", "sebelas · dua belas · lima belas", "11 · 12 · 15"], ["tens: + puluh", "dua puluh · tiga puluh lima", "20 · 35"], ["hundreds: + ratus", "seratus · dua ratus lima puluh", "100 · 250"], ["thousands: + ribu", "seribu · lima puluh ribu", "1,000 · 50,000"], ["millions: + juta", "satu juta · dua juta", "1,000,000 · 2,000,000"]], "after": "<b>se-</b> means \"one\": sebelas, seratus, seribu. Prices: <b>Rp 25.000</b> = dua puluh lima ribu rupiah. Indonesians use dots, not commas, for thousands."}, {"t": "dialog", "title": "Di pasar", "lines": [["Emma", "👩", "Bu, berapa harga mangga ini?", "Ma'am, how much are these mangoes?"], ["Penjual", "🧕", "Dua puluh ribu sekilo, Mbak.", "Twenty thousand per kilo, Miss."], ["Emma", "👩", "Wah, mahal. Boleh kurang? Lima belas ribu, ya?", "Wow, expensive. Can you lower it? Fifteen thousand, okay?"], ["Penjual", "🧕", "Delapan belas ribu saja, Mbak.", "Just eighteen thousand, Miss."], ["Emma", "👩", "Oke, saya beli dua kilo.", "Okay, I'll buy two kilos."]]}, {"t": "ex", "kind": "choice", "instr": "Choose the right answer.", "ans": "1. b · 2. a · 3. a · 4. b", "items": ["75 =|tujuh lima|tujuh puluh lima|tujuh belas lima|lima puluh tujuh", "Rp 150.000 =|seratus lima puluh ribu|lima belas ribu|satu juta lima|seratus lima ribu", "\"How much is this?\"|Berapa harganya?|Di mana ini?|Apa ini?|Boleh kurang?", "\"Boleh kurang?\" means ...|Is it free?|Can you lower the price?|Do you have more?|Is it fresh?"]}]}, {"num": 4, "en": "Makanan", "id": "Food and ordering", "emoji": "🍛", "goals": ["Order food and drinks at a warung or restaurant.", "Describe taste: pedas, manis, asin, enak."], "sections": [{"t": "vocab", "title": "Food & taste", "cols": 3, "items": [["🍳", "nasi goreng", "", "fried rice"], ["🍢", "sate", "", "satay (grilled skewers)"], ["🍲", "bakso", "", "meatball soup"], ["🥗", "gado-gado", "", "vegetables with peanut sauce"], ["🍵", "teh manis", "", "sweet tea"], ["🥥", "es kelapa", "", "iced coconut drink"], ["🌶️", "pedas", "", "spicy"], ["🍬", "manis", "", "sweet"], ["🧂", "asin", "", "salty"], ["😋", "enak", "", "delicious"], ["🍽️", "makan", "", "to eat"], ["🥤", "minum", "", "to drink"]]}, {"t": "phrases", "title": "At a warung", "items": [["Saya mau pesan nasi goreng.", "I'd like to order fried rice."], ["Tidak pakai cabai, ya.", "No chili, please."], ["Pedasnya sedang saja.", "Medium spicy, please."], ["Minumnya apa?", "What would you like to drink?"], ["Bungkus atau makan di sini?", "Take away or eat here?"], ["Minta bonnya, ya.", "The bill, please."]]}, {"t": "ex", "kind": "choice", "instr": "Choose the right answer.", "ans": "1. b · 2. b · 3. a · 4. b", "items": ["You don't want it spicy. You say ...|Pedas sekali, ya.|Tidak pakai cabai, ya.|Minta bonnya.|Bungkus, ya.", "\"Bungkus\" means ...|eat here|take away|very spicy|pay now", "Gado-gado is served with ...|peanut sauce|coconut milk|soy milk|cheese", "\"Enak sekali!\" means ...|Very spicy!|Very delicious!|Very expensive!|Very sweet!"]}, {"t": "fun", "html": "<b>Warung</b> are small family-run eateries found on almost every street. Many Indonesians eat with their right hand, and the word <b>\"pedas\"</b> at a warung often means much hotter than you expect!"}]}, {"num": 5, "en": "Arah dan Transportasi", "id": "Directions and transport", "emoji": "🛵", "goals": ["Ask for and give simple directions.", "Use public transport: ojek, angkot, bus, kereta."], "sections": [{"t": "vocab", "title": "Directions & transport", "cols": 3, "items": [["⬅️", "kiri", "", "left"], ["➡️", "kanan", "", "right"], ["⬆️", "lurus", "", "straight"], ["↪️", "belok", "", "to turn"], ["📍", "di mana", "", "where (location)"], ["🚶", "jalan kaki", "", "on foot"], ["🛵", "ojek", "", "motorcycle taxi"], ["🚐", "angkot", "", "minibus (city transport)"], ["🚆", "kereta", "", "train"], ["🚏", "halte", "", "bus stop"], ["🗺️", "jauh", "", "far"], ["📌", "dekat", "", "near"]]}, {"t": "grammar", "title": "Prepositions of place", "head": ["Indonesian", "English", "Example"], "rows": [["di", "at, in, on", "Saya di hotel."], ["ke", "to", "Saya mau ke stasiun."], ["dari", "from", "Dia dari bandara."], ["di depan / di belakang", "in front of / behind", "Bank di depan masjid."], ["di sebelah", "next to", "Kafe di sebelah toko buku."]]}, {"t": "dialog", "title": "Bertanya arah", "lines": [["Kenji", "👨", "Permisi, Mas. Stasiun di mana, ya?", "Excuse me. Where is the station?"], ["Mas Andi", "🧑", "Lurus saja, lalu belok kiri di lampu merah.", "Go straight, then turn left at the traffic light."], ["Kenji", "👨", "Jauh, tidak?", "Is it far?"], ["Mas Andi", "🧑", "Tidak, dekat. Jalan kaki lima menit.", "No, it's near. Five minutes on foot."]]}, {"t": "ex", "kind": "choice", "instr": "Choose the right answer.", "ans": "1. b · 2. b · 3. b · 4. b", "items": ["\"Belok kanan\" means ...|turn left|turn right|go straight|stop", "Saya mau ___ Bali. (to)|di|ke|dari|pada", "A motorcycle taxi is called ...|angkot|ojek|kereta|halte", "\"Kafe di sebelah toko buku\" means the café is ___ the bookshop.|behind|next to|in front of|far from"]}]}, {"num": 6, "en": "Kegiatan Sehari-hari", "id": "Daily routine and time", "emoji": "⏰", "goals": ["Tell the time and talk about daily activities.", "Use time markers: sudah, belum, sedang, akan."], "sections": [{"t": "grammar", "title": "Telling the time", "head": ["Indonesian", "Time"], "rows": [["jam tujuh", "7:00"], ["jam tujuh lewat seperempat", "7:15"], ["jam setengah delapan", "7:30 (half to eight!)"], ["jam delapan kurang seperempat", "7:45"], ["jam sembilan pagi / malam", "9 a.m. / 9 p.m."]], "after": "Careful: <b>setengah delapan</b> means 7:30 (half <i>to</i> eight), not 8:30."}, {"t": "grammar", "title": "Time markers (no verb change!)", "head": ["Marker", "Meaning", "Example"], "rows": [["sudah", "already (done)", "Saya sudah makan."], ["belum", "not yet", "Saya belum mandi."], ["sedang", "in progress (-ing)", "Dia sedang belajar."], ["akan", "will", "Kami akan pergi besok."]]}, {"t": "vocab", "title": "Daily activities", "cols": 3, "items": [["⏰", "bangun", "", "to wake up"], ["🚿", "mandi", "", "to bathe, shower"], ["💼", "bekerja", "", "to work"], ["📖", "belajar", "", "to study"], ["🏠", "pulang", "", "to go home"], ["😴", "tidur", "", "to sleep"], ["📅", "hari ini", "", "today"], ["⏭️", "besok", "", "tomorrow"], ["⏮️", "kemarin", "", "yesterday"]]}, {"t": "ex", "kind": "choice", "instr": "Choose the right answer.", "ans": "1. b · 2. b · 3. b · 4. c", "items": ["7:30 =|jam setengah tujuh|jam setengah delapan|jam tujuh tiga puluh lewat|jam delapan setengah", "\"Have you eaten?\" — \"Not yet.\"|Sudah.|Belum.|Sedang.|Akan.", "Dia ___ tidur. Jangan berisik! (in progress)|sudah|sedang|akan|belum", "\"Besok\" means ...|yesterday|today|tomorrow|now"]}, {"t": "tip", "html": "<b>\"Sudah makan?\"</b> (Have you eaten?) is a friendly greeting in Indonesia, not an invitation. A simple <i>\"Sudah, terima kasih\"</i> is a fine answer."}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Final review.", "ans": "1. b · 2. b · 3. b · 4. a · 5. c · 6. a", "items": ["Good evening (8 p.m.):|Selamat sore|Selamat malam|Selamat siang|Selamat pagi", "We (you and I) =|kami|kita|mereka|Anda", "Rp 45.000 =|empat lima ribu|empat puluh lima ribu|empat belas lima ribu|empat ratus lima puluh", "\"Can you lower the price?\"|Boleh kurang?|Berapa harganya?|Bungkus, ya?|Di mana?", "\"Turn left\" =|belok kanan|lurus|belok kiri|di depan", "8:30 =|jam setengah sembilan|jam setengah delapan|jam delapan setengah|jam sembilan kurang"]}, {"t": "ex", "kind": "tf", "instr": "True or False?", "ans": "1. False · 2. True · 3. False", "items": ["Indonesian verbs change with the subject (saya makan, dia makans).", "\"Bapak\" is a polite way to address an older man.", "\"Belum\" means \"already\"."]}], "words": [{"e": "🌅", "w": "selamat pagi", "p": "", "m": "good morning (until ±11:00)", "u": 1}, {"e": "☀️", "w": "selamat siang", "p": "", "m": "good day (±11:00–15:00)", "u": 1}, {"e": "🌇", "w": "selamat sore", "p": "", "m": "good afternoon (±15:00–18:00)", "u": 1}, {"e": "🌙", "w": "selamat malam", "p": "", "m": "good evening / night", "u": 1}, {"e": "🙂", "w": "apa kabar?", "p": "", "m": "how are you?", "u": 1}, {"e": "👍", "w": "baik", "p": "", "m": "fine, good", "u": 1}, {"e": "🙏", "w": "terima kasih", "p": "", "m": "thank you", "u": 1}, {"e": "😊", "w": "sama-sama", "p": "", "m": "you're welcome", "u": 1}, {"e": "🙇", "w": "maaf", "p": "", "m": "sorry", "u": 1}, {"e": "✋", "w": "permisi", "p": "", "m": "excuse me", "u": 1}, {"e": "👋", "w": "sampai jumpa", "p": "", "m": "see you", "u": 1}, {"e": "🛣️", "w": "selamat jalan", "p": "", "m": "goodbye (to someone leaving)", "u": 1}, {"e": "🧑‍🎓", "w": "mahasiswa", "p": "", "m": "university student", "u": 2}, {"e": "👨‍🏫", "w": "guru", "p": "", "m": "teacher", "u": 2}, {"e": "🧑‍⚕️", "w": "dokter", "p": "", "m": "doctor", "u": 2}, {"e": "💼", "w": "karyawan", "p": "", "m": "employee", "u": 2}, {"e": "🧳", "w": "turis", "p": "", "m": "tourist", "u": 2}, {"e": "🌏", "w": "negara", "p": "", "m": "country", "u": 2}, {"e": "🏙️", "w": "kota", "p": "", "m": "city", "u": 2}, {"e": "🏠", "w": "tinggal", "p": "", "m": "to live, to stay", "u": 2}, {"e": "1️⃣", "w": "satu", "p": "", "m": "one", "u": 3}, {"e": "2️⃣", "w": "dua", "p": "", "m": "two", "u": 3}, {"e": "3️⃣", "w": "tiga", "p": "", "m": "three", "u": 3}, {"e": "4️⃣", "w": "empat", "p": "", "m": "four", "u": 3}, {"e": "5️⃣", "w": "lima", "p": "", "m": "five", "u": 3}, {"e": "6️⃣", "w": "enam", "p": "", "m": "six", "u": 3}, {"e": "7️⃣", "w": "tujuh", "p": "", "m": "seven", "u": 3}, {"e": "8️⃣", "w": "delapan", "p": "", "m": "eight", "u": 3}, {"e": "9️⃣", "w": "sembilan", "p": "", "m": "nine", "u": 3}, {"e": "🔟", "w": "sepuluh", "p": "", "m": "ten", "u": 3}, {"e": "💯", "w": "seratus", "p": "", "m": "one hundred", "u": 3}, {"e": "💴", "w": "seribu", "p": "", "m": "one thousand", "u": 3}, {"e": "🍳", "w": "nasi goreng", "p": "", "m": "fried rice", "u": 4}, {"e": "🍢", "w": "sate", "p": "", "m": "satay (grilled skewers)", "u": 4}, {"e": "🍲", "w": "bakso", "p": "", "m": "meatball soup", "u": 4}, {"e": "🥗", "w": "gado-gado", "p": "", "m": "vegetables with peanut sauce", "u": 4}, {"e": "🍵", "w": "teh manis", "p": "", "m": "sweet tea", "u": 4}, {"e": "🥥", "w": "es kelapa", "p": "", "m": "iced coconut drink", "u": 4}, {"e": "🌶️", "w": "pedas", "p": "", "m": "spicy", "u": 4}, {"e": "🍬", "w": "manis", "p": "", "m": "sweet", "u": 4}, {"e": "🧂", "w": "asin", "p": "", "m": "salty", "u": 4}, {"e": "😋", "w": "enak", "p": "", "m": "delicious", "u": 4}, {"e": "🍽️", "w": "makan", "p": "", "m": "to eat", "u": 4}, {"e": "🥤", "w": "minum", "p": "", "m": "to drink", "u": 4}, {"e": "⬅️", "w": "kiri", "p": "", "m": "left", "u": 5}, {"e": "➡️", "w": "kanan", "p": "", "m": "right", "u": 5}, {"e": "⬆️", "w": "lurus", "p": "", "m": "straight", "u": 5}, {"e": "↪️", "w": "belok", "p": "", "m": "to turn", "u": 5}, {"e": "📍", "w": "di mana", "p": "", "m": "where (location)", "u": 5}, {"e": "🚶", "w": "jalan kaki", "p": "", "m": "on foot", "u": 5}, {"e": "🛵", "w": "ojek", "p": "", "m": "motorcycle taxi", "u": 5}, {"e": "🚐", "w": "angkot", "p": "", "m": "minibus (city transport)", "u": 5}, {"e": "🚆", "w": "kereta", "p": "", "m": "train", "u": 5}, {"e": "🚏", "w": "halte", "p": "", "m": "bus stop", "u": 5}, {"e": "🗺️", "w": "jauh", "p": "", "m": "far", "u": 5}, {"e": "📌", "w": "dekat", "p": "", "m": "near", "u": 5}, {"e": "⏰", "w": "bangun", "p": "", "m": "to wake up", "u": 6}, {"e": "🚿", "w": "mandi", "p": "", "m": "to bathe, shower", "u": 6}, {"e": "💼", "w": "bekerja", "p": "", "m": "to work", "u": 6}, {"e": "📖", "w": "belajar", "p": "", "m": "to study", "u": 6}, {"e": "🏠", "w": "pulang", "p": "", "m": "to go home", "u": 6}, {"e": "😴", "w": "tidur", "p": "", "m": "to sleep", "u": 6}, {"e": "📅", "w": "hari ini", "p": "", "m": "today", "u": 6}, {"e": "⏭️", "w": "besok", "p": "", "m": "tomorrow", "u": 6}, {"e": "⏮️", "w": "kemarin", "p": "", "m": "yesterday", "u": 6}]}