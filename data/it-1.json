{"id": "it-1", "kind": "lang", "lang": "it", "grade": null, "level": "umum", "tag": "A1", "badge": ["Level", "A1"], "title": "Bahasa Italia Pemula", "sub": "Pelafalan, salam, essere/avere, angka, keluarga, kata kerja, restoran", "c": "#2F9E44", "c2": "#EBFBEE", "c3": "#1B5E2A", "emojis": "👋 🪪 🔢 👨‍👩‍👧 🏃 🍝", "intro": "<div class=\"note\"><div class=\"note-h\">📌 Tentang kursus ini</div>Bahasa Italia dari nol, setara <b>A1</b> (CEFR, persiapan CELI/CILS A1). Bahasa musik, seni, dan kuliner, dengan ejaan yang mudah dibaca.</div>", "cando": ["Membaca huruf khas bahasa Italia (c, ch, g, gn, gli, sc, z).", "Memperkenalkan diri, asal, dan tempat tinggal.", "Menghitung 0–100.", "Menyebut anggota keluarga dengan artikel il/la.", "Mengonjugasikan kata kerja beraturan.", "Memesan makanan dan meminta tagihan."], "text": {"labels": {"learn": ["📚", "Vocabolario", "Kosakata"], "talk": ["🗣️", "Dialogo", "Percakapan"], "read": ["📖", "Lettura", "Membaca"], "practice": ["✏️", "Esercizi", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Grammatica", "Tata Bahasa"], "write": ["📝", "Menulis", ""]}, "brand": "Belajar Bahasa Italia", "unit_word": "unit", "tip_prefix": "Tips:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Vero", "false": "Falso", "review_t": "Ripasso · Evaluasi", "review_s": "Uji kemampuanmu", "pron_note": "", "pron_html": "<div class=\"note\"><div class=\"note-h\">🔊 Cara baca</div>Cara baca ditulis sederhana, misalnya <i>ciao</i> = <i>cau</i> dan <i>grazie</i> = <i>gra-tsi-e</i>. Dengarkan juga suaranya dengan tombol 🔊.</div>"}, "units": [{"num": 1, "en": "Pronuncia e saluti", "id": "Pelafalan & salam", "emoji": "👋", "goals": ["Membaca huruf khas bahasa Italia (c, ch, g, gn, gli, sc, z).", "Menyapa, berterima kasih, dan berpamitan."], "sections": [{"t": "note", "html": "Bahasa Italia dituturkan sekitar <b>85 juta orang</b> dan menjadi bahasa musik, seni, mode, dan kuliner dunia (pizza, pasta, espresso). Ejaannya teratur, hampir semua huruf dibaca. <b>Konsonan ganda</b> diucapkan lebih panjang dan bisa mengubah arti: <i>nonno</i> (kakek) ≠ <i>nono</i> (kesembilan).", "title": "Mengenal bahasa Italia"}, {"t": "grammar", "title": "Huruf yang perlu diperhatikan", "head": ["Tulisan", "Dibaca", "Contoh"], "rows": [["c + e/i", "c (seperti \"cari\")", "ciao (cau), cena (ce-na)"], ["ch", "k", "che (ke), chiesa (kie-za)"], ["g + e/i", "j", "gelato (je-la-to), giorno (jor-no)"], ["gh", "g", "spaghetti (spa-get-ti)"], ["gn", "ny", "gnocchi (nyok-ki), bagno (ba-nyo)"], ["gli", "ly", "figlio (fi-lyo), famiglia (fa-mi-lya)"], ["sc + e/i", "sy", "pesce (pe-sye), scienza (syen-tsa)"], ["z", "ts / dz", "pizza (pit-tsa), zero (dze-ro)"], ["h", "tidak dibaca", "ho (o), hanno (an-no)"]]}, {"t": "phrases", "title": "Salam & sopan santun", "items": [["Ciao!", "Hai! / Dah! (akrab)", "cau"], ["Buongiorno!", "Selamat pagi/siang!", "buon-jor-no"], ["Buonasera!", "Selamat sore/malam!", "buo-na-se-ra"], ["Buonanotte!", "Selamat tidur!", "buo-na-not-te"], ["Come stai? – Bene, grazie. E tu?", "Apa kabar? – Baik, terima kasih. Kamu?", "ko-me stai – be-ne, gra-tsi-e. e tu"], ["Per favore.", "Tolong / silakan.", "per fa-vo-re"], ["Grazie! – Prego!", "Terima kasih! – Sama-sama!", "gra-tsi-e – pre-go"], ["Scusi! / Scusa!", "Permisi / maaf! (formal / akrab)", "sku-zi / sku-za"], ["Arrivederci! / A presto!", "Sampai jumpa! / Sampai nanti!", "ar-ri-ve-der-ci / a pres-to"]]}, {"t": "ex", "kind": "choice", "instr": "Scegli la risposta giusta.", "ans": "1. b · 2. c · 3. b · 4. a · 5. b", "items": ["Huruf ch pada «che» dibaca ...|c|k|sy|ch", "Gabungan gn pada «gnocchi» dibaca ...|gn|g|ny|n", "Kata «ciao» dibaca ...|si-ao|cau|ki-ao|sya-o", "Jawaban untuk «Grazie!» adalah ...|Prego!|Ciao!|Scusi!|Per favore!", "Salam pukul 20.00 adalah ...|Buongiorno|Buonasera|Buonanotte|Arrivederci"]}]}, {"num": 2, "en": "Presentarsi", "id": "Perkenalan & essere", "emoji": "🪪", "goals": ["Memperkenalkan diri, asal, dan tempat tinggal.", "Memakai essere serta membedakan tu dan Lei."], "sections": [{"t": "grammar", "title": "essere (adalah)", "head": ["Subjek", "essere", "Contoh"], "rows": [["io (saya)", "sono", "<b>Sono</b> Budi."], ["tu (kamu)", "sei", "<b>Sei</b> italiano?"], ["lui / lei / Lei (dia / Anda)", "è", "Lei <b>è</b> professoressa."], ["noi (kami)", "siamo", "<b>Siamo</b> indonesiani."], ["voi (kalian)", "siete", "<b>Siete</b> amici?"], ["loro (mereka)", "sono", "<b>Sono</b> a Roma."]], "after": "Subjek biasanya dihilangkan karena bentuk kata kerjanya sudah jelas. <b>tu</b> untuk teman, <b>Lei</b> (kapital) untuk sapaan sopan. Kata sifat kebangsaan berubah: <i>indonesian<b>o</b></i> (lk) / <i>indonesian<b>a</b></i> (pr)."}, {"t": "dialog", "title": "All'università", "lines": [["Giulia", "👩", "Ciao! Mi chiamo Giulia. E tu, come ti chiami?", "Hai! Namaku Giulia. Kamu, siapa namamu?"], ["Budi", "👦", "Ciao, Giulia! Mi chiamo Budi.", "Hai, Giulia! Namaku Budi."], ["Giulia", "👩", "Di dove sei?", "Kamu dari mana?"], ["Budi", "👦", "Sono indonesiano, di Surabaya. Adesso abito a Milano. E tu?", "Aku orang Indonesia, dari Surabaya. Sekarang aku tinggal di Milan. Kamu?"], ["Giulia", "👩", "Sono di Roma. Piacere!", "Aku dari Roma. Senang berkenalan!"], ["Budi", "👦", "Piacere mio!", "Aku juga senang!"]]}, {"t": "ex", "kind": "fill", "instr": "Lengkapi dengan essere (sono, sei, è, siamo, siete).", "ans": "1. sono · 2. sei · 3. è/e · 4. siamo · 5. siete", "items": ["Io ___ Budi.", "Tu ___ di Roma?", "Lei ___ professoressa.", "Noi ___ indonesiani.", "Voi ___ amici?"]}, {"t": "ex", "kind": "order", "instr": "Susun menjadi kalimat.", "ans": "1. Mi chiamo Budi. · 2. Di dove sei? · 3. Abito a Jakarta.", "items": ["chiamo / Budi. / Mi", "Di / sei? / dove", "a / Abito / Jakarta."]}]}, {"num": 3, "en": "I numeri", "id": "Angka, umur & harga", "emoji": "🔢", "goals": ["Menghitung 0–100.", "Menyebut umur dengan avere dan menanyakan harga."], "sections": [{"t": "vocab", "title": "0–12", "cols": 4, "items": [["0️⃣", "zero", "dze-ro", "0"], ["1️⃣", "uno", "u-no", "1"], ["2️⃣", "due", "du-e", "2"], ["3️⃣", "tre", "tre", "3"], ["4️⃣", "quattro", "kuat-tro", "4"], ["5️⃣", "cinque", "cin-kue", "5"], ["6️⃣", "sei", "sei", "6"], ["7️⃣", "sette", "set-te", "7"], ["8️⃣", "otto", "ot-to", "8"], ["9️⃣", "nove", "no-ve", "9"], ["🔟", "dieci", "die-ci", "10"], ["🔢", "undici", "un-di-ci", "11"], ["🔢", "dodici", "do-di-ci", "12"]]}, {"t": "grammar", "title": "13–100", "head": ["Angka", "Bahasa Italia", "Catatan"], "rows": [["13–16", "tredici, quattordici, quindici, sedici", "satuan + dici"], ["17–19", "diciassette, diciotto, diciannove", "dici + satuan (terbalik)"], ["20, 21, 28", "venti, <b>ventuno</b>, <b>ventotto</b>", "vokal akhir puluhan hilang sebelum uno/otto"], ["30–90", "trenta, quaranta, cinquanta, sessanta, settanta, ottanta, novanta", ""], ["100", "cento", ""]]}, {"t": "phrases", "title": "Ungkapan dengan angka", "items": [["Quanti anni hai? – Ho vent'anni.", "Berapa umurmu? – Umurku 20 tahun. (pakai <i>avere</i> = punya)", "kuan-ti an-ni ai – o ven-tan-ni"], ["Quanto costa? – Costa cinque euro.", "Berapa harganya? – 5 euro.", "kuan-to kos-ta – kos-ta cin-kue eu-ro"]]}, {"t": "ex", "kind": "choice", "instr": "Che numero è?", "ans": "1. b · 2. b · 3. c · 4. b", "items": ["17 = ...|settedici|diciassette|settanta|sette", "21 = ...|ventiuno|ventuno|unoventi|undici", "60 = ...|sei|sedici|sessanta|settanta", "«Ho vent'anni» artinya ...|Saya punya 20 euro.|Umur saya 20 tahun.|Pukul 20.00.|Saya ke-20."]}]}, {"num": 4, "en": "La famiglia", "id": "Keluarga, artikel & avere", "emoji": "👨‍👩‍👧", "goals": ["Menyebut anggota keluarga dengan artikel il/la.", "Memakai avere dan kata milik mio/mia."], "sections": [{"t": "vocab", "title": "La famiglia", "cols": 4, "items": [["👨", "il padre", "il pa-dre", "ayah"], ["👩", "la madre", "la ma-dre", "ibu"], ["👦", "il fratello", "il fra-tel-lo", "saudara laki-laki"], ["👧", "la sorella", "la so-rel-la", "saudara perempuan"], ["👫", "i genitori", "i je-ni-to-ri", "orang tua"], ["👴", "il nonno", "il non-no", "kakek"], ["👵", "la nonna", "la non-na", "nenek"], ["👦", "il figlio", "il fi-lyo", "anak laki-laki"], ["👧", "la figlia", "la fi-lya", "anak perempuan"], ["🧔", "lo zio", "lo dzi-o", "paman"], ["👩‍🦱", "la zia", "la dzi-a", "bibi"], ["🧒", "il cugino", "il ku-ji-no", "sepupu"]]}, {"t": "grammar", "title": "Artikel tentu", "head": ["", "Maskulin", "Feminin"], "rows": [["tunggal", "il libro · <b>lo</b> zio, lo studente (z, s+konsonan) · <b>l'</b>amico", "la casa · <b>l'</b>amica"], ["jamak", "i libri · <b>gli</b> zii, gli amici", "le case, le amiche"], ["tak tentu", "un · uno (z, s+konsonan)", "una · un' (sebelum vokal)"]], "after": "Kata milik untuk anggota keluarga <b>tunggal tanpa artikel</b>: <i>mio padre, mia madre</i>. Untuk jamak memakai artikel: <i>i miei genitori</i>."}, {"t": "grammar", "title": "avere (punya)", "head": ["Subjek", "avere"], "rows": [["io", "ho"], ["tu", "hai"], ["lui / lei", "ha"], ["noi", "abbiamo"], ["voi", "avete"], ["loro", "hanno"]], "after": "Huruf h pada ho, hai, ha, hanno tidak dibaca."}, {"t": "ex", "kind": "choice", "instr": "Scegli la risposta giusta.", "ans": "1. b · 2. c · 3. b · 4. b", "items": ["___ madre|il|la|lo|i", "___ zio|il|la|lo|gli", "Io ___ due fratelli.|ha|ho|hanno|abbiamo", "___ padre è medico. (ayahku)|Il mio|Mio|Mia|La mia"]}]}, {"num": 5, "en": "I verbi al presente", "id": "Kata kerja -are, -ere, -ire", "emoji": "🏃", "goals": ["Mengonjugasikan kata kerja beraturan.", "Membuat kalimat negatif dan pertanyaan."], "sections": [{"t": "grammar", "title": "Kata kerja beraturan", "head": ["Subjek", "parlare (berbicara)", "prendere (mengambil)", "dormire (tidur)"], "rows": [["io", "parl<b>o</b>", "prend<b>o</b>", "dorm<b>o</b>"], ["tu", "parl<b>i</b>", "prend<b>i</b>", "dorm<b>i</b>"], ["lui / lei", "parl<b>a</b>", "prend<b>e</b>", "dorm<b>e</b>"], ["noi", "parl<b>iamo</b>", "prend<b>iamo</b>", "dorm<b>iamo</b>"], ["voi", "parl<b>ate</b>", "prend<b>ete</b>", "dorm<b>ite</b>"], ["loro", "parl<b>ano</b>", "prend<b>ono</b>", "dorm<b>ono</b>"]], "after": "Negatif: <b>non</b> + kata kerja (<i>Non mangio carne di maiale</i>). Kata tanya: <b>che cosa</b> (apa), <b>chi</b> (siapa), <b>dove</b> (di mana), <b>quando</b> (kapan), <b>come</b> (bagaimana), <b>perché</b> (mengapa), <b>quanto</b> (berapa)."}, {"t": "ex", "kind": "fill", "instr": "Konjugasikan kata kerjanya.", "ans": "1. parlo · 2. abiti · 3. prende · 4. studiamo · 5. dormono", "items": ["Io ___ italiano. (parlare)", "Tu ___ a Milano? (abitare)", "Lei ___ un caffè. (prendere)", "Noi ___ l'italiano. (studiare)", "Loro ___ molto. (dormire)"]}, {"t": "ex", "kind": "choice", "instr": "Scegli la risposta giusta.", "ans": "1. b · 2. b · 3. b", "items": ["___ abiti? – A Bandung.|Chi|Dove|Quando|Che cosa", "Kalimat negatif yang benar adalah ...|Io mangio non pizza.|Io non mangio pizza.|Non io mangio pizza.|Io mangio pizza non.", "«Perché studi l'italiano?» artinya ...|Kapan kamu belajar bahasa Italia?|Mengapa kamu belajar bahasa Italia?|Di mana kamu belajar?|Siapa gurumu?"]}]}, {"num": 6, "en": "Al ristorante", "id": "Di restoran & kafe", "emoji": "🍝", "goals": ["Memesan makanan dan meminta tagihan.", "Menanyakan kandungan babi dan alkohol."], "sections": [{"t": "vocab", "title": "Cibo e bevande", "cols": 4, "items": [["💧", "l'acqua", "lak-kua", "air"], ["☕", "il caffè", "il kaf-fe", "kopi (espresso)"], ["🍵", "il tè", "il te", "teh"], ["🧃", "il succo", "il suk-ko", "jus"], ["🍞", "il pane", "il pa-ne", "roti"], ["🍝", "la pasta", "la pas-ta", "pasta"], ["🍕", "la pizza", "la pit-tsa", "pizza"], ["🍚", "il riso", "il ri-zo", "nasi"], ["🍗", "il pollo", "il pol-lo", "ayam"], ["🐟", "il pesce", "il pe-sye", "ikan"], ["🥩", "la carne", "la kar-ne", "daging"], ["🍨", "il gelato", "il je-la-to", "es krim"]]}, {"t": "phrases", "title": "Al ristorante", "items": [["Vorrei una pizza margherita, per favore.", "Saya mau satu pizza margherita.", "vor-rei u-na pit-tsa mar-ge-ri-ta, per fa-vo-re"], ["Il conto, per favore.", "Minta tagihannya.", "il kon-to, per fa-vo-re"], ["Buon appetito!", "Selamat makan!", "buon ap-pe-ti-to"], ["È delizioso!", "Enak sekali!", "e de-li-tsi-o-zo"]]}, {"t": "note", "html": "<b>C'è carne di maiale?</b> (Apakah ada daging babi?) · <b>Non mangio carne di maiale.</b> (Saya tidak makan babi.) · <b>Non bevo alcol.</b> (Saya tidak minum alkohol.) · Waspadai <i>prosciutto, salame, pancetta,</i> dan <i>guanciale</i> (semuanya babi; carbonara asli memakai guanciale) serta <i>tiramisù</i> yang kadang memakai likeur. Pizza margherita dan pasta seafood (<i>frutti di mare</i>) biasanya aman.", "title": "🕌 Tips makan halal"}, {"t": "dialog", "title": "In pizzeria", "lines": [["Cameriere", "🧑‍🍳", "Buonasera! Cosa prendete?", "Selamat malam! Mau pesan apa?"], ["Rina", "🧕", "Vorrei una pizza margherita e un'acqua. C'è carne di maiale nella pizza?", "Saya mau pizza margherita dan air. Apakah pizzanya ada daging babi?"], ["Cameriere", "🧑‍🍳", "No, la margherita ha solo pomodoro, mozzarella e basilico.", "Tidak, margherita hanya berisi tomat, mozzarella, dan kemangi."], ["Rina", "🧕", "Perfetto, grazie!", "Bagus, terima kasih!"]]}, {"t": "ex", "kind": "choice", "instr": "Domande sul dialogo", "ans": "1. a · 2. b · 3. b", "items": ["Cosa prende Rina?|una pizza margherita e un'acqua|pasta e caffè|un gelato|pollo e riso", "La margherita ha carne di maiale?|Sì|No|Solo prosciutto|Non si sa", "«Il conto, per favore» artinya ...|Hitung, ya!|Minta tagihannya.|Minta menunya.|Selamat makan."]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Scegli la risposta giusta.", "ans": "1. b · 2. b · 3. b · 4. c · 5. b", "items": ["Io ___ indonesiano.|sei|sono|è|siamo", "Quanti anni ___?|sei|hai|ha|è", "___ amici (jamak, maskulin)|i|gli|le|lo", "Noi ___ l'italiano.|parlo|parlate|parliamo|parlano", "50 = ...|quindici|cinquanta|cinque|cinquecento"]}, {"t": "ex", "kind": "tf", "instr": "Vero o falso?", "ans": "1. Vero · 2. Falso · 3. Vero", "items": ["Huruf h dalam bahasa Italia tidak dibaca.", "«ch» dibaca seperti c dalam «cari».", "«Lei» dipakai sebagai sapaan sopan."]}], "words": [{"e": "0️⃣", "w": "zero", "p": "dze-ro", "m": "0", "u": 3}, {"e": "1️⃣", "w": "uno", "p": "u-no", "m": "1", "u": 3}, {"e": "2️⃣", "w": "due", "p": "du-e", "m": "2", "u": 3}, {"e": "3️⃣", "w": "tre", "p": "tre", "m": "3", "u": 3}, {"e": "4️⃣", "w": "quattro", "p": "kuat-tro", "m": "4", "u": 3}, {"e": "5️⃣", "w": "cinque", "p": "cin-kue", "m": "5", "u": 3}, {"e": "6️⃣", "w": "sei", "p": "sei", "m": "6", "u": 3}, {"e": "7️⃣", "w": "sette", "p": "set-te", "m": "7", "u": 3}, {"e": "8️⃣", "w": "otto", "p": "ot-to", "m": "8", "u": 3}, {"e": "9️⃣", "w": "nove", "p": "no-ve", "m": "9", "u": 3}, {"e": "🔟", "w": "dieci", "p": "die-ci", "m": "10", "u": 3}, {"e": "🔢", "w": "undici", "p": "un-di-ci", "m": "11", "u": 3}, {"e": "🔢", "w": "dodici", "p": "do-di-ci", "m": "12", "u": 3}, {"e": "👨", "w": "il padre", "p": "il pa-dre", "m": "ayah", "u": 4}, {"e": "👩", "w": "la madre", "p": "la ma-dre", "m": "ibu", "u": 4}, {"e": "👦", "w": "il fratello", "p": "il fra-tel-lo", "m": "saudara laki-laki", "u": 4}, {"e": "👧", "w": "la sorella", "p": "la so-rel-la", "m": "saudara perempuan", "u": 4}, {"e": "👫", "w": "i genitori", "p": "i je-ni-to-ri", "m": "orang tua", "u": 4}, {"e": "👴", "w": "il nonno", "p": "il non-no", "m": "kakek", "u": 4}, {"e": "👵", "w": "la nonna", "p": "la non-na", "m": "nenek", "u": 4}, {"e": "👦", "w": "il figlio", "p": "il fi-lyo", "m": "anak laki-laki", "u": 4}, {"e": "👧", "w": "la figlia", "p": "la fi-lya", "m": "anak perempuan", "u": 4}, {"e": "🧔", "w": "lo zio", "p": "lo dzi-o", "m": "paman", "u": 4}, {"e": "👩‍🦱", "w": "la zia", "p": "la dzi-a", "m": "bibi", "u": 4}, {"e": "🧒", "w": "il cugino", "p": "il ku-ji-no", "m": "sepupu", "u": 4}, {"e": "💧", "w": "l'acqua", "p": "lak-kua", "m": "air", "u": 6}, {"e": "☕", "w": "il caffè", "p": "il kaf-fe", "m": "kopi (espresso)", "u": 6}, {"e": "🍵", "w": "il tè", "p": "il te", "m": "teh", "u": 6}, {"e": "🧃", "w": "il succo", "p": "il suk-ko", "m": "jus", "u": 6}, {"e": "🍞", "w": "il pane", "p": "il pa-ne", "m": "roti", "u": 6}, {"e": "🍝", "w": "la pasta", "p": "la pas-ta", "m": "pasta", "u": 6}, {"e": "🍕", "w": "la pizza", "p": "la pit-tsa", "m": "pizza", "u": 6}, {"e": "🍚", "w": "il riso", "p": "il ri-zo", "m": "nasi", "u": 6}, {"e": "🍗", "w": "il pollo", "p": "il pol-lo", "m": "ayam", "u": 6}, {"e": "🐟", "w": "il pesce", "p": "il pe-sye", "m": "ikan", "u": 6}, {"e": "🥩", "w": "la carne", "p": "la kar-ne", "m": "daging", "u": 6}, {"e": "🍨", "w": "il gelato", "p": "il je-la-to", "m": "es krim", "u": 6}]}