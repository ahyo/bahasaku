{"id": "ja-2", "lang": "ja", "grade": 2, "level": "sd", "title": "がんばろう！", "sub": "Belajar sambil bermain · Untuk siswa Kelas 2 SD", "c": "#F08A24", "c2": "#FFEEDC", "c3": "#F9C74F", "emojis": "🔠 🎒 🍉 🐼 📅 🍡 🐘 ✏️ 🍓 🎏 🐰 ⭐", "intro": "", "cando": ["Membaca katakana dan menulis nama sendiri.", "Menyebut benda sekolah dengan <b>これ・それ・あれ</b>.", "Menyebut buah dan menyatakan suka/tidak suka.", "Menyebut hewan dan suaranya.", "Menyebut nama hari dan bilangan sampai 100."], "text": {"labels": {"learn": ["📚", "まなぼう！", "Ayo Belajar"], "talk": ["🗣️", "はなそう！", "Ayo Berbicara"], "read": ["📖", "よもう！", "Ayo Membaca"], "practice": ["✏️", "れんしゅう！", "Ayo Berlatih"], "sing": ["🎵", "うたおう！", "Ayo Bernyanyi"], "play": ["🎲", "あそぼう！", "Ayo Bermain"], "grammar": ["🧩", "ぶんをつくろう！", "Ayo Menyusun Kalimat"], "write": ["📝", "かこう！", "Ayo Menulis"]}, "brand": "Asyik Belajar Bahasa Jepang", "unit_word": "bab", "tip_prefix": "Kiko berkata:", "fun_h": "🌟 Tahukah Kamu? <small>しってる？</small>", "word_box": "Kotak Kata:", "true": "Benar", "false": "Salah", "review_t": "ふくしゅう", "review_s": "Evaluasi — Ayo uji kemampuanmu!", "pron_note": "Tulisan latin di dalam garis miring, misalnya ねこ <span class=\"vp inl\">/neko/</span>, disebut <b>romaji</b> — cara membaca huruf Jepang. Vokal ganda (<b>aa, ii, uu, ee, oo</b>) dibaca <b>panjang</b>. <b>shi</b> dibaca “si”, <b>chi</b> dibaca “ci”, <b>tsu</b> dibaca “tsu”, <b>fu</b> di antara “fu” dan “hu”, dan <b>ん</b> (n) dibaca “n/ng”. Huruf kecil di atas kanji disebut <b>furigana</b> (cara baca kanji). Biasakan membaca hiragana dan katakana, lalu dengarkan guru atau video berbahasa Jepang. 🎧", "pron_html": null}, "units": [{"num": 1, "en": "カタカナ", "id": "Huruf Katakana", "emoji": "🔠", "goals": ["Mengenal 46 huruf katakana.", "Membaca kata serapan (dari bahasa asing) dalam katakana.", "Menulis nama sendiri dalam katakana."], "sections": [{"t": "raw", "html": "<div class=\"sgrid\" style=\"--sc:5\"><div class=\"scard\"><div class=\"sch\">ア</div><div class=\"sn\">a</div><div