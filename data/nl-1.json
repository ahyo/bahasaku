{"id": "nl-1", "kind": "lang", "lang": "nl", "grade": null, "level": "umum", "tag": "A1", "badge": ["Level", "A1"], "title": "Bahasa Belanda Pemula", "sub": "Pelafalan, kata serapan, zijn/hebben, angka, keluarga, kata kerja, restoran", "c": "#E8590C", "c2": "#FFF4E6", "c3": "#8A3405", "emojis": "👋 🪪 🔢 👨‍👩‍👧 🏃 🍽️", "intro": "<div class=\"note\"><div class=\"note-h\">📌 Tentang kursus ini</div>Bahasa Belanda dari nol, setara <b>A1</b> (persiapan <i>inburgering</i>/NT2 A1). Berguna untuk studi di Belanda dan membaca arsip sejarah Indonesia.</div>", "cando": ["Membaca bunyi khas bahasa Belanda (g, ij, ui, oe, sch).", "Memperkenalkan diri, asal, dan tempat tinggal.", "Menghitung 0–100.", "Menyebut anggota keluarga dengan artikel de/het.", "Mengonjugasikan kata kerja beraturan (stam + t).", "Memesan makanan dan meminta tagihan."], "text": {"labels": {"learn": ["📚", "Woordenschat", "Kosakata"], "talk": ["🗣️", "Dialoog", "Percakapan"], "read": ["📖", "Lezen", "Membaca"], "practice": ["✏️", "Oefeningen", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Grammatica", "Tata Bahasa"], "write": ["📝", "Menulis", ""]}, "brand": "Belajar Bahasa Belanda", "unit_word": "unit", "tip_prefix": "Tips:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Waar", "false": "Niet waar", "review_t": "Herhaling · Evaluasi", "review_s": "Uji kemampuanmu", "pron_note": "", "pron_html": "<div class=\"note\"><div class=\"note-h\">🔊 Cara baca</div>Cara baca ditulis sederhana. Huruf <b>kh</b> = bunyi seperti خ (g/ch Belanda), misalnya <i>goed</i> = <i>khut</i>. Dengarkan juga suaranya dengan tombol 🔊.</div>"}, "units": [{"num": 1, "en": "Uitspraak en groeten", "id": "Pelafalan & salam", "emoji": "👋", "goals": ["Membaca bunyi khas bahasa Belanda (g, ij, ui, oe, sch).", "Mengenal kata Indonesia yang berasal dari bahasa Belanda."], "sections": [{"t": "note", "html": "Bahasa Belanda dituturkan sekitar <b>25 juta orang</b> di Belanda, Belgia (Flandria), Suriname, dan Karibia. Bahasa ini meninggalkan <b>ribuan kata serapan</b> dalam bahasa Indonesia: <i>kantor (kantoor), handuk (handdoek), kulkas (koelkast), wortel, gratis, om, tante, knalpot, persneling</i>. Banyak arsip sejarah Indonesia ditulis dalam bahasa Belanda.", "title": "Mengenal bahasa Belanda"}, {"t": "grammar", "title": "Bunyi yang perlu diperhatikan", "head": ["Tulisan", "Dibaca", "Contoh"], "rows": [["g, ch", "kh (seperti خ)", "goed (khut), acht (akht)"], ["ij, ei", "ei (antara ai dan ei)", "mijn (mein), klein (klein)"], ["ui", "öi (bibir bulat)", "huis (höis), uit (öit)"], ["oe", "u", "goed (khut), boek (buk)"], ["uu, u", "ü (i dengan bibir bulat)", "minuut (mi-nüt)"], ["eu", "ö", "neus (nös), leuk (lök)"], ["sch", "s + kh", "school (skhool)"], ["aa, ee, oo", "vokal panjang", "jaar (yaar), twee (twee), rood (root)"], ["j", "y", "ja (yaa), jij (yei)"], ["w", "w lembut / v", "water (waa-ter)"]]}, {"t": "phrases", "title": "Salam & sopan santun", "items": [["Hallo! / Hoi!", "Halo! / Hai!", "ha-lo / hoi"], ["Goedemorgen!", "Selamat pagi!", "khu-de-mor-khen"], ["Goedemiddag!", "Selamat siang!", "khu-de-mi-dakh"], ["Goedenavond!", "Selamat malam!", "khu-den-aa-vont"], ["Hoe gaat het? – Goed, dank je. En met jou?", "Apa kabar? – Baik, terima kasih. Kamu?", "hu khaat het – khut, dank ye. en met yau"], ["Alsjeblieft / Alstublieft.", "Tolong / silakan (akrab / sopan).", "al-sye-blift / al-stü-blift"], ["Dank je wel! – Graag gedaan!", "Terima kasih! – Sama-sama!", "dank ye wel – khraakh khe-daan"], ["Sorry! / Pardon!", "Maaf! / Permisi!", "so-ri / par-don"], ["Dag! / Doei! / Tot ziens!", "Dah! / Sampai jumpa!", "dakh / dui / tot ziins"]]}, {"t": "ex", "kind": "choice", "instr": "Kies het goede antwoord.", "ans": "1. b · 2. c · 3. b · 4. a · 5. a", "items": ["Huruf g pada «goed» dibaca ...|g|kh|y|h", "Gabungan oe pada «boek» dibaca ...|oe|o|u|ü", "Kata Indonesia «handuk» berasal dari ...|handschoen|handdoek|hand|handig", "Kata Indonesia «kulkas» berasal dari ...|koelkast|koekje|kast|keuken", "Jawaban untuk «Dank je wel!» adalah ...|Graag gedaan!|Goedemorgen!|Tot ziens!|Alsjeblieft!"]}]}, {"num": 2, "en": "Jezelf voorstellen", "id": "Perkenalan & zijn", "emoji": "🪪", "goals": ["Memperkenalkan diri, asal, dan tempat tinggal.", "Memakai zijn serta membedakan je dan u."], "sections": [{"t": "grammar", "title": "zijn (adalah)", "head": ["Subjek", "zijn", "Contoh"], "rows": [["ik", "ben", "Ik <b>ben</b> Budi."], ["jij / je", "bent", "Jij <b>bent</b> student. / <b>Ben</b> jij student?"], ["u (Anda)", "bent", "<b>Bent</b> u meneer De Vries?"], ["hij / zij / het", "is", "Zij <b>is</b> lerares."], ["wij / jullie / zij (mereka)", "zijn", "Wij <b>zijn</b> uit Indonesië."]], "after": "<b>je/jij</b> untuk teman, <b>u</b> untuk sapaan sopan. Saat <i>jij</i> berada di belakang kata kerja, akhiran <b>-t</b> hilang: <i>jij bent → ben jij?</i>"}, {"t": "dialog", "title": "Op de universiteit", "lines": [["Sanne", "👩", "Hoi! Ik ben Sanne. Hoe heet jij?", "Hai! Aku Sanne. Siapa namamu?"], ["Budi", "👦", "Hoi Sanne! Ik heet Budi.", "Hai Sanne! Namaku Budi."], ["Sanne", "👩", "Waar kom je vandaan?", "Kamu berasal dari mana?"], ["Budi", "👦", "Ik kom uit Indonesië, uit Semarang. Ik woon nu in Leiden.", "Aku dari Indonesia, dari Semarang. Sekarang aku tinggal di Leiden."], ["Sanne", "👩", "Leuk! Ik kom uit Utrecht.", "Asyik! Aku dari Utrecht."]]}, {"t": "ex", "kind": "fill", "instr": "Lengkapi dengan zijn (ben, bent, is, zijn).", "ans": "1. ben · 2. bent · 3. is · 4. zijn · 5. Bent/bent", "items": ["Ik ___ student.", "Jij ___ mijn vriend.", "Hij ___ uit Nederland.", "Wij ___ in Amsterdam.", "___ u mevrouw Jansen?"]}, {"t": "ex", "kind": "order", "instr": "Susun menjadi kalimat.", "ans": "1. Ik heet Budi. · 2. Waar kom je vandaan? · 3. Ik woon in Jakarta.", "items": ["heet / Budi. / Ik", "Waar / kom / vandaan? / je", "woon / Jakarta. / in / Ik"]}]}, {"num": 3, "en": "Getallen", "id": "Angka, umur & harga", "emoji": "🔢", "goals": ["Menghitung 0–100.", "Menyebut umur dan menanyakan harga."], "sections": [{"t": "vocab", "title": "0–12", "cols": 4, "items": [["0️⃣", "nul", "nül", "0"], ["1️⃣", "een", "een", "1"], ["2️⃣", "twee", "twee", "2"], ["3️⃣", "drie", "drii", "3"], ["4️⃣", "vier", "fiir", "4"], ["5️⃣", "vijf", "feif", "5"], ["6️⃣", "zes", "zes", "6"], ["7️⃣", "zeven", "zee-fen", "7"], ["8️⃣", "acht", "akht", "8"], ["9️⃣", "negen", "nee-khen", "9"], ["🔟", "tien", "tiin", "10"], ["🔢", "elf", "elf", "11"], ["🔢", "twaalf", "twaalf", "12"]]}, {"t": "grammar", "title": "13–100", "head": ["Angka", "Bahasa Belanda", "Catatan"], "rows": [["13–19", "dertien, veertien, vijftien, zestien, zeventien, achttien, negentien", ""], ["20–90", "twintig, dertig, veertig, vijftig, zestig, zeventig, tachtig, negentig", "80 = <b>t</b>achtig"], ["21", "<b>eenentwintig</b>", "\"satu-dan-dua puluh\" (seperti bahasa Jerman)"], ["100", "honderd", ""]]}, {"t": "phrases", "title": "Ungkapan dengan angka", "items": [["Hoe oud ben je? – Ik ben twintig jaar.", "Berapa umurmu? – Umurku 20 tahun.", "hu aut ben ye – ik ben twin-tikh yaar"], ["Hoeveel kost het? – Het kost vijf euro.", "Berapa harganya? – 5 euro.", "hu-feel kost het – het kost feif öi-ro"]]}, {"t": "ex", "kind": "choice", "instr": "Welk getal?", "ans": "1. b · 2. b · 3. a · 4. a", "items": ["21 = ...|twintigeen|eenentwintig|eentwintig|elf", "80 = ...|achtig|tachtig|achttien|achtentig", "35 = ...|vijfendertig|dertigvijf|vijftien|vijftig", "12 = ...|twaalf|twintig|tweetien|elf"]}]}, {"num": 4, "en": "De familie", "id": "Keluarga, de/het & hebben", "emoji": "👨‍👩‍👧", "goals": ["Menyebut anggota keluarga dengan artikel de/het.", "Memakai hebben dan kata milik."], "sections": [{"t": "vocab", "title": "De familie", "cols": 4, "items": [["👨", "de vader", "de faa-der", "ayah"], ["👩", "de moeder", "de mu-der", "ibu"], ["👦", "de broer", "de brur", "saudara laki-laki"], ["👧", "de zus", "de züs", "saudara perempuan"], ["👫", "de ouders", "de au-ders", "orang tua"], ["👴", "de opa", "de oo-pa", "kakek"], ["👵", "de oma", "de oo-ma", "nenek"], ["👦", "de zoon", "de zoon", "anak laki-laki"], ["👧", "de dochter", "de dokh-ter", "anak perempuan"], ["🧒", "het kind", "het kint", "anak"], ["🧔", "de oom", "de oom", "paman"], ["👩‍🦱", "de tante", "de tan-te", "bibi"]]}, {"t": "grammar", "title": "de atau het?", "head": ["Artikel", "Dipakai untuk", "Contoh"], "rows": [["de", "sebagian besar kata benda & <b>semua jamak</b>", "de man, de vrouw, de kinderen"], ["het", "kata netral, termasuk semua <b>-je</b> (kecil)", "het kind, het huis, het boekje"], ["een", "tak tentu (a/an)", "een broer, een huis"]], "after": "Kata milik: <b>mijn</b> (-ku), <b>jouw/je</b> (-mu), <b>zijn</b> (-nya, lk), <b>haar</b> (-nya, pr), <b>ons/onze</b> (kami), <b>hun</b> (mereka)."}, {"t": "grammar", "title": "hebben (punya)", "head": ["Subjek", "hebben"], "rows": [["ik", "heb"], ["jij", "hebt (heb jij?)"], ["u", "hebt / heeft"], ["hij / zij", "heeft"], ["wij / jullie / zij", "hebben"]]}, {"t": "ex", "kind": "choice", "instr": "Kies het goede antwoord.", "ans": "1. b · 2. a · 3. b · 4. c · 5. b", "items": ["___ kind|de|het|een de|den", "___ moeder|de|het|der|die", "Ik ___ twee broers.|heeft|heb|hebben|hebt", "Hij ___ een zus.|heb|hebben|heeft|hebt", "___ huisje (rumah kecil)|de|het|die|der"]}]}, {"num": 5, "en": "Werkwoorden", "id": "Kata kerja & urutan kata", "emoji": "🏃", "goals": ["Mengonjugasikan kata kerja beraturan (stam + t).", "Menyusun kalimat dengan kata kerja di posisi kedua, negasi niet/geen."], "sections": [{"t": "grammar", "title": "Kata kerja beraturan (werken = bekerja)", "head": ["Subjek", "Bentuk", "werken", "wonen (tinggal)"], "rows": [["ik", "stam", "werk", "woon"], ["jij / u / hij / zij", "stam + t", "werkt", "woont"], ["werk jij? (jij di belakang)", "stam", "werk jij?", "woon jij?"], ["wij / jullie / zij", "infinitif", "werken", "wonen"]], "after": "Kata kerja selalu di <b>posisi 2</b>: <i>Morgen <b>werk</b> ik thuis.</i> Negasi: <b>niet</b> (kata kerja/sifat) dan <b>geen</b> (kata benda tanpa artikel/een): <i>Ik eet <b>geen</b> varkensvlees.</i>"}, {"t": "vocab", "title": "Kata tanya", "cols": 4, "items": [["❓", "wat", "wat", "apa"], ["🧑", "wie", "wii", "siapa"], ["📍", "waar", "waar", "di mana"], ["📅", "wanneer", "wa-neer", "kapan"], ["🤔", "hoe", "hu", "bagaimana"], ["💭", "waarom", "waa-rom", "mengapa"], ["💰", "hoeveel", "hu-feel", "berapa"], ["🧭", "waarheen", "waar-heen", "ke mana"]]}, {"t": "ex", "kind": "fill", "instr": "Konjugasikan kata kerjanya.", "ans": "1. woon · 2. leert · 3. drinken · 4. Spreek/spreek", "items": ["Ik ___ in Amsterdam. (wonen)", "Zij ___ Nederlands. (leren)", "Wij ___ koffie. (drinken)", "___ jij Engels? (spreken)"]}, {"t": "ex", "kind": "choice", "instr": "Niet of geen?", "ans": "1. b · 2. b · 3. b", "items": ["Ik eet ___ vlees.|niet|geen|nee|nooit geen", "Ik kom morgen ___.|geen|niet|nee|geene", "Hij heeft ___ auto.|niet|geen|nee|niets"]}]}, {"num": 6, "en": "In het restaurant", "id": "Di restoran", "emoji": "🍽️", "goals": ["Memesan makanan dan meminta tagihan.", "Menanyakan kandungan babi dan alkohol."], "sections": [{"t": "vocab", "title": "Eten en drinken", "cols": 4, "items": [["💧", "het water", "het waa-ter", "air"], ["☕", "de koffie", "de ko-fi", "kopi"], ["🍵", "de thee", "de tee", "teh"], ["🧃", "het sap", "het sap", "jus"], ["🍞", "het brood", "het broot", "roti"], ["🧀", "de kaas", "de kaas", "keju"], ["🍚", "de rijst", "de reist", "nasi"], ["🍗", "de kip", "de kip", "ayam"], ["🐟", "de vis", "de fis", "ikan"], ["🥩", "het vlees", "het flees", "daging"], ["🍲", "de soep", "de sup", "sup"], ["🍎", "de appel", "de a-pel", "apel"]]}, {"t": "phrases", "title": "In het restaurant", "items": [["Ik wil graag een thee, alstublieft.", "Saya mau teh.", "ik wil khraakh en tee, al-stü-blift"], ["Mag ik de rekening, alstublieft?", "Boleh minta tagihannya?", "makh ik de ree-ke-ning, al-stü-blift"], ["Eet smakelijk!", "Selamat makan!", "eet smaa-ke-lek"], ["Lekker!", "Enak!", "le-ker"]]}, {"t": "note", "html": "<b>Zit er varkensvlees in?</b> (Apakah ada daging babi?) · <b>Ik eet geen varkensvlees.</b> · <b>Ik drink geen alcohol.</b> · <b>Is het halal?</b> · Restoran Indonesia di Belanda kadang menjual <i>babi pangang</i> dan <i>saté babi</i>, jadi tetap tanyakan. Toko daging Turki/Maroko (<i>halal slager</i>) mudah ditemukan.", "title": "🕌 Tips makan halal"}, {"t": "dialog", "title": "In een Indonesisch restaurant", "lines": [["Ober", "🧑‍🍳", "Goedenavond! Wat wilt u eten?", "Selamat malam! Anda mau makan apa?"], ["Rina", "🧕", "Ik wil graag nasi goreng. Zit er varkensvlees in?", "Saya mau nasi goreng. Apakah ada babinya?"], ["Ober", "🧑‍🍳", "Nee, onze nasi goreng is met kip. Alles is halal.", "Tidak, nasi goreng kami pakai ayam. Semuanya halal."], ["Rina", "🧕", "Lekker! En een water, alstublieft.", "Asyik! Dan air putih."]]}, {"t": "ex", "kind": "choice", "instr": "Vragen over de dialoog", "ans": "1. a · 2. a · 3. b", "items": ["Wat eet Rina?|nasi goreng|saté babi|soep|vis", "Is het eten halal?|Ja|Nee|Niet zeker|Alleen de soep", "«Mag ik de rekening?» artinya ...|Boleh saya pesan?|Boleh minta tagihannya?|Boleh minta menu?|Boleh duduk di sini?"]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Kies het goede antwoord.", "ans": "1. a · 2. b · 3. b · 4. b · 5. b", "items": ["Ik ___ uit Indonesië.|ben|bent|is|zijn", "___ jij Nederlands?|Spreekt|Spreek|Spreken|Spreekte", "___ huis|de|het|der|die", "Ik heb ___ tijd.|niet|geen|nee|nooit", "80 = ...|achtig|tachtig|achttien|achtenzestig"]}, {"t": "ex", "kind": "tf", "instr": "Waar of niet waar?", "ans": "1. Waar · 2. Niet waar · 3. Waar", "items": ["Kata «kantor» berasal dari bahasa Belanda «kantoor».", "Huruf g Belanda dibaca seperti g dalam «gula».", "Semua kata benda jamak memakai artikel «de»."]}], "words": [{"e": "0️⃣", "w": "nul", "p": "nül", "m": "0", "u": 3}, {"e": "1️⃣", "w": "een", "p": "een", "m": "1", "u": 3}, {"e": "2️⃣", "w": "twee", "p": "twee", "m": "2", "u": 3}, {"e": "3️⃣", "w": "drie", "p": "drii", "m": "3", "u": 3}, {"e":