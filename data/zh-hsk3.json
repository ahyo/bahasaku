{"id": "zh-hsk3", "kind": "lang", "lang": "zh", "grade": null, "level": "ujian", "tag": "HSK 3", "badge": ["HSK", "3"], "title": "Persiapan HSK 3", "sub": "把, 被, pelengkap hasil, 越来越, kalimat kompleks, bacaan", "c": "#C92A2A", "c2": "#FDECEC", "c3": "#871B1B", "emojis": "🫳 🔄 🎯 📈 🧷 🥗", "intro": "", "cando": ["Memakai kalimat 把 untuk menekankan perlakuan terhadap objek.", "Membuat kalimat pasif dengan 被.", "Memakai pelengkap hasil 完、好、懂、到、见、错.", "Menyatakan perubahan bertahap dengan 越来越.", "Memakai 除了…以外、只要…就、如果…就.", "Membaca teks pendek tentang kebiasaan sehat."], "text": {"labels": {"learn": ["📚", "生词", "Kosakata"], "talk": ["🗣️", "会话", "Percakapan"], "read": ["📖", "阅读", "Membaca"], "practice": ["✏️", "练习", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "语法", "Tata Bahasa"], "write": ["📝", "Menulis", ""]}, "brand": "Persiapan HSK", "unit_word": "unit", "tip_prefix": "Tips:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Benar", "false": "Salah", "review_t": "模拟考试 · Simulasi", "review_s": "Soal campuran gaya HSK", "pron_note": "", "pron_html": ""}, "units": [{"num": 1, "en": "把字句", "id": "Kalimat 把", "emoji": "🫳", "goals": ["Memakai kalimat 把 untuk menekankan perlakuan terhadap objek.", "Menyusun kalimat 把 dengan pelengkap."], "sections": [{"t": "grammar", "title": "Kalimat 把", "head": ["Pola", "Contoh", "Arti"], "rows": [["S + 把 + O + V + lainnya", "我把作业做完了。", "Saya sudah menyelesaikan PR."], ["S + 把 + O + V + 在 + tempat", "请把书放在桌子上。", "Tolong taruh buku di atas meja."], ["S + 把 + O + V + 给 + orang", "他把钱还给我了。", "Dia mengembalikan uang kepada saya."], ["S + 没 + 把 + O + V…", "我没把门关上。", "Saya tidak menutup pintunya."]], "after": "Kata kerja dalam kalimat 把 tidak boleh berdiri sendiri. Harus ada <b>pelengkap</b> setelahnya (了、完、在…、给…). Kata ingkar 没/不 diletakkan <b>sebelum</b> 把."}, {"t": "vocab", "title": "Kata HSK 3", "cols": 3, "items": [["📥", "放", "fàng", "menaruh"], ["🚪", "关", "guān", "menutup"], ["↩️", "