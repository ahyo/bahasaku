{"id": "en-1", "lang": "en", "grade": 1, "level": "sd", "title": "Hello English!", "sub": "Belajar sambil bermain · Untuk siswa Kelas 1 SD", "c": "#FF5D73", "c2": "#FFE3E8", "c3": "#FF9A5A", "emojis": "🍎 🐱 🎈 ⭐ 🌈 🐶 🖍️ 🐰 👋 🐤 🌸 🔢", "intro": "", "cando": ["Menyapa dan memperkenalkan diri dalam bahasa Inggris.", "Berhitung 1–10.", "Menyebut warna, anggota keluarga, anggota tubuh, dan hewan.", "Memakai kata ajaib: <i>please, thank you, sorry</i>.", "Menyanyikan lagu-lagu bahasa Inggris sederhana."], "text": {"labels": {"learn": ["📚", "Let's Learn!", "Ayo Belajar"], "talk": ["🗣️", "Let's Talk!", "Ayo Berbicara"], "read": ["📖", "Let's Read!", "Ayo Membaca"], "practice": ["✏️", "Let's Practice!", "Ayo Berlatih"], "sing": ["🎵", "Let's Sing!", "Ayo Bernyanyi"], "play": ["🎲", "Let's Play!", "Ayo Bermain"], "grammar": ["🧩", "Let's Build Sentences!", "Ayo Menyusun Kalimat"], "write": ["📝", "Let's Write!", "Ayo Menulis"]}, "brand": "Fun English", "unit_word": "unit", "tip_prefix": "Kiko says:", "fun_h": "🌟 Fun Fact! <small>Tahukah kamu?</small>", "word_box": "Word Box:", "true": "True", "false": "False", "review_t": "Review Time!", "review_s": "Evaluasi — Ayo uji kemampuanmu!", "pron_note": "Tulisan di dalam garis miring, misalnya <b>apple</b> <span class=\"vp inl\">/é-pel/</span>, adalah <b>cara mengucapkan</b> kata itu. Bacalah seperti membaca tulisan bahasa Indonesia. Huruf <b>é</b> dibaca seperti “e” pada kata <i>“bebek”</i>, sedangkan <b>e</b> biasa dibaca seperti “e” pada kata <i>“emas”</i>. Tanda ini hanya bantuan — cara terbaik tetap <b>mendengarkan</b> guru, orang tua, lagu, atau video berbahasa Inggris. 🎧", "pron_html": null}, "units": [{"num": 1, "en": "Hello!", "id": "Salam dan Perkenalan", "emoji": "👋", "goals": ["Menyapa teman dan guru dalam bahasa Inggris.", "Memperkenalkan nama sendiri.", "Mengucapkan terima kasih, maaf, dan selamat tinggal."], "sections": [{"t": "vocab", "title": "Greetings — Kata sapaan", "items": [["👋", "Hello!", "he-lo", "Halo!"], ["🙌", "Hi!", "hai", "Hai!"], ["🌅", "Good morning!", "gud mor-ning", "Selamat pagi!"], ["☀️", "Good afternoon!", "gud af-ter-nun", "Selamat siang/sore!"], ["🌆", "Good evening!", "gud iv-ning", "Selamat malam! (saat bertemu)"], ["🌙", "Good night!", "gud nait", "Selamat tidur/malam! (saat berpisah)"], ["🚶", "Goodbye!", "gud-bai", "Selamat tinggal!"], ["👀", "See you!", "sii yu", "Sampai jumpa!"]], "cols": 4, "label": "learn", "dict": true}, {"t": "vocab", "title": "Magic words — Kata ajaib", "items": [["🙏", "Please", "pliis", "Tolong / silakan"], ["💝", "Thank you!", "thenk yu", "Terima kasih!"], ["😊", "You're welcome.", "yor wel-kam", "Sama-sama."], ["😔", "Sorry.", "so-ri", "Maaf."]], "cols": 4, "label": "learn", "dict": true}, {"t": "tip", "html": "Kata <b>please</b>, <b>thank you</b>, dan <b>sorry</b> disebut <b>magic words</b> (kata ajaib). Pakai setiap hari supaya kamu disayang teman! 💖"}, {"t": "dialog", "title": "Meeting a new friend — Bertemu teman baru", "lines": [["Dina", "👧", "Hello! Good morning!", "Halo! Selamat pagi!"], ["Budi", "👦", "Hi! Good morning!", "Hai! Selamat pagi!"], ["Dina", "👧", "I am Dina. What is your name?", "Aku Dina. Siapa namamu?"], ["Budi", "👦", "My name is Budi.", "Namaku Budi."], ["Dina", "👧", "Nice to meet you, Budi!", "Senang bertemu denganmu, Budi!"], ["Budi", "👦", "Nice to meet you too!", "Senang bertemu denganmu juga!"]]}, {"t": "dialog", "title": "How are you? — Apa kabar?", "lines": [["Teacher", "👩‍🏫", "Good morning, children! How are you?", "Selamat pagi, anak-anak! Apa kabar?"], ["Students", "🧒", "Good morning, teacher! I am fine, thank you. And you?", "Selamat pagi, Bu Guru! Kabar kami baik, terima kasih. Bagaimana dengan Ibu?"], ["Teacher", "👩‍🏫", "I am fine too. Thank you!", "Ibu juga baik. Terima kasih!"]]}, {"t": "note", "html": "Untuk memperkenalkan diri, kamu bisa bilang:<ul><li><b>My name is</b> Sari. → Namaku Sari.</li><li><b>I am</b> Sari. → Aku Sari.</li></ul>Untuk menanyakan nama teman: <b>What is your name?</b> → Siapa namamu?", "title": "Ingat, ya!"}, {"t": "song", "title": "Good Morning to You", "lines": ["Good morning to you,", "Good morning to you,", "Good morning, dear teacher,", "Good morning to you! 🌞"], "info": "Nyanyikan dengan nada lagu <i>“Happy Birthday”</i>. Ganti <i>teacher</i> dengan <i>friends</i>, <i>mother</i>, atau <i>father</i>!"}, {"t": "ex", "kind": "match", "instr": "Pasangkan gambar dengan sapaan yang tepat. Tarik garis!", "ans": "1–b, 2–d, 3–c, 4–a", "left": ["🌅 (pagi hari)", "☀️ (siang hari)", "🌆 (malam hari, bertemu)", "🌙 (mau tidur)"], "right": ["Good night!", "Good morning!", "Good evening!", "Good afternoon!"]}, {"t": "ex", "kind": "choice", "instr": "Pilih jawaban yang benar. Lingkari a, b, atau c!", "ans": "1. b · 2. a · 3. b · 4. a", "items": ["Temanmu memberi hadiah. Kamu bilang …|Sorry.|Thank you!|Good night!", "Kamu menginjak kaki temanmu. Kamu bilang …|Sorry.|Hello!|Goodbye!", "Pulang sekolah, kamu berpamitan. Kamu bilang …|Good morning!|Goodbye!|Please.", "Temanmu bilang “Thank you!”. Kamu menjawab …|You're welcome.|Sorry.|See you!"]}, {"t": "ex", "kind": "write", "instr": "Tulis namamu, lalu ucapkan dengan keras! 🗣️", "ans": "Jawaban bebas (nama anak).", "items": ["My name is ___ ."]}, {"t": "ex", "kind": "draw", "instr": "Gambar wajahmu dan wajah sahabatmu. Tulis nama kalian!", "ans": "Jawaban bebas.", "h": 120, "caps": ["This is me. My name is ___ .", "This is my friend. Her/His name is ___ ."]}]}, {"num": 2, "en": "Numbers 1–10", "id": "Bilangan 1 sampai 10", "emoji": "🔢", "goals": ["Menyebut dan menulis angka 1–10 dalam bahasa Inggris.", "Menghitung benda dengan <b>How many …?</b>"], "sections": [{"t": "vocab", "title": "Let's count! — Ayo berhitung!", "items": [["1️⃣", "one", "wan", "satu"], ["2️⃣", "two", "tu", "dua"], ["3️⃣", "three", "thrii", "tiga"], ["4️⃣", "four", "for", "empat"], ["5️⃣", "five", "faiv", "lima"], ["6️⃣", "six", "siks", "enam"], ["7️⃣", "seven", "se-ven", "tujuh"], ["8️⃣", "eight", "eit", "delapan"], ["9️⃣", "nine", "nain", "sembilan"], ["🔟", "ten", "ten", "sepuluh"]], "cols": 5, "label": "learn", "dict": true}, {"t": "vocab", "title": "Count the pictures — Hitung gambarnya", "items": [["⭐", "one star", "wan star", "satu bintang"], ["🍎🍎", "two apples", "tu é-pels", "dua apel"], ["🐱🐱🐱", "three cats", "thrii kets", "tiga kucing"], ["🎈🎈🎈🎈", "four balloons", "for ba-luuns", "empat balon"]], "cols": 4, "label": "learn", "dict": false}, {"t": "note", "html": "Kalau bendanya <b>lebih dari satu</b>, tambahkan huruf <b>-s</b> di belakangnya.<ul><li>one ball → two ball<b>s</b> ⚽⚽</li><li>one cat → three cat<b>s</b> 🐱🐱🐱</li></ul>", "title": "Ingat, ya!"}, {"t": "dialog", "title": "How many? — Berapa banyak?", "lines": [["Mother", "👩", "Siti, how many apples?", "Siti, ada berapa apel?"], ["Siti", "👧", "One, two, three... Three apples!", "Satu, dua, tiga... Tiga apel!"], ["Mother", "👩", "Very good! 👍", "Pintar sekali!"]]}, {"t": "song", "title": "One, Two, Buckle My Shoe", "lines": ["One, two, buckle my shoe, 👟", "Three, four, knock at the door, 🚪", "Five, six, pick up sticks, 🥢", "Seven, eight, lay them straight, 📏", "Nine, ten, a big fat hen! 🐔"], "info": "Lagu anak tradisional dari Inggris. Hitung dengan jarimu sambil bernyanyi!"}, {"t": "ex", "kind": "count", "instr": "Hitung gambarnya, lalu tulis angkanya dalam bahasa Inggris!", "ans": "🐟 three · 🌸 five · 🚗 two · 🍌 seven · ⭐ four · 🐤 six", "items": ["🐟|3", "🌸|5", "🚗|2", "🍌|7", "⭐|4", "🐤|6"]}, {"t": "ex", "kind": "match", "instr": "Pasangkan angka dengan kata yang benar!", "ans": "1–d (8 = eight), 2–a (1 = one), 3–e (10 = ten), 4–c (6 = six), 5–b (9 = nine)", "left": ["8", "1", "10", "6", "9"], "right": ["one", "nine", "six", "eight", "ten"]}, {"t": "ex", "kind": "fill", "instr": "Lengkapi huruf yang hilang!", "ans": "1. five (i) · 2. two (w) · 3. seven (e) · 4. three (e) · 5. nine (i)", "items": ["f _ v e  (5)", "t _ o  (2)", "s e v _ n  (7)", "t h r _ e  (3)", "n _ n e  (9)"]}, {"t": "fun", "html": "Jari tanganmu ada <b>ten</b> (10) dan jari kakimu juga <b>ten</b>. Jadi, semuanya ada <b>twenty</b> (20)! 🖐️🖐️🦶🦶"}]}, {"num": 3, "en": "Colors", "id": "Warna-warni", "emoji": "🎨", "goals": ["Menyebut 10 warna dalam bahasa Inggris.", "Bertanya dan menjawab <b>What color is it?</b>"], "sections": [{"t": "vocab", "title": "Colors — Warna", "items": [["<i class=\"sw\" style=\"background:#e63946\"></i>", "red", "red", "merah"], ["<i class=\"sw\" style=\"background:#1e6fe0\"></i>", "blue", "bluu", "biru"], ["<i class=\"sw\" style=\"background:#ffd60a\"></i>", "yellow", "ye-lou", "kuning"], ["<i class=\"sw\" style=\"background:#2dc653\"></i>", "green", "griin", "hijau"], ["<i class=\"sw\" style=\"background:#fb8500\"></i>", "orange", "o-rinj", "oranye/jingga"], ["<i class=\"sw\" style=\"background:#8338ec\"></i>", "purple", "per-pel", "ungu"], ["<i class=\"sw\" style=\"background:#ff8fab\"></i>", "pink", "pink", "merah muda"], ["<i class=\"sw\" style=\"background:#8d5524\"></i>", "brown", "braun", "cokelat"], ["<i class=\"sw\" style=\"background:#111\"></i>", "black", "blek", "hitam"], ["<i class=\"sw\" style=\"background:#fff\"></i>", "white", "wait", "putih"]], "cols": 5, "label": "learn", "dict": true}, {"t": "vocab", "title": "Colorful things — Benda berwarna", "items": [["🍓", "red strawberry", "red stro-be-ri", "stroberi merah"], ["🍌", "yellow banana", "ye-lou ba-na-na", "pisang kuning"], ["🐸", "green frog", "griin frog", "katak hijau"], ["🐳", "blue whale", "bluu weil", "paus biru"]], "cols": 4, "label": "learn", "dict": false}, {"t": "grammar", "title": "Asking about colors", "head": ["Question — Pertanyaan", "Answer — Jawaban"], "rows": [["What color is it? 🍎", "It is **red**."], ["What color is it? 🌳", "It is **green**."], ["What color is it? ☁️", "It is **white**."]], "after": "<b>Tips:</b> Dalam bahasa Inggris, warna diletakkan <b>sebelum</b> benda: <i>a <b>red</b> car</i> 🚗 = mobil <b>merah</b>."}, {"t": "dialog", "title": "My favorite color — Warna kesukaanku", "lines": [["Rina", "👧", "What is your favorite color?", "Apa warna kesukaanmu?"], ["Andi", "👦", "My favorite color is blue. And you?", "Warna kesukaanku biru. Kalau kamu?"], ["Rina", "👧", "I like pink!", "Aku suka merah muda!"]]}, {"t": "song", "title": "Rainbow Colors 🌈", "lines": ["Red and orange, yellow, green,", "Blue and purple — can you see?", "Pretty colors in the sky,", "Rainbow, rainbow, way up high! 🌈"], "info": "Nyanyikan dengan nada bebas atau nada lagu <i>“Twinkle Twinkle Little Star”</i>."}, {"t": "ex", "kind": "colorit", "instr": "Color it! Warnai bentuk di bawah ini sesuai warnanya dengan krayon 🖍️", "ans": "Anak mewarnai sesuai warna yang tertulis.", "items": ["red|circle", "blue|square", "yellow|star", "green|triangle", "pink|heart", "purple|oval"]}, {"t": "ex", "kind": "fill", "instr": "What color is it? Tulis warnanya!", "ans": "1. yellow · 2. red · 3. green · 4. orange · 5. white · 6. purple", "items": ["🍌 It is ___ .", "🍓 It is ___ .", "🐸 It is ___ .", "🍊 It is ___ .", "☁️ It is ___ .", "🍆 It is ___ ."], "bank": ["white", "yellow", "orange", "red", "purple", "green"]}, {"t": "fun", "html": "Pelangi memiliki <b>tujuh</b> warna. Dalam bahasa Inggris pelangi disebut <b>rainbow</b> 🌈 — dari kata <i>rain</i> (hujan) dan <i>bow</i> (busur)."}]}, {"num": 4, "en": "My Family", "id": "Keluargaku", "emoji": "👨‍👩‍👧‍👦", "goals": ["Menyebut anggota keluarga.", "Memperkenalkan keluarga dengan <b>This is my …</b>"], "sections": [{"t": "vocab", "title": "Family members — Anggota keluarga", "items": [["👨", "father / dad", "fa-der / ded", "ayah"], ["👩", "mother / mom", "ma-der / mom", "ibu"], ["👦", "brother", "bra-der", "saudara laki-laki"], ["👧", "sister", "sis-ter", "saudara perempuan"], ["👴", "grandfather / grandpa", "grend-fa-der / grend-pa", "kakek"], ["👵", "grandmother / grandma", "grend-ma-der / grend-ma", "nenek"], ["👶", "baby", "bei-bi", "bayi / adik bayi"], ["🧔", "uncle", "ang-kel", "paman / om"], ["👱‍♀️", "aunt", "ent", "bibi / tante"], ["🙋", "me", "mii", "aku"]], "cols": 5, "label": "learn", "dict": true}, {"t": "grammar", "title": "Introducing my family", "head": ["English", "Bahasa Indonesia"], "rows": [["**This is my** father.", "Ini ayahku."], ["**This is my** mother.", "Ini ibuku."], ["**He is** my brother. 👦", "Dia saudara laki-lakiku."], ["**She is** my sister. 👧", "Dia saudara perempuanku."]], "after": "<b>He</b> dipakai untuk laki-laki 👦, <b>She</b> dipakai untuk perempuan 👧. Dalam bahasa Indonesia, keduanya berarti “dia”."}, {"t": "reading", "title": "My Family", "paras": ["Hello! My name is **Lala**. 👧", "This is my family. This is my father. His name is Mr. Anton. This is my mother. Her name is Mrs. Wati.", "This is my brother, Doni. He is ten. And this is my baby sister, Mia. She is one.", "I love my family! ❤️"], "gloss": [["love", "sayang / cinta"], ["his name", "namanya (laki-laki)"], ["her name", "namanya (perempuan)"]], "pic": "👨‍👩‍👧‍👦"}, {"t": "ex", "kind": "tf", "instr": "Baca cerita “My Family” lagi. Lingkari True (benar) atau False (salah)!", "ans": "1. True · 2. True · 3. False (Mia is one) · 4. True", "items": ["Lala has a brother.", "Her father's name is Mr. Anton.", "Mia is ten years old.", "Lala loves her family."]}, {"t": "ex", "kind": "fill", "instr": "Lengkapi dengan kata yang tepat!", "ans": "1. father · 2. grandmother · 3. sister · 4. baby", "bank": ["grandmother", "father", "baby", "sister"], "items": ["👨 This is my ___ .", "👵 This is my ___ .", "👧 She is my ___ .", "👶 This is my ___ ."]}, {"t": "ex", "kind": "draw", "instr": "Draw your family! Gambar keluargamu, lalu lengkapi kalimatnya.", "ans": "Jawaban bebas.", "h": 170, "caps": ["This is my ___ .", "This is my ___ ."]}, {"t": "song", "title": "Finger Family 🖐️", "lines": ["Daddy finger, daddy finger, where are you?", "Here I am, here I am. How do you do?", "Mommy finger, mommy finger, where are you?", "Here I am, here I am. How do you do?", "(Brother finger… Sister finger… Baby finger…)"], "info": "Angkat satu jari setiap menyebut anggota keluarga. 👍"}]}, {"num": 5, "en": "My Body", "id": "Anggota Tubuhku", "emoji": "🧍", "goals": ["Menyebut bagian-bagian tubuh.", "Mengikuti perintah sederhana <b>Touch your …!</b>"], "sections": [{"t": "vocab", "title": "Parts of the body — Bagian tubuh", "items": [["🙂", "head", "hed", "kepala"], ["💇", "hair", "heir", "rambut"], ["👀", "eyes", "ais", "mata"], ["👂", "ears", "iirs", "telinga"], ["👃", "nose", "nous", "hidung"], ["👄", "mouth", "mauth", "mulut"], ["🦷", "teeth", "tiith", "gigi"], ["💪", "arm", "arm", "lengan"], ["✋", "hand", "hend", "tangan"], ["🦵", "leg", "leg", "kaki (tungkai)"], ["🦶", "foot / feet", "fut / fiit", "telapak kaki"], ["👆", "finger", "fing-ger", "jari"]], "cols": 4, "label": "learn", "dict": true}, {"t": "note", "html": "Kita punya <b>satu</b> hidung dan <b>dua</b> mata. Perhatikan bedanya:<ul><li>one eye → two eye<b>s</b> 👀</li><li>one ear → two ear<b>s</b></li><li>one hand → two hand<b>s</b></li><li>one foot → two <b>feet</b> (berubah, bukan <i>foots</i>!)</li><li>one tooth → many <b>teeth</b> 🦷</li></ul>", "title": "Ingat, ya!"}, {"t": "raw", "html": "<div class=\"vgrid c4\"><div class=\"vcard\"><div class=\"ve\">👃</div><div class=\"vw\">Touch your nose!</div><div class=\"vm\">Sentuh hidungmu!</div></div><div class=\"vcard\"><div class=\"ve\">👂</div><div class=\"vw\">Touch your ears!</div><div class=\"vm\">Sentuh telingamu!</div></div><div class=\"vcard\"><div class=\"ve\">👏</div><div class=\"vw\">Clap your hands!</div><div class=\"vm\">Tepuk tanganmu!</div></div><div class=\"vcard\"><div class=\"ve\">🦶</div><div class=\"vw\">Stamp your feet!</div><div class=\"vm\">Hentakkan kakimu!</div></div><div class=\"vcard\"><div class=\"ve\">👀</div><div class=\"vw\">Close your eyes!</div><div class=\"vm\">Tutup matamu!</div></div><div class=\"vcard\"><div class=\"ve\">😮</div><div class=\"vw\">Open your mouth!</div><div class=\"vm\">Buka mulutmu!</div></div><div class=\"vcard\"><div class=\"ve\">🙋</div><div class=\"vw\">Raise your hand!</div><div class=\"vm\">Angkat tanganmu!</div></div><div class=\"vcard\"><div class=\"ve\">🙆</div><div class=\"vw\">Touch your head!</div><div class=\"vm\">Sentuh kepalamu!</div></div></div>", "label": "play", "title": "Simon Says! — Permainan “Simon berkata”"}, {"t": "tip", "html": "Cara bermain <b>Simon Says</b>: Kalau guru bilang “<i>Simon says, touch your nose!</i>”, kamu harus melakukannya. Tapi kalau guru hanya bilang “<i>Touch your nose!</i>” tanpa “Simon says”, jangan bergerak! Siapa yang salah, keluar dari permainan. 😆"}, {"t": "song", "title": "Head, Shoulders, Knees and Toes", "lines": ["Head, shoulders, knees and toes, knees and toes,", "Head, shoulders, knees and toes, knees and toes,", "And eyes and ears and mouth and nose,", "Head, shoulders, knees and toes, knees and toes! 🎉"], "info": "<i>shoulders</i> = bahu · <i>knees</i> = lutut · <i>toes</i> = jari kaki. Sentuh bagian tubuh yang disebut sambil bernyanyi!"}, {"t": "ex", "kind": "match", "instr": "Pasangkan gambar dengan katanya!", "ans": "1–c (nose), 2–a (eyes), 3–e (hand), 4–d (ears), 5–b (mouth)", "left": ["👃", "👀", "✋", "👂", "👄"], "right": ["eyes", "mouth", "nose", "ears", "hand"]}, {"t": "ex", "kind": "html", "instr": "Label the body! Tulis nama bagian tubuh pada garis.", "ans": "1. head · 2. eye · 3. mouth · 4. hand · 5. leg · 6. foot", "bank": ["head", "hand", "leg", "eye", "mouth", "foot"], "html": "<div style=\"display:flex;align-items:center;gap:26px;justify-content:center\"><div style=\"line-height:2.6;text-align:right\">1. <span class=\"blank\"></span> ←<br>2. <span class=\"blank\"></span> ←<br>3. <span class=\"blank\"></span> ←</div><div style=\"font-size:120px;line-height:1\">🧍</div><div style=\"line-height:2.6\">→ 4. <span class=\"blank\"></span><br>→ 5. <span class=\"blank\"></span><br>→ 6. <span class=\"blank\"></span></div></div><div style=\"font-size:.85em;color:#777;text-align:center\">Petunjuk: 1 = paling atas (kepala), 2 = mata, 3 = mulut, 4 = tangan, 5 = kaki, 6 = telapak kaki</div>"}, {"t": "ex", "kind": "fill", "