{"id": "jv-1", "kind": "lang", "lang": "jv", "grade": null, "level": "umum", "tag": "Dasar", "badge": ["Jawa", "1"], "title": "Basa Jawa Dasar", "sub": "Salam, unggah-ungguh, keluarga, angka, pasar, paribasan", "c": "#A0522D", "c2": "#F8EDE6", "c3": "#6B3315", "emojis": "🙏 🪜 👨‍👩‍👧‍👦 🔢 🧺 📜", "intro": "<div class=\"note\"><div class=\"note-h\">📌 Tentang kursus ini</div>Bahasa Jawa dipakai oleh lebih dari 80 juta orang. Kursus ini memperkenalkan <b>unggah-ungguh basa</b> (tingkat tutur ngoko, krama, dan krama inggil) yang menjadi inti kesopanan berbahasa Jawa. Ejaan memakai ejaan Latin baku. Pengucapan dapat sedikit berbeda antara daerah Yogyakarta/Solo, Jawa Timur, dan pesisiran.</div>", "cando": ["Mengucapkan salam dalam bahasa Jawa.", "Mengenal kata kerja dan kata benda dalam tiga tingkat tutur.", "Menyebut anggota keluarga dalam bahasa Jawa.", "Menghitung dalam bahasa Jawa ngoko dan krama.", "Berbelanja di pasar tradisional dengan bahasa Jawa krama.", "Memahami peribahasa (paribasan) Jawa yang populer."], "text": {"labels": {"learn": ["📚", "Tembung", "Kosakata"], "talk": ["🗣️", "Pacelathon", "Percakapan"], "read": ["📖", "Maca", "Membaca"], "practice": ["✏️", "Gladhen", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Unggah-ungguh", "Tingkat tutur"], "write": ["📝", "Menulis", ""]}, "brand": "Basa Jawa", "unit_word": "piwulang", "tip_prefix": "Pitutur:", "fun_h": "🌟 Apa kowe ngerti?", "word_box": "Kotak Kata:", "true": "Leres", "false": "Lepat", "review_t": "Evaluasi Akhir", "review_s": "Uji kawruhmu", "pron_note": "", "pron_html": ""}, "units": [{"num": 1, "en": "Salam lan Unggah-ungguh", "id": "Salam dan sopan santun", "emoji": "🙏", "goals": ["Mengucapkan salam dalam bahasa Jawa.", "Memahami tingkat tutur ngoko, krama, dan krama inggil."], "sections": [{"t": "phrases", "title": "Salam", "items": [["Sugeng enjing.", "Selamat pagi."], ["Sugeng siang.", "Selamat siang."], ["Sugeng sonten.", "Selamat sore."], ["Sugeng dalu.", "Selamat malam."], ["Sugeng rawuh.", "Selamat datang."], ["Pripun kabaripun?", "Bagaimana kabarnya? (krama)"], ["Pangestunipun, sae.", "Atas doa restunya, baik. (krama)"], ["Piye kabare?", "Apa kabar? (ngoko, kepada teman)"], ["Matur nuwun.", "Terima kasih."], ["Sami-sami.", "Sama-sama."], ["Nyuwun pangapunten.", "Mohon maaf."], ["Nderek langkung.", "Permisi, numpang lewat."]]}, {"t": "grammar", "title": "Tingkat tutur (unggah-ungguh basa)", "head": ["Tingkat", "Dipakai kepada", "Contoh"], "rows": [["Ngoko", "teman sebaya, adik, orang yang akrab", "Kowe arep lunga menyang ngendi?"], ["Krama", "orang yang belum akrab / lebih tua", "Sampeyan badhe kesah dhateng pundi?"], ["Krama inggil", "orang tua, guru, orang yang dihormati", "Panjenengan badhe tindak dhateng pundi?"]], "after": "Ketiga kalimat di atas berarti \"Kamu/Anda mau pergi ke mana?\". Untuk <b>diri sendiri</b>, jangan memakai krama inggil. Contohnya: <i>Kula badhe <b>kesah</b></i>, bukan <i>✗ Kula badhe tindak</i>."}, {"t": "vocab", "title": "Tembung salam", "cols": 3, "items": [["🙏", "matur nuwun", "", "terima kasih"], ["😊", "sami-sami", "", "sama-sama"], ["🙇", "nyuwun pangapunten", "", "mohon maaf"], ["👍", "sae", "", "baik (krama)"], ["👌", "apik", "", "baik, bagus (ngoko)"], ["👋", "sugeng rawuh", "", "selamat datang"], ["🙋", "kula", "", "saya (krama)"], ["🫵", "panjenengan", "", "Anda (krama inggil)"]]}, {"t": "dialog", "title": "Ketemu Bu Guru", "lines": [["Rina", "👧", "Sugeng enjing, Bu. Pripun kabaripun?", "Selamat pagi, Bu. Bagaimana kabarnya?"], ["Bu Guru", "👩‍🏫", "Pangestunipun, sae. Rina piye kabare?", "Atas doa restunya, baik. Rina apa kabar?"], ["Rina", "👧", "Sae, Bu. Matur nuwun.", "Baik, Bu. Terima kasih."]]}, {"t": "ex", "kind": "choice", "instr": "Pilihen sing bener. (Pilih yang benar)", "ans": "1. b · 2. c · 3. a · 4. b", "items": ["Sore hari bertemu tetangga, kamu menyapa ...|Sugeng enjing|Sugeng sonten|Sugeng dalu|Sugeng rawuh", "Kepada guru, \"Anda\" dalam bahasa Jawa adalah ...|kowe|sampeyan|panjenengan|aku", "\"Matur nuwun\" dijawab ...|Sami-sami|Nyuwun pangapunten|Sugeng dalu|Nderek langkung", "Lewat di depan orang tua sambil membungkuk, kamu berkata ...|Piye kabare?|Nderek langkung|Sugeng rawuh|Sami-sami"]}]}, {"num": 2, "en": "Ngoko, Krama, Krama Inggil", "id": "Kata dalam tiga tingkat tutur", "emoji": "🪜", "goals": ["Mengenal kata kerja dan kata benda dalam tiga tingkat tutur.", "Memilih kata yang sopan untuk orang lain dan untuk diri sendiri."], "sections": [{"t": "grammar", "title": "Tembung ing telung tingkat", "head": ["Ngoko", "Krama", "Krama inggil", "Arti"], "rows": [["mangan", "nedha", "dhahar", "makan"], ["turu", "tilem", "sare", "tidur"], ["lunga", "kesah", "tindak", "pergi"], ["teka", "dugi", "rawuh", "datang"], ["omah", "griya", "dalem", "rumah"], ["jeneng", "nama", "asma", "nama"], ["weruh", "sumerep", "pirsa", "tahu, melihat"], ["lara", "sakit", "gerah", "sakit"], ["adus", "adus", "siram", "mandi"], ["kowe", "sampeyan", "panjenengan", "kamu, Anda"]], "after": "Krama inggil hanya dipakai untuk <b>orang lain yang dihormati</b>. Contoh: <i>Bapak <b>dhahar</b></i> (Bapak makan), tetapi <i>Kula <b>nedha</b></i> (saya makan)."}, {"t": "vocab", "title": "Tembung krama", "cols": 3, "items": [["🍽️", "nedha", "", "makan (krama)"], ["🍛", "dhahar", "", "makan (krama inggil)"], ["😴", "sare", "", "tidur (krama inggil)"], ["🚶", "tindak", "", "pergi (krama inggil)"], ["🏃", "rawuh", "", "datang (krama inggil)"], ["🏠", "dalem", "", "rumah (krama inggil)"], ["🏷️", "asma", "", "nama (krama inggil)"], ["🤒", "gerah", "", "sakit (krama inggil)"]]}, {"t": "ex", "kind": "choice", "instr": "Pilihen tembung sing trep. (Pilih kata yang tepat)", "ans": "1. c · 2. b · 3. c · 4. a · 5. b", "items": ["Simbah lagi ___. (tidur, kepada orang tua)|turu|tilem|sare|ngorok", "Kula sampun ___. (saya sudah makan)|dhahar|nedha|mangan dhahar|sare", "Bapak guru sampun ___. (sudah datang)|teka|dugi|rawuh|tindak", "Asmanipun panjenengan sinten? artinya ...|Siapa nama Anda?|Di mana rumah Anda?|Anda mau ke mana?|Anda sakit apa?", "Bentuk ngoko dari \"griya\" adalah ...|dalem|omah|wisma|kamar"]}, {"t": "ex", "kind": "match", "instr": "Jodohna ngoko lan krama inggil.", "ans": "1–b · 2–c · 3–d · 4–e · 5–a", "left": ["mangan", "turu", "lunga", "omah", "lara"], "right": ["gerah", "dhahar", "sare", "tindak", "dalem"]}]}, {"num": 3, "en": "Kulawarga", "id": "Keluarga", "emoji": "👨‍👩‍👧‍👦", "goals": ["Menyebut anggota keluarga dalam bahasa Jawa.", "Memperkenalkan keluarga dengan sopan."], "sections": [{"t": "vocab", "title": "Kulawarga", "cols": 3, "items": [["👨", "bapak", "", "ayah"], ["👩", "ibu / biyung", "", "ibu"], ["👴", "simbah kakung / eyang kakung", "", "kakek"], ["👵", "simbah putri / eyang putri", "", "nenek"], ["👦", "mas / kangmas", "", "kakak laki-laki"], ["👧", "mbak / mbakyu", "", "kakak perempuan"], ["🧒", "adhi", "", "adik"], ["👶", "anak", "", "anak"], ["🧔", "paklik / pakdhe", "", "paman (adik / kakak orang tua)"], ["👩‍🦰", "bulik / budhe", "", "bibi (adik / kakak orang tua)"], ["🧑‍🤝‍🧑", "sedulur", "", "saudara"], ["👪", "kulawarga", "", "keluarga"]]}, {"t": "reading", "title": "Kulawargaku", "paras": ["<div class=\"rtitle\">Kulawargaku</div>Jenengku Bayu. Aku manggon ing Klaten. Kulawargaku ana lima: bapak, ibu, mbakyu, adhiku, lan aku. Bapakku dadi petani, ibuku dadi guru SD. Mbakyuku kuliah ing Yogyakarta. Adhiku isih cilik, umure enem taun. Saben Minggu aku lan bapak tindak menyang sawah. Aku seneng banget karo kulawargaku."], "gloss": [["manggon", "tinggal"], ["dadi", "menjadi"], ["isih cilik", "masih kecil"], ["saben", "setiap"], ["seneng", "senang"]]}, {"t": "ex", "kind": "choice", "instr": "Wangsulana miturut wacan. (Jawab sesuai bacaan)", "ans": "1. b · 2. b · 3. c · 4. b", "items": ["Bayu manggon ing ngendi?|Yogyakarta|Klaten|Solo|Semarang", "Kulawargane Bayu ana pira?|papat|lima|enem|telu", "Ibune Bayu dadi apa?|petani|dokter|guru SD|pedagang", "Adhine Bayu umure pira?|lima taun|enem taun|pitu taun|sepuluh taun"]}, {"t": "tip", "html": "Dalam bacaan tertulis <i>bapak <b>tindak</b> menyang sawah</i>. Kata <b>tindak</b> adalah krama inggil, dipakai untuk menghormati bapak, meskipun kalimatnya berbahasa ngoko."}]}, {"num": 4, "en": "Wilangan", "id": "Angka", "emoji": "🔢", "goals": ["Menghitung dalam bahasa Jawa ngoko dan krama.", "Mengenal bilangan khusus: selikur, selawe, seket, sewidak."], "sections": [{"t": "grammar", "title": "Wilangan 1–10", "head": ["Angka", "Ngoko", "Krama"], "rows": [["1", "siji", "setunggal"], ["2", "loro", "kalih"], ["3", "telu", "tiga"], ["4", "papat", "sekawan"], ["5", "lima", "gangsal"], ["6", "enem", "enem"], ["7", "pitu", "pitu"], ["8", "wolu", "wolu"], ["9", "sanga", "sanga"], ["10", "sepuluh", "sedasa"]]}, {"t": "grammar", "title": "Wilangan khusus", "head": ["Angka", "Basa Jawa", "Catatan"], "rows": [["11 · 12 · 13", "sewelas · rolas · telulas", "+ -las"], ["20", "rong puluh", ""], ["21–29", "selikur · rolikur · … · sangang likur", "pakai -likur"], ["25", "selawe", "khusus"], ["50", "seket", "khusus"], ["60", "sewidak", "khusus"], ["100 · 1.000", "satus · sewu", ""]], "after": "Ada ungkapan bahwa usia 21–29 (<b>likur</b>) adalah masa <i>lungguh kursi</i>, yaitu ketika seseorang mulai mendapat pekerjaan dan kedudukan."}, {"t": "vocab", "title": "Wilangan", "cols": 4, "items": [["1️⃣", "siji", "", "satu"], ["2️⃣", "loro", "", "dua"], ["3️⃣", "telu", "", "tiga"], ["4️⃣", "papat", "", "empat"], ["5️⃣", "lima", "", "lima"], ["🔟", "sepuluh", "", "sepuluh"], ["2️⃣5️⃣", "selawe", "", "dua puluh lima"], ["5️⃣0️⃣", "seket", "", "lima puluh"]]}, {"t": "ex", "kind": "choice", "instr": "Pilihen sing bener.", "ans": "1. b · 2. c · 3. a · 4. b · 5. a", "items": ["25 =|rong puluh lima|selawe|selikur|seket", "50 =|limang puluh|sewidak|seket|selawe", "Krama saka \"loro\" (2) =|kalih|kalah|tiga|sekawan", "12 =|sepuluh loro|rolas|rolikur|rong puluh", "Krama saka \"lima\" =|gangsal|lima|sedasa|sekawan"]}]}, {"num": 5, "en": "Ing Pasar", "id": "Di pasar", "emoji": "🧺", "goals": ["Berbelanja di pasar tradisional dengan bahasa Jawa krama.", "Mengenal nama makanan khas Jawa."], "sections": [{"t": "vocab", "title": "Ing pasar", "cols": 3, "items": [["🍚", "sega / sekul", "", "nasi (ngoko / krama)"], ["🥤", "wedang", "", "minuman (hangat)"], ["🍈", "gudeg", "", "gudeg (nangka muda)"], ["🍪", "jajan pasar", "", "kue tradisional"], ["🛒", "tuku / tumbas", "", "membeli (ngoko / krama)"], ["💰", "rega / regi", "", "harga (ngoko / krama)"], ["❓", "pira / pinten", "", "berapa (ngoko / krama)"], ["💸", "larang / awis", "", "mahal (ngoko / krama)"], ["🏷️", "murah / mirah", "", "murah (ngoko / krama)"], ["😋", "enak / eco", "", "enak (ngoko / krama)"]]}, {"t": "dialog", "title": "Tumbas gudeg", "lines": [["Rina", "👧", "Bu, gudegipun pinten setunggal?", "Bu, gudegnya berapa satu (porsi)?"], ["Bakul", "🧕", "Sedasa ewu, Mbak.", "Sepuluh ribu, Mbak."], ["Rina", "👧", "Kula tumbas kalih, nggih. Mboten ngagem sambel.", "Saya beli dua, ya. Tidak pakai sambal."], ["Bakul", "🧕", "Nggih, Mbak. Sedaya kalih dasa ewu.", "Ya, Mbak. Semuanya dua puluh ribu."], ["Rina", "👧", "Punika artanipun. Matur nuwun, Bu.", "Ini uangnya. Terima kasih, Bu."]]}, {"t": "ex", "kind": "choice", "instr": "Pilihen sing bener.", "ans": "1. b · 2. a · 3. c · 4. b", "items": ["\"Pinten?\" artinya ...|di mana?|berapa?|kapan?|siapa?", "Krama saka \"tuku\" =|tumbas|tuku|suwun|mundhut", "\"Awis\" artinya ...|murah|enak|mahal|manis", "\"Mboten ngagem sambel\" artinya ...|pakai sambal|tidak pakai sambal|sambalnya habis|sambalnya pedas"]}, {"t": "fun", "html": "<b>Gudeg</b> adalah makanan khas Yogyakarta yang dibuat dari nangka muda (<i>gori</i>). Nangka dimasak berjam-jam dengan santan dan gula jawa, sehingga rasanya manis dan warnanya cokelat."}]}, {"num": 6, "en": "Paribasan lan Aksara", "id": "Peribahasa dan aksara Jawa", "emoji": "📜", "goals": ["Memahami peribahasa (paribasan) Jawa yang populer.", "Mengenal 20 aksara dasar Jawa (hanacaraka)."], "sections": [{"t": "phrases", "title": "Paribasan", "items": [["Alon-alon waton kelakon.", "Pelan-pelan asal tercapai (tidak tergesa-gesa)."], ["Ajining dhiri saka lathi.", "Harga diri seseorang berasal dari ucapannya."], ["Becik ketitik, ala ketara.", "Yang baik akan terlihat, yang buruk akan ketahuan."], ["Rukun agawe santosa, crah agawe bubrah.", "Rukun membuat kuat, bertengkar membuat hancur."], ["Ana dina ana upa.", "Ada hari, ada rezeki."], ["Ojo dumeh.", "Jangan sok / mentang-mentang."]]}, {"t": "grammar", "title": "Aksara Jawa (Hanacaraka)", "head": ["Baris", "Aksara", "Maknanya (legenda Aji Saka)"], "rows": [["1", "ha na ca ra ka", "ada utusan"], ["2", "da ta sa wa la", "saling bertengkar"], ["3", "pa dha ja ya nya", "sama-sama sakti"], ["4", "ma ga ba tha nga", "lalu keduanya gugur"]], "after": "Aksara Jawa ditulis tanpa spasi antarkata. Setiap aksara dasar berbunyi konsonan + <b>a</b>. Bunyi vokalnya diubah dengan tanda <i>sandhangan</i>."}, {"t": "vocab", "title": "Tembung saka paribasan", "cols": 3, "items": [["🐢", "alon", "", "pelan"], ["👄", "lathi", "", "lidah, ucapan"], ["👍", "becik", "", "baik"], ["👎", "ala", "", "buruk"], ["🤝", "rukun", "", "rukun, damai"], ["💥", "bubrah", "", "rusak, hancur"]]}, {"t": "ex", "kind": "choice", "instr": "Pilihen sing bener.", "ans": "1. b · 2. a · 3. a · 4. b", "items": ["Peribahasa tentang menjaga ucapan:|Alon-alon waton kelakon|Ajining dhiri saka lathi|Ana dina ana upa|Becik ketitik ala ketara", "\"Rukun agawe santosa\" mengajarkan ...|persatuan|kecepatan|kekayaan|kepandaian", "Baris pertama aksara Jawa adalah ...|ha na ca ra ka|da ta sa wa la|pa dha ja ya nya|ma ga ba tha nga", "\"Becik\" artinya ...|buruk|baik|pelan|rusak"]}, {"t": "ex", "kind": "tf", "instr": "Leres utawa lepat? (Benar atau salah?)", "ans": "1. Lepat · 2. Leres · 3. Lepat", "items": ["Aksara Jawa ditulis dengan spasi di antara kata.", "Ada 20 aksara dasar dalam hanacaraka.", "\"Alon-alon waton kelakon\" berarti harus selalu cepat."]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Evaluasi akhir.", "ans": "1. c · 2. b · 3. b · 4. b · 5. a · 6. a", "items": ["Selamat malam =|Sugeng enjing|Sugeng sonten|Sugeng dalu|Sugeng siang", "Krama inggil \"mangan\" =|nedha|dhahar|mangan|nyamikan", "Kepada diri sendiri: \"Kula badhe ___ dhateng peken.\" (pergi)|tindak|kesah|rawuh|lunga-lunga", "selawe =|15|25|50|21", "\"Pinten reginipun?\" artinya ...|Berapa harganya?|Di mana rumahnya?|Siapa namanya?|Kapan datangnya?", "Kakak perempuan =|mbakyu|adhi|budhe|simbah"]}, {"t": "ex", "kind": "match", "instr": "Jodohna ngoko lan krama.", "ans": "1–e · 2–a · 3–d · 4–c · 5–b", "left": ["tuku", "larang", "omah", "teka", "loro"], "right": ["awis", "kalih", "dugi", "griya", "tumbas"]}], "words": [{"e": "🙏", "w": "matur nuwun", "p": "", "m": "terima kasih", "u": 1}, {"e": "😊", "w": "sami-sami", "p": "", "m": "sama-sama", "u": 1}, {"e": "🙇", "w": "nyuwun pangapunten", "p": "", "m": "mohon maaf", "u": 1}, {"e": "👍", "w": "sae", "p": "", "m": "baik (krama)", "u": 1}, {"e": "👌", "w": "apik", "p": "", "m": "baik, bagus (ngoko)", "u": 1}, {"e": "👋", "w": "sugeng rawuh", "p": "", "m": "selamat datang", "u": 1}, {"e": "🙋", "w": "kula", "p": "", "m": "saya (krama)", "u": 1}, {"e": "🫵", "w": "panjenengan", "p": "", "m": "Anda (krama inggil)", "u": 1}, {"e": "🍽️", "w": "nedha", "p": "", "m": "makan (krama)", "u": 2}, {"e": "🍛", "w": "dhahar", "p": "", "m": "makan (krama inggil)", "u": 2}, {"e": "😴", "w": "sare", "p": "", "m": "tidur (krama inggil)", "u": 2}, {"e": "🚶", "w": "tindak", "p": "", "m": "pergi (krama inggil)", "u": 2}, {"e": "🏃", "w": "rawuh", "p": "", "m": "datang (krama inggil)", "u": 2}, {"e": "🏠", "w": "dalem", "p": "", "m": "rumah (krama inggil)", "u": 2}, {"e": "🏷️", "w": "asma", "p": "", "m": "nama (krama inggil)", "u": 2}, {"e": "🤒", "w": "gerah", "p": "", "m": "sakit (krama inggil)", "u": 2}, {"e": "👨", "w": "bapak", "p": "", "m": "ayah", "u": 3}, {"e": "👩", "w": "ibu / biyung", "p": "", "m": "ibu", "u": 3}, {"e": "👴", "w": "simbah kakung / eyang kakung", "p": "", "m": "k