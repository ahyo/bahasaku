{"id": "vi-1", "kind": "lang", "lang": "vi", "grade": null, "level": "umum", "tag": "Pemula", "badge": ["Level", "1"], "title": "Bahasa Vietnam Pemula", "sub": "Nada & pelafalan, salam, angka, keluarga, kata kerja, restoran", "c": "#C92A2A", "c2": "#FFF5F5", "c3": "#7A1A1A", "emojis": "👋 🪪 🔢 👨‍👩‍👧 🏃 🍜", "intro": "<div class=\"note\"><div class=\"note-h\">📌 Tentang kursus ini</div>Bahasa Vietnam dari nol. Hurufnya Latin dengan 6 nada, dan kata kerjanya tidak berubah sehingga tata bahasanya mirip bahasa Indonesia.</div>", "cando": ["Mengenal 6 nada dan huruf khas bahasa Vietnam.", "Menyebut nama dan asal.", "Menghitung 0–100 dengan perubahan bunyi khusus.", "Menyebut anggota keluarga.", "Memakai đang/đã/sẽ dan negasi không.", "Memesan makanan dan meminta tagihan."], "text": {"labels": {"learn": ["📚", "Từ vựng", "Kosakata"], "talk": ["🗣️", "Hội thoại", "Percakapan"], "read": ["📖", "Đọc", "Membaca"], "practice": ["✏️", "Bài tập", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Ngữ pháp", "Tata Bahasa"], "write": ["📝", "Menulis", ""]}, "brand": "Belajar Bahasa Vietnam", "unit_word": "unit", "tip_prefix": "Tips:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Đúng", "false": "Sai", "review_t": "Ôn tập · Evaluasi", "review_s": "Uji kemampuanmu", "pron_note": "", "pron_html": "<div class=\"note\"><div class=\"note-h\">🔊 Cara baca</div>Bahasa Vietnam memakai huruf Latin dengan tanda nada. Cara baca ditulis sederhana, misalnya <i>xin chào</i> = <i>sin cau</i>. Dengarkan juga suaranya dengan tombol 🔊.</div>"}, "units": [{"num": 1, "en": "Phát âm và chào hỏi", "id": "Pelafalan, nada & salam", "emoji": "👋", "goals": ["Mengenal 6 nada dan huruf khas bahasa Vietnam.", "Menyapa dengan kata ganti yang tepat."], "sections": [{"t": "note", "html": "Bahasa Vietnam dituturkan sekitar <b>85 juta orang</b> dan ditulis dengan <b>huruf Latin</b> (chữ Quốc ngữ) beserta tanda nada. Nada mengubah arti: <i>ma</i> (hantu), <i>má</i> (ibu, selatan), <i>mà</i> (tetapi), <i>mả</i> (makam), <i>mã</i> (kuda, bahasa sastra), <i>mạ</i> (bibit padi).", "title": "Mengenal bahasa Vietnam"}, {"t": "grammar", "title": "6 nada", "head": ["Nama", "Tanda", "Bunyi"], "rows": [["ngang", "a", "datar"], ["sắc", "á", "naik tajam"], ["huyền", "à", "turun pelan"], ["hỏi", "ả", "turun lalu naik"], ["ngã", "ã", "naik dengan patahan"], ["nặng", "ạ", "pendek, berat, turun"]]}, {"t": "grammar", "title": "Huruf yang perlu diperhatikan", "head": ["Tulisan", "Dibaca", "Contoh"], "rows": [["đ", "d", "đi (di) = pergi"], ["d, gi", "z (utara) / y (selatan)", "da (za / ya) = kulit"], ["x", "s", "xin (sin)"], ["ch, tr", "c", "chào (cau)"], ["nh", "ny", "nhà (nya) = rumah"], ["ng, ngh", "ng", "người (ngươi) = orang"], ["ph", "f", "phở (fö)"], ["ư", "u dengan bibir datar", "từ (tư)"], ["ơ, â", "e pepet", "cơm (kem) = nasi"]]}, {"t": "phrases", "title": "Salam & sopan santun", "items": [["Xin chào!", "Halo!", "sin cau"], ["Chào anh / chị / em!", "Halo, Mas / Mbak / Dik!", "cau ainh / ci / em"], ["Bạn khỏe không? – Tôi khỏe, cảm ơn.", "Apa kabar? – Saya baik, terima kasih.", "ban khwe khong – toi khwe, kam ơn"], ["Cảm ơn! – Không có gì.", "Terima kasih! – Sama-sama.", "kam ơn – khong ko zi"], ["Xin lỗi.", "Maaf / permisi.", "sin loi"], ["Tạm biệt! / Hẹn gặp lại!", "Selamat tinggal! / Sampai jumpa!", "tam biet / hen gap lai"]]}, {"t": "ex", "kind": "choice", "instr": "Chọn câu trả lời đúng.", "ans": "1. a · 2. b · 3. c · 4. b", "items": ["Huruf đ dibaca ...|d|z|t|đ", "Huruf x pada «xin» dibaca ...|ks|s|sy|z", "Bahasa Vietnam memiliki ... nada.|4|5|6|8", "Jawaban untuk «Cảm ơn!» adalah ...|Xin lỗi|Không có gì|Xin chào|Tạm biệt"]}]}, {"num": 2, "en": "Giới thiệu", "id": "Perkenalan & kata ganti", "emoji": "🪪", "goals": ["Menyebut nama dan asal.", "Memilih kata ganti sesuai usia lawan bicara."], "sections": [{"t": "grammar", "title": "Kata ganti mengikuti hubungan keluarga", "head": ["Kata", "Untuk", "Mirip"], "rows": [["tôi", "saya (netral)", "saya"], ["bạn", "kamu (teman sebaya)", "kamu"], ["anh", "laki-laki sedikit lebih tua", "mas/abang"], ["chị", "perempuan sedikit lebih tua", "mbak/kakak"], ["em", "yang lebih muda", "dik"], ["ông / bà", "pria / wanita tua", "kakek / nenek, bapak / ibu"]], "after": "Kalimat dasar: <b>là</b> = adalah. Contohnya <i>Tôi là người Indonesia</i> (Saya orang Indonesia). Kata kerja <b>tidak berubah bentuk</b>."}, {"t": "dialog", "title": "Làm quen", "lines": [["Lan", "👩", "Xin chào! Tôi tên là Lan. Bạn tên là gì?", "Halo! Nama saya Lan. Siapa namamu?"], ["Budi", "👦", "Chào Lan! Tôi tên là Budi.", "Halo Lan! Nama saya Budi."], ["Lan", "👩", "Bạn là người nước nào?", "Kamu orang negara mana?"], ["Budi", "👦", "Tôi là người Indonesia. Bây giờ tôi sống ở Hà Nội.", "Saya orang Indonesia. Sekarang saya tinggal di Hanoi."], ["Lan", "👩", "Rất vui được gặp bạn!", "Senang bertemu denganmu!"]]}, {"t": "ex", "kind": "choice", "instr": "Chọn câu trả lời đúng.", "ans": "1. b · 2. b · 3. b", "items": ["«Bạn tên là gì?» artinya ...|Kamu dari mana?|Siapa namamu?|Apa kabar?|Berapa umurmu?", "Menyapa perempuan yang sedikit lebih tua memakai ...|anh|chị|em|ông", "«Tôi là người Indonesia» artinya ...|Saya tinggal di Indonesia.|Saya orang Indonesia.|Saya suka Indonesia.|Saya ke Indonesia."]}, {"t": "ex", "kind": "order", "instr": "Susun menjadi kalimat.", "ans": "1. Tôi tên là Budi. · 2. Tôi là người Indonesia. · 3. Bạn tên là gì?", "items": ["Budi. / Tôi / là / tên", "Tôi / là / Indonesia. / người", "tên / gì? / là / Bạn"]}]}, {"num": 3, "en": "Số đếm", "id": "Angka, umur & harga", "emoji": "🔢", "goals": ["Menghitung 0–100 dengan perubahan bunyi khusus.", "Menyebut umur dan harga dalam đồng."], "sections": [{"t": "vocab", "title": "0–10", "cols": 4, "items": [["0️⃣", "không", "khong", "0"], ["1️⃣", "một", "mot", "1"], ["2️⃣", "hai", "hai", "2"], ["3️⃣", "ba", "ba", "3"], ["4️⃣", "bốn", "bon", "4"], ["5️⃣", "năm", "nam", "5"], ["6️⃣", "sáu", "sau", "6"], ["7️⃣", "bảy", "bai", "7"], ["8️⃣", "tám", "tam", "8"], ["9️⃣", "chín", "cin", "9"], ["🔟", "mười", "mươi", "10"]]}, {"t": "grammar", "title": "11–100", "head": ["Angka", "Bahasa Vietnam", "Catatan"], "rows": [["11", "mười một", "teratur"], ["15", "mười <b>lăm</b>", "năm → lăm setelah puluhan"], ["20", "hai mươi", "puluhan = mươi (tanpa nada turun)"], ["21", "hai mươi <b>mốt</b>", "một → mốt setelah 20 ke atas"], ["24", "hai mươi <b>tư</b>", "bốn → tư (umum)"], ["100", "một trăm", ""]]}, {"t": "phrases", "title": "Ungkapan dengan angka", "items": [["Bạn bao nhiêu tuổi? – Tôi hai mươi tuổi.", "Berapa umurmu? – Saya 20 tahun.", "ban bau nyieu tuoi – toi hai mươi tuoi"], ["Bao nhiêu tiền? – Năm mươi nghìn đồng.", "Berapa harganya? – 50 ribu dong.", "bau nyieu tien – nam mươi nghin dong"]]}, {"t": "ex", "kind": "choice", "instr": "Chọn câu trả lời đúng.", "ans": "1. b · 2. b · 3. b · 4. b", "items": ["15 = ...|mười năm|mười lăm|năm mươi|mười một", "21 = ...|hai mươi một|hai mươi mốt|hai một|mười hai", "bảy = ...|6|7|8|9", "bao nhiêu artinya ...|di mana|berapa|kapan|siapa"]}]}, {"num": 4, "en": "Gia đình", "id": "Keluarga & có (punya)", "emoji": "👨‍👩‍👧", "goals": ["Menyebut anggota keluarga.", "Memakai có (punya) dan của (milik)."], "sections": [{"t": "vocab", "title": "Gia đình", "cols": 4, "items": [["👨", "bố / ba", "bo / ba", "ayah (utara / selatan)"], ["👩", "mẹ / má", "me / ma", "ibu (utara / selatan)"], ["👦", "anh trai", "ainh trai", "kakak laki-laki"], ["👧", "chị gái", "ci gai", "kakak perempuan"], ["🧒", "em trai", "em trai", "adik laki-laki"], ["👧", "em gái", "em gai", "adik perempuan"], ["👴", "ông", "ong", "kakek"], ["👵", "bà", "ba", "nenek"], ["👦", "con trai", "kon trai", "anak laki-laki"], ["👧", "con gái", "kon gai", "anak perempuan"], ["🧔", "chú", "cu", "paman"], ["🏠", "gia đình", "za dinh", "keluarga"]]}, {"t": "grammar", "title": "có (punya) & của (milik)", "head": ["Pola", "Contoh", "Arti"], "rows": [["có", "Tôi <b>có</b> hai em gái.", "Saya punya dua adik perempuan."], ["không có", "Tôi <b>không có</b> xe.", "Saya tidak punya kendaraan."], ["của", "mẹ <b>của</b> tôi (= mẹ tôi)", "ibu saya"]], "after": "Seperti bahasa Indonesia, urutannya <b>benda + pemilik</b>: <i>nhà tôi</i> = rumah saya."}, {"t": "ex", "kind": "choice", "instr": "Chọn câu trả lời đúng.", "ans": "1. b · 2. a · 3. b", "items": ["em gái artinya ...|kakak perempuan|adik perempuan|ibu|nenek", "«Tôi có một anh trai» artinya ...|Saya punya satu kakak laki-laki.|Saya kakak laki-laki.|Saya tidak punya kakak.|Kakak saya satu tahun.", "«mẹ tôi» artinya ...|saya ibu|ibu saya|ibu-ibu|ibumu"]}]}, {"num": 5, "en": "Động từ", "id": "Kata kerja, waktu & pertanyaan", "emoji": "🏃", "goals": ["Memakai đang/đã/sẽ dan negasi không.", "Membuat pertanyaan."], "sections": [{"t": "grammar", "title": "Penanda waktu (kata kerja tidak berubah)", "head": ["Penanda", "Arti", "Contoh"], "rows": [["đang", "sedang", "Tôi <b>đang</b> ăn cơm. = Saya sedang makan."], ["đã", "sudah", "Tôi <b>đã</b> ăn rồi. = Saya sudah makan."], ["sẽ", "akan", "Ngày mai tôi <b>sẽ</b> đi chợ. = Besok saya akan ke pasar."], ["không", "tidak", "Tôi <b>không</b> ăn thịt heo. = Saya tidak makan babi."]], "after": "Pertanyaan ya/tidak: <b>… không?</b> (<i>Bạn có khỏe không?</i>). Kata tanya: <b>gì</b> (apa), <b>ai</b> (siapa), <b>đâu</b> (di mana), <b>khi nào</b> (kapan), <b>tại sao</b> (mengapa), <b>bao nhiêu</b> (berapa)."}, {"t": "vocab", "title": "Kata kerja dasar", "cols": 4, "items": [["🍽️", "ăn", "an", "makan"], ["🥤", "uống", "uong", "minum"], ["🚶", "đi", "di", "pergi"], ["🏠", "đến", "den", "datang"], ["🗣️", "nói", "noi", "berbicara"], ["📖", "học", "hok", "belajar"], ["💼", "làm việc", "lam viek", "bekerja"], ["❤️", "thích", "thik", "suka"]]}, {"t": "ex", "kind": "choice", "instr": "Chọn câu trả lời đúng.", "ans": "1. b · 2. b · 3. a · 4. a", "items": ["«sedang makan» = ...|đã ăn|đang ăn|sẽ ăn|không ăn", "«Saya akan belajar» = ...|Tôi đã học.|Tôi sẽ học.|Tôi đang học.|Tôi không học.", "đâu artinya ...|di mana|apa|siapa|kapan", "thích artinya ...|suka|minum|pergi|bekerja"]}]}, {"num": 6, "en": "Ở nhà hàng", "id": "Di restoran", "emoji": "🍜", "goals": ["Memesan makanan dan meminta tagihan.", "Menanyakan kandungan babi."], "sections": [{"t": "vocab", "title": "Món ăn", "cols": 4, "items": [["💧", "nước", "nươk", "air"], ["☕", "cà phê", "ka fe", "kopi"], ["🍵", "trà", "ca", "teh"], ["🍚", "cơm", "kem", "nasi"], ["🍜", "phở", "fö", "phở (mi kuah)"], ["🥖", "bánh mì", "bainh mi", "roti isi"], ["🍗", "gà", "ga", "ayam"], ["🐟", "cá", "ka", "ikan"], ["🐄", "thịt bò", "thit bo", "daging sapi"], ["🐖", "thịt heo / thịt lợn", "thit heo / thit lơn", "daging babi"], ["🥬", "rau", "zau", "sayur"], ["😋", "ngon", "ngon", "enak"]]}, {"t": "phrases", "title": "Ở nhà hàng", "items": [["Cho tôi một bát phở bò.", "Saya pesan satu mangkuk phở sapi.", "co toi mot bat fö bo"], ["Không cay nhé.", "Jangan pedas, ya.", "khong kai nye"], ["Tính tiền!", "Minta tagihannya!", "tinh tien"], ["Ngon quá!", "Enak sekali!", "ngon kwa"]]}, {"t": "note", "html": "<b>Có thịt heo không?</b> (Ada daging babi?) · <b>Tôi không ăn thịt heo.</b> (Saya tidak makan babi.) · <b>Tôi không uống rượu.</b> (Saya tidak minum alkohol.) · Phở bò memakai sapi, tetapi kaldu dan topping lain bisa bercampur. Di Kota Ho Chi Minh dan An Giang ada komunitas muslim <b>Cham</b> dengan restoran halal.", "title": "🕌 Tips makan halal"}, {"t": "dialog", "title": "Ở quán phở", "lines": [["Người bán", "🧑‍🍳", "Chào chị! Chị ăn gì?", "Halo, Mbak! Mau makan apa?"], ["Rina", "🧕", "Phở bò có thịt heo không?", "Apakah phở sapinya ada babi?"], ["Người bán", "🧑‍🍳", "Không có, chỉ có thịt bò.", "Tidak ada, hanya daging sapi."], ["Rina", "🧕", "Vậy cho tôi một bát phở bò, không cay nhé.", "Kalau begitu saya pesan satu phở sapi, tidak pedas."]]}, {"t": "ex", "kind": "choice", "instr": "Chọn câu trả lời đúng.", "ans": "1. b · 2. b · 3. b", "items": ["Rina memesan ...|bánh mì|phở bò|cơm gà|cà phê", "thịt heo artinya ...|daging sapi|daging babi|ayam|ikan", "«Tính tiền!» artinya ...|Hitung sampai sepuluh!|Minta tagihannya!|Uangnya kurang!|Selamat makan!"]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Chọn câu trả lời đúng.", "ans": "1. b · 2. c · 3. b · 4. b", "items": ["Xin chào artinya ...|terima kasih|halo|maaf|selamat tinggal", "hai mươi mốt = ...|12|20|21|22", "«Saya sudah makan» = ...|Tôi đang ăn.|Tôi đã ăn rồi.|Tôi sẽ ăn.|Tôi không ăn.", "chị artinya ...|adik|kakak perempuan|ibu|teman"]}, {"t": "ex", "kind": "tf", "instr": "Đúng hay sai?", "ans": "1. Đúng · 2. Sai · 3. Đúng", "items": ["Bahasa Vietnam ditulis dengan huruf Latin.", "Kata kerja bahasa Vietnam berubah sesuai subjek.", "Nada yang berbeda dapat mengubah arti kata."]}], "words": [{"e": "0️⃣", "w": "không", "p": "khong", "m": "0", "u": 3}, {"e": "1️⃣", "w": "một", "p": "mot", "m": "1", "u": 3}, {"e": "2️⃣", "w": "hai", "p": "hai", "m": "2", "u": 3}, {"e": "3️⃣", "w": "ba", "p": "ba", "m": "3", "u": 3}, {"e": "4️⃣", "w": "bốn", "p": "bon", "m": "4", "u": 3}, {"e": "5️⃣", "w": "năm", "p": "nam", "m": "5", "u": 3}, {"e": "6️⃣", "w": "sáu", "p": "sau", "m": "6", "u": 3}, {"e": "7️⃣", "w": "bảy", "p": "bai", "m": "7", "u": 3}, {"e": "8️⃣", "w": "tám", "p": "tam", "m": "8", "u": 3}, {"e": "9️⃣", "w": "chín", "p": "cin", "m": "9", "u": 3}, {"e": "🔟", "w": "mười", "p": "mươi", "m": "10", "u": 3}, {"e": "👨", "w": "bố / ba", "p": "bo / ba", "m": "ayah (utara / selatan)", "u": 4}, {"e": "👩", "w": "mẹ / má", "p": "me / ma", "m": "ibu (utara / selatan)", "u": 4}, {"e": "👦", "w": "anh trai", "p": "ainh trai", "m": "kakak laki-laki", "u": 4}, {"e": "👧", "w": "chị gái", "p": "ci gai", "m": "kakak perempuan", "u": 4}, {"e": "🧒", "w": "em trai", "p": "em trai", "m": "adik laki-laki", "u": 4}, {"e": "👧", "w": "em gái", "p": "em gai", "m": "adik perempuan", "u": 4}, {"e": "👴", "w": "ông", "p": "ong", "m": "kakek", "u": 4}, {"e": "👵", "w": "bà", "p": "ba", "m": "nenek", "u": 4}, {"e": "👦", "w": "con trai", "p": "kon trai", "m": "anak laki-laki", "u": 4}, {"e": "👧", "w": "con gái", "p": "kon gai", "m": 