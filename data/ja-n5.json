{"id": "ja-n5", "kind": "lang", "lang": "ja", "grade": null, "level": "ujian", "tag": "JLPT N5", "badge": ["JLPT", "N5"], "title": "Persiapan JLPT N5", "sub": "Partikel, ます, kata sifat, angka, て, kanji dasar", "c": "#D6336C", "c2": "#FDE8EF", "c3": "#8C1D47", "emojis": "🔤 🏃 🎨 🔢 🔗 🈶", "intro": "<div class=\"note\"><div class=\"note-h\">📌 JLPT N5</div>Level paling dasar dari <b>Japanese-Language Proficiency Test</b>. Peserta diharapkan memahami kalimat dan ungkapan sederhana yang ditulis dengan hiragana, katakana, dan kanji dasar. Ada tiga bagian ujian: <b>Kosakata</b>, <b>Tata Bahasa · Membaca</b>, dan <b>Menyimak</b>.</div>", "cando": ["Memakai partikel は、が、を、に、で、へ、の、も dengan tepat.", "Mengubah kata kerja ke bentuk ます、ません、ました、ませんでした.", "Membedakan kata sifat い dan な.", "Menyebut jam, hari, dan jumlah benda.", "Mengubah kata kerja ke bentuk て.", "Mengenal 16 kanji dasar N5 beserta cara bacanya."], "text": {"labels": {"learn": ["📚", "ことば", "Kosakata"], "talk": ["🗣️", "かいわ", "Percakapan"], "read": ["📖", "どっかい", "Membaca"], "practice": ["✏️", "れんしゅう", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "ぶんぽう", "Tata Bahasa"], "write": ["📝", "Menulis", ""]}, "brand": "Persiapan JLPT", "unit_word": "unit", "tip_prefix": "Tips:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Benar", "false": "Salah", "review_t": "模擬試験 · Simulasi", "review_s": "Soal campuran gaya JLPT", "pron_note": "", "pron_html": ""}, "units": [{"num": 1, "en": "じょし", "id": "Partikel dasar", "emoji": "🔤", "goals": ["Memakai partikel は、が、を、に、で、へ、の、も dengan tepat.", "Menyusun kalimat sederhana pola S は O を V。"], "sections": [{"t": "grammar", "title": "Partikel inti N5", "head": ["Partikel", "Fungsi", "Contoh", "Arti"], "rows": [["は (wa)", "penanda topik", "わたしは がくせいです。", "Saya (adalah) pelajar."], ["が", "subjek / dengan すき・ある・いる", "ねこが います。", "Ada kucing."], ["を (o)", "objek", "パンを たべます。", "Makan roti."], ["に", "waktu / tujuan / tempat keberadaan", "７じに おきます。", "Bangun jam 7."], ["で", "tempat kegiatan / alat", "としょかんで べんきょうします。", "Belajar di perpustakaan."], ["へ (e)", "arah", "がっこうへ いきます。", "Pergi ke sekolah."], ["の", "kepemilikan", "わたしの ほん", "buku saya"], ["も", "juga", "わたしも がくせいです。", "Saya juga pelajar."]], "after": "Huruf は dibaca <b>wa</b> dan へ dibaca <b>e</b> bila berfungsi sebagai partikel. を dibaca <b>o</b>."}, {"t": "vocab", "title": "Kata benda sehari-hari", "cols": 3, "items": [["🏫", "がっこう", "gakkō", "sekolah"], ["📚", "としょかん", "toshokan", "perpustakaan"], ["🏠", "うち", "uchi", "rumah"], ["🍞", "パン", "pan", "roti"], ["☕", "コーヒー", "kōhī", "kopi"], ["📖", "ほん", "hon", "buku"], ["🐱", "ねこ", "neko", "kucing"], ["🧑‍🎓", "がくせい", "gakusei", "pelajar"], ["👨‍🏫", "せんせい", "sensei", "guru"], ["🚉", "えき", "eki", "stasiun"]]}, {"t": "dialog", "title": "じこしょうかい", "lines": [["Rina", "👧", "はじめまして。リナです。インドネシアから きました。", "Hajimemashite. Rina desu. Indoneshia kara kimashita.", "Salam kenal. Saya Rina. Saya datang dari Indonesia."], ["Ken", "👦", "はじめまして。けんです。リナさんは がくせいですか。", "Hajimemashite. Ken desu. Rina-san wa gakusei desu ka.", "Salam kenal. Saya Ken. Apakah Rina pelajar?"], ["Rina", "👧", "はい、だいがくせいです。けんさんも がくせいですか。", "Hai, daigakusei desu. Ken-san mo gakusei desu ka.", "Ya, mahasiswa. Ken juga pelajar?"], ["Ken", "👦", "いいえ、わたしは かいしゃいんです。", "Iie, watashi wa kaishain desu.", "Bukan, saya karyawan."]]}, {"t": "ex", "kind": "choice", "instr": "（　）に なにを いれますか。Pilih partikel yang tepat.", "ans": "1. a · 2. b · 3. c · 4. a · 5. c · 6. a", "items": ["まいあさ コーヒー（　）のみます。|を|に|で|へ", "としょかん（　）べんきょうします。|を|で|が|の", "あした にほん（　）いきます。|を|で|へ|も", "これは わたし（　）ほんです。|の|が|に|を", "つくえの うえに ねこ（　）います。|を|で|が|へ", "ろくじ（　）おきます。|に|で|を|の"]}, {"t": "ex", "kind": "match", "instr": "Jodohkan.", "ans": "1–d · 2–c · 3–e · 4–a · 5–b", "left": ["がっこう", "えき", "せんせい", "としょかん", "うち"], "right": ["perpustakaan", "rumah", "stasiun", "sekolah", "guru"]}]}, {"num": 2, "en": "どうし ます形", "id": "Kata kerja bentuk ます", "emoji": "🏃", "goals": ["Mengubah kata kerja ke bentuk ます、ません、ました、ませんでした.", "Menceritakan kegiatan sehari-hari."], "sections": [{"t": "vocab", "title": "Kata kerja penting N5", "cols": 3, "items": [["🚶", "いきます", "ikimasu", "pergi"], ["🏃", "きます", "kimasu", "datang"], ["🏠", "かえります", "kaerimasu", "pulang"], ["🍚", "たべます", "tabemasu", "makan"], ["🥤", "のみます", "nomimasu", "minum"], ["👀", "みます", "mimasu", "melihat, menonton"], ["🎧", "ききます", "kikimasu", "mendengar"], ["📖", "よみます", "yomimasu", "membaca"], ["✍️", "かきます", "kakimasu", "menulis"], ["🛒", "かいます", "kaimasu", "membeli"], ["⏰", "おきます", "okimasu", "bangun"], ["😴", "ねます", "nemasu", "tidur"]]}, {"t": "grammar", "title": "Empat bentuk ます", "head": ["Bentuk", "Akhiran", "Contoh", "Arti"], "rows": [["sekarang / akan (+)", "〜ます", "たべます", "makan"], ["sekarang / akan (−)", "〜ません", "たべません", "tidak makan"], ["lampau (+)", "〜ました", "たべました", "sudah makan"], ["lampau (−)", "〜ませんでした", "たべませんでした", "tidak makan (kemarin)"]], "after": "Ajakan: <b>〜ませんか</b> (maukah…?) dan <b>〜ましょう</b> (ayo…). Contoh: いっしょに たべませんか。 → ええ、たべましょう。"}, {"t": "dialog", "title": "しゅうまつ", "lines": [["Ken", "👦", "きのう なにを しましたか。", "Kinō nani o shimashita ka.", "Kemarin kamu melakukan apa?"], ["Rina", "👧", "デパートで くつを かいました。それから えいがを みました。", "Depāto de kutsu o kaimashita. Sorekara eiga o mimashita.", "Membeli sepatu di department store. Lalu menonton film."], ["Ken", "👦", "いいですね。こんど いっしょに えいがを みませんか。", "Ii desu ne. Kondo issho ni eiga o mimasen ka.", "Asyik ya. Lain kali mau menonton film bersama?"], ["Rina", "👧", "ええ、みましょう！", "Ē, mimashō!", "Ya, ayo menonton!"]]}, {"t": "ex", "kind": "choice", "instr": "Pilih bentuk yang tepat.", "ans": "1. b · 2. c · 3. a · 4. b · 5. b", "items": ["きのう テレビを（　）。|みます|みました|みません|みましょう", "わたしは おさけを（　）。(tidak minum)|のみます|のみました|のみません|のみましょう", "いっしょに ひるごはんを たべ（　）か。 (ajakan)|ません|ました|ます|ましょう", "けさ ７じに（　）。 (bangun, lampau)|おきます|おきました|ねました|ねます", "せんしゅう がっこうへ（　）。 (tidak pergi, lampau)|いきません|いきませんでした|いきました|いきましょう"]}, {"t": "ex", "kind": "match", "instr": "Jodohkan.", "ans": "1–e · 2–d · 3–a · 4–b · 5–c", "left": ["かいます", "かえります", "よみます", "ききます", "ねます"], "right": ["membaca", "mendengar", "tidur", "pulang", "membeli"]}]}, {"num": 3, "en": "けいようし", "id": "Kata sifat い dan な", "emoji": "🎨", "goals": ["Membedakan kata sifat い dan な.", "Mengubah kata sifat ke bentuk negatif dan lampau."], "sections": [{"t": "vocab", "title": "Kata sifat", "cols": 3, "items": [["🐘", "おおきい", "ōkii", "besar"], ["🐜", "ちいさい", "chiisai", "kecil"], ["💴", "たかい", "takai", "mahal; tinggi"], ["🏷️", "やすい", "yasui", "murah"], ["🆕", "あたらしい", "atarashii", "baru"], ["🏚️", "ふるい", "furui", "lama, tua (benda)"], ["😋", "おいしい", "oishii", "enak"], ["🥵", "あつい", "atsui", "panas"], ["🥶", "さむい", "samui", "dingin (cuaca)"], ["🌸", "きれい", "kirei", "indah, bersih (な)"], ["🤫", "しずか", "shizuka", "tenang (な)"], ["💪", "げんき", "genki", "sehat, semangat (な)"], ["⭐", "ゆうめい", "yūmei", "terkenal (な)"], ["❤️", "すき", "suki", "suka (な)"]]}, {"t": "grammar", "title": "Perubahan kata sifat", "head": ["", "い: たかい", "な: しずか"], "rows": [["sekarang (+)", "たかいです", "しずかです"], ["sekarang (−)", "たかくないです", "しずかじゃないです"], ["lampau (+)", "たかかったです", "しずかでした"], ["lampau (−)", "たかくなかったです", "しずかじゃなかったです"], ["+ kata benda", "たかい かばん", "しずかな へや"]], "after": "Pengecualian: <b>いい</b> (bagus) → よくないです、よかったです. Kata きれい dan ゆうめい berakhiran い tetapi termasuk kata sifat <b>な</b>."}, {"t": "ex", "kind": "choice", "instr": "Pilih bentuk yang tepat.", "ans": "1. a · 2. b · 3. b · 4. b · 5. b", "items": ["この ラーメンは とても（　）です。|おいしい|おいしく|おいしいな|おいしかったな", "きのうは（　）。 (dingin, lampau)|さむいです|さむかったです|さむくないです|さむいでした", "ここは（　）こうえんです。|しずか|しずかな|しずかの|しずかい", "この へやは きれい（　）。 (tidak)|くないです|じゃないです|かったです|でした", "てんきは（　）。 (bagus, lampau)|いかったです|よかったです|いいでした|よいでした"]}, {"t": "ex", "kind": "match", "instr": "Jodohkan lawan kata.", "ans": "1–d · 2–c · 3–a · 4–b", "left": ["おおきい", "たかい", "あたらしい", "あつい"], "right": ["ふるい", "さむい", "やすい", "ちいさい"]}]}, {"num": 4, "en": "かず・じかん", "id": "Angka, waktu, dan kata bantu bilangan", "emoji": "🔢", "goals": ["Menyebut jam, hari, dan jumlah benda.", "Memakai kata bantu bilangan 〜つ、〜にん、〜まい、〜ほん."], "sections": [{"t": "vocab", "title": "Waktu", "cols": 3, "items": [["📅", "きょう", "kyō", "hari ini"], ["⏭️", "あした", "ashita", "besok"], ["⏮️", "きのう", "kinō", "kemarin"], ["🌅", "あさ", "asa", "pagi"], ["🌆", "ばん", "ban", "malam"], ["🕐", "いちじ", "ichiji", "jam satu"], ["🕓", "よじ", "yoji", "jam empat"], ["🕖", "しちじ", "shichiji", "jam tujuh"], ["🕘", "くじ", "kuji", "jam sembilan"], ["⏱️", "はん", "han", "setengah (…:30)"], ["❓", "なんじ", "nanji", "jam berapa"]]}, {"t": "grammar", "title": "Kata bantu bilangan", "head": ["Benda", "Kata bantu", "1", "2", "3"], "rows": [["umum (apel, kotak)", "〜つ", "ひとつ", "ふたつ", "みっつ"], ["orang", "〜にん", "ひとり", "ふたり", "さんにん"], ["benda tipis (kertas, tiket)", "〜まい", "いちまい", "にまい", "さんまい"], ["benda panjang (pensil, botol)", "〜ほん", "いっぽん", "にほん", "さんぼん"]], "after": "Ingat pengecualian: <b>よじ</b> (jam 4), <b>しちじ</b> (jam 7), <b>くじ</b> (jam 9). Untuk orang: <b>ひとり</b> dan <b>ふたり</b>."}, {"t": "dialog", "title": "かいもの", "lines": [["Rina", "👧", "すみません、りんごを みっつ ください。", "Sumimasen, ringo o mittsu kudasai.", "Permisi, minta apel tiga."], ["Penjual", "🧑‍🌾", "はい、さんびゃくえんです。", "Hai, sanbyaku en desu.", "Baik, tiga ratus yen."], ["Rina", "👧", "それから、みずを にほん ください。", "Sorekara, mizu o nihon kudasai.", "Lalu, minta air dua botol."], ["Penjual", "🧑‍🌾", "ぜんぶで ごひゃくえんです。", "Zenbu de gohyaku en desu.", "Semuanya lima ratus yen."]]}, {"t": "ex", "kind": "choice", "instr": "Pilih jawaban yang tepat.", "ans": "1. b · 2. b · 3. a · 4. c · 5. b", "items": ["Jam 4 dalam bahasa Jepang adalah ...|しじ|よじ|よんじ|しんじ", "Dua orang: ...|ににん|ふたり|ふたつ|にほん", "Tiket 3 lembar: きっぷを（　）ください。|さんまい|みっつ|さんぼん|さんにん", "Pensil 1 batang: えんぴつを（　）。|いちほん|ひとつ|いっぽん|いちまい", "いま なんじですか。 — 9:30 です。|きゅうじはん|くじはん|くじさんじゅう|きゅうじさんぷん"]}]}, {"num": 5, "en": "て形", "id": "Bentuk て", "emoji": "🔗", "goals": ["Mengubah kata kerja ke bentuk て.", "Memakai 〜てください、〜ています、〜てもいいです."], "sections": [{"t": "grammar", "title": "Cara membuat bentuk て (golongan 1)", "head": ["Akhiran ます", "→ て", "Contoh"], "rows": [["〜います・〜ちます・〜ります", "〜って", "かいます → かって · まちます → まって · かえります → かえって"], ["〜みます・〜びます・〜にます", "〜んで", "よみます → よんで · あそびます → あそんで"], ["〜きます", "〜いて", "かきます → かいて (pengecualian: いきます → いって)"], ["〜ぎます", "〜いで", "およぎます → およいで"], ["〜します", "〜して", "はなします → はなして"]], "after": "Golongan 2: buang ます, tambah て (たべます → たべて, みます → みて). Golongan 3: します → して, きます → きて."}, {"t": "grammar", "title": "Pola dengan bentuk て", "head": ["Pola", "Arti", "Contoh"], "rows": [["〜てください", "tolong …", "ここに なまえを かいてください。"], ["〜ています", "sedang …", "いま ほんを よんでいます。"], ["〜てもいいです", "boleh …", "しゃしんを とってもいいですか。"], ["〜てはいけません", "tidak boleh …", "ここで たばこを すってはいけません。"], ["〜て、〜", "lalu …", "あさごはんを たべて、がっこうへ いきます。"]]}, {"t": "ex", "kind": "choice", "instr": "Pilih bentuk て yang benar.", "ans": "1. b · 2. c · 3. b · 4. a · 5. d · 6. a", "items": ["かきます →|かきて|かいて|かって|かんで", "のみます →|のみて|のって|のんで|のいで", "いきます →|いいて|いって|いきて|いんで", "たべます →|たべて|たべって|たんで|たいて", "まちます →|まちて|まいて|まんで|まって", "ちょっと（　）ください。 (menunggu)|まって|まちて|まつ|まった"]}, {"t": "ex", "kind": "tf", "instr": "Benar atau salah?", "ans": "1. Benar · 2. Salah · 3. Benar", "items": ["いま ごはんを たべています berarti \"Sekarang sedang makan\".", "Bentuk て dari します adalah しって.", "〜てもいいですか dipakai untuk meminta izin."]}]}, {"num": 6, "en": "かんじ N5", "id": "Kanji dasar N5", "emoji": "🈶", "goals": ["Mengenal 16 kanji dasar N5 beserta cara bacanya.", "Membaca kata sehari-hari yang memakai kanji."], "sections": [{"t": "vocab", "title": "Kanji hari dan alam", "cols": 4, "items": [["☀️", "日", "nichi · hi", "hari, matahari"], ["🌙", "月", "getsu · tsuki", "bulan"], ["🔥", "火", "ka · hi", "api"], ["💧", "水", "sui · mizu", "air"], ["🌳", "木", "moku · ki", "pohon"], ["🪙", "金", "kin · kane", "emas, uang"], ["🟫", "土", "do · tsuchi", "tanah"], ["⛰️", "山", "san · yama", "gunung"], ["🏞️", "川", "sen · kawa", "sungai"], ["🧍", "人", "jin · hito", "orang"], ["👄", "口", "kō · kuchi", "mulut"], ["👁️", "目", "moku · me", "mata"], ["✋", "手", "shu · te", "tangan"], ["⬆️", "上", "jō · ue", "atas"], ["⬇️", "下", "ka · shita", "bawah"], ["🎓", "学", "gaku · mana(bu)", "belajar"]]}, {"t": "grammar", "title": "Nama hari", "head": ["Kanji", "Bacaan", "Arti"], "rows": [["月曜日", "げつようび", "Senin"], ["火曜日", "かようび", "Selasa"], ["水曜日", "すいようび", "Rabu"], ["木曜日", "もくようび", "Kamis"], ["金曜日", "きんようび", "Jumat"], ["土曜日", "どようび", "Sabtu"], ["日曜日", "にちようび", "Minggu"]], "after": "Kanji punya dua jenis bacaan: <b>on'yomi</b> (dari bahasa Tionghoa, misalnya すい) dan <b>kun'yomi</b> (asli Jepang, misalnya みず)."}, {"t": "ex", "kind": "choice", "instr": "Bagaimana cara membaca kata ini?", "ans": "1. a · 2. b · 3. b · 4. c · 5. c", "items": ["日本|にほん|ひもと|にちほん|かほん", "学生|がっこう|がくせい|せんせい|がくしょう", "山|かわ|やま|つち|き", "金曜日|もくようび|どようび|きんようび|かようび", "水|ひ|き|みず|つち"]}, {"t": "ex", "kind": "match", "instr": "Jodohkan kanji dengan artinya.", "ans": "1–c · 2–b · 3–d · 4–e · 5–a", "left": ["川", "人", "目", "手", "木"], "right": ["pohon", "orang", "sungai", "mata", "tangan"]}, {"t": "tip", "html": "Banyak kanji berasal dari gambar. 山 tampak seperti tiga puncak gunung, 川 seperti aliran air, dan 木 seperti pohon dengan akarnya. Coba latih menulisnya di menu <b>Menulis Huruf › Hanzi</b>, karena bentuknya sama."}]}], "review": [{"t": "ex", "kind": "choice", "instr": "もんだい: pilih yang paling tepat.", "ans": "1. b · 2. b · 3. b · 4. b · 5. b · 6. a · 7. b · 8. a", "items": ["わたしは まいにち でんしゃ（　）がっこうへ いきます。|を|で|に|が", "きのう ともだちと えいがを（　）。|みます|みました|みません|みましょう", "この かばんは（　）です。 (tidak mahal)|たかいじゃない|たかくない|たかくなかった|たかいない", "しずか（　）としょかん|い|な|の|に", "りんごを（　）ください。 (dua buah)|ふたり|ふたつ|にほん|にまい", "ここに なまえを（　）ください。|かいて|かきて|かって|かんで", "「土曜日」の よみかたは？|にちようび|どようび|もくようび|げつようび", "いま あめが（　）います。 (sedang turun)|ふって|ふりて|ふんで|ふいて"]}], "words": [{"e": "🏫", "w": "がっこう", "p": "gakkō", "m": "sekolah", "u": 1}, {"e": "📚", "w": "としょかん", "p": "toshokan", "m": "perpustakaan", "u": 1}, {"e": "🏠", "w": "うち", "p": "uchi", "m": "rumah", "u": 1}, {"e": "🍞", "w": "パン", "p": "pan", "m": "roti", "u": 1}, {"e": "☕", "w": "コーヒー", "p": "kōhī", "m": "kopi", "u": 1}, {"e": "📖", "w": "ほん", "p"