{"id": "ms-1", "kind": "lang", "lang": "ms", "grade": null, "level": "umum", "tag": "Pemula", "badge": ["Level", "1"], "title": "Bahasa Melayu (Malaysia)", "sub": "Sapaan, kata berbeda makna, bahasa basahan, ringgit, kedai mamak", "c": "#1864AB", "c2": "#E7F0FA", "c3": "#0B3D7A", "emojis": "👋 🪪 🔢 ⚠️ 💬 🍛", "intro": "<div class=\"note\"><div class=\"note-h\">📌 Tentang kursus ini</div>Untuk penutur bahasa Indonesia yang akan kuliah, bekerja, atau berwisata ke Malaysia/Brunei/Singapura. Fokusnya pada <b>perbedaan</b> kosakata, terutama kata yang bisa membuat salah paham (kereta, percuma, seronok, pejabat).</div>", "cando": ["Menyapa dengan ungkapan khas Malaysia.", "Memperkenalkan diri ala Malaysia.", "Memakai ringgit dan sen.", "Mengenal kata Melayu yang berbeda atau berlawanan arti dengan bahasa Indonesia.", "Memahami bentuk santai: nak, tak, dah, jom, lah.", "Memesan di kedai mamak dan warung Melayu."], "text": {"labels": {"learn": ["📚", "Kosa kata", "Kosakata"], "talk": ["🗣️", "Perbualan", "Percakapan"], "read": ["📖", "Bacaan", "Membaca"], "practice": ["✏️", "Latihan", "Latihan"], "sing": ["🎧", "Menyimak", ""], "play": ["🎲", "Proyek", ""], "grammar": ["🧩", "Tatabahasa", "Tata Bahasa"], "write": ["📝", "Menulis", ""]}, "brand": "Belajar Bahasa Melayu", "unit_word": "unit", "tip_prefix": "Tips:", "fun_h": "🌟 Tahukah Kamu?", "word_box": "Kotak Kata:", "true": "Betul", "false": "Salah", "review_t": "Ulang kaji · Evaluasi", "review_s": "Uji kemampuanmu", "pron_note": "", "pron_html": "<div class=\"note\"><div class=\"note-h\">🔊 Cara baca</div>Bahasa Melayu dibaca hampir sama dengan bahasa Indonesia, jadi kursus ini berfokus pada <b>perbedaan</b> kata dan ungkapan. Dengarkan juga suaranya dengan tombol 🔊.</div>"}, "units": [{"num": 1, "en": "Salam dan sapaan", "id": "Salam & sapaan Malaysia", "emoji": "👋", "goals": ["Menyapa dengan ungkapan khas Malaysia.", "Memakai sapaan encik, cik, puan, tuan."], "sections": [{"t": "note", "html": "Bahasa Melayu (Malaysia, Brunei, Singapura) dan bahasa Indonesia berasal dari akar yang sama, sehingga penuturnya <b>saling memahami</b>. Namun, banyak kata sehari-hari berbeda, bahkan ada yang maknanya bertolak belakang. Kursus ini membantumu berbicara seperti orang Malaysia.", "title": "Mengenal bahasa Melayu"}, {"t": "phrases", "title": "Salam & ungkapan", "items": [["Selamat pagi / tengah hari / petang / malam", "Selamat pagi / siang / sore / malam", "petang = sore"], ["Apa khabar? – Khabar baik.", "Apa kabar? – Baik."], ["Terima kasih. – Sama-sama.", "Terima kasih. – Sama-sama."], ["Minta maaf.", "Mohon maaf."], ["Jumpa lagi!", "Sampai jumpa!"], ["Jemput masuk.", "Silakan masuk.", "jemput = silakan / undang"]]}, {"t": "grammar", "title": "Sapaan", "head": ["Sapaan", "Untuk", "Padanan Indonesia"], "rows": [["Encik", "laki-laki dewasa", "Bapak / Mas"], ["Cik", "perempuan (belum menikah) / umum", "Nona / Mbak"], ["Puan", "perempuan dewasa", "Ibu / Nyonya"], ["Tuan", "laki-laki (resmi)", "Tuan / Bapak"], ["Pak cik / Mak cik", "orang tua (akrab)", "Pakde / Bude, Om / Tante"]]}, {"t": "ex", "kind": "choice", "instr": "Pilih jawapan yang betul.", "ans": "1. b · 2. b · 3. b", "items": ["«Selamat petang» diucapkan pada ...|pagi|sore|tengah malam|subuh", "«Jemput masuk» artinya ...|Jemput dia!|Silakan masuk.|Ayo keluar.|Tunggu di luar.", "Menyapa ibu-ibu dengan sopan: ...|Encik|Puan|Tuan|Budak"]}]}, {"num": 2, "en": "Berkenalan", "id": "Perkenalan & kata ganti", "emoji": "🪪", "goals": ["Memperkenalkan diri ala Malaysia.", "Memakai kata ganti awak, kamu, anda dengan tepat."], "sections": [{"t": "grammar", "title": "Kata ganti", "head": ["Melayu", "Kapan dipakai", "Indonesia"], "rows": [["saya", "umum", "saya"], ["aku", "sangat akrab", "aku"], ["awak", "kamu (umum, sopan untuk teman)", "kamu"], ["kamu", "ke orang yang lebih muda (bisa terdengar kurang sopan)", "kamu"], ["anda", "resmi/iklan", "Anda"], ["dia / kami / kita / mereka", "sama", "sama"]]}, {"t": "dialog", "title": "Di kampus", "lines": [["Aisyah", "🧕", "Hai! Nama saya Aisyah. Siapa nama awak?", "Hai! Nama saya Aisyah. Siapa namamu?"], ["Budi", "👦", "Nama saya Budi. Saya dari Indonesia.", "Nama saya Budi. Saya dari Indonesia."], ["Aisyah", "🧕", "Oh, seronoknya! Awak belajar di sini ke?", "Wah, menyenangkan! Kamu kuliah di sini?"], ["Budi", "👦", "Ya, saya belajar di Universiti Malaya. Saya tinggal di asrama.", "Ya, saya kuliah di Universitas Malaya. Saya tinggal di asrama."]]}, {"t": "ex", "kind": "choice", "instr": "Pilih jawapan yang betul.", "ans": "1. b · 2. a · 3. b", "items": ["Kata ganti yang sopan untuk teman sebaya: ...|kamu|awak|engkau|dia", "«Awak belajar di sini ke?» artinya ...|Kamu belajar di sini?|Kamu ke sini?|Kamu mau belajar?|Kamu tinggal di sini?", "Partikel «ke» di akhir kalimat berfungsi sebagai ...|kata depan «ke»|penanda pertanyaan|kata kerja|kata sapaan"]}]}, {"num": 3, "en": "Wang dan nombor", "id": "Angka, uang & waktu", "emoji": "🔢", "goals": ["Memakai ringgit dan sen.", "Menyebut waktu dengan istilah Malaysia."], "sections": [{"t": "grammar", "title": "Angka & waktu", "head": ["Melayu", "Indonesia", "Catatan"], "rows": [["satu, dua … sepuluh, sebelas, dua puluh, seratus", "sama", "angka hampir sama"], ["RM10 = sepuluh ringgit", "10 ringgit", "1 ringgit = 100 sen"], ["pukul tiga petang", "pukul tiga sore", "petang = sore"], ["setengah jam", "setengah jam", ""], ["bila?", "kapan?", "bila = kapan (bukan «jika»)"]]}, {"t": "phrases", "title": "Ungkapan", "items": [["Berapa harga ni?", "Berapa harganya?"], ["Mahal sangat! Boleh kurang sikit?", "Mahal sekali! Bisa kurang sedikit?", "sikit = sedikit"], ["Pukul berapa sekarang?", "Jam berapa sekarang?"], ["Bila awak sampai?", "Kapan kamu tiba?"]]}, {"t": "ex", "kind": "choice", "instr": "Pilih jawapan yang betul.", "ans": "1. b · 2. b · 3. b", "items": ["«Bila awak datang?» artinya ...|Jika kamu datang?|Kapan kamu datang?|Mengapa kamu datang?|Bagaimana kamu datang?", "Mata uang Malaysia adalah ...|rupiah|ringgit|dolar|baht", "«sikit» artinya ...|sakit|sedikit|sekitar|siku"]}]}, {"num": 4, "en": "Kata berbeza makna", "id": "Kata yang berbeda arti (awas!)", "emoji": "⚠️", "goals": ["Mengenal kata Melayu yang berbeda atau berlawanan arti dengan bahasa Indonesia.", "Menghindari salah paham."], "sections": [{"t": "grammar", "title": "Kata yang sering membuat salah paham", "head": ["Melayu", "Artinya", "Catatan"], "rows": [["kereta", "mobil", "kereta api = kereta"], ["percuma", "gratis", "bukan «sia-sia»!"], ["seronok", "menyenangkan, asyik", "bukan «tidak senonoh»!"], ["budak", "anak-anak", "bukan «hamba sahaya»"], ["senang", "mudah", "juga bisa «gembira»"], ["bilik", "kamar", "bilik air = kamar mandi"], ["tandas", "toilet", ""], ["pejabat", "kantor", "bukan «pejabat negara»"], ["kedai", "toko", ""], ["comel", "imut, lucu", ""], ["pusing", "berputar, belok", "bukan «sakit kepala»"], ["basikal", "sepeda", ""]]}, {"t": "vocab", "title": "Kosa kata harian", "cols": 4, "items": [["🚗", "kereta", "", "mobil"], ["🚲", "basikal", "", "sepeda"], ["🚌", "bas", "", "bus"], ["🏥", "hospital", "", "rumah sakit"], ["👟", "kasut", "", "sepatu"], ["👖", "seluar", "", "celana"], ["🚻", "tandas", "", "toilet"], ["🏢", "pejabat", "", "kantor"], ["🛍️", "kedai", "", "toko"], ["🛏️", "bilik", "", "kamar"], ["👶", "budak", "", "anak"], ["🆓", "percuma", "", "gratis"]]}, {"t": "ex", "kind": "match", "instr": "Jodohkan kata Melayu dengan artinya.", "ans": "1–e · 2–c · 3–b · 4–a · 5–d", "left": ["kereta", "percuma", "pejabat", "seronok", "kasut"], "right": ["menyenangkan", "kantor", "gratis", "sepatu", "mobil"]}, {"t": "ex", "kind": "choice", "instr": "Pilih jawapan yang betul.", "ans": "1. b · 2. b · 3. b", "items": ["«Masuk percuma!» artinya ...|Masuk sia-sia!|Masuk gratis!|Dilarang masuk!|Masuk cepat!", "«Saya naik kereta ke pejabat» artinya ...|Saya naik kereta api ke kantor pejabat.|Saya naik mobil ke kantor.|Saya naik bus ke pasar.|Saya jalan ke kantor.", "«Di mana tandas?» artinya ...|Di mana tanda?|Di mana toilet?|Di mana tas?|Di mana tandu?"]}]}, {"num": 5, "en": "Bahasa basahan", "id": "Bahasa sehari-hari & partikel", "emoji": "💬", "goals": ["Memahami bentuk santai: nak, tak, dah, jom, lah.", "Menyusun kalimat percakapan sehari-hari."], "sections": [{"t": "grammar", "title": "Bentuk santai", "head": ["Kata", "Arti", "Contoh"], "rows": [["nak", "mau", "Saya <b>nak</b> pergi ke kedai."], ["tak", "tidak", "Saya <b>tak</b> tahu."], ["dah", "sudah", "Awak <b>dah</b> makan?"], ["boleh", "bisa / boleh", "Saya <b>boleh</b> cakap Melayu sikit."], ["tengah", "sedang", "Dia <b>tengah</b> makan."], ["jom", "ayo", "<b>Jom</b> makan!"], ["lah", "penegas", "Cepat<b>lah</b>! / Okey<b>lah</b>."], ["macam mana", "bagaimana", "<b>Macam mana</b> nak pergi ke KLCC?"], ["cakap", "berbicara", "Awak <b>cakap</b> bahasa apa?"]]}, {"t": "ex", "kind": "order", "instr": "Susun menjadi kalimat.", "ans": "1. Jom kita makan. · 2. Saya tak nak pergi. · 3. Awak dah makan ke?", "items": ["kita / makan. / Jom", "Saya / tak / pergi. / nak", "dah / ke? / makan / Awak"]}, {"t": "ex", "kind": "choice", "instr": "Pilih jawapan yang betul.", "ans": "1. a · 2. a · 3. a", "items": ["«Saya nak balik» artinya ...|Saya mau pulang.|Saya sudah pulang.|Saya tidak pulang.|Saya baru pulang.", "«Macam mana?» artinya ...|Bagaimana?|Macam apa?|Di mana?|Siapa?", "«Dah siap?» artinya ...|Sudah siap?|Mau siap?|Belum siap?|Siapa?"]}]}, {"num": 6, "en": "Di kedai makan", "id": "Di warung makan Malaysia", "emoji": "🍛", "goals": ["Memesan di kedai mamak dan warung Melayu.", "Mengenal logo halal JAKIM."], "sections": [{"t": "vocab", "title": "Makanan & minuman", "cols": 4, "items": [["🍛", "nasi lemak", "", "nasi uduk khas Malaysia"], ["🫓", "roti canai", "", "roti cane"], ["🥤", "teh tarik", "", "teh susu ditarik"], ["🧊", "ais", "", "es"], ["🍜", "mi goreng mamak", "", "mi goreng ala India-Muslim"], ["🍗", "ayam", "", "ayam"], ["🐟", "ikan", "", "ikan"], ["🥚", "telur", "", "telur"], ["🌶️", "sambal", "", "sambal"], ["🥡", "bungkus", "", "dibawa pulang"]]}, {"t": "phrases", "title": "Di kedai makan", "items": [["Nak makan apa?", "Mau makan apa?"], ["Saya nak nasi lemak satu, teh tarik kurang manis.", "Saya mau satu nasi lemak, teh tarik tidak terlalu manis."], ["Makan sini atau bungkus?", "Makan di sini atau dibungkus?"], ["Berapa semua?", "Berapa semuanya?"], ["Sedapnya!", "Enaknya!", "sedap = enak"]]}, {"t": "note", "html": "Malaysia adalah negara muslim dengan sertifikasi halal ketat dari <b>JAKIM</b>, dengan logo bulat bertulisan <i>Halal Malaysia</i>. Kedai mamak (India-Muslim) dan warung Melayu umumnya halal. Restoran Tionghoa belum tentu halal, jadi cari logonya atau tanyakan <i>\"Ini halal ke?\"</i>", "title": "🕌 Tips makan halal"}, {"t": "dialog", "title": "Di kedai mamak", "lines": [["Pelayan", "🧑‍🍳", "Nak order apa, bang?", "Mau pesan apa, Bang?"], ["Budi", "👦", "Roti canai dua, teh tarik satu. Kurang manis, ya.", "Roti canai dua, teh tarik satu. Tidak terlalu manis, ya."], ["Pelayan", "🧑‍🍳", "Makan sini ke bungkus?", "Makan di sini atau dibungkus?"], ["Budi", "👦", "Makan sini. Berapa semua?", "Makan di sini. Berapa semuanya?"], ["Pelayan", "🧑‍🍳", "Semua lapan ringgit.", "Semuanya delapan ringgit."]]}, {"t": "ex", "kind": "choice", "instr": "Pilih jawapan yang betul.", "ans": "1. b · 2. b · 3. b", "items": ["«bungkus» artinya ...|makan di sini|dibawa pulang|dibayar|dipesan", "«sedap» artinya ...|sedang|enak|siap|pedas", "Berapa Budi membayar?|RM 5|RM 8|RM 18|RM 80"]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Pilih jawapan yang betul.", "ans": "1. b · 2. b · 3. b · 4. b", "items": ["«kereta» dalam bahasa Melayu artinya ...|kereta api|mobil|gerobak|sepeda", "«percuma» artinya ...|sia-sia|gratis|mahal|murah", "«Saya tak tahu» artinya ...|Saya tahu.|Saya tidak tahu.|Saya mau tahu.|Saya sudah tahu.", "«Selamat petang» = ...|selamat pagi|selamat sore|selamat malam|selamat siang"]}, {"t": "ex", "kind": "tf", "instr": "Betul atau salah?", "ans": "1. Betul · 2. Salah · 3. Betul", "items": ["«seronok» dalam bahasa Melayu berarti menyenangkan.", "«bila» berarti «jika».", "Logo halal Malaysia dikeluarkan oleh JAKIM."]}], "words": [{"e": "🚗", "w": "kereta", "p": "", "m": "mobil", "u": 4}, {"e": "🚲", "w": "basikal", "p": "", "m": "sepeda", "u": 4}, {"e": "🚌", "w": "bas", "p": "", "m": "bus", "u": 4}, {"e": "🏥", "w": "hospital", "p": "", "m": "rumah sakit", "u": 4}, {"e": "👟", "w": "kasut", "p": "", "m": "sepatu", "u": 4}, {"e": "👖", "w": "seluar", "p": "", "m": "celana", "u": 4}, {"e": "🚻", "w": "tandas", "p": "", "m": "toilet", "u": 4}, {"e": "🏢", "w": "pejabat", "p": "", "m": "kantor", "u": 4}, {"e": "🛍️", "w": "kedai", "p": "", "m": "toko", "u": 4}, {"e": "🛏️", "w": "bilik", "p": "", "m": "kamar", "u": 4}, {"e": "👶", "w": "budak", "p": "", "m": "anak", "u": 4}, {"e": "🆓", "w": "percuma", "p": "", "m": "gratis", "u": 4}, {"e": "🍛", "w": "nasi lemak", "p": "", "m": "nasi uduk khas Malaysia", "u": 6}, {"e": "🫓", "w": "roti canai", "p": "", "m": "roti cane", "u": 6}, {"e": "🥤", "w": "teh tarik", "p": "", "m": "teh susu ditarik", "u": 6}, {"e": "🧊", "w": "ais", "p": "", "m": "es", "u": 6}, {"e": "🍜", "w": "mi goreng mamak", "p": "", "m": "mi goreng ala India-Muslim", "u": 6}, {"e": "🍗", "w": "ayam", "p": "", "m": "ayam", "u": 6}, {"e": "🐟", "w": "ikan", "p": "", "m": "ikan", "u": 6}, {"e": "🥚", "w": "telur", "p": "", "m": "telur", "u": 6}, {"e": "🌶️", "w": "sambal", "p": "", "m": "sambal", "u": 6}, {"e": "🥡", "w": "bungkus", "p": "", "m": "dibawa pulang", "u": 6}]}