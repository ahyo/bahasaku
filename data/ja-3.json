{"id": "ja-3", "lang": "ja", "grade": 3, "level": "sd", "title": "にほんご だいすき！", "sub": "Belajar sambil bermain · Untuk siswa Kelas 3 SD", "c": "#8E5CF7", "c2": "#EFE6FF", "c3": "#F15BB5", "emojis": "🏠 🍱 👘 ⏰ 🎏 🎨 🍙 🦢 🌸 🍜 🎋 ⭐", "intro": "", "cando": ["Menceritakan rumah dengan <b>います / あります</b>.", "Menyebut makanan dan memakai <b>いただきます・ごちそうさまでした</b>.", "Menyebut pakaian dengan kata kerja yang tepat.", "Menceritakan kegiatan harian berurutan.", "Menyebut bulan, musim, festival, dan hobi."], "text": {"labels": {"learn": ["📚", "まなぼう！", "Ayo Belajar"], "talk": ["🗣️", "はなそう！", "Ayo Berbicara"], "read": ["📖", "よもう！", "Ayo Membaca"], "practice": ["✏️", "れんしゅう！", "Ayo Berlatih"], "sing": ["🎵", "うたおう！", "Ayo Bernyanyi"], "play": ["🎲", "あそぼう！", "Ayo Bermain"], "grammar": ["🧩", "ぶんをつくろう！", "Ayo Menyusun Kalimat"], "write": ["📝", "かこう！", "Ayo Menulis"]}, "brand": "Asyik Belajar Bahasa Jepang", "unit_word": "bab", "tip_prefix": "Kiko berkata:", "fun_h": "🌟 Tahukah Kamu? <small>しってる？</small>", "word_box": "Kotak Kata:", "true": "Benar", "false": "Salah", "review_t": "ふくしゅう", "review_s": "Evaluasi — Ayo uji kemampuanmu!", "pron_note": "Tulisan latin di dalam garis miring, misalnya ねこ <span class=\"vp inl\">/neko/</span>, disebut <b>romaji</b> — cara membaca huruf Jepang. Vokal ganda (<b>aa, ii, uu, ee, oo</b>) dibaca <b>panjang</b>. <b>shi</b> dibaca “si”, <b>chi</b> dibaca “ci”, <b>tsu</b> dibaca “tsu”, <b>fu</b> di antara “fu” dan “hu”, dan <b>ん</b> (n) dibaca “n/ng”. Huruf kecil di atas kanji disebut <b>furigana</b> (cara baca kanji). Biasakan membaca hiragana dan katakana, lalu dengarkan guru atau video berbahasa Jepang. 🎧", "pron_html": null}, "units": [{"num": 1, "en": "わたしの いえ", "id": "Rumahku", "emoji": "🏠", "goals": ["Menyebut ruangan dan benda di rumah.", "Memakai <b>〜に います</b> (orang/hewan) dan <b>〜に あります</b> (benda)."], "sections": [{"t": "vocab", "title": "Ruangan — へや", "items": [["🏠", "いえ", "ie", "rumah"], ["🛋️", "リビング", "ribingu", "ruang keluarga"], ["🛏️", "しんしつ", "shinshitsu", "kamar tidur"], ["🍳", "だいどころ", "daidokoro", "dapur"], ["🛁", "おふろ", "ofuro", "kamar mandi (berendam)"], ["🚽", "トイレ", "toire", "toilet"], ["🌷", "にわ", "niwa", "kebun/halaman"], ["👟", "げんかん", "genkan", "pintu masuk (tempat lepas sepatu)"]], "cols": 4, "label": "learn", "dict": true}, {"t": "vocab", "title": "Benda di rumah — いえの もの", "items": [["🛏️", "ベッド", "beddo", "tempat tidur"], ["🍽️", "テーブル", "teeburu", "meja"], ["📺", "テレビ", "terebi", "televisi"], ["🧊", "れいぞうこ", "reizooko", "kulkas"], ["🪟", "まど", "mado", "jendela"], ["🚪", "ドア", "doa", "pintu"], ["💡", "でんき", "denki", "lampu"], ["🪞", "かがみ", "kagami", "cermin"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Di mana …?", "head": ["Bahasa Jepang", "Romaji", "Arti"], "rows": [["おかあさんは どこですか？", "okaasan wa doko desu ka?", "Di mana ibu?"], ["だいどころに います。 🍳", "daidokoro ni imasu", "Ada di dapur."], ["ねこは にわに います。 🐱", "neko wa niwa ni imasu", "Kucing ada di kebun."], ["テレビは リビングに あります。 📺", "terebi wa ribingu ni arimasu", "TV ada di ruang keluarga."]], "after": "<b>どこ</b> = di mana · <b>に</b> = di · <b>います</b> untuk orang dan hewan · <b>あります</b> untuk benda."}, {"t": "raw", "html": "<div class=\"reading ltr\"><div class=\"rpic\">🏡</div><div class=\"tl\"><div class=\"tar\">これは わたしの いえです。</div><div class=\"ttr\">kore wa watashi no ie desu</div><div class=\"tid\">Ini rumahku.</div></div><div class=\"tl\"><div class=\"tar\">いえには リビングと だいどころと しんしつが ふたつ あります。</div><div class=\"ttr\">ie ni wa ribingu to daidokoro to shinshitsu ga futatsu arimasu</div><div class=\"tid\">Di rumah ada ruang keluarga, dapur, dan dua kamar tidur.</div></div><div class=\"tl\"><div class=\"tar\">にわには はなが たくさん あります。 🌸</div><div class=\"ttr\">niwa ni wa hana ga takusan arimasu</div><div class=\"tid\">Di kebun ada banyak bunga.</div></div><div class=\"tl\"><div class=\"tar\">よる、かぞくは リビングで テレビを みます。</div><div class=\"ttr\">yoru, kazoku wa ribingu de terebi o mimasu</div><div class=\"tid\">Malam hari, keluargaku menonton TV di ruang keluarga.</div></div><div class=\"tl\"><div class=\"tar\">わたしは いえが だいすきです！ ❤️</div><div class=\"ttr\">watashi wa ie ga daisuki desu!</div><div class=\"tid\">Aku sangat suka rumahku!</div></div><div class=\"gloss\"><b>📌 Kata penting:</b> ふたつ = dua (buah) · たくさん = banyak · よる = malam · みます = menonton/melihat</div></div>", "label": "read", "title": "わたしの いえ — Rumahku"}, {"t": "ex", "kind": "choice", "instr": "Jawab berdasarkan bacaan!", "ans": "1. b · 2. b · 3. b", "items": ["Berapa kamar tidur?|satu|dua|tiga", "Apa yang ada di kebun?|mobil|banyak bunga|kucing", "Di mana keluarga menonton TV?|di dapur|di ruang keluarga|di kamar"]}, {"t": "ex", "kind": "circle", "instr": "Lingkari います atau あります!", "ans": "1. います · 2. あります · 3. います · 4. あります", "items": ["いぬが ((います / あります))。", "ベッドが ((います / あります))。", "おとうさんが ((います / あります))。", "テレビが ((います / あります))。"]}, {"t": "ex", "kind": "match", "instr": "Di mana? Pasangkan!", "ans": "1–c, 2–d, 3–a, 4–b", "left": ["🛁 berendam", "🍳 memasak", "😴 tidur", "👟 melepas sepatu"], "right": ["しんしつ", "げんかん", "おふろ", "だいどころ"]}, {"t": "fun", "html": "Di Jepang, orang <b>melepas sepatu</b> di <b>げんかん</b> (pintu masuk) sebelum masuk rumah, lalu memakai sandal rumah. Mirip kebiasaan di Indonesia, ya! 👟🏠"}]}, {"num": 2, "en": "たべもの と のみもの", "id": "Makanan dan Minuman", "emoji": "🍱", "goals": ["Menyebut makanan dan minuman.", "Mengucapkan <b>いただきます</b> dan <b>ごちそうさまでした</b>.", "Menyatakan lapar dan haus."], "sections": [{"t": "vocab", "title": "Makanan — たべもの", "items": [["🍚", "ごはん", "gohan", "nasi"], ["🍞", "パン", "pan", "roti"], ["🥚", "たまご", "tamago", "telur"], ["🐟", "さかな", "sakana", "ikan"], ["🍗", "とりにく", "toriniku", "daging ayam"], ["🥦", "やさい", "yasai", "sayur"], ["🍲", "みそしる", "misoshiru", "sup miso"], ["🍣", "すし", "sushi", "sushi"], ["🍜", "ラーメン", "raamen", "ramen"], ["🍙", "おにぎり", "onigiri", "nasi kepal"]], "cols": 5, "label": "learn", "dict": true}, {"t": "vocab", "title": "Minuman — のみもの", "items": [["💧", "みず", "mizu", "air"], ["🍵", "おちゃ", "ocha", "teh"], ["🥛", "ぎゅうにゅう", "gyuunyuu", "susu"], ["🧃", "ジュース", "juusu", "jus"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Selamat makan!", "head": ["Bahasa Jepang", "Romaji", "Arti"], "rows": [["いただきます！ 🙏", "itadakimasu!", "(diucapkan sebelum makan)"], ["ごちそうさまでした！ 😊", "gochisoosama deshita!", "(diucapkan setelah makan)"], ["おなかが すきました。 😫", "onaka ga sukimashita", "Aku lapar."], ["のどが かわきました。 🥵", "nodo ga kawakimashita", "Aku haus."], ["なにを たべますか？ — ラーメンを たべます。", "nani o tabemasu ka? — raamen o tabemasu", "Makan apa? — Aku makan ramen."], ["おいしい！ 😋", "oishii!", "Enak!"]], "after": "<b>たべます</b> = makan · <b>のみます</b> = minum · <b>を</b> (dibaca o) menandai benda yang dimakan/diminum."}, {"t": "dialog", "title": "Waktunya makan", "lines": [["Sota", "👦", "おかあさん、おなかが すきました！", "okaasan, onaka ga sukimashita!", "Bu, aku lapar!"], ["Ibu", "👩", "おにぎりと みそしるが ありますよ。", "onigiri to misoshiru ga arimasu yo.", "Ada nasi kepal dan sup miso."], ["Sota", "👦", "やった！ いただきます！", "yatta! itadakimasu!", "Asyik! Selamat makan!"], ["Sota", "👦", "おいしい！ ごちそうさまでした！", "oishii! gochisoosama deshita!", "Enak! Terima kasih atas makanannya!"]]}, {"t": "ex", "kind": "match", "instr": "Pasangkan gambar dengan katanya!", "ans": "1–c, 2–e, 3–a, 4–d, 5–b", "left": ["🍚", "🍵", "🥚", "🍙", "🥛"], "right": ["たまご", "ぎゅうにゅう", "ごはん", "おにぎり", "おちゃ"]}, {"t": "ex", "kind": "choice", "instr": "Pilih ucapan yang tepat!", "ans": "1. b · 2. a · 3. b", "items": ["Sebelum makan, kita berkata …|ごちそうさまでした|いただきます|おやすみなさい", "Setelah makan, kita berkata …|ごちそうさまでした|いただきます|はじめまして", "Aku lapar = …|のどが かわきました|おなかが すきました|おいしいです"]}, {"t": "ex", "kind": "table", "instr": "Menu makananku! Tulis dalam bahasa Jepang.", "ans": "Jawaban bebas.", "head": ["Waktu", "Makanan", "Minuman"], "rows": ["あさごはん (sarapan)| | ", "ひるごはん (makan siang)| | ", "ばんごはん (makan malam)| | "]}, {"t": "fun", "html": "Anak-anak Jepang sering membawa <b>おべんとう</b> (bekal makan siang) yang dihias lucu — nasinya dibentuk seperti panda, beruang, atau bunga! 🍱🐼"}]}, {"num": 3, "en": "ふく", "id": "Pakaian", "emoji": "👕", "goals": ["Menyebut jenis pakaian.", "Mengenal kata kerja “memakai” yang berbeda-beda dalam bahasa Jepang."], "sections": [{"t": "vocab", "title": "Pakaian — ふく", "items": [["👔", "シャツ", "shatsu", "kemeja"], ["👕", "Tシャツ", "tii shatsu", "kaos"], ["👖", "ズボン", "zubon", "celana panjang"], ["👧", "スカート", "sukaato", "rok"], ["👗", "ワンピース", "wanpiisu", "gaun"], ["🧢", "ぼうし", "booshi", "topi"], ["👟", "くつ", "kutsu", "sepatu"], ["🧦", "くつした", "kutsushita", "kaus kaki"], ["🧥", "コート", "kooto", "mantel"], ["🎽", "せいふく", "seifuku", "seragam"], ["👘", "きもの", "kimono", "kimono"], ["👓", "めがね", "megane", "kacamata"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Memakai … (kata kerjanya berbeda!)", "head": ["Untuk", "Kata kerja", "Contoh", "Arti"], "rows": [["baju atas", "きます (kimasu)", "シャツを きます。", "Memakai kemeja."], ["celana, rok, sepatu, kaus kaki", "はきます (hakimasu)", "くつを はきます。", "Memakai sepatu."], ["topi", "かぶります (kaburimasu)", "ぼうしを かぶります。", "Memakai topi."], ["kacamata", "かけます (kakemasu)", "めがねを かけます。", "Memakai kacamata."]], "after": "Dalam bahasa Indonesia semuanya “memakai”, tetapi dalam bahasa Jepang kata kerjanya <b>berbeda</b> sesuai bagian tubuh! 🤓"}, {"t": "raw", "html": "<div class=\"reading ltr\"><div class=\"rpic\">🧑‍🎓</div><div class=\"tl\"><div class=\"tar\">げつようびに しろい シャツと あかい ズボンを きます。</div><div class=\"ttr\">getsuyoobi ni shiroi shatsu to akai zubon o kimasu</div><div class=\"tid\">Pada hari Senin, aku memakai kemeja putih dan celana merah.</div></div><div class=\"tl\"><div class=\"tar\">くろい くつと しろい くつしたを はきます。</div><div class=\"ttr\">kuroi kutsu to shiroi kutsushita o hakimasu</div><div class=\"tid\">Aku memakai sepatu hitam dan kaus kaki putih.</div></div><div class=\"tl\"><div class=\"tar\">あついので、ぼうしを かぶります。 ☀️</div><div class=\"ttr\">atsui node, booshi o kaburimasu</div><div class=\"tid\">Karena panas, aku memakai topi.</div></div><div class=\"tl\"><div class=\"tar\">ともだちの あやちゃんは めがねを かけています。 👓</div><div class=\"ttr\">tomodachi no aya-chan wa megane o kakete imasu</div><div class=\"tid\">Temanku, Aya, memakai kacamata.</div></div><div class=\"gloss\"><b>📌 Kata penting:</b> しろい = putih · あかい = merah · くろい = hitam · あつい = panas · ので = karena</div></div>", "label": "read", "title": "わたしの せいふく — Seragamku"}, {"t": "ex", "kind": "tf", "instr": "Benar atau Salah?", "ans": "1. Benar · 2. Salah (hitam) · 3. Benar · 4. Benar", "items": ["Pada hari Senin, penulis memakai celana merah.", "Sepatunya putih.", "Penulis memakai topi karena panas.", "Aya memakai kacamata."]}, {"t": "ex", "kind": "circle", "instr": "Lingkari kata kerja yang benar!", "ans": "1. かぶります · 2. はきます · 3. きます · 4. かけます", "items": ["ぼうしを ((きます / かぶります))。", "くつを ((はきます / かけます))。", "シャツを ((きます / はきます))。", "めがねを ((かぶります / かけます))。"]}, {"t": "ex", "kind": "match", "instr": "Pasangkan gambar dengan katanya!", "ans": "1–c, 2–d, 3–e, 4–a, 5–b", "left": ["🧦", "👘", "🧢", "🧥", "👖"], "right": ["コート", "ズボン", "くつした", "きもの", "ぼうし"]}, {"t": "fun", "html": "<b>きもの</b> (kimono) adalah pakaian tradisional Jepang. Pada musim panas, orang memakai kimono tipis bernama <b>ゆかた</b> (yukata) saat festival. 👘🎆"}]}, {"num": 4, "en": "いちにち", "id": "Kegiatan Sehari-hari", "emoji": "⏰", "goals": ["Menyebut kegiatan sehari-hari dengan bentuk <b>〜ます</b>.", "Bercerita berurutan: <b>まず、それから、そして、さいごに</b>."], "sections": [{"t": "vocab", "title": "Kegiatan — いちにちの こと", "items": [["⏰", "おきます", "okimasu", "bangun"], ["🧼", "かおを あらいます", "kao o araimasu", "cuci muka"], ["🪥", "はを みがきます", "ha o migakimasu", "gosok gigi"], ["🍳", "あさごはんを たべます", "asagohan o tabemasu", "sarapan"], ["🏫", "がっこうへ いきます", "gakkoo e ikimasu", "pergi ke sekolah"], ["📚", "べんきょうします", "benkyoo shimasu", "belajar"], ["⚽", "あそびます", "asobimasu", "bermain"], ["🏠", "うちへ かえります", "uchi e kaerimasu", "pulang ke rumah"], ["📝", "しゅくだいを します", "shukudai o shimasu", "mengerjakan PR"], ["🛁", "おふろに はいります", "ofuro ni hairimasu", "mandi (berendam)"], ["📖", "ほんを よみます", "hon o yomimasu", "membaca buku"], ["😴", "ねます", "nemasu", "tidur"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Kata urutan", "head": ["Bahasa Jepang", "Romaji", "Arti"], "rows": [["まず", "mazu", "pertama"], ["それから", "sorekara", "kemudian"], ["そして", "soshite", "lalu / dan"], ["さいごに", "saigo ni", "terakhir"]], "after": "<b>へ</b> (dibaca e) = ke: がっこう<b>へ</b> いきます (pergi ke sekolah)."}, {"t": "raw", "html": "<div class=\"reading ltr\"><div class=\"rpic\">🌅</div><div class=\"tl\"><div class=\"tar\">けんくんは まいあさ ろくじに おきます。</div><div class=\"ttr\">ken-kun wa maiasa rokuji ni okimasu</div><div class=\"tid\">Ken bangun jam enam setiap pagi.</div></div><div class=\"tl\"><div class=\"tar\">まず、かおを あらって、はを みがきます。</div><div class=\"ttr\">mazu, kao o aratte, ha o migakimasu</div><div class=\"tid\">Pertama, dia cuci muka dan gosok gigi.</div></div><div class=\"tl\"><div class=\"tar\">それから、あさごはんを たべます。ごはんと みそしるです。</div><div class=\"ttr\">sorekara, asagohan o tabemasu. gohan to misoshiru desu</div><div class=\"tid\">Kemudian dia sarapan. Nasi dan sup miso.</div></div><div class=\"tl\"><div class=\"tar\">そして、せいふくを きます。</div><div class=\"ttr\">soshite, seifuku o kimasu</div><div class=\"tid\">Lalu dia memakai seragam.</div></div><div class=\"tl\"><div class=\"tar\">さいごに、「いってきます！」と いって、がっこうへ いきます。</div><div class=\"ttr\">saigo ni, \"ittekimasu!\" to itte, gakkoo e ikimasu</div><div class=\"tid\">Terakhir, dia berkata “Aku berangkat!” dan pergi ke sekolah.</div></div><div class=\"gloss\"><b>📌 Kata penting:</b> まいあさ = setiap pagi · ろくじ = jam enam · いってきます = aku berangkat (salam saat keluar rumah)</div></div>", "label": "read", "title": "けんくんの あさ — Pagi Ken"}, {"t": "ex", "kind": "order", "instr": "Urutkan kegiatan Ken (1–4)!", "ans": "1 おきます · 2 はを みがきます · 3 あさごはんを たべます · 4 がっこうへ いきます", "items": [], "after": "<div class=\"scr\" style=\"line-height:2.4\"><span>☐ あさごはんを たべます</span><span>☐ おきます</span><span>☐ がっこうへ いきます</span><span>☐ はを みがきます</span></div>"}, {"t": "ex", "kind": "match", "instr": "Pasangkan gambar dengan kegiatannya!", "ans": "1–c, 2–e, 3–d, 4–a, 5–b", "left": ["🪥", "😴", "📖", "⚽", "📝"], "right": ["あそびます", "しゅくだいを します", "はを みがきます", "ほんを よみます", "ねます"]}, {"t": "ex", "kind": "write", "instr": "Ceritakan pagimu!", "ans": "Jawaban bebas.", "items": ["まず、___ 。", "それから、___ 。", "さいごに、___ 。"]}, {"t": "fun", "html": "Saat keluar rumah, anak Jepang berkata <b>いってきます！</b> (aku berangkat), dan keluarganya menjawab <b>いってらっしゃい！</b> (hati-hati di jalan). Saat pulang: <b>ただいま！</b> — <b>おかえりなさい！</b> 🏠"}]}, {"num": 5, "en": "つきと きせつ", "id": "Bulan dan Musim", "emoji": "🗓️", "goals": ["Menyebut 12 bulan dan 4 musim.", "Bertanya dan menjawab tentang ulang tahun."], "sections": [{"t": "vocab", "title": "Bulan — つき", "items": [["一月", "いちがつ", "ichigatsu", "Januari"], ["二月", "にがつ", "nigatsu", "Februari"], ["三月", "さんがつ", "sangatsu", "Maret"], ["四月", "しがつ", "shigatsu", "April"], ["五月", "ごがつ", "gogatsu", "Mei"], ["六月", "ろくがつ", "rokugatsu", "Juni"], ["七月", "しちがつ", "shichigatsu", "Juli"], ["八月", "はちがつ", "hachigatsu", "Agustus"], ["九月", "くがつ", "kugatsu", "September"], ["十月", "じゅうがつ", "juugatsu", "Oktober"], ["十一月", "じゅういちがつ", "juuichigatsu", "November"], ["十二月", "じゅうにがつ", "juunigatsu", "Desember"]], "cols": 4, "label": "learn", "dict": true}, {"t": "note", "html": "Nama bulan Jepang sangat mudah: <b>angka + がつ</b> (gatsu)! Hati-hati: April = <b>しがつ</b>, Juli = <b>しちがつ</b>, September = <b>くがつ</b>.", "title": "Ingat, ya!"}, {"t": "vocab", "title": "Musim — きせつ", "items": [["🌸", "はる", "haru", "musim semi"], ["🏖️", "なつ", "natsu", "musim panas"], ["🍁", "あき", "aki", "musim gugur"], ["⛄", "ふゆ", "fuyu", "musim dingin"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Kapan ulang tahunmu?", "head": ["Bahasa Jepang", "Romaji", "Arti"], "rows": [["たんじょうびは いつですか？", "tanjoobi wa itsu desu ka?", "Kapan ulang tahunmu?"], ["ごがつです。 🌸", "gogatsu desu", "Bulan Mei."], ["おたんじょうび おめでとう！ 🎂", "otanjoobi omedetoo!", "Selamat ulang tahun!"]], "after": null}, {"t": "raw", "html": "<div class=\"vgrid c3\"><div class=\"vcard\"><div class=\"ve\">🎎</div><div class=\"vw\">ひなまつり</div><div class=\"vm\">3 Maret — festival boneka anak perempuan</div></div><div class=\"vcard\"><div class=\"ve\">🎏</div><div class=\"vw\">こどもの日</div><div class=\"vm\">5 Mei — Hari Anak</div></div><div class=\"vcard\"><div class=\"ve\">🎋</div><div class=\"vw\">たなばた</div><div class=\"vm\">7 Juli — festival bintang (menggantung harapan)</div></div></div>", "label": "learn", "title": "Festival Jepang — まつり"}, {"t": "ex", "kind": "fill", "instr": "Tulis bulan yang hilang!", "ans": "1. にがつ · 2. しちがつ · 3. じゅういちがつ", "items": ["いちがつ → ___ → さんがつ", "ろくがつ → ___ → はちがつ", "じゅうがつ → ___ → じゅうにがつ"]}, {"t": "ex", "kind": "match", "instr": "Pasangkan musim dengan gambarnya!", "ans": "1–c, 2–d, 3–b, 4–a", "left": ["ふゆ", "なつ", "あき", "はる"], "right": ["🌸", "🍁", "⛄", "🏖️"]}, {"t": "ex", "kind": "table", "instr": "Survei ulang tahun! Tanyakan kepada 4 temanmu: たんじょうびは いつですか？", "ans": "Jawaban bebas.", "head": ["Nama", "Bulan (bahasa Jepang)"], "rows": [" | ", " | ", " | ", " | "]}, {"t": "fun", "html": "Di Jepang, tahun ajaran baru dimulai pada bulan <b>April</b> (しがつ), saat bunga sakura bermekaran. 🌸🏫"}]}, {"num": 6, "en": "しゅみ", "id": "Hobiku", "emoji": "🎨", "goals": ["Menyebut macam-macam hobi.", "Bertanya: <b>しゅみは なんですか？</b>", "Menyatakan kemampuan: <b>〜が できます</b>."], "sections": [{"t": "vocab", "title": "Hobi — しゅみ", "items": [["📚", "どくしょ", "dokusho", "membaca buku"], ["🎨", "え", "e", "gambar/menggambar"], ["🎤", "うた", "uta", "lagu/bernyanyi"], ["⚽", "サッカー", "sakkaa", "sepak bola"], ["🏊", "すいえい", "suiei", "berenang"], ["🍳", "りょうり", "ryoori", "memasak"], ["🎹", "ピアノ", "piano", "piano"], ["🦢", "おりがみ", "origami", "melipat kertas"], ["📕", "まんが", "manga", "komik"], ["🎮", "ゲーム", "geemu", "permainan"], ["💃", "ダンス", "dansu", "menari"], ["🏸", "バドミントン", "badominton", "bulu tangkis"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Apa hobimu?", "head": ["Bahasa Jepang", "Romaji", "Arti"], "rows": [["しゅみは なんですか？", "shumi wa nan desu ka?", "Apa hobimu?"], ["しゅみは おりがみです。 🦢", "shumi wa origami desu", "Hobiku origami."], ["サッカーが すきです。 ⚽", "sakkaa ga suki desu", "Aku suka sepak bola."], ["すいえいが できますか？", "suiei ga dekimasu ka?", "Bisakah kamu berenang?"], ["はい、できます。 ✅ / いいえ、できません。 ❌", "hai, dekimasu / iie, dekimasen", "Ya, bisa. / Tidak bisa."]], "after": null}, {"t": "raw", "html": "<div class=\"reading ltr\"><div class=\"rpic\">👫</div><div class=\"tl\"><div class=\"tar\">ゆいちゃんの しゅみは ピアノです。 🎹</div><div class=\"ttr\">yui-chan no shumi wa piano desu</div><div class=\"tid\">Hobi Yui bermain piano.</div></div><div class=\"tl\"><div class=\"tar\">たくやくんの しゅみは サッカーです。 ⚽</div><div class=\"ttr\">takuya-kun no shumi wa sakkaa desu</div><div class=\"tid\">Hobi Takuya sepak bola.</div></div><div class=\"tl\"><div class=\"tar\">はるとくんは おりがみが できます。 🦢</div><div class=\"ttr\">haruto-kun wa origami ga dekimasu</div><div class=\"tid\">Haruto bisa membuat origami.</div></div><div class=\"tl\"><div class=\"tar\">わたしの しゅみは えを かくことです！ 🎨</div><div class=\"ttr\">watashi no shumi wa e o kaku koto desu!</div><div class=\"tid\">Hobiku menggambar!</div></div><div class=\"gloss\"><b>📌 Kata penting:</b> 〜ちゃん = panggilan untuk anak perempuan · 〜くん = panggilan untuk anak laki-laki · えを かく = menggambar</div></div>", "label": "read", "title": "ともだちの しゅみ — Hobi teman-temanku"}, {"t": "ex", "kind": "match", "instr": "Siapa hobinya apa?", "ans": "1–c, 2–d, 3–a, 4–b", "left": ["ゆいちゃん", "たくやくん", "はるとくん", "Penulis"], "right": ["おりがみ 🦢", "え 🎨", "ピアノ 🎹", "サッカー ⚽"]}, {"t": "ex", "kind": "table", "instr": "Apa yang bisa kamu lakukan? Tanda ✓ (できます) atau ✗ (できません).", "ans": "Jawaban bebas.", "head": ["Kegiatan", "Aku", "Temanku: ______"], "rows": ["🏊 すいえい| | ", "🦢 おりがみ| | ", "🎹 ピアノ| | ", "🍳 りょうり| | "]}, {"t": "ex", "kind": "write", "instr": "Tulis tentang hobimu!", "ans": "Jawaban bebas.", "items": ["しゅみは ___ です。", "___ が できます。"]}, {"t": "