{"id": "ru-2", "lang": "ru", "grade": 2, "level": "sd", "title": "Учимся с Ки́ко!", "sub": "Belajar sambil bermain · Untuk siswa Kelas 2 SD", "c": "#E07A1F", "c2": "#FFEEDC", "c3": "#F4C542", "emojis": "📖 🎒 🍉 🐻 📅 🍎 🐘 ✏️ 🍇 🪆 🐰 ⭐", "intro": "", "cando": ["Membaca suku kata dan kata pendek bahasa Rusia.", "Menyebut benda di sekolah dengan <b>Что / Кто э́то?</b>", "Menyebut buah dan menyatakan suka/tidak suka.", "Menyebut hewan dengan sifat besar/kecil.", "Menyebut nama hari dan bilangan 11–20."], "text": {"labels": {"learn": ["📚", "Учимся!", "Ayo Belajar"], "talk": ["🗣️", "Говорим!", "Ayo Berbicara"], "read": ["📖", "Читаем!", "Ayo Membaca"], "practice": ["✏️", "Тренируемся!", "Ayo Berlatih"], "sing": ["🎵", "Поём!", "Ayo Bernyanyi"], "play": ["🎲", "Играем!", "Ayo Bermain"], "grammar": ["🧩", "Строим фразы!", "Ayo Menyusun Kalimat"], "write": ["📝", "Пишем!", "Ayo Menulis"]}, "brand": "Asyik Belajar Bahasa Rusia", "unit_word": "bab", "tip_prefix": "Kiko berkata:", "fun_h": "🌟 Tahukah Kamu? <small>А ты зна́ешь?</small>", "word_box": "Kotak Kata:", "true": "Benar", "false": "Salah", "review_t": "Повторе́ние", "review_s": "Evaluasi — Ayo uji kemampuanmu!", "pron_note": "Tulisan di dalam garis miring, misalnya кни́га <span class=\"vp inl\">/KNI-ga/</span>, adalah <b>cara membacanya</b>. Suku kata yang ditulis <b>HURUF BESAR</b> dibaca lebih kuat (tekanan). Tanda <b>´</b> di atas huruf Rusia (misalnya а́) juga menunjukkan tekanan. Huruf <b>о</b> yang tidak ditekan biasanya dibaca <b>a</b>: молоко́ = /ma-la-KO/. <b>zh</b> = ж (seperti “j” lembut) · <b>kh</b> = х · <b>ts</b> = ц · <b>ch</b> = ч (seperti “c” pada <i>cicak</i>) · <b>sy</b> = ш · <b>y</b> pada “ы” dibaca seperti “i” yang ditarik ke belakang. Dengarkan juga guru, lagu, atau video berbahasa Rusia. 🎧", "pron_html": null}, "units": [{"num": 1, "en": "Чита́ем по слога́м", "id": "Membaca Suku Kata", "emoji": "📖", "goals": ["Mengenal pasangan vokal keras dan lunak.", "Membaca suku kata dan kata-kata pendek."], "sections": [{"t": "grammar", "title": "Vokal keras dan vokal lunak", "head": ["Vokal keras", "Bunyi", "Vokal lunak", "Bunyi"], "rows": [["А", "a", "Я", "ya"], ["О", "o", "Ё", "yo"], ["У", "u", "Ю", "yu"], ["Ы", "y", "И", "i"], ["Э", "e", "Е", "ye"]], "after": "Vokal lunak (<b>я, ё, ю, и, е</b>) membuat konsonan sebelumnya dibaca lebih <b>lembut</b>, misalnya <b>ня</b> dibaca /nya/."}, {"t": "grammar", "title": "Ayo membaca suku kata!", "head": ["", "а", "о", "у", "ы / и"], "rows": [["М", "ма (ma)", "мо (mo)", "му (mu)", "мы (my)"], ["П", "па (pa)", "по (po)", "пу (pu)", "пы (py)"], ["Л", "ла (la)", "ло (lo)", "лу (lu)", "лы (ly)"], ["Н", "на (na)", "но (no)", "ну (nu)", "ни (ni)"], ["С", "са (sa)", "со (so)", "су (su)", "си (si)"]], "after": null}, {"t": "vocab", "title": "Ayo membaca kata pendek!", "items": [["👩", "ма́ма", "MA-ma", "ibu"], ["👨", "па́па", "PA-pa", "ayah"], ["🥛", "молоко́", "ma-la-KO", "susu"], ["🐶", "соба́ка", "sa-BA-ka", "anjing"], ["🐟", "ры́ба", "RY-ba", "ikan"], ["🍋", "лимо́н", "li-MON", "lemon"], ["🦉", "сова́", "sa-VA", "burung hantu"], ["🌙", "луна́", "lu-NA", "bulan"]], "cols": 4, "label": "learn", "dict": true}, {"t": "tip", "html": "Bacalah pelan-pelan per suku kata: <b>ма-ма</b>, <b>мо-ло-ко́</b>, <b>со-ба́-ка</b>. Ingat, huruf <b>о</b> yang tidak ditekan dibaca <b>a</b>: молоко́ = /ma-la-KO/! 🗣️"}, {"t": "ex", "kind": "match", "instr": "Pasangkan suku kata dengan bunyinya!", "ans": "1–c, 2–e, 3–a, 4–d, 5–b", "left": ["му", "ня", "ло", "ри", "сы"], "right": ["lo", "sy", "mu", "ri", "nya"]}, {"t": "ex", "kind": "fill", "instr": "Tulis cara bacanya dengan huruf latin!", "ans": "1. MA-ma · 2. lu-NA · 3. RY-ba · 4. li-MON", "items": ["ма́ма = ___", "луна́ = ___", "ры́ба = ___", "лимо́н = ___"]}, {"t": "ex", "kind": "circle", "instr": "Lingkari kata yang sesuai dengan gambar!", "ans": "1. соба́ка · 2. луна́ · 3. молоко́", "items": ["🐶 ((соба́ка / сова́))", "🌙 ((луна́ / лимо́н))", "🥛 ((молоко́ / ма́ма))"]}, {"t": "fun", "html": "Anak-anak di Rusia mulai belajar membaca dengan buku bernama <b>«Бу́кварь»</b> (Bukvar), yaitu buku belajar huruf. 📘"}]}, {"num": 2, "en": "В шко́ле", "id": "Peralatan Sekolah", "emoji": "🎒", "goals": ["Menyebut benda-benda di sekolah.", "Bertanya dan menjawab: <b>Что э́то? — Э́то …</b>"], "sections": [{"t": "vocab", "title": "Benda di sekolah — Шко́льные ве́щи", "items": [["📖", "кни́га", "KNI-ga", "buku"], ["🖊️", "ру́чка", "RUCH-ka", "pulpen"], ["✏️", "каранда́ш", "ka-ran-DASY", "pensil"], ["🧽", "ла́стик", "LAS-tik", "penghapus"], ["📏", "лине́йка", "li-NYEY-ka", "penggaris"], ["🎒", "рюкза́к", "ryuk-ZAK", "tas punggung"], ["📓", "тетра́дь", "ti-TRAT'", "buku tulis"], ["✂️", "но́жницы", "NOZH-ni-tsy", "gunting"], ["🗄️", "стол", "stol", "meja"], ["🪑", "стул", "stul", "kursi"], ["🟩", "доска́", "das-KA", "papan tulis"], ["🧑‍🏫", "учи́тель", "u-CHI-tyel'", "guru"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Apa ini? Siapa ini?", "head": ["Bahasa Rusia", "Cara baca", "Arti"], "rows": [["Что э́то?", "shto E-ta?", "Apa ini?"], ["Э́то кни́га. 📖", "E-ta KNI-ga", "Ini buku."], ["Кто э́то?", "kto E-ta?", "Siapa ini?"], ["Э́то учи́тель. 🧑‍🏫", "E-ta u-CHI-tyel'", "Ini guru."], ["Э́то не ру́чка, э́то каранда́ш.", "E-ta nye RUCH-ka, E-ta ka-ran-DASY", "Ini bukan pulpen, ini pensil."]], "after": "<b>Что?</b> (shto) = apa? (untuk benda) · <b>Кто?</b> (kto) = siapa? (untuk orang dan hewan) · <b>не</b> (nye) = bukan/tidak. Huruf <b>ч</b> dalam <b>что</b> dibaca <b>sh</b>."}, {"t": "dialog", "title": "Boleh aku pinjam?", "lines": [["Pasha", "👦", "Ка́тя, у тебя́ есть ла́стик?", "KA-tya, u ti-BYA yest' LAS-tik?", "Katya, kamu punya penghapus?"], ["Katya", "👧", "Да, есть. Вот, пожа́луйста!", "da, yest'. vot, pa-ZHA-lus-ta!", "Ya, punya. Ini, silakan!"], ["Pasha", "👦", "Спаси́бо!", "spa-SI-ba!", "Terima kasih!"], ["Katya", "👧", "Пожа́луйста!", "pa-ZHA-lus-ta!", "Sama-sama!"]]}, {"t": "ex", "kind": "choice", "instr": "Что э́то? Pilih jawaban yang benar!", "ans": "1. a · 2. b · 3. b · 4. a", "items": ["✏️|Э́то каранда́ш.|Э́то кни́га.|Э́то стол.", "🎒|Э́то стул.|Э́то рюкза́к.|Э́то доска́.", "📏|Э́то ла́стик.|Э́то лине́йка.|Э́то ру́чка.", "🧑‍🏫 Кто э́то?|Э́то учи́тель.|Э́то тетра́дь.|Э́то но́жницы."]}, {"t": "ex", "kind": "match", "instr": "Pasangkan gambar dengan katanya!", "ans": "1–c, 2–e, 3–a, 4–d, 5–b", "left": ["✂️", "📓", "🪑", "🟩", "🖊️"], "right": ["стул", "ру́чка", "но́жницы", "доска́", "тетра́дь"]}, {"t": "ex", "kind": "fill", "instr": "Tulis Что atau Кто!", "ans": "1. Что · 2. Кто · 3. Кто (hewan memakai кто) · 4. Что", "items": ["___ э́то? — Э́то кни́га.", "___ э́то? — Э́то ма́ма.", "___ э́то? — Э́то ко́шка.", "___ э́то? — Э́то стол."]}, {"t": "fun", "html": "Di Rusia, hari pertama sekolah adalah tanggal <b>1 September</b> dan disebut <b>«День зна́ний»</b> (Hari Ilmu Pengetahuan). Murid membawa bunga untuk gurunya! 💐"}]}, {"num": 3, "en": "Фру́кты", "id": "Buah-buahan", "emoji": "🍉", "goals": ["Menyebut nama buah-buahan.", "Menyatakan suka dan tidak suka: <b>Я люблю́ … / Я не люблю́ …</b>"], "sections": [{"t": "vocab", "title": "Buah-buahan — Фру́кты", "items": [["🍎", "я́блоко", "YAB-la-ka", "apel"], ["🍌", "бана́н", "ba-NAN", "pisang"], ["🍊", "апельси́н", "a-pil'-SIN", "jeruk"], ["🍇", "виногра́д", "vi-na-GRAT", "anggur"], ["🍉", "арбу́з", "ar-BUS", "semangka"], ["🍐", "гру́ша", "GRU-sya", "pir"], ["🍋", "лимо́н", "li-MON", "lemon"], ["🍓", "клубни́ка", "klub-NI-ka", "stroberi"], ["🍍", "анана́с", "a-na-NAS", "nanas"], ["🥭", "ма́нго", "MAN-ga", "mangga"], ["🍑", "пе́рсик", "PYER-sik", "persik"], ["🍒", "ви́шня", "VISY-nya", "ceri"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Aku suka …", "head": ["Bahasa Rusia", "Cara baca", "Arti"], "rows": [["Я люблю́ бана́ны. 😋", "ya lyub-LYU ba-NA-ny", "Aku suka pisang."], ["Я не люблю́ лимо́ны. 😖", "ya nye lyub-LYU li-MO-ny", "Aku tidak suka lemon."], ["Ты лю́бишь виногра́д?", "ty LYU-bisy vi-na-GRAT?", "Kamu suka anggur?"], ["Да, люблю́! 👍 / Нет, не люблю́. 👎", "da, lyub-LYU / nyet, nye lyub-LYU", "Ya, suka! / Tidak suka."], ["Арбу́з сла́дкий. Лимо́н ки́слый.", "ar-BUS SLAT-kiy. li-MON KIS-lyy", "Semangka manis. Lemon asam."]], "after": "<b>Да</b> (da) = ya · <b>Нет</b> (nyet) = tidak · <b>сла́дкий</b> = manis · <b>ки́слый</b> = asam · <b>вку́сно!</b> (FKUS-na) = enak!"}, {"t": "dialog", "title": "Di pasar buah", "lines": [["Penjual", "👨‍🌾", "Здра́вствуйте! Что вы хоти́те?", "ZDRAST-vuy-tye! shto vy kha-TI-tye?", "Halo! Anda mau apa?"], ["Ibu", "👩", "Бана́ны и арбу́з, пожа́луйста.", "ba-NA-ny i ar-BUS, pa-ZHA-lus-ta", "Pisang dan semangka, tolong."], ["Ibu", "👩", "О́ля, ты лю́бишь ма́нго?", "O-lya, ty LYU-bisy MAN-ga?", "Olya, kamu suka mangga?"], ["Olya", "👧", "Да, о́чень! Ма́нго — э́то вку́сно!", "da, O-chin'! MAN-ga — E-ta FKUS-na!", "Ya, sangat! Mangga itu enak!"]]}, {"t": "ex", "kind": "fill", "instr": "Tulis nama buahnya!", "ans": "1. я́блоко · 2. виногра́д · 3. гру́ша · 4. анана́с · 5. клубни́ка", "bank": ["гру́ша", "виногра́д", "клубни́ка", "анана́с", "я́блоко"], "items": ["🍎 ___", "🍇 ___", "🍐 ___", "🍍 ___", "🍓 ___"]}, {"t": "ex", "kind": "circle", "instr": "Manis atau asam?", "ans": "1. сла́дкий · 2. ки́слый · 3. сла́дкий", "items": ["🍉 Арбу́з ((сла́дкий / ки́слый)).", "🍋 Лимо́н ((сла́дкий / ки́слый)).", "🍌 Бана́н ((сла́дкий / ки́слый))."]}, {"t": "ex", "kind": "table", "instr": "Tanyakan kepada 3 temanmu: “Ты лю́бишь …?” Beri tanda ✓ atau ✗.", "ans": "Jawaban bebas.", "head": ["Nama", "🍌 бана́ны", "🍋 лимо́ны", "🍉 арбу́з", "🥭 ма́нго"], "rows": ["Я| | | | ", " | | | | ", " | | | | ", " | | | | "]}, {"t": "fun", "html": "Di Rusia yang dingin, buah tropis seperti mangga dan nanas didatangkan dari negara lain. Buah yang banyak tumbuh di sana adalah <b>я́блоко</b> (apel), <b>ви́шня</b> (ceri), dan berbagai buah beri! 🍎🍒"}]}, {"num": 4, "en": "Живо́тные", "id": "Hewan-hewan", "emoji": "🐾", "goals": ["Menyebut nama hewan.", "Memakai <b>большо́й</b> (besar) dan <b>ма́ленький</b> (kecil).", "Mengenal suara hewan dalam bahasa Rusia."], "sections": [{"t": "vocab", "title": "Hewan — Живо́тные", "items": [["🐱", "ко́шка", "KOSY-ka", "kucing"], ["🐶", "соба́ка", "sa-BA-ka", "anjing"], ["🐄", "коро́ва", "ka-RO-va", "sapi"], ["🐴", "ло́шадь", "LO-syat'", "kuda"], ["🐐", "коза́", "ka-ZA", "kambing"], ["🐔", "ку́рица", "KU-ri-tsa", "ayam"], ["🦆", "у́тка", "UT-ka", "bebek"], ["🐰", "кро́лик", "KRO-lik", "kelinci"], ["🐻", "медве́дь", "mid-VYET'", "beruang"], ["🐺", "волк", "volk", "serigala"], ["🐘", "слон", "slon", "gajah"], ["🐒", "обезья́на", "a-biz-YA-na", "monyet"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Besar atau kecil?", "head": ["Bahasa Rusia", "Cara baca", "Arti"], "rows": [["Кто э́то? — Э́то слон.", "kto E-ta? — E-ta slon", "Siapa ini? — Ini gajah."], ["Слон большо́й. 🐘", "slon bal'-SYOY", "Gajah itu besar."], ["Кро́лик ма́ленький. 🐰", "KRO-lik MA-lin'-kiy", "Kelinci itu kecil."], ["Коро́ва больша́я. 🐄", "ka-RO-va bal'-SYA-ya", "Sapi itu besar."], ["Ку́рица ма́ленькая. 🐔", "KU-ri-tsa MA-lin'-ka-ya", "Ayam itu kecil."]], "after": "Untuk hewan “laki-laki” (kata berakhiran konsonan) pakai <b>большо́й / ма́ленький</b>. Untuk hewan “perempuan” (berakhiran -а/-я) pakai <b>больша́я / ма́ленькая</b>."}, {"t": "vocab", "title": "Suara hewan — Кто как говори́т?", "items": [["🐱", "Мя́у!", "MYA-u", "meong"], ["🐶", "Гав-гав!", "gaf-gaf", "guk guk"], ["🐄", "Му-у!", "muu", "mooo"], ["🦆", "Кря-кря!", "krya-krya", "kwek kwek"], ["🐓", "Кукареку́!", "ku-ka-ri-KU", "kukuruyuk"], ["🐸", "Ква-ква!", "kva-kva", "kwok kwok"], ["🐐", "Ме-е!", "mye", "mbeek"], ["🐑", "Бе-е!", "bye", "mbeek (domba)"]], "cols": 4, "label": "learn", "dict": false}, {"t": "ex", "kind": "match", "instr": "Hewan apa bersuara apa?", "ans": "1–c, 2–d, 3–b, 4–a", "left": ["🐶 соба́ка", "🐱 ко́шка", "🐄 коро́ва", "🦆 у́тка"], "right": ["Кря-кря!", "Му-у!", "Гав-гав!", "Мя́у!"]}, {"t": "ex", "kind": "fill", "instr": "Кто э́то? Tulis nama hewannya!", "ans": "1. медве́дь · 2. волк · 3. кро́лик · 4. обезья́на · 5. ло́шадь", "items": ["🐻 Э́то ___ .", "🐺 Э́то ___ .", "🐰 Э́то ___ .", "🐒 Э́то ___ .", "🐴 Э́то ___ ."]}, {"t": "ex", "kind": "circle", "instr": "Lingkari yang benar!", "ans": "1. большо́й · 2. ма́ленький · 3. больша́я", "items": ["🐘 Слон ((большо́й / ма́ленький)).", "🐰 Кро́лик ((большо́й / ма́ленький)).", "🐄 Коро́ва ((большо́й / больша́я))."]}, {"t": "fun", "html": "<b>Медве́дь</b> (beruang) adalah hewan yang sering menjadi lambang Rusia. Kata “медве́дь” berasal dari “мёд” (madu) dan artinya kira-kira <b>“yang tahu (letak) madu”</b>! 🐻🍯"}]}, {"num": 5, "en": "Дни неде́ли", "id": "Nama-nama Hari", "emoji": "📅", "goals": ["Menyebut nama hari secara berurutan.", "Bertanya dan menjawab: <b>Како́й сего́дня день?</b>"], "sections": [{"t": "vocab", "title": "Hari — Дни неде́ли", "items": [["1️⃣", "понеде́льник", "pa-ni-DYEL'-nik", "Senin"], ["2️⃣", "вто́рник", "FTOR-nik", "Selasa"], ["3️⃣", "среда́", "sri-DA", "Rabu"], ["4️⃣", "четве́рг", "chit-VYERK", "Kamis"], ["5️⃣", "пя́тница", "PYAT-ni-tsa", "Jumat"], ["6️⃣", "суббо́та", "sub-BO-ta", "Sabtu"], ["7️⃣", "воскресе́нье", "vas-kri-SYEN'-ye", "Minggu"], ["📅", "неде́ля", "ni-DYE-lya", "minggu (7 hari)"]], "cols": 4, "label": "learn", "dict": true}, {"t": "grammar", "title": "Hari apa sekarang?", "head": ["Bahasa Rusia", "Cara baca", "Arti"], "rows": [["Како́й сего́дня день?", "ka-KOY si-VOD-nya dyen'?", "Hari apa sekarang?"], ["Сего́дня пя́тница.", "si-VOD-nya PYAT-ni-tsa", "Hari ini hari Jumat."], ["За́втра суббо́та.", "ZAF-tra sub-BO-ta", "Besok hari Sabtu."], ["Вчера́ был четве́рг.", "fchi-RA byl chit-VYERK", "Kemarin hari Kamis."]], "after": "<b>сего́дня</b> (si-VOD-nya) = hari ini · <b>за́втра</b> = besok · <b>вчера́</b> = kemarin. Nama hari ditulis dengan <b>huruf kecil</b> dalam bahasa Rusia."}, {"t": "dialog", "title": "Besok hari apa?", "lines": [["Dima", "👦", "Како́й сего́дня день?", "ka-KOY si-VOD-nya dyen'?", "Hari apa sekarang?"], ["Sonya", "👧", "Сего́дня пя́тница!", "si-VOD-nya PYAT-ni-tsa!", "Hari ini hari Jumat!"], ["Dima", "👦", "Ура́! За́втра суббо́та!", "u-RA! ZAF-tra sub-BO-ta!", "Horee! Besok hari Sabtu!"]]}, {"t": "ex", "kind": "fill", "instr": "Tulis hari yang hilang!", "ans": "1. вто́рник · 2. пя́тница · 3. воскресе́нье", "items": ["понеде́льник → ___ → среда́", "четве́рг → ___ → суббо́та", "суббо́та → ___ → понеде́льник"]}, {"t": "ex", "kind": "match", "instr": "Pasangkan hari dengan artinya!", "ans": "1–c, 2–d, 3–a, 4–b", "left": ["среда́", "воскресе́нье", "четве́рг", "суббо́та"], "right": ["Kamis", "Sabtu", "Rabu", "Minggu"]}, {"t": "ex", "kind": "choice", "instr": "Pilih jawaban yang benar!", "ans": "1. b · 2. b", "items": ["Сего́дня понеде́льник. За́втра …|воскресе́нье|вто́рник|пя́тница", "за́втра artinya …|kemarin|besok|hari ini"]}, {"t": "fun", "html": "Nama hari Rusia punya arti lucu! <b>вто́рник</b> dari “второ́й” (kedua), <b>четве́рг</b> dari “четы́ре” (empat), <b>пя́тница</b> dari “пять” (lima). Hari Minggu, <b>воскресе́нье</b>, berarti “kebangkitan”. 🤓"}]}, {"num": 6, "en": "Счёт от 11 до 20", "id": "Bilangan 11 sampai 20", "emoji": "🔢", "goals": ["Menyebut bilangan 11–20.", "Berhitung sederhana dalam bahasa Rusia."], "sections": [{"t": "vocab", "title": "Bilangan — Чи́сла", "items": [["11", "оди́ннадцать", "a-DI-na-tsat'", "sebelas"], ["12", "двена́дцать", "dvi-NA-tsat'", "dua belas"], ["13", "трина́дцать", "tri-NA-tsat'", "tiga belas"], ["14", "четы́рнадцать", "chi-TYR-na-tsat'", "empat belas"], ["15", "пятна́дцать", "pit-NA-tsat'", "lima belas"], ["16", "шестна́дцать", "sys-NA-tsat'", "enam belas"], ["17", "семна́дцать", "sim-NA-tsat'", "tujuh belas"], ["18", "восемна́дцать", "va-sim-NA-tsat'", "delapan belas"], ["19", "девятна́дцать", "di-vit-NA-tsat'", "sembilan belas"], ["20", "два́дцать", "DVA-tsat'", "dua puluh"]], "cols": 5, "label": "learn", "dict": false}, {"t": "note", "html": "Bilangan 11–19 dibentuk dari <b>angka + -на́дцать</b> (-NA-tsat', artinya “di atas sepuluh”). Contoh: пят<b>на́дцать</b> = 15. Huruf <b>дц</b> dibaca <b>ts</b>.", "title": "Ingat, ya!"}, {"t": "grammar", "title": "Ayo berhitung!", "head": ["Soal", "Bahasa Rusia", "Cara baca"], "rows": [["10 + 5 = 15", "де́сять плюс пять — пятна́дцать", "DYE-syat' plyus pyat' — pit-NA-tsat'"], ["20 − 8 = 12", "два́дцать ми́нус во́семь — двена́дцать", "DVA-tsat' MI-nus VO-syim' — dvi-NA-tsat'"]], "after": "<b>плюс</b> = tambah · <b>ми́нус</b> = kurang · <b>равно́</b> (rav-NO) = sama dengan"}, {"t": "ex", "kind": "match", "instr": "Pasangkan angka dengan kata!", "ans": "1–c, 2–e, 3–a, 4–b, 5–d", "left": ["14", "20", "11", "17", "12"], "right": ["оди́ннадцать", "семна́дцать", "четы́рнадцать", "двена́дцать", "два́дцать"]}, {"t": "ex", "kind": "fill", "instr": "Hitung, lalu tulis jawabannya dalam bahasa Rusia!", "ans": "1. трина́дцать · 2. шестна́дцать · 3. девятна́дцать · 4. оди́ннадцать", "items": ["10 + 3 = ___", "8 + 8 = ___", "20 − 1 = ___", "15 − 4 = ___"]}, {"t": "ex", "kind": "write", "instr": "Jawab tentang dirimu!", "ans": "Jawaban bebas.", "items": ["Ско́лько тебе́ лет? — Мне ___ лет.", "Ско́лько ученико́в в кла́ссе? (Berapa murid di kelasmu?) — ___"]}]}], "review": [{"t": "ex", "kind": "choice", "instr": "Pilih jawaban yang benar!", "ans": "1. b · 2. a · 3. b · 4. b · 5. a · 6. b · 7. a · 8. b", "items": ["молоко́ dibaca …|mo-lo-ko|ma-la-KO|MO-lo-ka", "Что э́то? ✏️|Э́то каранда́ш.|Э́то кни́га.|Э́то учи́тель.", "Я не люблю́ artinya …|aku suka|aku tidak suka|apakah kamu suka", "🐘 Слон …|ма́ленький|большо́й|ки́слый", "Hari setelah пя́тница adalah …|суббо́та|четве́рг|среда́", "пятна́дцать = …|5|15|50", "Кто э́то? 👩|Э́то ма́ма.|Э́то стол.|Э́то арбу́з.", "Гав-гав! adalah suara …|kucing|anjing|bebek"]}, {"t": "ex", "kind": "match", "instr": "Pasangkan!", "ans": "1–e, 2–d, 3–c, 4–b, 5–a", "left": ["кни́га", "гру́ша", "медве́дь", "за́втра", "два́дцать"], "right": ["20", "besok", "beruang", "pir", "buku"]}, {"t": "ex", "kind": "write", "instr": "Jawab tentang dirimu!", "ans": "Jawaban bebas.", "items": ["Я люблю́ ___ . (buah kesukaanmu)", "Сего́дня ___ ."]}], "words": [{"e": "👩", "w": "м